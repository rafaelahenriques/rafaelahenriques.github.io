// Cloudflare Workers Builds: `npm run build`, then `npx wrangler deploy`
// serves the static Astro output in ./dist. The name must match the Worker
// in the Cloudflare dashboard.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "rafaelahenriques-github-io",
    "compatibility_date": "2026-10-01",
    // only the videos and other media go through it: it answers requests for
    // part of a file (Range), which the assets on their own don't, and which
    // Safari needs before it will play a video (worker/index.js)
    "main": "./worker/index.js",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/media/*"],
        // unknown addresses get the site's own 404 page (src/pages/404.astro)
        "not_found_handling": "404-page"
    }
}
