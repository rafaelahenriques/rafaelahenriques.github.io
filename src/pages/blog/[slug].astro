---
import Base from "../../layouts/BaseLayout.astro";
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";

type BlogEntry = CollectionEntry<"blog">;

const formatDate = (d: Date): string =>
  d.toLocaleDateString("en-GB", { dateStyle: "medium" });

export async function getStaticPaths() {
  const entries = (await getCollection("blog")) as BlogEntry[];
  return entries.map((entry) => ({
    // URL param is still called "slug", value comes from entry.id
    params: { slug: entry.id.replace(/\.md$/, "") },
  }));
}

const entries = (await getCollection("blog")) as BlogEntry[];
const currentId = Astro.params.slug;

// current entry
const entry = entries.find((p) => p.id.replace(/\.md$/, "") === currentId);
if (!entry) {
  throw new Error("Post not found");
}

// render markdown
const { Content } = await render(entry);

// normalise tags
const tags = Array.isArray(entry.data.tags) ? entry.data.tags : [];

// sort by date (newest → oldest) for prev/next navigation
const sorted = [...entries].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const currentIndex = sorted.findIndex(
  (p) => p.id.replace(/\.md$/, "") === currentId
);
const prev = currentIndex > 0 ? sorted[currentIndex - 1] : null;
const next =
  currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;
---

<Base title={entry.data.title} description={entry.data.description}>
  <article class="blog-layout">
    <header class="blog-header">
      <a href="/blog/" class="blog-back">
        ← Back to all posts
      </a>

      <div class="blog-meta-row">
        {tags.length > 0 && (
          <div class="blog-tags">
            {tags.map((tag) => (
              <span class="blog-tag">{tag}</span>
            ))}
          </div>
        )}

        <span class="blog-dot">•</span>

        <span class="blog-date">
          {formatDate(entry.data.date)}
        </span>
      </div>

      <h1 class="blog-title">{entry.data.title}</h1>

      <hr class="blog-divider" />
    </header>

    {(prev || next) && (
      <nav class="blog-nav" aria-label="Post navigation">
        {prev ? (
          <a
            href={`/blog/${prev.id.replace(/\.md$/, "")}/`}
            class="blog-nav__link blog-nav__prev"
            aria-label={`Previous: ${prev.data.title}`}
          >
            {/* MOBILE: circle only */}
            <span class="blog-nav__circle" aria-hidden="true">←</span>

            {/* DESKTOP: keep old text style */}
            <span class="blog-nav__label">← {prev.data.title}</span>
          </a>
        ) : (
          <span />
        )}

        {next ? (
          <a
            href={`/blog/${next.id.replace(/\.md$/, "")}/`}
            class="blog-nav__link blog-nav__next"
            aria-label={`Next: ${next.data.title}`}
          >
            {/* DESKTOP: keep old text style */}
            <span class="blog-nav__label">{next.data.title} →</span>

            {/* MOBILE: circle only */}
            <span class="blog-nav__circle" aria-hidden="true">→</span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )}

    <section class="blog-body">
      <Content />
    </section>
  </article>
</Base>

<style>
  /* ---- CONTAINER ---- */
  .blog-layout {
    max-width: 900px;
    margin-inline: auto;
    padding-inline: var(--space-s);
    padding-bottom: var(--space-xl);
  }

  .blog-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .blog-back {
    align-self: flex-start;
    font-size: var(--fontsize--1);
    color: var(--muted);
    text-decoration: none;
    padding: 4px 10px;
    border-radius: 999px;
    background: light-dark(
      color-mix(in oklab, var(--surface) 96%, transparent),
      color-mix(in oklab, var(--bg) 80%, var(--accent) 10%)
    );
    border: 1px solid var(--border);
    transition:
      background 0.18s ease,
      transform 0.12s ease,
      color 0.18s ease;
  }

  .blog-back:hover {
    background: var(--glass);
    color: var(--text);
    transform: translateY(-1px);
    text-decoration: none;
  }

  /* ---- META ROW ---- */
  .blog-meta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: var(--fontsize--1);
    margin-top: var(--space-3xs);
    margin-bottom: var(--space-xs);
    flex-wrap: wrap;
  }

  .blog-tags {
    margin-top: 1rem;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .blog-tag {
    padding: 2px 8px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--accent) 18%, transparent);
    border: 1px solid color-mix(in oklab, var(--accent) 40%, transparent);
    font-size: var(--fontsize--2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .blog-dot {
    margin-top: 1rem;
    opacity: 0.5;
  }

  .blog-date {
    margin-top: 1rem;
    font-size: var(--fontsize--1);
  }

  /* ---- TITLE ---- */
  .blog-title {
    font-family: var(--font-title);
    font-size: var(--fontsize--1);
    line-height: 1.1;
  }

  /* ---- DIVIDER ---- */
  .blog-divider {
    border: none;
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--space-m);
  }

  /* ---- BODY ---- */
  .blog-body {
    font-size: var(--fontsize-0);
    line-height: 1.7;
    color: var(--text);
    margin-top: var(--space-xl);
    overflow-wrap: break-word;
  }

  .blog-body p {
    margin-bottom: var(--space-s);
    max-width: 70ch;
  }

  .blog-body h2 {
    font-size: var(--fontsize-2);
    font-weight: 700;
    margin-top: var(--space-s);
    margin-bottom: var(--space-xs);
  }

  .blog-body h3 {
    font-size: var(--fontsize-1);
    margin-top: var(--space-m);
    margin-bottom: var(--space-2xs);
  }

  .blog-body ul,
  .blog-body ol {
    margin-bottom: var(--space-s);
    padding-left: 1.5rem;
  }

  .blog-body li {
    margin-bottom: 0.5rem;
  }

  /* ---- PREV / NEXT NAV ---- */
  .blog-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-xs);
    border-top: 1px solid var(--border);
    gap: var(--space-xs);
    font-size: var(--fontsize--2);
  }

  .blog-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    max-width: 48%;
    color: var(--muted);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--surface) 92%, transparent);
    transition:
      background 0.18s ease,
      color 0.18s ease,
      transform 0.12s ease;
    line-height: 1.4;
  }

  .blog-nav__link:hover {
    background: var(--glass);
    color: var(--text);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .blog-nav__prev {
    text-align: left;
    justify-content: flex-start;
  }

  .blog-nav__next {
    text-align: right;
    justify-content: flex-end;
  }

  .blog-nav__label {
    white-space: nowrap;
  }

  .blog-nav__circle {
    display: none; /* visible only on mobile */
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--accent) 15%, transparent);
    border: 1px solid color-mix(in oklab, var(--accent) 40%, transparent);
    align-items: center;
    justify-content: center;
    font-size: var(--fontsize-1);
    color: var(--text);
    font-weight: bold;
    flex-shrink: 0;
  }

  .blog-nav__link:hover .blog-nav__circle {
    background: var(--glass);
    border-color: var(--accent);
  }

  @media (max-width: 599px) {
    .blog-layout {
      padding-inline: var(--space-2xs);
    }

    .blog-title {
      font-size: var(--fontsize-0);
    }

    /* Keep arrows left/right on a row, no column */
    .blog-nav {
      flex-direction: row;
      align-items: center;
    }

    .blog-nav__link {
      max-width: unset;
      background: transparent;
      padding-inline: 0;
    }

    .blog-nav__label {
      display: none;
    }

    .blog-nav__circle {
      display: flex;
    }
  }
</style>