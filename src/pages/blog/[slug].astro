---
import Base from "../../layouts/BaseLayout.astro";
import { render } from "astro:content";
import { getPosts, formatDate, slugOf, type BlogEntry } from "../../lib/content";

export async function getStaticPaths() {
    // newest → oldest, so "previous" is the newer post
    const posts = await getPosts();
    return posts.map((entry, i) => ({
        params: { slug: slugOf(entry) },
        props: { entry, prev: posts[i - 1] ?? null, next: posts[i + 1] ?? null },
    }));
}

interface Props {
    entry: BlogEntry;
    prev: BlogEntry | null;
    next: BlogEntry | null;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { title, date, description, tags } = entry.data;
---

<Base title={title} description={description}>
    <header class="page-head wrap">
        <a href="/blog/" class="mono muted link" data-reveal>← All posts</a>
        <h1 class="display post-title" data-split>{title}</h1>
    </header>

    <article class="wrap">
        <div class="row">
            <div class="row__label mono meta" data-reveal>
                <time datetime={date.toISOString()}>{formatDate(date)}</time>
                {tags && <span class="muted">{tags.join(", ")}</span>}
            </div>
            <div class="row__body">
                {description && <p class="lead" data-split>{description}</p>}
                <div class="prose post-body" data-reveal>
                    <Content />
                </div>
            </div>
        </div>
    </article>

    <nav class="section wrap pager" aria-label="Post navigation">
        {
            prev && (
                <a href={`/blog/${slugOf(prev)}/`} class="pager__link row">
                    <span class="row__label mono muted">← Newer</span>
                    <span class="row__body h2">{prev.data.title}</span>
                </a>
            )
        }
        {
            next && (
                <a href={`/blog/${slugOf(next)}/`} class="pager__link row">
                    <span class="row__label mono muted">Older →</span>
                    <span class="row__body h2">{next.data.title}</span>
                </a>
            )
        }
    </nav>
</Base>

<style>
    .post-title {
        max-width: 18ch;
        font-size: clamp(2.5rem, 1rem + 5vw, 6.5rem);
    }

    .meta {
        display: grid;
        gap: 6px;
        align-content: start;
    }

    .post-body {
        margin-top: clamp(40px, 5vw, 72px);
    }

    .pager {
        display: grid;
    }

    .pager__link .h2 {
        padding-bottom: 14px;
        transition: transform 0.6s var(--ease);
    }

    .pager__link:hover .h2 {
        transform: translateX(12px);
    }

    .pager__link:last-child {
        border-bottom: 1px solid var(--line);
    }
</style>
