---
import Base from "../../layouts/BaseLayout.astro";
import { getPosts, formatDate, pad, slugOf, type BlogEntry } from "../../lib/content";

// map tags → one or more filter categories
const getCategories = (entry: BlogEntry): string[] => {
    const tags = (entry.data.tags ?? []).map((t) => t.toLowerCase());
    const categories: string[] = [];

    if (tags.includes("game dev")) categories.push("game");
    if (tags.includes("web dev")) categories.push("web");
    if (tags.includes("design")) categories.push("design");
    if (tags.includes("programming")) categories.push("programming");
    if (tags.includes("beginner")) categories.push("beginner");

    return categories.length > 0 ? categories : ["other"];
};

const filters = [
    { value: "all", label: "All" },
    { value: "game", label: "Game Dev" },
    { value: "web", label: "Web Dev" },
    { value: "design", label: "Design" },
    { value: "programming", label: "Programming" },
    { value: "beginner", label: "Beginner" },
];

const posts = await getPosts();
---

<Base title="Blog" description="Rafaela Henriques — notes, technical snippets and observations.">
    <header class="page-head wrap">
        <p class="mono muted" data-reveal>Blog ({pad(posts.length)})</p>
        <h1 class="display" data-split>Notes &amp; thoughts</h1>
        <p class="lead page-lead" data-split data-split-delay="0.2">
            Notes, technical snippets and observations — from CSS architecture
            and performance to game development logic.
        </p>
    </header>

    <section class="wrap" aria-label="Posts">
        <div class="blog-toolbar row" data-reveal>
            <p class="row__label mono muted">Filter</p>
            <div class="row__body blog-toolbar__controls mono">
                <nav class="filters" aria-label="Filter posts by category" data-blog-filter-root>
                    {
                        filters.map((f) => (
                            <button
                                type="button"
                                class="text-button link"
                                data-filter={f.value}
                                aria-pressed={f.value === "all" ? "true" : "false"}
                            >
                                {f.label}
                            </button>
                        ))
                    }
                </nav>
                <div class="filters" role="group" aria-label="Sort posts by date" data-blog-sort-root>
                    <button type="button" class="text-button link" data-sort="newest" aria-pressed="true">
                        Newest
                    </button>
                    <button type="button" class="text-button link" data-sort="oldest" aria-pressed="false">
                        Oldest
                    </button>
                </div>
            </div>
        </div>

        <ol class="index index--dated" data-blog-list>
            {
                posts.map((post) => (
                    <li
                        class="index__item"
                        data-reveal
                        data-blog-category={getCategories(post).join(" ")}
                        data-date={post.data.date.toISOString()}
                    >
                        <a href={`/blog/${slugOf(post)}/`} class="index__link">
                            <span class="index__num mono muted">→</span>
                            <span class="index__title">
                                {post.data.title}
                                {post.data.description && (
                                    <span class="entry__desc muted">{post.data.description}</span>
                                )}
                            </span>
                            <span class="index__meta mono muted">{post.data.tags?.join(", ")}</span>
                            <time class="index__year mono" datetime={post.data.date.toISOString()}>
                                {formatDate(post.data.date)}
                            </time>
                        </a>
                    </li>
                ))
            }
        </ol>
    </section>
</Base>

<script>
    const list = document.querySelector<HTMLElement>("[data-blog-list]");
    const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-blog-filter-root] [data-filter]");
    const sortButtons = document.querySelectorAll<HTMLButtonElement>("[data-blog-sort-root] [data-sort]");
    const items = [...document.querySelectorAll<HTMLElement>("[data-blog-category]")];

    const press = (buttons: NodeListOf<HTMLButtonElement>, active: HTMLButtonElement) =>
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === active)));

    filterButtons.forEach((button) =>
        button.addEventListener("click", () => {
            const filter = button.dataset.filter ?? "all";
            press(filterButtons, button);
            items.forEach((item) => {
                const categories = (item.dataset.blogCategory ?? "other").split(" ");
                item.hidden = !(filter === "all" || categories.includes(filter));
            });
        }),
    );

    sortButtons.forEach((button) =>
        button.addEventListener("click", () => {
            const newest = button.dataset.sort === "newest";
            press(sortButtons, button);
            const time = (el: HTMLElement) => new Date(el.dataset.date ?? "").getTime();
            items
                .sort((a, b) => (newest ? time(b) - time(a) : time(a) - time(b)))
                .forEach((item) => list?.append(item));
        }),
    );
</script>

<style>
    .page-lead {
        margin-top: clamp(24px, 3vw, 40px);
        max-width: 32ch;
    }

    .blog-toolbar {
        margin-bottom: clamp(40px, 6vw, 80px);
    }

    .blog-toolbar__controls {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 12px var(--gutter);
    }

    .index__item[hidden] {
        display: none;
    }

    .entry__desc {
        display: block;
        margin-top: 8px;
        max-width: 48ch;
        font-size: var(--fs-small);
        letter-spacing: 0;
        line-height: 1.4;
    }
</style>
