---
import Base from "../../layouts/BaseLayout.astro";
import {
  getCollection,
  type CollectionEntry,
} from "astro:content";

type BlogEntry = CollectionEntry<"blog">;

const formatDate = (d: Date): string =>
  d.toLocaleDateString("en-GB", { dateStyle: "medium" });

const posts = (await getCollection("blog")) as BlogEntry[];

// date is already a Date (z.date()), no need to wrap
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Blog" description="Rafaela's blog posts.">
  <section class="section">
    <h1 class="page-title">Blog</h1>
    <p class="lead">Thoughts, notes, and tutorials.</p>

    <div class="grid" style={`margin-top: calc(var(--gap) * 2)`}>
      {posts.map((post) => (
        <a href={`/blog/${post.id}/`} class="card">
          <h3 class="card__title">{post.data.title}</h3>
          <p class="card__meta">
            {formatDate(post.data.date)}
          </p>
        </a>
      ))}
    </div>
  </section>
</Base>
