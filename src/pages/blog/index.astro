---
import Base from "../../layouts/BaseLayout.astro";
import {
  getCollection,
  type CollectionEntry,
} from "astro:content";

type BlogEntry = CollectionEntry<"blog">;

const formatDate = (d: Date): string =>
  d.toLocaleDateString("en-GB", { dateStyle: "medium" });

const posts = (await getCollection("blog")) as BlogEntry[];

// sort newest → oldest by default
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// map tags → one or more filter categories
// Allowed filter categories: game, web, design, programming, beginner
const getCategories = (entry: BlogEntry): string[] => {
  const rawTags: string[] = Array.isArray(entry.data.tags)
    ? entry.data.tags
    : [];
  const tags = rawTags.map((t) => t.toLowerCase());

  const categories: string[] = [];

  if (tags.includes("game dev")) categories.push("game");
  if (tags.includes("web dev")) categories.push("web");
  if (tags.includes("design")) categories.push("design");
  if (tags.includes("programming")) categories.push("programming");
  if (tags.includes("beginner")) categories.push("beginner");

  return categories.length > 0 ? categories : ["other"];
};
---

<Base title="Blog" description="Rafaela's blog posts.">
  <section class="section">
    <h1 class="page-title">Blog</h1>
    <p class="lead">
      A collection of notes, technical snippets, and observations. I use this space to document what I’m learning—from CSS architecture and performance patterns to game development logic.
    </p>

    <!-- FILTER + SORT BAR WRAPPER -->
    <div class="blog-controls">
      <!-- FILTER BAR -->
      <nav
        class="blog-filters"
        aria-label="Filter blog posts by category"
        data-blog-filter-root
        data-active-filter="all"
      >
        <button
          type="button"
          class="blog-filters__button"
          data-filter="all"
          aria-pressed="true"
        >
          All
        </button>
        <button
          type="button"
          class="blog-filters__button"
          data-filter="game"
          aria-pressed="false"
        >
          Game Dev
        </button>
        <button
          type="button"
          class="blog-filters__button"
          data-filter="web"
          aria-pressed="false"
        >
          Web Dev
        </button>
        <button
          type="button"
          class="blog-filters__button"
          data-filter="design"
          aria-pressed="false"
        >
          Design
        </button>
        <button
          type="button"
          class="blog-filters__button"
          data-filter="programming"
          aria-pressed="false"
        >
          Programming
        </button>
        <button
          type="button"
          class="blog-filters__button"
          data-filter="beginner"
          aria-pressed="false"
        >
          Beginner
        </button>
      </nav>

      <!-- SORT BUTTONS -->
      <div
        class="blog-sort"
        aria-label="Sort blog posts by date"
        data-blog-sort-root
        data-sort-order="newest"
      >
        <button
          type="button"
          class="blog-sort__button"
          data-sort="newest"
          aria-pressed="true"
        >
          Newest first
        </button>
        <button
          type="button"
          class="blog-sort__button"
          data-sort="oldest"
          aria-pressed="false"
        >
          Oldest first
        </button>
      </div>
    </div>

    <!-- 1-column mobile, 2-column from 720px+; date-sorted already -->
    <div
      class="grid blog-grid"
      style={`margin-top: calc(var(--gap) * 2)`}
    >
      {posts.map((post) => {
        const categories = getCategories(post);
        return (
          <a
            href={`/blog/${post.id.replace(/\.md$/, "")}/`}
            class="card"
            data-blog-category={categories.join(" ")}
            data-date={post.data.date.toISOString()}
          >
            <h3 class="card__title">{post.data.title}</h3>
            <p class="card__meta">
              {formatDate(post.data.date)}
            </p>

            {post.data.tags && post.data.tags.length > 0 && (
              <div class="card__tags" aria-label="Tags">
                {post.data.tags.map((tag) => (
                  <span class="tag-pill">{tag}</span>
                ))}
              </div>
            )}
          </a>
        );
      })}
    </div>
  </section>

  <script is:inline>
    const setupBlogFilters = () => {
      const root = document.querySelector("[data-blog-filter-root]");
      if (!root) return;

      const buttons = root.querySelectorAll("[data-filter]");
      const cards = document.querySelectorAll("[data-blog-category]");

      const applyFilter = (filter) => {
        root.dataset.activeFilter = filter;

        buttons.forEach((button) => {
          const buttonFilter = button.dataset.filter;
          const isActive = buttonFilter === filter;
          button.setAttribute("aria-pressed", isActive ? "true" : "false");
        });

        cards.forEach((card) => {
          const raw = card.dataset.blogCategory || "other";
          const categories = raw.split(" ").filter(Boolean);
          const show = filter === "all" || categories.includes(filter);
          card.style.display = show ? "" : "none";
        });
      };

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const filter = button.dataset.filter;
          if (!filter) return;
          applyFilter(filter);
        });
      });

      applyFilter(root.dataset.activeFilter || "all");
    };

    const setupBlogSort = () => {
      const sortRoot = document.querySelector("[data-blog-sort-root]");
      const container = document.querySelector(".blog-grid");
      if (!sortRoot || !container) return;

      const sortButtons = sortRoot.querySelectorAll("[data-sort]");
      const cards = Array.from(
        container.querySelectorAll("[data-blog-category]")
      );

      const applySort = (order) => {
        sortRoot.dataset.sortOrder = order;

        sortButtons.forEach((button) => {
          const buttonOrder = button.dataset.sort;
          const isActive = buttonOrder === order;
          button.setAttribute("aria-pressed", isActive ? "true" : "false");
        });

        const sorted = [...cards].sort((a, b) => {
          const da = new Date(a.dataset.date || "").getTime();
          const db = new Date(b.dataset.date || "").getTime();
          return order === "newest" ? db - da : da - db;
        });

        // re-append in new order
        sorted.forEach((card) => container.appendChild(card));
      };

      sortButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const order = button.dataset.sort;
          if (!order) return;
          applySort(order);
        });
      });

      // initial state: newest first
      applySort(sortRoot.dataset.sortOrder || "newest");
    };

    if (typeof window !== "undefined") {
      window.addEventListener("DOMContentLoaded", () => {
        setupBlogFilters();
        setupBlogSort();
      });
    }
  </script>

  <style>
    .blog-controls {
      display: flex;
      flex-direction: column;
      gap: var(--space-2xs);
      align-items: flex-start;
      margin-top: var(--gap);
    }

    .blog-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 0;
    }

    .blog-filters__button {
      border-radius: 999px;
      border: 1px solid var(--border);
      background: color-mix(in oklab, var(--surface) 92%, transparent);
      padding: 6px 14px;
      font-size: var(--step--1);
      cursor: pointer;
      color: var(--muted);
      transition:
        background 0.18s ease,
        border-color 0.18s ease,
        color 0.18s ease,
        transform 0.12s ease;
    }

    .blog-filters__button[aria-pressed="true"] {
      color: var(--text);
      border-color: color-mix(in oklab, var(--accent) 60%, var(--border));
      background: color-mix(in oklab, var(--accent) 20%, var(--surface));
      transform: translateY(-1px);
    }

    .blog-filters__button:hover {
      color: var(--text);
      background: color-mix(in oklab, var(--accent) 10%, var(--surface));
    }

    .blog-sort {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
    }

    .blog-sort__button {
      border-radius: 999px;
      border: 1px solid var(--border);
      background: color-mix(in oklab, var(--surface) 92%, transparent);
      padding: 4px 10px;
      font-size: var(--fontsize--2);
      cursor: pointer;
      color: var(--muted);
      transition:
        background 0.18s ease,
        border-color 0.18s ease,
        color 0.18s ease,
        transform 0.12s ease;
    }

    .blog-sort__button[aria-pressed="true"] {
      color: var(--text);
      border-color: color-mix(in oklab, var(--accent) 60%, var(--border));
      background: color-mix(in oklab, var(--accent) 16%, var(--surface));
      transform: translateY(-1px);
    }

    .blog-sort__button:hover {
      color: var(--text);
      background: color-mix(in oklab, var(--accent) 8%, var(--surface));
    }

    @media (min-width: 720px) {
      .blog-controls {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }

      .blog-filters {
        justify-content: flex-start;
      }
    }
  </style>
</Base>