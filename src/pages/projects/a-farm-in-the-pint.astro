---
/**
 * Ben & Jerry's: A Farm in the Pint (customPage in the content entry). The
 * film on the web page it was designed for opens the page, beside the title.
 * Then the ## sections of index.md: the thinking behind it, the storyboard in
 * seven frames, then the process, each section with what it describes: the
 * diorama it began as, the ice cream, the three versions of the farm, the cows,
 * and the film on its own.
 */
import Base from "../../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import { projectSeo } from "../../lib/seo";
import LoopVideo from "../../components/LoopVideo.astro";
import Shot from "../../components/Shot.astro";
import Lightbox from "../../components/Lightbox.astro";
import NextProject from "../../components/NextProject.astro";

import filmPoster from "../../content/projects/a-farm-in-the-pint/media/film-poster.jpg";
import pagePoster from "../../content/projects/a-farm-in-the-pint/media/page-poster.jpg";
import dioramaPoster from "../../content/projects/a-farm-in-the-pint/media/diorama-poster.jpg";
import story1 from "../../content/projects/a-farm-in-the-pint/media/story-1.jpg";
import story2 from "../../content/projects/a-farm-in-the-pint/media/story-2.jpg";
import story3 from "../../content/projects/a-farm-in-the-pint/media/story-3.jpg";
import story4 from "../../content/projects/a-farm-in-the-pint/media/story-4.jpg";
import story5 from "../../content/projects/a-farm-in-the-pint/media/story-5.jpg";
import story6 from "../../content/projects/a-farm-in-the-pint/media/story-6.jpg";
import story7 from "../../content/projects/a-farm-in-the-pint/media/story-7.jpg";
import icecream1 from "../../content/projects/a-farm-in-the-pint/media/icecream-1.jpg";
import icecream2 from "../../content/projects/a-farm-in-the-pint/media/icecream-2.jpg";
import icecream3 from "../../content/projects/a-farm-in-the-pint/media/icecream-3.jpg";
import version1 from "../../content/projects/a-farm-in-the-pint/media/version-1.jpg";
import version2 from "../../content/projects/a-farm-in-the-pint/media/version-2.jpg";
import version3 from "../../content/projects/a-farm-in-the-pint/media/version-3.jpg";
import cows1 from "../../content/projects/a-farm-in-the-pint/media/cows-1.jpg";
import cows2 from "../../content/projects/a-farm-in-the-pint/media/cows-2.jpg";

const project = (await getEntry("projects", "a-farm-in-the-pint"))!;
const { title, description, role, year, category, context } = project.data;

const facts = [
    { label: "Year", value: year },
    { label: "Role", value: role },
    { label: "Tools", value: "Maya and Blender (EEVEE). The scene and animation were built with Python scripts written with Claude Code." },
    { label: "Specs", value: "28.5 seconds (685 frames), 1920×1080, 24 fps, seamless loop" },
    { label: "Context", value: context },
];

// index.md split at its ## headings; each part is one section's text
const parts = new Map(
    (project.rendered?.html ?? "").split(/(?=<h2[\s>])/).flatMap((chunk) => {
        const heading = chunk.match(/^<h2[^>]*>([\s\S]*?)<\/h2>/);
        return heading ? [[heading[1].trim(), chunk.slice(heading[0].length)] as [string, string]] : [];
    }),
);
// the text-only sections that open the case study, in order
const thinking = ["The concept", "Why now", "The brief"];
const placed = [...thinking, "Starting point", "Appetite", "Editing the farm", "The cows", "On the page", "Note"];
// a new ## section added to index.md later still shows up, before the note
const extra = [...parts.keys()].filter((heading) => !placed.includes(heading));

// the storyboard, a frame at a time, from the film
const story = [
    { img: story1, alt: "The pint in its blue and white cloud packaging, its lid lifting off" },
    { img: story2, alt: "A large white milk can tilted over the open pint, pouring in a stream of cream" },
    { img: story3, alt: "A mound of pale ice cream rising above the rim of the pint, a dark line of chocolate running down it" },
    { img: story4, alt: "A small barn, two trees and a red tractor on top of the ice cream, a fence starting to appear" },
    { img: story5, alt: "A closer view of the finished farm: the barn, trees, tractor, sunflowers and cows in a fenced pen" },
    { img: story6, alt: "A large metal scoop holding a round ball of ice cream beside the farm, a channel carved out of the mound" },
    { img: story7, alt: "The pint full of flat, melted cream, its lid coming back down from above" },
];

const prose = (heading: string) => parts.get(heading);
---

<Base title={title} description={description} {...projectSeo(project)}>
    <article class="fp">
        <!-- TITLE, AND THE FILM ON ITS PAGE -->
        <header class="page-head wrap fp-head">
            <a href="/projects/" class="mono muted link" data-reveal>← All projects</a>
            <p class="fp-kicker mono muted" data-reveal>Other work — {category}</p>
            <div class="fp-first">
                <div class="fp-first__text">
                    <div>
                        <h1 class="display fp-title" data-split>{title}<span class="stop" aria-hidden="true"></span></h1>
                        <p class="fp-sub mono muted" data-reveal>Personal project, not affiliated with Ben &amp; Jerry’s</p>
                    </div>
                    <p class="lead fp-lead" data-split>{description}</p>
                </div>
                <div class="fp-first__video" data-reveal>
                    <LoopVideo src="/media/a-farm-in-the-pint/page.mp4" poster={pagePoster} label="The film on a concept of the Ben & Jerry's flavours page: the headline and copy on the left stay clear while the pint and the farm play out on the right" />
                </div>
            </div>
        </header>

        <!-- THE FACTS -->
        <div class="wrap">
            <dl class="row fp-facts mono" data-reveal>
                {
                    facts.map((f) => (
                        <div>
                            <dt class="muted">{f.label}</dt>
                            <dd>{f.value}</dd>
                        </div>
                    ))
                }
            </dl>
        </div>

        <!-- THE THINKING BEHIND IT -->
        {
            thinking.map((heading) => (
                <section class="section wrap">
                    <div class="row">
                        <h2 class="row__label mono muted">{heading}</h2>
                        <div class="row__body prose" data-reveal set:html={prose(heading)} />
                    </div>
                </section>
            ))
        }

        <!-- THE STORYBOARD -->
        <section class="section wrap">
            <div class="row">
                <h2 class="row__label mono muted">Storyboard</h2>
            </div>
            <ol class="fp-story">
                {
                    story.map((s) => (
                        <li>
                            <Shot img={s.img} alt={s.alt} sizes="(min-width: 900px) 24vw, (min-width: 600px) 48vw, 100vw" />
                        </li>
                    ))
                }
            </ol>
        </section>

        <!-- STARTING POINT: the diorama it began as -->
        <section class="section wrap">
            <div class="row fp-side">
                <div class="fp-side__text" style="--below: 80px">
                    <h2 class="mono muted">Starting point</h2>
                    <div class="prose" data-reveal set:html={prose("Starting point")} />
                </div>
                <figure class="fp-side__media" data-reveal>
                    <LoopVideo src="/media/a-farm-in-the-pint/diorama.mp4" poster={dioramaPoster} sound label="The original farm diorama, seen whole and then up close: a windmill, a table on the porch, a tree stump, chickens and vegetables" />
                    <figcaption class="mono muted">
                        The farm diorama it started from<br />
                        Music: Walt Adams / A Call From the Sea / courtesy of
                        <a href="https://www.epidemicsound.com" class="link" target="_blank" rel="noopener">Epidemic Sound ↗</a>
                    </figcaption>
                </figure>
            </div>
        </section>

        <!-- APPETITE -->
        <section class="section wrap">
            <div class="row">
                <h2 class="row__label mono muted">Appetite</h2>
                <div class="row__body prose" data-reveal set:html={prose("Appetite")} />
            </div>
            <div class="fp-three">
                <Shot img={icecream1} alt="The pint filled with glossy liquid cream, flecked with chocolate at the edge" caption="Glossy liquid" sizes="(min-width: 700px) 32vw, 100vw" />
                <Shot img={icecream2} alt="The cream risen above the rim as a matte, frozen mound" caption="Frozen and swelling" sizes="(min-width: 700px) 32vw, 100vw" />
                <Shot img={icecream3} alt="Close up of the ice cream's surface: scraped layers running down the mound, chocolate pieces and sunflowers" caption="Scraped layers and a torn texture" sizes="(min-width: 700px) 32vw, 100vw" />
            </div>
        </section>

        <!-- EDITING THE FARM -->
        <section class="section wrap">
            <div class="row">
                <h2 class="row__label mono muted">Editing the farm</h2>
                <div class="row__body prose" data-reveal set:html={prose("Editing the farm")} />
            </div>
            <div class="fp-three">
                <Shot img={version1} alt="An early version on the web page: a barn, a tall windmill, cows, a pig, chickens and a tractor scattered over the ice cream" caption="Version 1" sizes="(min-width: 700px) 32vw, 100vw" />
                <Shot img={version2} alt="A second version on the web page: a large grey house with a windmill beside it, a fenced pen, sunflowers, pumpkins and a tractor" caption="Version 2" sizes="(min-width: 700px) 32vw, 100vw" />
                <Shot img={version3} alt="The final version on the web page: a brown barn between two trees, a fenced pen with cows, sunflowers and a tractor" caption="Final" sizes="(min-width: 700px) 32vw, 100vw" />
            </div>
        </section>

        <!-- THE COWS -->
        <section class="section wrap">
            <div class="row">
                <h2 class="row__label mono muted">The cows</h2>
                <div class="row__body prose" data-reveal set:html={prose("The cows")} />
            </div>
            <div class="fp-two">
                <Shot img={cows1} alt="Two low-poly cows in a wooden pen on the ice cream, both with their heads lowered to graze just above the surface" caption="Heads down" sizes="(min-width: 700px) 48vw, 100vw" />
                <Shot img={cows2} alt="The same two cows a moment later, their heads raised on separate neck and head joints" caption="Heads coming up" sizes="(min-width: 700px) 48vw, 100vw" />
            </div>
        </section>

        <!-- ON THE PAGE: the film on its own -->
        <section class="section wrap">
            <div class="row fp-side">
                <div class="fp-side__text">
                    <h2 class="mono muted">On the page</h2>
                    <div class="prose" data-reveal set:html={prose("On the page")} />
                </div>
                <figure class="fp-side__media" data-reveal>
                    <LoopVideo src="/media/a-farm-in-the-pint/film.mp4" poster={filmPoster} label="The film on its own: a closed pint rises and opens, cream pours in and swells into ice cream, a small farm grows on top, then a scoop carves out a ball, the ice cream melts flat, and the pint closes and sinks out of frame" />
                    <figcaption class="mono muted">The film on its own</figcaption>
                </figure>
            </div>
        </section>

        <!-- WHERE IT COULD GO, ANY SECTION ADDED LATER, THEN THE NOTE -->
        {
            [...extra, "Note"].map((heading) => (
                <section class="section wrap">
                    <div class="row">
                        <h2 class="row__label mono muted">{heading}</h2>
                        <div class="row__body prose" data-reveal set:html={prose(heading)} />
                    </div>
                </section>
            ))
        }
    </article>

    <NextProject current="a-farm-in-the-pint" />
    <Lightbox />
</Base>

<style>
    /* room before the next project's pixels start */
    .fp {
        padding-bottom: var(--section);
    }

    .fp-head {
        padding-top: clamp(24px, 3vw, 48px);
        padding-bottom: clamp(20px, 2.5vw, 36px);
    }

    .fp-kicker {
        margin: 24px 0 0;
    }

    .fp-first {
        margin-top: 18px;
    }

    .fp-first .fp-title {
        margin-top: 0;
        font-size: clamp(2.5rem, 1rem + 3.6vw, 5rem);
    }

    .fp-sub {
        margin: clamp(12px, 1.5vw, 20px) 0 0;
    }

    .fp-lead {
        margin-top: clamp(20px, 2.5vw, 32px);
    }

    .fp-first__video {
        margin-top: 24px;
    }

    /* the title's top meets the video's top, and the text ends level with its bottom
       (the 36px is the buttons under the video; the text scales with the window so
       that it stays about as tall as the video) */
    @media (min-width: 900px) {
        .fp-first {
            --video-align: end;
            display: grid;
            grid-template-columns: repeat(12, minmax(0, 1fr));
            column-gap: var(--gutter);
        }

        .fp-first__text {
            grid-column: 1 / span 5;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 20px;
            padding-bottom: 36px;
        }

        .fp-lead {
            margin-top: 0;
            font-size: clamp(1.1rem, 2.05vw, 2.75rem);
        }

        .fp-first__video {
            grid-column: 6 / -1;
            margin-top: 0;
        }
    }

    .fp-facts {
        display: grid;
        gap: 14px var(--gutter);
        margin: 0;
    }

    .fp-facts dd {
        margin: 2px 0 0;
    }

    @media (min-width: 900px) {
        .fp-facts > :nth-child(1) {
            grid-column: span 1;
        }

        .fp-facts > :nth-child(2),
        .fp-facts > :nth-child(4) {
            grid-column: span 3;
        }

        .fp-facts > :nth-child(3) {
            grid-column: span 3;
        }

        .fp-facts > :nth-child(5) {
            grid-column: span 2;
        }
    }

    /* --- the storyboard, a frame at a time --- */

    .fp-story {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 32px 12px;
        margin: clamp(20px, 3vw, 32px) 0 0;
        padding: 0;
        list-style: none;
    }

    @media (min-width: 600px) {
        .fp-story {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 900px) {
        .fp-story {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    /* --- what each section describes --- */

    /* text on the left, set larger so it holds its side; a video on the right */
    .fp-side {
        gap: 20px var(--gutter);
    }

    .fp-side__text h2 {
        margin: 0 0 clamp(16px, 2vw, 24px);
        font-weight: 400;
    }

    .fp-side__text .prose :global(p) {
        margin: 0;
        font-size: clamp(1.05rem, 0.9rem + 0.45vw, 1.35rem);
        line-height: 1.3;
        letter-spacing: -0.015em;
    }

    .fp-side__text .prose :global(p + p) {
        margin-top: 0.8em;
    }

    .fp-side__media {
        display: grid;
        gap: 10px;
        margin: 0;
    }

    /* the label level with the video's top, the text with its bottom
       (--below is the buttons and the caption under the video) */
    @media (min-width: 900px) {
        .fp-side {
            --video-align: end;
        }

        .fp-side__text {
            grid-column: 1 / span 5;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding-bottom: var(--below, 62px);
        }

        .fp-side__text h2 {
            margin: 0;
        }

        .fp-side__media {
            grid-column: 6 / -1;
            justify-items: end;
        }
    }

    .fp-three,
    .fp-two {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 24px 12px;
        margin-top: clamp(20px, 3vw, 32px);
    }

    @media (min-width: 700px) {
        .fp-three {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .fp-two {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>
