---
/**
 * One Corner Off (Marina Yee for MoMu) case study. Same shape as Wolf & Sheep
 * and Mongmo: parts and numbered chapters, each ## section of index.md beside
 * what it explains: screenshots of the site, stills of the four sections that
 * set the direction, a live type specimen in the site's own fonts, a short
 * looping clip of each interaction (cut from the walkthrough) and the bundle
 * sizes. The full walkthrough closes the page, before the link to the site.
 */
import Base from "../../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import { getEntry } from "astro:content";
import { pad } from "../../lib/content";
import Chapter from "../../components/Chapter.astro";
import ChapterNav from "../../components/ChapterNav.astro";
import LoopVideo from "../../components/LoopVideo.astro";
import Shot from "../../components/Shot.astro";
import Lightbox from "../../components/Lightbox.astro";
import NextProject from "../../components/NextProject.astro";

import walkthroughPoster from "../../content/projects/marina-yee-one-corner-off/media/walkthrough.jpg";
import coverPoster from "../../content/projects/marina-yee-one-corner-off/media/cover.jpg";
import spotlightPoster from "../../content/projects/marina-yee-one-corner-off/media/spotlight.jpg";
import garmentsPoster from "../../content/projects/marina-yee-one-corner-off/media/garments.jpg";
import marqueePoster from "../../content/projects/marina-yee-one-corner-off/media/marquee.jpg";
import myProjectPoster from "../../content/projects/marina-yee-one-corner-off/media/myproject.jpg";
import horizontalPoster from "../../content/projects/marina-yee-one-corner-off/media/horizontal.jpg";
import foldPoster from "../../content/projects/marina-yee-one-corner-off/media/fold.jpg";
import siteOneCornerOff from "../../content/projects/marina-yee-one-corner-off/media/site-one-corner-off.png";
import siteFilm from "../../content/projects/marina-yee-one-corner-off/media/site-film.png";
import siteFooter from "../../content/projects/marina-yee-one-corner-off/media/site-footer.png";
import stillCover from "../../content/projects/marina-yee-one-corner-off/media/still-cover.jpg";
import stillBeyond from "../../content/projects/marina-yee-one-corner-off/media/still-beyond.jpg";
import stillTurning from "../../content/projects/marina-yee-one-corner-off/media/still-turning.jpg";
import stillLookCloser from "../../content/projects/marina-yee-one-corner-off/media/still-lookcloser.jpg";

const project = (await getEntry("projects", "marina-yee-one-corner-off"))!;
const { title, description, role, year, category, context, order, tech, media, status } = project.data;

// index.md split at its ## headings; each part is one chapter's text
const parts = new Map(
    (project.rendered?.html ?? "").split(/(?=<h2[\s>])/).flatMap((chunk) => {
        const heading = chunk.match(/^<h2[^>]*>([\s\S]*?)<\/h2>/);
        return heading ? [[heading[1].trim(), chunk.slice(heading[0].length)] as [string, string]] : [];
    }),
);
// headings come through HTML-escaped with curly quotes; compare on plain text
const plain = (s: string) =>
    s
        .replace(/&#x27;|&#39;|’/g, "'")
        .replace(/&#x26;|&amp;/g, "&");
const byPlain = new Map([...parts].map(([k, v]) => [plain(k), v]));
const t = (heading: string) => byPlain.get(heading);
const placed = [
    "The project",
    "Design process",
    "Layout and typography",
    "Colour and imagery",
    "Cover: detachable corner",
    "Spotlight: pinned scroll animation",
    "Garment index: interactive content selection",
    "Typography animations",
    "M.Y. Project: image sequence",
    "Beyond sustainability: horizontal scrolling",
    "Main interaction: folding the page",
    "Responsive design and accessibility",
    "ScrollTrigger architecture",
    "Tooling and performance",
    "What I learned",
];
const extra = [...byPlain.keys()].filter((heading) => !placed.includes(heading));

const walkthroughPosterSrc = (await getImage({ src: walkthroughPoster, width: 1280, format: "webp", quality: 80 })).src;

const stillsThatWorked = [
    { img: stillCover, label: "The cover" },
    { img: stillBeyond, label: "The horizontal chapter" },
    { img: stillTurning, label: "The rotating paragraphs" },
    { img: stillLookCloser, label: "The closing spread" },
];

const palette = [
    { name: "Black", value: "#1a1a1a" },
    { name: "Paper", value: "#f4f2ee" },
    { name: "White", value: "#ffffff" },
    { name: "Biro blue", value: "#2f3db0" },
    { name: "Red", value: "#d2382b" },
];

const withoutJs = [
    { part: "Garment index", js: "One look at a time", none: "All four looks" },
    { part: "M.Y. Project", js: "Pinned image sequence", none: "Static image grid" },
    { part: "Horizontal sections", js: "Scroll sideways", none: "Vertical layout" },
    { part: "Folding page", js: "Fold the corner back", none: "Static composition" },
];

const sizes = [
    { value: 4.6, unit: "KB", label: "initial JavaScript, gzipped (11.7 KB raw)" },
    { value: 8.7, unit: "KB", label: "CSS, gzipped (40.6 KB raw)" },
    { value: 64.6, unit: "KB", label: "GSAP, loaded only when motion is enabled" },
];
---

<Base title={title} description={description}>
    <Fragment slot="head">
        <!-- the site's own typefaces, for the typography specimen -->
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Reenie+Beanie&display=swap"
        />
    </Fragment>

    <article class="my">
        <!-- INTRO -->
        <header class="page-head wrap">
            <a href="/projects/" class="mono muted link" data-reveal>← All projects</a>
            <p class="my-kicker mono muted" data-reveal>
                {pad(order ?? 4)} — {category}
                {status === "in-progress" && <span class="my-status">In progress</span>}
            </p>
            <h1 class="display my-title" data-split>{title}</h1>

            <div class="row my-intro">
                <dl class="row__label my-facts mono" data-reveal>
                    <div><dt class="muted">Year</dt><dd>{year}</dd></div>
                    <div><dt class="muted">Role</dt><dd>{role}</dd></div>
                    <div><dt class="muted">Context</dt><dd>{context}</dd></div>
                    <div><dt class="muted">Stack</dt><dd>{tech?.join(", ")}</dd></div>
                </dl>
                <div class="row__body">
                    <p class="lead my-lead" data-split>{description}</p>
                    {
                        media?.live && (
                            <a href={media.live} class="my-visit mono" target="_blank" rel="noopener" data-reveal>
                                Visit the website <span aria-hidden="true">↗</span>
                            </a>
                        )
                    }
                </div>
            </div>
        </header>

        <!-- ============ PART 1 ============ -->
        <div class="my-part-wrap wrap" data-reveal data-part="The project">
            <p class="my-part mono">The project</p>
        </div>

        <Chapter id="my-project" num={1} title="The project" html={t("The project")} lead={1}>
            <Shot slot="media" img={siteOneCornerOff} alt="The One Corner Off chapter: the title, and the Flemish expression explained in two justified columns" />
        </Chapter>

        <Chapter id="my-process" num={2} title="Design process" html={t("Design process")} side="left">
            <figure class="my-direction" slot="media">
                <p class="mono muted">The four sections that worked</p>
                <ul class="my-direction__grid">
                    {
                        stillsThatWorked.map((s) => (
                            <li>
                                <Image src={s.img} alt={s.label} widths={[400, 800]} sizes="(min-width: 900px) 25vw, 45vw" class="my-screen" />
                                <span class="mono">{s.label}</span>
                            </li>
                        ))
                    }
                </ul>
            </figure>
        </Chapter>

        <!-- ============ PART 2 ============ -->
        <div class="my-part-wrap wrap" data-reveal data-part="Visual design">
            <p class="my-part mono">Visual design</p>
        </div>

        <Chapter id="my-type" num={3} title="Layout and typography" html={t("Layout and typography")}>
            <figure class="my-spec" slot="media" data-my-spec>
                <div class="my-spec__type" aria-hidden="true">
                    <span class="my-spec__word" data-my-word><span>One corner</span><span>off</span></span>
                </div>
                <p class="my-spec__axes mono">
                    Archivo · <span data-my-axes>width 62 · weight 800</span>
                </p>
                <p class="my-spec__hand">Make it look finished, then disturb it.</p>
                <figcaption class="visually-hidden">
                    Archivo moving between its condensed and wide, heavy and light cuts, with Reenie Beanie for the handwritten note.
                </figcaption>
            </figure>
        </Chapter>

        <Chapter id="my-colour" num={4} title="Colour and imagery" html={t("Colour and imagery")} side="left">
            <figure class="my-colour" slot="media">
                <ul class="my-swatches" aria-label="Palette">
                    {
                        palette.map((c) => (
                            <li>
                                <span class="my-swatch" style={`--c:${c.value}`} />
                                <span class="mono">{c.name}</span>
                            </li>
                        ))
                    }
                </ul>
                <Shot img={siteFilm} alt="A dark section: a film still with a play button and a handwritten biro-blue note, 'she loves second-hand'" />
            </figure>
        </Chapter>

        <!-- ============ PART 3 ============ -->
        <div class="my-part-wrap wrap" data-reveal data-part="Interaction design and development">
            <p class="my-part mono">Interaction design and development</p>
        </div>

        <Chapter id="my-cover" num={5} title="Cover: detachable corner" html={t("Cover: detachable corner")}>
            <div class="my-clip" slot="media"><LoopVideo src="/media/marina-yee/cover.mp4" poster={coverPoster} label="The cover: a corner is cut away from the title, falls and is thrown" /></div>
        </Chapter>

        <Chapter id="my-spotlight" num={6} title="Spotlight: pinned scroll animation" html={t("Spotlight: pinned scroll animation")} side="left">
            <div class="my-clip" slot="media"><LoopVideo src="/media/marina-yee/spotlight.mp4" poster={spotlightPoster} label="The Antwerp Six in a spotlight that shrinks as her work comes into view" /></div>
        </Chapter>

        <Chapter id="my-garments" num={7} title="Garment index: interactive content selection" html={t("Garment index: interactive content selection")}>
            <div class="my-clip" slot="media"><LoopVideo src="/media/marina-yee/garments.mp4" poster={garmentsPoster} label="The garment index: choosing a category reveals its garment and details" /></div>
        </Chapter>

        <Chapter id="my-typography" num={8} title="Typography animations" html={t("Typography animations")} side="left">
            <div class="my-clip" slot="media"><LoopVideo src="/media/marina-yee/marquee.mp4" poster={marqueePoster} label="An oversized marquee whose letters change weight as they cross the screen" /></div>
        </Chapter>

        <Chapter id="my-myproject" num={9} title="M.Y. Project: image sequence" html={t("M.Y. Project: image sequence")}>
            <div class="my-clip" slot="media"><LoopVideo src="/media/marina-yee/myproject.mp4" poster={myProjectPoster} label="M.Y. Project: each garment wipes up over the last as its name rolls in" /></div>
        </Chapter>

        <Chapter id="my-beyond" num={10} title="Beyond sustainability: horizontal scrolling" html={t("Beyond sustainability: horizontal scrolling")} side="left">
            <div class="my-clip" slot="media"><LoopVideo src="/media/marina-yee/horizontal.mp4" poster={horizontalPoster} label="The horizontal chapter, ending with the bottom corner of the page breaking away" /></div>
        </Chapter>

        <Chapter id="my-fold" num={11} title="Main interaction: folding the page" html={t("Main interaction: folding the page")}>
            <div class="my-clip" slot="media"><LoopVideo src="/media/marina-yee/fold.mp4" poster={foldPoster} label="Folding back the corner of the black page to reveal the garment underneath" /></div>
        </Chapter>

        <!-- ============ PART 4 ============ -->
        <div class="my-part-wrap wrap" data-reveal data-part="Under the hood">
            <p class="my-part mono">Under the hood</p>
        </div>

        <Chapter id="my-responsive" num={12} title="Responsive design and accessibility" html={t("Responsive design and accessibility")} side="left">
            <figure class="my-diagram" slot="media" data-my-diagram>
                <div class="my-table" role="table" aria-label="Each interactive part with and without JavaScript">
                    <div class="my-table__row my-table__row--head mono" role="row">
                        <span role="columnheader">Part</span>
                        <span role="columnheader">With JavaScript</span>
                        <span role="columnheader">Without</span>
                    </div>
                    {
                        withoutJs.map((r) => (
                            <div class="my-table__row" role="row">
                                <span role="cell" class="mono">{r.part}</span>
                                <span role="cell">{r.js}</span>
                                <span role="cell" class="my-table__none">{r.none}</span>
                            </div>
                        ))
                    }
                </div>
            </figure>
        </Chapter>

        <Chapter id="my-scrolltrigger" num={13} title="ScrollTrigger architecture" html={t("ScrollTrigger architecture")} />

        <Chapter id="my-tooling" num={14} title="Tooling and performance" html={t("Tooling and performance")} lead={6}>
            <ul class="my-sizes" slot="media" data-my-diagram>
                {
                    sizes.map((s) => (
                        <li class="my-size">
                            <span class="my-size__value">
                                <span data-my-count={s.value}>{s.value}</span>
                                <small class="mono">{s.unit}</small>
                            </span>
                            <span class="my-size__label muted">{s.label}</span>
                        </li>
                    ))
                }
            </ul>
        </Chapter>

        <!-- ============ PART 5 ============ -->
        <div class="my-part-wrap wrap" data-reveal data-part="Looking back">
            <p class="my-part mono">Looking back</p>
        </div>

        <Chapter id="my-learned" num={15} title="What I learned" html={t("What I learned")} side="left" />
        {extra.map((heading, i) => <Chapter id={`my-extra-${i}`} num={16 + i} title={heading} html={t(heading)} />)}

        <!-- WALKTHROUGH: the whole thing, start to finish -->
        <section class="wrap my-end" aria-labelledby="my-walkthrough-title">
            <p id="my-walkthrough-title" class="my-part mono">Walkthrough</p>
            <figure class="my-walkthrough">
                <video
                    class="my-screen"
                    controls
                    playsinline
                    preload="none"
                    poster={walkthroughPosterSrc}
                    width="1280"
                    height="726"
                    aria-label="Walkthrough of the One Corner Off longread, from the cover to the end"
                >
                    <source src="/media/marina-yee/walkthrough.mp4" type="video/mp4" />
                </video>
                <figcaption class="mono muted">The longread from cover to close · 1:14</figcaption>
            </figure>

            {
                media?.live && (
                    <a href={media.live} class="my-end__link" target="_blank" rel="noopener">
                        <span class="my-end__shot">
                            <Image src={siteFooter} alt="" widths={[800, 1400, 2000]} sizes="(min-width: 900px) 50vw, 100vw" class="my-screen" />
                        </span>
                        <span class="my-end__text">
                            <span class="mono muted">momu-marina-yee.netlify.app</span>
                            <span class="my-end__title">Visit the website <span class="my-end__arrow" aria-hidden="true">↗</span></span>
                        </span>
                    </a>
                )
            }
        </section>
    </article>

    <ChapterNav />
    <NextProject current="marina-yee-one-corner-off" />
    <Lightbox />
</Base>

<script>
    import { gsap } from "gsap";

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // tables and figures build up the first time they come into view
    if (!reduceMotion) {
        const io = new IntersectionObserver(
            (entries) =>
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    io.unobserve(entry.target);
                    gsap.from(entry.target.querySelectorAll(".my-table__row, .my-size"), {
                        autoAlpha: 0,
                        y: 14,
                        duration: 0.7,
                        ease: "expo.out",
                        stagger: 0.08,
                    });
                    entry.target.querySelectorAll<HTMLElement>("[data-my-count]").forEach((el) => {
                        const counter = { n: 0 };
                        gsap.to(counter, {
                            n: Number(el.dataset.myCount),
                            duration: 1.4,
                            ease: "expo.out",
                            onUpdate: () => (el.textContent = counter.n.toFixed(1)),
                        });
                    });
                }),
            { threshold: 0.3 },
        );
        document.querySelectorAll("[data-my-diagram]").forEach((d) => io.observe(d));
    }

    // --- the specimen: Archivo's width and weight follow the cursor, the way
    //     the site's marquee animates the weight axis ---
    const spec = document.querySelector<HTMLElement>("[data-my-spec]");
    const word = spec?.querySelector<HTMLElement>("[data-my-word]");
    const axes = spec?.querySelector<HTMLElement>("[data-my-axes]");
    if (spec && word && axes) {
        const state = { wdth: 62, wght: 800 };
        const render = () => {
            word.style.fontVariationSettings = `"wdth" ${state.wdth.toFixed(0)}, "wght" ${state.wght.toFixed(0)}`;
            axes.textContent = `width ${state.wdth.toFixed(0)} · weight ${state.wght.toFixed(0)}`;
        };
        render();

        if (!reduceMotion) {
            // on its own it breathes between condensed-heavy and wide-light
            const idle = gsap.to(state, {
                wdth: 125,
                wght: 200,
                duration: 3.2,
                ease: "sine.inOut",
                yoyo: true,
                repeat: -1,
                paused: true,
                onUpdate: render,
            });
            new IntersectionObserver(([e]) => (e.isIntersecting ? idle.resume() : idle.pause())).observe(spec);

            // with the cursor: left to right is width, top to bottom is weight
            spec.addEventListener("pointermove", (e) => {
                idle.pause();
                const r = spec.getBoundingClientRect();
                const x = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
                const y = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
                gsap.to(state, { wdth: 62 + x * 63, wght: 900 - y * 800, duration: 0.5, ease: "power3.out", overwrite: true, onUpdate: render });
            });
            spec.addEventListener("pointerleave", () => idle.resume());
        }
    }
</script>

<style>
    .my {
        overflow-x: clip;
        padding-bottom: var(--section);
        /* code keywords: biro blue */
        --code-accent: #9fb0ff;
    }

    :global(html.dark) .my {
        --code-accent: #2f3db0;
    }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    /* --- INTRO --- */

    .my-kicker {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        margin: 24px 0 0;
    }

    .my-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--text);
    }

    .my-status::before {
        content: "";
        width: 6px;
        height: 6px;
        border: 1px solid currentColor;
        border-radius: 50%;
    }

    .my-title {
        max-width: 12ch;
        font-size: clamp(2.75rem, 1rem + 7vw, 8.5rem);
    }

    .my-intro {
        margin-top: clamp(32px, 5vw, 64px);
    }

    .my-facts {
        display: grid;
        gap: 14px;
        align-content: start;
        margin: 0;
    }

    .my-facts dd {
        margin: 2px 0 0;
    }

    .my-lead {
        max-width: 32ch;
    }

    .my-visit {
        display: inline-flex;
        gap: 8px;
        margin-top: 28px;
        padding: 10px 16px;
        border: 1px solid var(--text);
        border-radius: 999px;
        transition:
            background-color 0.35s var(--ease),
            color 0.35s var(--ease);
    }

    .my-visit:hover,
    .my-visit:focus-visible {
        background: var(--text);
        color: var(--bg);
    }

    /* --- SCREENS: the site sits in a dark frame, like it does on screen --- */

    .my :global(.my-screen) {
        display: block;
        width: 100%;
        height: auto;
        background: #1a1a1a;
        box-shadow: var(--media-shadow);
    }

    .my-walkthrough {
        display: grid;
        gap: 12px;
        margin: 0;
    }

    .my-walkthrough video {
        aspect-ratio: 1280 / 726;
    }

    .my-clip :global(video) {
        background: #1a1a1a;
        box-shadow: var(--media-shadow);
    }

    /* --- PARTS --- */

    .my-part-wrap {
        margin-top: calc(var(--section) * 1.4);
    }

    .my-part {
        margin: 0;
        padding-top: 14px;
        border-top: 1px solid var(--text);
    }

    .my-part-wrap + :global(.chapter) {
        padding-top: clamp(40px, 6vw, 80px);
    }

    /* --- 02 DESIGN PROCESS: the four sections that worked --- */

    .my-direction {
        margin: 0;
    }

    .my-direction p {
        margin: 0 0 10px;
    }

    .my-direction__grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .my-direction__grid li {
        display: grid;
        gap: 6px;
    }

    /* --- 03 SPECIMEN --- */

    .my-spec {
        display: grid;
        gap: 16px;
        margin: 0;
        padding: clamp(20px, 3vw, 36px);
        background: #1a1a1a;
        color: #f4f2ee;
        cursor: ew-resize;
        user-select: none;
    }

    /* two fixed lines, sized so even the widest, heaviest setting fits:
       the box never changes height while the axes move */
    .my-spec__type {
        font-size: clamp(1.9rem, 0.6rem + 3vw, 4rem);
        overflow: hidden;
    }

    .my-spec__word {
        display: block;
        font-family: "Archivo", var(--sans);
        line-height: 0.92;
        letter-spacing: -0.01em;
        text-transform: uppercase;
    }

    .my-spec__word > span {
        display: block;
        white-space: nowrap;
    }

    .my-spec__axes {
        margin: 0;
        opacity: 0.6;
    }

    .my-spec__hand {
        margin: 4px 0 0;
        font-family: "Reenie Beanie", cursive;
        font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.4rem);
        line-height: 1;
        color: #9fb0ff;
        transform: rotate(-2deg);
        transform-origin: left;
    }

    /* --- 04 COLOUR: the palette above a dark section of the site --- */

    .my-colour {
        display: grid;
        gap: 20px;
        margin: 0;
    }

    .my-swatches {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .my-swatches li {
        display: grid;
        gap: 6px;
    }

    .my-swatch {
        aspect-ratio: 1;
        background: var(--c);
        border: 1px solid var(--line);
    }

    /* --- 12 WITHOUT JAVASCRIPT --- */

    .my-diagram {
        margin: 0;
    }

    .my-table {
        border-top: 1px solid var(--text);
    }

    .my-table__row {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) minmax(0, 1fr);
        align-items: baseline;
        gap: 6px var(--gutter);
        padding-block: 14px;
        border-bottom: 1px solid var(--line);
        font-size: var(--fs-small);
    }

    .my-table__row--head {
        color: var(--muted);
    }

    .my-table__none {
        font-weight: 800;
    }

    /* --- 14 SIZES --- */

    .my-sizes {
        display: grid;
        gap: var(--gutter);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .my-size {
        display: grid;
        grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
        align-items: end;
        gap: var(--gutter);
