---
import Base from "../../layouts/BaseLayout.astro";
import { Picture } from "astro:assets";
import { getProjects, pad, slugOf, type ProjectEntry } from "../../lib/content";

// Map tags -> one or more category slugs
const getCategories = (project: ProjectEntry): string[] => {
    const tags: string[] = project.data.tags ?? [];
    const categories: string[] = [];

    if (tags.includes("Game Dev")) categories.push("game");
    if (tags.includes("Web Dev")) categories.push("web");
    if (tags.includes("Design")) categories.push("design");

    return categories.length > 0 ? categories : ["other"];
};

const filters = [
    { value: "all", label: "All" },
    { value: "game", label: "Game Dev" },
    { value: "web", label: "Web Dev" },
    { value: "design", label: "Design" },
];

const projects = await getProjects();
---

<Base title="Projects" description="Rafaela Henriques — selected projects.">
    <header class="page-head wrap">
        <p class="mono muted" data-reveal>Projects ({pad(projects.length)})</p>
        <h1 class="display" data-split>Selected work</h1>
        <p class="lead page-lead" data-split data-split-delay="0.2">
            Work from university and personal side projects, where I test new
            tools and bridge strict logic with fluid design.
        </p>
    </header>

    <section class="wrap" aria-label="Projects">
        <div class="projects-toolbar row" data-reveal>
            <p class="row__label mono muted">Filter</p>
            <nav class="row__body filters mono" aria-label="Filter projects by category" data-project-filter-root>
                {
                    filters.map((f) => (
                        <button
                            type="button"
                            class="text-button link"
                            data-filter={f.value}
                            aria-pressed={f.value === "all" ? "true" : "false"}
                        >
                            {f.label}
                        </button>
                    ))
                }
            </nav>
        </div>

        <ul class="work-grid">
            {
                projects.map((p, i) => {
                    const screenshot = p.data.media?.screenshot;
                    return (
                        <li
                            class="work-grid__item"
                            data-project-category={getCategories(p).join(" ")}
                            data-col={i % 3}
                        >
                            <a href={`/projects/${slugOf(p)}/`} class="work-card">
                                {screenshot && (
                                    <div class="work-card__media" data-reveal-img>
                                        <Picture
                                            src={screenshot}
                                            alt=""
                                            formats={["avif", "webp"]}
                                            widths={[480, 800, 1200]}
                                            sizes="(min-width: 900px) 33vw, 100vw"
                                            loading={i < 3 ? "eager" : "lazy"}
                                        />
                                    </div>
                                )}
                                <div class="work-card__caption mono" data-reveal>
                                    <span class="muted">{pad(i + 1)}</span>
                                    <span class="work-card__title">{p.data.title}</span>
                                    <span class="muted">{p.data.year}</span>
                                </div>
                            </a>
                        </li>
                    );
                })
            }
        </ul>
    </section>
</Base>

<script>
    const root = document.querySelector<HTMLElement>("[data-project-filter-root]");
    const buttons = root?.querySelectorAll<HTMLButtonElement>("[data-filter]") ?? [];
    const items = [...document.querySelectorAll<HTMLElement>("[data-project-category]")];

    const applyFilter = (filter: string) => {
        buttons.forEach((button) =>
            button.setAttribute("aria-pressed", String(button.dataset.filter === filter)),
        );

        // data-col drives the staggered offsets, so renumber visible items
        let col = 0;
        items.forEach((item) => {
            const categories = (item.dataset.projectCategory ?? "other").split(" ");
            const show = filter === "all" || categories.includes(filter);
            item.hidden = !show;
            if (show) item.dataset.col = String(col++ % 3);
        });
    };

    buttons.forEach((button) =>
        button.addEventListener("click", () => applyFilter(button.dataset.filter ?? "all")),
    );
</script>

<style>
    .page-lead {
        margin-top: clamp(24px, 3vw, 40px);
        max-width: 32ch;
    }

    .projects-toolbar {
        margin-bottom: clamp(40px, 6vw, 80px);
    }

    .work-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(40px, 6vw, 96px) var(--gutter);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .work-grid__item[hidden] {
        display: none;
    }

    .work-card {
        display: block;
    }

    .work-card__media {
        aspect-ratio: 4 / 5;
        overflow: hidden;
        background: var(--line);
    }

    /* <Picture> renders outside this component's scope, hence :global */
    .work-card__media :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 1.2s var(--ease);
    }

    .work-card:hover .work-card__media :global(img) {
        transform: scale(1.04);
    }

    .work-card__caption {
        display: grid;
        grid-template-columns: 2.5rem 1fr auto;
        gap: var(--gutter);
        margin-top: 12px;
    }

    .work-card:hover .work-card__title {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    /* Staggered editorial grid: 3 columns, middle/right columns dropped */
    @media (min-width: 900px) {
        .work-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            align-items: start;
        }

        .work-grid__item[data-col="1"] {
            margin-top: 22vh;
        }

        .work-grid__item[data-col="2"] {
            margin-top: 8vh;
        }

        .work-grid__item[data-col="1"] .work-card__media {
            aspect-ratio: 3 / 4;
        }
    }
</style>
