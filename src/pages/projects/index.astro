---
/**
 * Every project in one staggered grid, filtered by discipline. Filtering
 * glides the cards to their new places (GSAP Flip); the choice is kept in
 * the URL hash so a filtered view can be linked (/projects/#design).
 */
import Base from "../../layouts/BaseLayout.astro";
import { Picture } from "astro:assets";
import { getProjects, pad, slugOf } from "../../lib/content";

const projects = await getProjects();

const filters = [
    { key: "all", label: "All" },
    { key: "development", label: "Development" },
    { key: "design", label: "Design" },
].map((f) => ({
    ...f,
    count: f.key === "all" ? projects.length : projects.filter((p) => p.data.discipline === f.key).length,
}));
---

<Base title="Projects" description="Rafaela Henriques — all projects, from full-stack and mobile apps to creative development and design.">
    <header class="page-head wrap projects-head">
        <h1 class="display" data-split>Projects</h1>
        <div class="pf" role="group" aria-label="Filter projects" data-reveal data-filters>
            {
                filters.map((f) => (
                    <button type="button" class="pf__btn" data-filter={f.key} aria-pressed={String(f.key === "all")}>
                        <span class="pf__label">{f.label}</span>
                        <sup class="pf__count mono">{pad(f.count)}</sup>
                    </button>
                ))
            }
            <span class="pf__line" aria-hidden="true" data-filter-line></span>
        </div>
    </header>

    <section class="wrap" aria-label="All projects">
        <ul class="work-grid" data-grid>
            {
                projects.map((p, i) => {
                    const screenshot = p.data.media?.screenshot;
                    return (
                        <li class="work-grid__item" data-item data-discipline={p.data.discipline} data-col={i % 3}>
                            <a href={`/projects/${slugOf(p)}/`} class="work-card">
                                {screenshot && (
                                    <div class="work-card__media" data-reveal-img>
                                        <Picture
                                            src={screenshot}
                                            alt=""
                                            formats={["avif", "webp"]}
                                            widths={[480, 800, 1200]}
                                            sizes="(min-width: 900px) 33vw, 100vw"
                                            loading={i < 3 ? "eager" : "lazy"}
                                        />
                                    </div>
                                )}
                                <div class="work-card__caption mono" data-reveal>
                                    <span class="muted">{pad(i + 1)}</span>
                                    <span>
                                        <span class="work-card__title">{p.data.title}</span>
                                        <span class="work-card__meta muted">
                                            {p.data.category}
                                            {p.data.status === "in-progress" && <span class="status">In progress</span>}
                                        </span>
                                    </span>
                                    <span class="muted">{p.data.year}</span>
                                </div>
                            </a>
                        </li>
                    );
                })
            }
        </ul>
        <p class="visually-hidden" aria-live="polite" data-filter-status></p>
    </section>
</Base>

<script>
    import { gsap } from "gsap";
    import { Flip } from "gsap/Flip";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(Flip, ScrollTrigger);

    const items = [...document.querySelectorAll<HTMLElement>("[data-grid] [data-item]")];
    const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const line = document.querySelector<HTMLElement>("[data-filter-line]")!;
    const status = document.querySelector<HTMLElement>("[data-filter-status]")!;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const keys = buttons.map((b) => b.dataset.filter!);

    let current = "all";

    /** The underline slides to sit under the active word. */
    const moveLine = (animate: boolean) => {
        const btn = buttons.find((b) => b.dataset.filter === current)!;
        const word = btn.querySelector(".pf__label")!.getBoundingClientRect();
        const box = line.parentElement!.getBoundingClientRect();
        gsap.to(line, {
            x: word.left - box.left,
            width: word.width,
            duration: animate && !reduceMotion ? 0.5 : 0,
            ease: "power3.inOut",
        });
    };

    function apply(key: string, animate = true) {
        current = keys.includes(key) ? key : "all";
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === current)));
        moveLine(animate);

        const state = Flip.getState(items);

        // data-col drives the staggered column offsets, so renumber what's left
        let col = 0;
        items.forEach((item) => {
            const show = current === "all" || item.dataset.discipline === current;
            item.hidden = !show;
            if (show) item.dataset.col = String(col++ % 3);
        });

        const shown = items.filter((i) => !i.hidden).length;
        status.textContent = `Showing ${shown} of ${items.length} projects`;
        history.replaceState(null, "", current === "all" ? location.pathname : `#${current}`);

        if (!animate || reduceMotion) {
            ScrollTrigger.refresh();
            return;
        }
        Flip.from(state, {
            duration: 0.7,
            ease: "power3.inOut",
            absolute: true,
            stagger: 0.03,
            onEnter: (els) =>
                gsap.fromTo(els, { autoAlpha: 0, scale: 0.94 }, { autoAlpha: 1, scale: 1, duration: 0.6, ease: "power3.out", delay: 0.2 }),
            onLeave: (els) => gsap.to(els, { autoAlpha: 0, scale: 0.94, duration: 0.35, ease: "power2.in" }),
            onComplete: () => ScrollTrigger.refresh(),
        });
    }

    buttons.forEach((b) => b.addEventListener("click", () => apply(b.dataset.filter!)));
    window.addEventListener("hashchange", () => apply(location.hash.slice(1) || "all"));
    window.addEventListener("resize", () => moveLine(false));
    document.fonts.ready.then(() => moveLine(false));

    apply(location.hash.slice(1) || "all", false);
</script>

<style>
    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    /* --- HEADER: the title, and the filter on its baseline --- */

    .projects-head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-end;
        gap: 24px var(--gutter);
    }

    .projects-head .display {
        margin: 0;
    }

    .pf {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        gap: 4px clamp(16px, 2.4vw, 32px);
        padding-bottom: 10px;
    }

    .pf__btn {
        padding: 0;
        border: 0;
        background: none;
        color: var(--muted);
        font: inherit;
        font-size: var(--fs-lead);
        line-height: 1.1;
        letter-spacing: -0.03em;
        cursor: pointer;
        transition: color 0.4s var(--ease);
    }

    .pf__btn:hover,
    .pf__btn[aria-pressed="true"] {
        color: var(--text);
    }

    .pf__count {
        margin-left: 3px;
        font-size: var(--fs-mono);
        letter-spacing: 0.02em;
        vertical-align: super;
        line-height: 0;
    }

    .pf__line {
        position: absolute;
        left: 0;
        bottom: 0;
        width: 0;
        height: 1px;
        background: var(--text);
    }

    /* --- GRID --- */

    [data-item][hidden] {
        display: none;
    }

    .work-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(40px, 6vw, 96px) var(--gutter);
        margin: 0;
        padding: 0 0 var(--section);
        list-style: none;
    }

    .work-card {
        display: block;
    }

    .work-card__media {
        aspect-ratio: 4 / 5;
        overflow: hidden;
        background: var(--line);
    }

    /* <Picture> renders outside this component's scope, hence :global */
    .work-card__media :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 1.2s var(--ease);
    }

    .work-card:hover .work-card__media :global(img) {
        transform: scale(1.04);
    }

    .work-card__caption {
        display: grid;
        grid-template-columns: 2.5rem 1fr auto;
        gap: var(--gutter);
        margin-top: 12px;
    }

    .work-card__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 10px;
        margin-top: 4px;
    }

    .work-card:hover .work-card__title {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--text);
    }

    .status::before {
        content: "";
        width: 6px;
        height: 6px;
        border: 1px solid currentColor;
        border-radius: 50%;
    }

    /* Staggered editorial grid: 3 columns, middle/right columns dropped */
    @media (min-width: 900px) {
        .work-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            align-items: start;
        }

        .work-grid__item[data-col="1"] {
            margin-top: 22vh;
        }

        .work-grid__item[data-col="2"] {
            margin-top: 8vh;
        }

        .work-grid__item[data-col="1"] .work-card__media {
            aspect-ratio: 3 / 4;
        }
    }
</style>
