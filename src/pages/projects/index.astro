---
import Base from "../../layouts/BaseLayout.astro";
import {
  getCollection,
  type CollectionEntry,
} from "astro:content";
import { Picture } from "astro:assets";

type ProjectEntry = CollectionEntry<"projects">;

const sortProjects = (items: ProjectEntry[]): ProjectEntry[] =>
  [...items].sort((a, b) => {
    const yearA = a.data.year ?? "";
    const yearB = b.data.year ?? "";
    if (yearA !== yearB) return yearB.localeCompare(yearA);
    return (a.data.title ?? "").localeCompare(b.data.title ?? "");
  });

// Map tags -> one or more category slugs
const getCategories = (project: ProjectEntry): string[] => {
  const tags: string[] = project.data.tags ?? [];
  const categories: string[] = [];

  if (tags.includes("Game Dev")) categories.push("game");
  if (tags.includes("Web Dev")) categories.push("web");
  if (tags.includes("Design")) categories.push("design");

  return categories.length > 0 ? categories : ["other"];
};

const allProjects = (await getCollection("projects")) as ProjectEntry[];
const projects = sortProjects(allProjects);
---

<Base title="Projects" description="Rafaela — projects.">
  <section class="section projects-section">
    <h1 class="page-title">Projects</h1>
    <p class="lead">
      Selected work from my time at university and personal side projects. I use these projects to test new tools, refine my workflow, and bridge the gap between strict logic and fluid design.
    </p>

    <!-- FILTER BAR -->
    <nav
      class="project-filters"
      aria-label="Filter projects by category"
      data-project-filter-root
      data-active-filter="all"
    >
      <button
        type="button"
        class="project-filters__button"
        data-filter="all"
        aria-pressed="true"
      >
        All
      </button>
      <button
        type="button"
        class="project-filters__button"
        data-filter="game"
        aria-pressed="false"
      >
        Game Dev
      </button>
      <button
        type="button"
        class="project-filters__button"
        data-filter="web"
        aria-pressed="false"
      >
        Web Dev
      </button>
      <button
        type="button"
        class="project-filters__button"
        data-filter="design"
        aria-pressed="false"
      >
        Design
      </button>
    </nav>

    <div
      class="projects-list stagger"
      style={`margin-top: calc(var(--gap) * 2)`}
    >
      {projects.map((project) => {
        const categories = getCategories(project);
        const screenshot = project.data.media?.screenshot;
        return (
          <a
            href={`/projects/${project.id}/`}
            class="card"
            data-project-category={categories.join(" ")}
          >
            <div class="card__media">
              {screenshot && (
                <Picture
                  src={screenshot}
                  alt={project.data.title}
                  loading="lazy"
                  formats={["avif", "webp", "png"]}
                  widths={[320, 640, 768, 1024, 1400]}
                  sizes="(max-width: 719px) 100vw, (max-width: 1023px) 50vw, (max-width: 1399px) 33vw, 25vw"
                />
              )}
            </div>
            <h3 class="card__title">{project.data.title}</h3>
            <p class="card__meta">{project.data.year}</p>
          </a>
        );
      })}
    </div>
  </section>

  <script is:inline>
    const setupProjectFilters = () => {
      const root = document.querySelector("[data-project-filter-root]");
      if (!root) return;

      const buttons = root.querySelectorAll("[data-filter]");
      const cards = document.querySelectorAll("[data-project-category]");

      const applyFilter = (filter) => {
        root.dataset.activeFilter = filter;

        buttons.forEach((button) => {
          const buttonFilter = button.dataset.filter;
          const isActive = buttonFilter === filter;
          button.setAttribute("aria-pressed", isActive ? "true" : "false");
        });

        cards.forEach((card) => {
          const raw = card.dataset.projectCategory || "other";
          const categories = raw.split(" ").filter(Boolean);
          const show = filter === "all" || categories.includes(filter);
          card.style.display = show ? "" : "none";
        });
      };

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const filter = button.dataset.filter;
          if (!filter) return;
          applyFilter(filter);
        });
      });

      applyFilter(root.dataset.activeFilter || "all");
    };

    if (typeof window !== "undefined") {
      window.addEventListener("DOMContentLoaded", setupProjectFilters);
    }
  </script>

  <style>
    .projects-section {
      display: flex;
      flex-direction: column;
      gap: var(--gap);
    }

    .project-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: var(--gap);
    }

    .project-filters__button {
      border-radius: 999px;
      border: 1px solid var(--border);
      background: color-mix(in oklab, var(--surface) 92%, transparent);
      padding: 6px 14px;
      font-size: var(--step--1);
      cursor: pointer;
      color: var(--muted);
      transition:
        background 0.18s ease,
        border-color 0.18s ease,
        color 0.18s ease,
        transform 0.12s ease;
    }

    .project-filters__button[aria-pressed="true"] {
      color: var(--text);
      border-color: color-mix(in oklab, var(--accent) 60%, var(--border));
      background: color-mix(in oklab, var(--accent) 20%, var(--surface));
      transform: translateY(-1px);
    }

    .project-filters__button:hover {
      color: var(--text);
      background: color-mix(in oklab, var(--accent) 10%, var(--surface));
    }

    @media (min-width: 720px) {
      .project-filters {
        justify-content: flex-start;
      }
    }
  </style>
</Base>