---
/**
 * All projects. A moving strip of every project's images, a big title, then
 * one list that can be shown two ways: rows (big titles, thumbnail on the
 * right) or a staggered grid. Switching layout morphs the items into place
 * and filtering glides them (GSAP Flip). The filter is kept in the URL hash
 * (/projects/#web), the layout in localStorage.
 */
import Base from "../../layouts/BaseLayout.astro";
import { Picture, getImage } from "astro:assets";
import { getProjects, pad, slugOf, PROJECT_TYPES } from "../../lib/content";

const projects = await getProjects();

const items = projects.map((p, i) => ({
    p,
    num: pad(i + 1),
    href: `/projects/${slugOf(p)}/`,
    types: p.data.types,
    inProgress: p.data.status === "in-progress",
    image: p.data.media?.screenshot,
}));

const filters = [
    { key: "all", label: "All", count: projects.length },
    ...PROJECT_TYPES.map((t) => ({
        key: t.key as string,
        label: t.label as string,
        count: projects.filter((p) => (p.data.types as string[]).includes(t.key)).length,
    })),
].filter((f) => f.count > 0);

// The strip: every project's images, taken round-robin so neighbours differ
const STRIP_H = 360;
const galleries = items.map((it) => (it.p.data.media?.gallery ?? [it.image]).filter((img) => img !== undefined));
const depth = Math.max(...galleries.map((g) => g.length));
const strip = await Promise.all(
    Array.from({ length: depth }, (_, round) => items.map((it, i) => ({ it, img: galleries[i][round] })))
        .flat()
        .filter((s) => s.img !== undefined)
        .map(async ({ it, img }) => ({
            src: (await getImage({ src: img!, height: STRIP_H, format: "webp", quality: 80 })).src,
            width: Math.round((img!.width * STRIP_H) / img!.height),
            num: it.num,
            title: it.p.data.title,
            href: it.href,
        })),
);
---

<Base title="Projects" description="Rafaela Henriques — all projects: web, mobile and full-stack apps, games and interactive work, branding and UI design.">
    <!-- STRIP: every project's images, drifting past -->
    <div class="strip" data-strip aria-label="Project images">
        <div class="strip__track" data-strip-track>
            {
                strip.map((s) => (
                    <a href={s.href} class="strip__item" aria-label={s.title}>
                        <img src={s.src} width={s.width} height={STRIP_H} alt="" loading="eager" draggable="false" />
                        <span class="strip__label mono">
                            [{s.num}] <span class="strip__name">{s.title}</span>
                        </span>
                    </a>
                ))
            }
        </div>
    </div>

    <!-- TITLE -->
    <header class="wrap ph">
        <h1 class="ph__title" data-split>Projects<sup class="ph__count mono">({pad(projects.length)})</sup></h1>
        <p class="ph__desc" data-reveal>
            Apps, games, interactive stories and brand work. Some finished,
            some still in progress.
        </p>
    </header>

    <!-- CONTROLS: filter + layout -->
    <div class="wrap pc" data-reveal>
        <div class="pc__filters" role="group" aria-label="Filter projects" data-filters>
            {
                filters.map((f) => (
                    <button type="button" class="pill mono" data-filter={f.key} aria-pressed={String(f.key === "all")}>
                        {f.label}
                        <span class="pill__count">{pad(f.count)}</span>
                    </button>
                ))
            }
        </div>
        <div class="pc__layout mono" role="group" aria-label="Display as">
            <button type="button" class="pc__layout-btn" data-layout="list" aria-pressed="true">List</button>
            <button type="button" class="pc__layout-btn" data-layout="grid" aria-pressed="false">Grid</button>
        </div>
    </div>

    <!-- THE PROJECTS -->
    <section class="wrap" aria-label="All projects">
        <ul class="works" data-works data-layout="list">
            {
                items.map((it, i) => (
                    <li class="work" data-item data-types={it.types.join(" ")} data-col={i % 3}>
                        <a href={it.href} class="work__link">
                            <span class="work__num mono">{it.num}</span>
                            <span class="work__title">{it.p.data.title}</span>
                            <span class="work__meta mono">
                                {it.p.data.category}
                                {it.inProgress && <span class="status">In progress</span>}
                            </span>
                            <span class="work__year mono">{it.p.data.year}</span>
                            {it.image && (
                                <span class="work__media">
                                    <Picture
                                        src={it.image}
                                        alt=""
                                        formats={["avif", "webp"]}
                                        widths={[320, 640, 1000]}
                                        sizes="(min-width: 900px) 33vw, 50vw"
                                        loading={i < 3 ? "eager" : "lazy"}
                                    />
                                </span>
                            )}
                        </a>
                    </li>
                ))
            }
        </ul>
        <p class="works__empty mono muted" data-empty hidden>Nothing here yet.</p>
        <p class="visually-hidden" aria-live="polite" data-filter-status></p>
    </section>
</Base>

<script>
    import { gsap } from "gsap";
    import { Flip } from "gsap/Flip";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(Flip, ScrollTrigger);

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* --- STRIP: an endless drift that speeds up with scrolling, stops on hover --- */
    const strip = document.querySelector<HTMLElement>("[data-strip]");
    const track = strip?.querySelector<HTMLElement>("[data-strip-track]");
    if (strip && track && !reduceMotion) {
        // a second copy so the loop never shows a gap
        [...track.children].forEach((child) => {
            const copy = child.cloneNode(true) as HTMLElement;
            copy.setAttribute("aria-hidden", "true");
            copy.tabIndex = -1;
            track.append(copy);
        });
        strip.classList.add("is-moving");

        let loop: gsap.core.Tween | null = null;
        const build = () => {
            const progress = loop?.progress() ?? 0;
            loop?.kill();
            const half = track.scrollWidth / 2;
            loop = gsap.fromTo(track, { x: 0 }, { x: -half, duration: half / 45, ease: "none", repeat: -1 });
            loop.progress(progress);
        };
        // widths are known once the images have their size
        Promise.all([...track.querySelectorAll("img")].map((img) => img.decode().catch(() => {}))).then(build);
        window.addEventListener("resize", () => build());

        let hovering = false;
        strip.addEventListener("pointerenter", () => {
            hovering = true;
            if (loop) gsap.to(loop, { timeScale: 0, duration: 0.6, ease: "power2.out", overwrite: true });
        });
        strip.addEventListener("pointerleave", () => {
            hovering = false;
            if (loop) gsap.to(loop, { timeScale: 1, duration: 0.8, ease: "power2.in", overwrite: true });
        });
        ScrollTrigger.create({
            onUpdate(self) {
                if (!loop || hovering) return;
                const boost = 1 + Math.min(Math.abs(self.getVelocity()) / 250, 6);
                gsap.timeline()
                    .to(loop, { timeScale: boost, duration: 0.2, overwrite: true })
                    .to(loop, { timeScale: 1, duration: 1.2, ease: "power2.out" });
            },
        });
    }

    /* --- FILTER + LAYOUT --- */
    const list = document.querySelector<HTMLElement>("[data-works]")!;
    const items = [...list.querySelectorAll<HTMLElement>("[data-item]")];
    const filterButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const layoutButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-layout]")];
    const status = document.querySelector<HTMLElement>("[data-filter-status]")!;
    const empty = document.querySelector<HTMLElement>("[data-empty]")!;
    const keys = filterButtons.map((b) => b.dataset.filter!);
    const targets = () => [...items, ...list.querySelectorAll<HTMLElement>(".work__media")];

    let filter = "all";

    /** Animate whatever changed between `state` and now. */
    const morph = (state: Flip.FlipState) => {
        if (reduceMotion) {
            ScrollTrigger.refresh();
            return;
        }
        Flip.from(state, {
            duration: 0.75,
            ease: "power3.inOut",
            nested: true,
            absolute: true,
            stagger: 0.025,
            onEnter: (els) =>
                gsap.fromTo(els, { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: 0.6, ease: "power3.out", delay: 0.2 }),
            onLeave: (els) => gsap.to(els, { autoAlpha: 0, y: -12, duration: 0.3, ease: "power2.in" }),
            onComplete: () => ScrollTrigger.refresh(),
        });
    };

    function applyFilter(key: string, animate = true) {
        filter = keys.includes(key) ? key : "all";
        filterButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === filter)));
        // on phones the row scrolls sideways: keep the active filter in view
        const active = filterButtons.find((b) => b.dataset.filter === filter)!;
        const row = active.parentElement!;
        if (row.scrollWidth > row.clientWidth) {
            row.scrollTo({ left: active.offsetLeft - row.offsetLeft - 16, behavior: animate && !reduceMotion ? "smooth" : "auto" });
        }

        const state = Flip.getState(targets());
        // data-col drives the grid's staggered offsets, so renumber what's left
        let col = 0;
        items.forEach((item) => {
            const show = filter === "all" || (item.dataset.types ?? "").split(" ").includes(filter);
            item.hidden = !show;
            if (show) item.dataset.col = String(col++ % 3);
        });

        const shown = items.filter((i) => !i.hidden).length;
        status.textContent = `Showing ${shown} of ${items.length} projects`;
        empty.hidden = shown > 0;
        history.replaceState(null, "", filter === "all" ? location.pathname : `#${filter}`);
        if (animate) morph(state);
        else ScrollTrigger.refresh();
    }

    function applyLayout(layout: string, animate = true) {
        if (layout !== "list" && layout !== "grid") return;
        layoutButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.layout === layout)));
        if (list.dataset.layout === layout) return;
        const state = Flip.getState(targets());
        list.dataset.layout = layout;
        try {
            localStorage.setItem("projects-layout", layout);
        } catch {}
        if (animate) morph(state);
        else ScrollTrigger.refresh();
    }

    filterButtons.forEach((b) => b.addEventListener("click", () => applyFilter(b.dataset.filter!)));
    layoutButtons.forEach((b) => b.addEventListener("click", () => applyLayout(b.dataset.layout!)));
    window.addEventListener("hashchange", () => applyFilter(location.hash.slice(1) || "all"));

    let saved: string | null = null;
    try {
        saved = localStorage.getItem("projects-layout");
    } catch {}
    if (saved) applyLayout(saved, false);
    applyFilter(location.hash.slice(1) || "all", false);
</script>

<style>
    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    /* --- STRIP --- */

    .strip {
        --strip-h: clamp(110px, 13vw, 190px);
        margin-top: clamp(16px, 2vw, 28px);
        overflow-x: auto;
        scrollbar-width: none;
    }

    .strip::-webkit-scrollbar {
        display: none;
    }

    /* once it drifts on its own, nothing to scroll by hand */
    .strip.is-moving {
        overflow: hidden;
    }

    .strip__track {
        display: flex;
        gap: clamp(10px, 1.2vw, 16px);
        width: max-content;
        padding-inline: var(--gutter);
    }

    .strip.is-moving .strip__track {
        padding-inline: 0;
    }

    .strip__item {
        display: grid;
        gap: 6px;
        flex: none;
    }

    .strip__item img {
        width: auto;
        height: var(--strip-h);
        object-fit: cover;
        background: var(--line);
        transition: transform 0.6s var(--ease);
    }

    .strip__item:hover img {
        transform: translateY(-4px);
    }

    .strip__label {
        display: flex;
        gap: 6px;
        overflow: hidden;
        white-space: nowrap;
        color: var(--muted);
    }

    /* the name appears next to the number on hover */
    .strip__name {
        color: var(--text);
        opacity: 0;
        transform: translateY(100%);
        transition:
            opacity 0.4s var(--ease),
            transform 0.4s var(--ease);
    }

    .strip__item:hover .strip__name,
    .strip__item:focus-visible .strip__name {
        opacity: 1;
        transform: none;
    }

    /* --- TITLE --- */

    .ph {
        display: grid;
        gap: 24px var(--gutter);
        padding-block: clamp(40px, 6vw, 96px) clamp(32px, 4vw, 56px);
    }

    .ph__title {
        margin: 0;
        font-size: clamp(3.5rem, 0.5rem + 12.5vw, 13rem);
        font-weight: 800;
        line-height: 0.82;
        letter-spacing: -0.045em;
        text-transform: uppercase;
    }

    .ph__count {
        margin-left: 0.15em;
        font-size: var(--fs-mono);
        font-weight: 500;
        letter-spacing: 0.02em;
        vertical-align: top;
        line-height: 1;
    }

    .ph__desc {
        max-width: 30ch;
        margin: 0;
        color: var(--muted);
    }

    @media (min-width: 900px) {
        .ph {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            align-items: end;
        }

        .ph__title {
            grid-column: 1 / span 9;
        }

        .ph__desc {
            grid-column: 10 / -1;
            padding-bottom: 0.6em;
        }
    }

    /* --- CONTROLS --- */

    .pc {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start;
        gap: 16px var(--gutter);
        padding-bottom: clamp(24px, 3vw, 40px);
    }

    .pc__layout {
        padding-top: 9px;
    }

    .pc__filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .pill {
        display: inline-flex;
        align-items: baseline;
        gap: 8px;
        padding: 8px 14px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: none;
        color: var(--text);
        cursor: pointer;
        transition:
            background-color 0.35s var(--ease),
            color 0.35s var(--ease),
            border-color 0.35s var(--ease);
    }

    .pill:hover {
        border-color: var(--text);
    }

    .pill[aria-pressed="true"] {
        background: var(--text);
        border-color: var(--text);
        color: var(--bg);
    }

    .pill__count {
        opacity: 0.55;
    }

    .pc__layout {
        display: flex;
        gap: 16px;
    }

    .pc__layout-btn {
        padding: 0 0 2px;
        border: 0;
        border-bottom: 1px solid transparent;
        background: none;
        color: var(--muted);
        font: inherit;
        text-transform: inherit;
        letter-spacing: inherit;
        cursor: pointer;
        transition:
            color 0.3s var(--ease),
            border-color 0.3s var(--ease);
    }

    .pc__layout-btn:hover,
    .pc__layout-btn[aria-pressed="true"] {
        color: var(--text);
    }

    .pc__layout-btn[aria-pressed="true"] {
        border-color: currentColor;
    }

    /* on phones the filters scroll sideways on one line */
    @media (max-width: 719px) {
        .pc__filters {
            flex-wrap: nowrap;
            width: calc(100% + 2 * var(--gutter));
            margin-inline: calc(-1 * var(--gutter));
            padding-inline: var(--gutter);
            overflow-x: auto;
            scrollbar-width: none;
        }

        .pc__filters::-webkit-scrollbar {
            display: none;
        }

        .pill {
            flex: none;
        }

        .pc {
            grid-template-columns: minmax(0, 1fr);
        }

        .pc__layout {
            order: -1;
            justify-self: end;
            padding-top: 0;
        }
    }

    /* --- THE PROJECTS --- */

    [data-item][hidden] {
        display: none;
    }

    .works {
        margin: 0;
        padding: 0 0 var(--section);
        list-style: none;
    }

    .works__empty {
        padding-block: 40px;
    }

    .work__link {
        display: grid;
    }

    .work__media {
        display: block;
        overflow: hidden;
        background: var(--line);
    }

    .work__media :global(img) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 1s var(--ease);
    }

    .work__link:hover .work__media :global(img) {
        transform: scale(1.05);
    }

    .work__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 10px;
        color: var(--muted);
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--text);
    }

    .status::before {
        content: "";
        width: 6px;
        height: 6px;
        border: 1px solid currentColor;
        border-radius: 50%;
    }

    .work__num,
    .work__year {
        color: var(--muted);
    }

    /* LIST: big uppercase titles between rules, thumbnail on the right */
    .works[data-layout="list"] {
        border-bottom: 1px solid var(--text);
    }

    .works[data-layout="list"] .work {
        border-top: 1px solid var(--text);
    }

    .works[data-layout="list"] .work__link {
        grid-template-columns: minmax(0, 1fr) clamp(88px, 24vw, 120px);
        grid-template-areas:
            "num   media"
            "title media"
            "meta  media";
        align-items: start;
        gap: 8px var(--gutter);
        padding-block: clamp(16px, 2vw, 24px);
        transition: opacity 0.4s var(--ease);
    }

    .works[data-layout="list"] .work__num {
        grid-area: num;
    }

    .works[data-layout="list"] .work__title {
        grid-area: title;
        font-size: clamp(1.6rem, 0.9rem + 3vw, 3.75rem);
        line-height: 0.95;
        letter-spacing: -0.03em;
        text-transform: uppercase;
        transition: transform 0.6s var(--ease);
    }

    .works[data-layout="list"] .work__meta {
        grid-area: meta;
        margin-top: 6px;
    }

    .works[data-layout="list"] .work__year {
        display: none;
    }

    .works[data-layout="list"] .work__media {
        grid-area: media;
        aspect-ratio: 4 / 5;
    }

    /* hovering a row: it steps forward, the others step back */
    .works[data-layout="list"]:hover .work__link {
        opacity: 0.4;
    }

    .works[data-layout="list"] .work__link:hover,
    .works[data-layout="list"] .work__link:focus-visible {
        opacity: 1;
    }

    .works[data-layout="list"] .work__link:hover .work__title {
        transform: translateX(12px);
    }

    @media (min-width: 900px) {
        .works[data-layout="list"] .work__link {
            grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 16rem) 4rem clamp(120px, 11vw, 170px);
            grid-template-areas: "num title meta year media";
            align-items: center;
        }

        .works[data-layout="list"] .work__num {
            align-self: start;
            padding-top: 0.4em;
        }

        .works[data-layout="list"] .work__meta {
            margin-top: 0;
        }

        .works[data-layout="list"] .work__year {
            display: block;
            grid-area: year;
            text-align: right;
        }
    }

    /* GRID: staggered cards, image first */
    .works[data-layout="grid"] {
        display: grid;
        gap: clamp(40px, 6vw, 96px) var(--gutter);
    }

    .works[data-layout="grid"] .work__link {
        grid-template-columns: 2.5rem minmax(0, 1fr) auto;
        grid-template-areas:
            "media media media"
            "num   title year"
            ".     meta  meta";
        gap: 4px var(--gutter);
    }

    .works[data-layout="grid"] .work__media {
        grid-area: media;
        aspect-ratio: 4 / 5;
        margin-bottom: 8px;
    }

    .works[data-layout="grid"] .work__num {
        grid-area: num;
    }

    .works[data-layout="grid"] .work__title {
        grid-area: title;
        font-family: var(--mono);
        font-size: var(--fs-mono);
        letter-spacing: 0.02em;
        text-transform: uppercase;
    }

    .works[data-layout="grid"] .work__link:hover .work__title {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .works[data-layout="grid"] .work__meta {
        grid-area: meta;
    }

    .works[data-layout="grid"] .work__year {
        grid-area: year;
    }

    @media (min-width: 900px) {
        .works[data-layout="grid"] {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            align-items: start;
        }

        .works[data-layout="grid"] .work[data-col="1"] {
            margin-top: 22vh;
        }

        .works[data-layout="grid"] .work[data-col="2"] {
            margin-top: 8vh;
        }

        .works[data-layout="grid"] .work[data-col="1"] .work__media {
            aspect-ratio: 3 / 4;
        }
    }
</style>
