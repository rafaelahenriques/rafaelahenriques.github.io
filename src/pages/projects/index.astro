---
/**
 * All projects, on an arcade (components/ProjectArcade.astro): the cabinet
 * flipping through them, or moved in on its screen for the list of them all.
 */
import Base from "../../layouts/BaseLayout.astro";
import ProjectArcade from "../../components/ProjectArcade.astro";
import { getProjects, slugOf } from "../../lib/content";
import { SITE_URL, breadcrumbSchema } from "../../lib/seo";

const projects = await getProjects();
---

<Base
    title="Projects"
    description="All projects by Rafaela Henriques: web, mobile and full-stack apps, games and interactive work, branding and UI design."
    schema={[
        {
            "@context": "https://schema.org",
            "@type": "CollectionPage",
            name: "Projects",
            url: `${SITE_URL}/projects/`,
            mainEntity: {
                "@type": "ItemList",
                itemListElement: projects.map((p, i) => ({ "@type": "ListItem", position: i + 1, name: p.data.title, url: `${SITE_URL}/projects/${slugOf(p)}/` })),
            },
        },
        breadcrumbSchema([{ name: "Home", path: "/" }, { name: "Projects", path: "/projects/" }]),
    ]}
>
    <ProjectArcade projects={projects} />
</Base>
