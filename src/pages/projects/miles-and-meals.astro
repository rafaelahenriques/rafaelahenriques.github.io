---
/**
 * Miles & Meals case study. A custom page (customPage in the content entry)
 * so the identity can be shown as an editorial sequence: header slideshow,
 * hero reveal, brief, boxes rising out of the red band, pinned horizontal
 * brand-board scroll, pattern strip, parallax mockups, the app and its
 * walkthrough. Every image opens in a lightbox.
 */
import Base from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import { pad } from "../../lib/content";
import { projectSeo } from "../../lib/seo";
import { fullSize as full } from "../../lib/images";
import Lightbox from "../../components/Lightbox.astro";
import NextProject from "../../components/NextProject.astro";

import hero from "../../content/projects/miles-and-meals/main.jpg";
import bbVision from "../../content/projects/miles-and-meals/brandboard-1.png";
import bbLook from "../../content/projects/miles-and-meals/brandboard-2.png";
import bbLogo from "../../content/projects/miles-and-meals/brandboard-3.png";
import bbLogoColours from "../../content/projects/miles-and-meals/brandboard-4.png";
import bbColour from "../../content/projects/miles-and-meals/brandboard-5.png";
import bbTote from "../../content/projects/miles-and-meals/brandboard-6.png";
import bbType from "../../content/projects/miles-and-meals/brandboard-7.png";
import bbBox from "../../content/projects/miles-and-meals/brandboard-8.png";
import bbPattern from "../../content/projects/miles-and-meals/brandboard-9.png";
import bbIcons from "../../content/projects/miles-and-meals/brandboard-10.png";
import bbStreetMade from "../../content/projects/miles-and-meals/brandboard-11.png";
import bbPhoto from "../../content/projects/miles-and-meals/brandboard-12.png";
import moodboard from "../../content/projects/miles-and-meals/moodboard.png";
import mockupPhone from "../../content/projects/miles-and-meals/mockup_phone.png";
import appSplash from "../../content/projects/miles-and-meals/logo_app.png";
import appMain from "../../content/projects/miles-and-meals/app-main.png";
import appExplore from "../../content/projects/miles-and-meals/app-explore.png";
import appFavorites from "../../content/projects/miles-and-meals/app-favorites.png";
import appRecipe from "../../content/projects/miles-and-meals/app-recipe-detail.png";

const project = (await getEntry("projects", "miles-and-meals"))!;
const { title, description, role, year, category, tech } = project.data;

const links = {
    brandBoard: "https://www.figma.com/design/icN4oVbYhw1gKWb5aECHgS/Miles-and-Meals---Rafaela-Henriques?node-id=59105-12675",
    appDesign: "https://www.figma.com/design/icN4oVbYhw1gKWb5aECHgS/Miles-and-Meals---Rafaela-Henriques?node-id=6817-1887",
    prototype:
        "https://www.figma.com/proto/icN4oVbYhw1gKWb5aECHgS/Miles-and-Meals---Rafaela-Henriques?node-id=58769-5168&viewport=-1707%2C638%2C0.17&scaling=scale-down&content-scaling=fixed&starting-point-node-id=58769%3A5168&show-proto-sidebar=1&page-id=6817%3A1887",
    pdf: "/files/miles-and-meals-brandboard.pdf",
};

// Header rail: a vertical column of images drifting upward
const rail = await Promise.all(
    [
        { img: moodboard, alt: "Look and feel moodboard" },
        { img: mockupPhone, alt: "The Miles & Meals app on a phone" },
        { img: bbTote, alt: "Tote bag and food mockups" },
    ].map(async (s) => ({ ...s, full: await full(s.img) })),
);

const facts = [
    { value: "3", label: "box themes" },
    { value: "4", label: "recipes per box" },
    { value: "2 · 4 · 6", label: "servings" },
    { value: "100%", label: "compostable box" },
];

const boxes = [
    { name: "Local Legend", text: "The classics people grow up with and order without looking at the menu." },
    { name: "Street Made", text: "Fast and loud: smoke, heat, crunch and layered sauces, ready in little time." },
    { name: "Neighbourhood Bakes", text: "Fritters, breads, sticky sweets — the snacks sold on corners and markets." },
];

const identity = await Promise.all(
    [
        { img: bbLogo, title: "Logo", text: "A bicycle and a cloche: food and movement, with a nod to Belgium and delivery by bike." },
        { img: bbLogoColours, title: "Logo in use", text: "Sharp forms for energy, curves to keep it approachable — on every brand colour." },
        { img: bbColour, title: "Colour", text: "Warm, food-led tones with one strong contemporary contrast, used selectively." },
        { img: bbType, title: "Typography", text: "Bold, condensed headlines for energy; a clean sans for everything you need to read." },
        { img: bbIcons, title: "Iconography", text: "Simple, bold and functional — the structured side of the identity." },
        { img: bbPhoto, title: "Photography", text: "Direct flash, documentary style: people, busy tables, markets and city details." },
    ].map(async (p) => ({ ...p, full: await full(p.img) })),
);

const phones = await Promise.all(
    [
        { img: appSplash, alt: "Splash screen with the Miles & Meals symbol" },
        { img: appMain, alt: "Home: this week's Local Legend box" },
        { img: appExplore, alt: "Explore cities" },
        { img: appFavorites, alt: "Favourite recipes" },
        { img: appRecipe, alt: "Recipe detail" },
    ].map(async (p) => ({ ...p, full: await full(p.img) })),
);

const zoom = {
    hero: await full(hero),
    streetMade: await full(bbStreetMade),
    vision: await full(bbVision),
    look: await full(bbLook),
    box: await full(bbBox),
    tote: await full(bbTote),
};

const values = [
    { name: "Out & Social", text: "Direct flash, people, strong colour." },
    { name: "Authentic & Open", text: "Real places and local stories, without stereotypes." },
    { name: "Trendy, not mainstream", text: "Editorial references instead of meal-kit clichés." },
    { name: "Smart", text: "Structured layouts and clear, functional information." },
];
---

<Base title={title} description={description} {...projectSeo(project)}>
    <article class="mm">
        <!-- INTRO: title on the left, a slideshow of the work on the right -->
        <header class="page-head wrap">
            <a href="/projects/" class="mono muted link" data-reveal>← All projects</a>
            <div class="mm-top">
                <div class="mm-top__title">
                    <p class="mm-kicker mono muted" data-reveal>Other work — {category}</p>
                    <h1 class="display mm-title" data-split>{title}<span class="stop" aria-hidden="true"></span></h1>
                </div>

                <div class="mm-rail" data-mm-rail aria-label="Project images">
                    <div class="mm-rail__window">
                        <div class="mm-rail__track" data-mm-rail-track>
                            {
                                [0, 1].map((copy) =>
                                    rail.map((r) => (
                                        <button
                                            type="button"
                                            class="mm-rail__item zoom-btn"
                                            data-mm-rail-item
                                            data-zoom-single
                                            data-zoom={r.full}
                                            data-caption={r.alt}
                                            aria-label={`View larger: ${r.alt}`}
                                            aria-hidden={copy ? "true" : undefined}
                                            tabindex={copy ? "-1" : undefined}
                                        >
                                            <Image quality={90} src={r.img} alt={copy ? "" : r.alt} widths={[400, 700, 1000]} sizes="(min-width: 900px) 22vw, 60vw" loading="eager" />
                                        </button>
                                    )),
                                )
                            }
                        </div>
                    </div>
                    <button type="button" class="text-button link mono mm-rail__toggle" data-mm-rail-toggle aria-pressed="false">Pause</button>
                </div>
            </div>

            <div class="row mm-intro">
                <dl class="row__label mm-facts mono" data-reveal>
                    <div><dt class="muted">Role</dt><dd>{role}</dd></div>
                    <div><dt class="muted">Year</dt><dd>{year}</dd></div>
                    <div><dt class="muted">Scope</dt><dd>{tech?.join(", ")}</dd></div>
                    <div>
                        <dt class="muted">Figma</dt>
                        <dd class="mm-links">
                            <a href={links.brandBoard} class="link" target="_blank" rel="noopener noreferrer">Brand board ↗</a>
                            <a href={links.appDesign} class="link" target="_blank" rel="noopener noreferrer">App design ↗</a>
                            <a href={links.prototype} class="link" target="_blank" rel="noopener noreferrer">Prototype ↗</a>
                        </dd>
                    </div>
                    <div>
                        <dt class="muted">Download</dt>
                        <dd><a href={links.pdf} class="link" download>Brand board PDF ↓</a></dd>
                    </div>
                </dl>
                <p class="row__body lead" data-split>{description}</p>
            </div>
        </header>

        <!-- HERO: full-bleed photo that opens up as you scroll -->
        <figure class="mm-hero" data-mm-hero>
            <button type="button" class="mm-hero__frame zoom-btn" data-zoom={zoom.hero} data-caption="Miles & Meals" aria-label="View larger: Miles & Meals hero image">
                <Image quality={90} src={hero} alt="Friends laughing over pizza and pasta, with the Miles & Meals logo" widths={[1000, 1600, 2400, 3024]} sizes="100vw" loading="eager" />
            </button>
        </figure>

        <!-- BRIEF -->
        <section class="section wrap" aria-labelledby="mm-brief">
            <div class="row">
                <h2 id="mm-brief" class="row__label mono muted">The brief</h2>
                <div class="row__body">
                    <p class="mm-statement" data-split>Street food. Local stories. At home.</p>
                    <p class="mm-copy" data-reveal>
                        A street-food box built around signature dishes found on
                        Melanie and Rob's travels and developed with the locals
                        who cook them. Pre-portioned ingredients, step-by-step
                        recipe cards, no professional skills needed — delivered by
                        bike in compostable packaging, starting in Antwerp.
                    </p>
                    <dl class="mm-stats">
                        {
                            facts.map((f) => (
                                <div class="mm-stat" data-reveal>
                                    <dd>{f.value}</dd>
                                    <dt class="mono">{f.label}</dt>
                                </div>
                            ))
                        }
                    </dl>
                </div>
            </div>
        </section>

        <!-- BOXES: cards rise out of the red band as you scroll -->
        <section class="mm-band mm-band--red mm-boxes-band" aria-labelledby="mm-boxes" data-mm-boxes>
            <div class="wrap">
                <h2 id="mm-boxes" class="mono mm-band__label">Three boxes</h2>
                <ol class="mm-boxes">
                    {
                        boxes.map((b, i) => (
                            <li class="mm-box" data-mm-box>
                                <span class="mm-box__num">{pad(i + 1)}</span>
                                <h3 class="mm-box__name">{b.name}</h3>
                                <p>{b.text}</p>
                            </li>
                        ))
                    }
                </ol>
            </div>
        </section>

        <!-- STREET MADE: one big image between the boxes and the art direction -->
        <section class="wrap mm-feature" aria-label="Street Made box and poster">
            <figure data-reveal-img>
                <button type="button" class="zoom-btn" data-zoom={zoom.streetMade} data-caption="Street Made box and poster" aria-label="View larger: Street Made box and poster">
                    <Image quality={90} src={bbStreetMade} alt="Street Made box and poster" widths={[1000, 1600, 2400]} sizes="100vw" />
                </button>
            </figure>
        </section>

        <!-- ART DIRECTION: expressive vs structured -->
        <section class="section wrap" aria-labelledby="mm-direction">
            <div class="row">
                <h2 id="mm-direction" class="row__label mono muted">Art direction</h2>
                <div class="row__body">
                    <p class="mm-statement mm-statement--small" data-split>
                        Less meal kit, more independent food and travel magazine.
                    </p>
                    <div class="mm-duo">
                        <div data-reveal>
                            <p class="mono muted">Expressive</p>
                            <p>Bold type, strong colour and spontaneous photography bring energy and the social side of food.</p>
                        </div>
                        <div data-reveal>
                            <p class="mono muted">Structured</p>
                            <p>Clean type, grids and clear information keep the brand smart and easy to use.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mm-pair">
                <figure class="mm-pair__a" data-speed="-6" data-reveal-img>
                    <button type="button" class="zoom-btn" data-zoom={zoom.vision} data-caption="Brand vision, tone of voice and personality" aria-label="View larger: brand vision">
                        <Image quality={90} src={bbVision} alt="Brand vision, tone of voice and personality" widths={[700, 1200, 1800]} sizes="(min-width: 900px) 38vw, 100vw" />
                    </button>
                </figure>
                <figure class="mm-pair__b" data-speed="8" data-reveal-img>
                    <button type="button" class="zoom-btn" data-zoom={zoom.look} data-caption="Look and feel moodboard" aria-label="View larger: look and feel">
                        <Image quality={90} src={bbLook} alt="Look and feel moodboard" widths={[900, 1500, 2200]} sizes="(min-width: 900px) 55vw, 100vw" />
                    </button>
                </figure>
            </div>
        </section>

        <!-- IDENTITY: pinned horizontal scroll on desktop, swipe on touch -->
        <section class="mm-band mm-band--ink mm-identity" aria-labelledby="mm-identity" data-mm-identity>
            <div class="wrap mm-identity__head">
                <h2 id="mm-identity" class="mono mm-band__label">The identity</h2>
                <p class="mono mm-identity__links">
                    <a href={links.brandBoard} class="link" target="_blank" rel="noopener noreferrer">Full brand board in Figma ↗</a>
                    <a href={links.pdf} class="link" download>PDF ↓</a>
                </p>
            </div>
            <div class="mm-identity__viewport" data-mm-viewport>
                <ol class="mm-identity__track" data-mm-track>
                    {
                        identity.map((panel, i) => (
                            <li class="mm-panel">
                                <figure>
                                    <button type="button" class="zoom-btn" data-zoom={panel.full} data-caption={`${panel.title} — ${panel.text}`} aria-label={`View larger: ${panel.title}`}>
                                        <Image quality={90} src={panel.img} alt={panel.title} widths={[1000, 1600, 2400]} sizes="(min-width: 900px) 80vw, 88vw" />
                                    </button>
                                    <figcaption>
                                        <span class="mono">{pad(i + 1)} / {pad(identity.length)}</span>
                                        <strong>{panel.title}</strong>
                                        <span>{panel.text}</span>
                                    </figcaption>
                                </figure>
                            </li>
                        ))
                    }
                </ol>
            </div>
            <div class="wrap"><div class="mm-identity__progress" data-mm-progress></div></div>
        </section>

        <!-- PATTERN: one image, full width, cropped to a strip -->
        <div class="mm-pattern" aria-hidden="true" data-mm-pattern>
            <Image quality={90} src={bbPattern} alt="" widths={[1200, 2000, 3024]} sizes="100vw" />
        </div>

        <!-- APPLICATIONS: parallax collage -->
        <section class="section wrap" aria-labelledby="mm-applications">
            <div class="row">
                <h2 id="mm-applications" class="row__label mono muted">Applications</h2>
                <p class="row__body mm-statement mm-statement--small" data-split>
                    From the box on the doorstep to the tote on the way to the market.
                </p>
            </div>
            <div class="mm-collage">
                <figure class="mm-collage__box" data-speed="-10" data-reveal-img>
                    <button type="button" class="zoom-btn" data-zoom={zoom.box} data-caption="Local Legend box" aria-label="View larger: Local Legend box">
                        <Image quality={90} src={bbBox} alt="Local Legend box" widths={[900, 1500, 2200]} sizes="(min-width: 900px) 58vw, 100vw" />
                    </button>
                </figure>
                <figure class="mm-collage__tote" data-speed="12" data-reveal-img>
                    <button type="button" class="zoom-btn" data-zoom={zoom.tote} data-caption="Tote bag and food mockups" aria-label="View larger: tote bag">
                        <Image quality={90} src={bbTote} alt="Tote bag and food mockups" widths={[700, 1200, 1800]} sizes="(min-width: 900px) 40vw, 100vw" />
                    </button>
                </figure>
            </div>
        </section>

        <!-- APP on brand red -->
        <section class="mm-band mm-band--red mm-app" aria-labelledby="mm-app">
            <div class="wrap">
                <div class="row mm-app__head">
                    <h2 id="mm-app" class="row__label mono">The app</h2>
                    <p class="row__body mm-statement mm-statement--small">
                        Plan the next box, follow its delivery, explore cities and cook along step by step.
                    </p>
                </div>
                <ul class="mm-phones" data-mm-phones>
                    {
                        phones.map((p) => (
                            <li class="mm-phone">
                                <button type="button" class="zoom-btn" data-zoom={p.full} data-caption={p.alt} aria-label={`View larger: ${p.alt}`}>
                                    <Image quality={90} src={p.img} alt={p.alt} widths={[400, 700, 1016]} sizes="(min-width: 900px) 18vw, 45vw" />
                                </button>
                            </li>
                        ))
                    }
                </ul>

                <div class="mm-walkthrough">
                    <div class="mm-walkthrough__side" data-reveal>
                        <p class="mono mm-walkthrough__label">Full app walkthrough</p>
                        <p class="mm-walkthrough__text">
                            From opening this week's box to cooking along, step by step.
                        </p>
                        <div class="mm-walkthrough__links mono">
                            <a href={links.prototype} class="mm-cta" target="_blank" rel="noopener noreferrer">Try the prototype ↗</a>
                            <a href={links.appDesign} class="mm-cta mm-cta--ghost" target="_blank" rel="noopener noreferrer">App design in Figma ↗</a>
                        </div>
                    </div>
                    <div class="mm-video" data-reveal>
                        <iframe
                            src="https://player.vimeo.com/video/1232722059?badge=0&autopause=0&dnt=1"
                            title="Miles & Meals — app walkthrough"
                            loading="lazy"
                            allow="autoplay; fullscreen; picture-in-picture"
                            referrerpolicy="strict-origin-when-cross-origin"></iframe>
                    </div>
                </div>
            </div>
        </section>

        <!-- WHY IT WORKS -->
        <section class="section wrap mm-why" aria-labelledby="mm-why">
            <div class="row">
                <h2 id="mm-why" class="row__label mono muted">Why it works</h2>
                <ol class="row__body mm-values">
                    {
                        values.map((v, i) => (
                            <li class="mm-value" data-reveal>
                                <span class="mono muted">{pad(i + 1)}</span>
                                <strong>{v.name}</strong>
                                <span class="muted">{v.text}</span>
                            </li>
                        ))
                    }
                </ol>
            </div>
        </section>

    </article>

    <NextProject current="miles-and-meals" />

    <Lightbox />
</Base>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const MOTION = "(prefers-reduced-motion: no-preference)";
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const mm = gsap.matchMedia();

    /* ---------------- HEADER RAIL ---------------- */
    // The track holds the images twice; moving it up by half loops seamlessly.
    const railEl = document.querySelector<HTMLElement>("[data-mm-rail]");
    if (railEl) {
        const track = railEl.querySelector<HTMLElement>("[data-mm-rail-track]")!;
        const toggle = railEl.querySelector<HTMLButtonElement>("[data-mm-rail-toggle]")!;
        let paused = reduceMotion.matches;
        const loop = gsap.to(track, { yPercent: -50, duration: 28, ease: "none", repeat: -1, paused });

        const setPaused = (value: boolean) => {
            paused = value;
            toggle.textContent = paused ? "Play" : "Pause";
            toggle.setAttribute("aria-pressed", String(paused));
            paused ? loop.pause() : loop.play();
        };
        setPaused(paused);
        toggle.addEventListener("click", () => setPaused(!paused));
        // slow down to a stop under the pointer so an image can be picked
        railEl.addEventListener("pointerenter", () => !paused && gsap.to(loop, { timeScale: 0, duration: 0.6 }));
        railEl.addEventListener("pointerleave", () => !paused && gsap.to(loop, { timeScale: 1, duration: 0.6 }));
    }

    /* ---------------- SCROLL MOTION ---------------- */
    mm.add(MOTION, () => {
        // Hero: the frame opens from an inset card to full bleed, the photo settles
        const hero = document.querySelector<HTMLElement>("[data-mm-hero]");
        if (hero) {
            gsap.fromTo(
                hero.querySelector(".mm-hero__frame"),
                { clipPath: "inset(6% 12% 6% 12% round 4px)" },
                {
                    clipPath: "inset(0% 0% 0% 0% round 0px)",
                    ease: "none",
                    scrollTrigger: { trigger: hero, start: "top 85%", end: "top 15%", scrub: true },
                },
            );
            gsap.fromTo(
                hero.querySelector("img"),
                { scale: 1.2 },
                { scale: 1, ease: "none", scrollTrigger: { trigger: hero, start: "top bottom", end: "bottom top", scrub: true } },
            );
        }

        // Boxes: the red band clips them, so they rise up out of it with the scroll
        const boxesBand = document.querySelector<HTMLElement>("[data-mm-boxes]");
        if (boxesBand) {
            gsap.fromTo(
                "[data-mm-box]",
                { yPercent: 130, rotate: (i) => [6, -5, 4][i % 3] },
                {
                    yPercent: 0,
                    rotate: (i) => [-2, 1.5, -1][i % 3],
                    ease: "power3.out",
                    stagger: 0.12,
                    scrollTrigger: { trigger: boxesBand, start: "top 70%", end: "center 55%", scrub: 0.8 },
                },
            );
        }

        // Parallax: data-speed moves an element against the scroll (percent of its height)
        gsap.utils.toArray<HTMLElement>("[data-speed]").forEach((el) => {
            gsap.fromTo(
                el,
                { yPercent: -Number(el.dataset.speed) },
                {
                    yPercent: Number(el.dataset.speed),
                    ease: "none",
                    scrollTrigger: { trigger: el, start: "top bottom", end: "bottom top", scrub: true },
                },
            );
        });

        // Pattern strip: the cropped image glides inside its frame
        const pattern = document.querySelector<HTMLElement>("[data-mm-pattern]");
        if (pattern) {
            gsap.fromTo(
                pattern.querySelector("img"),
                { yPercent: -6 },
                { yPercent: 6, ease: "none", scrollTrigger: { trigger: pattern, start: "top bottom", end: "bottom top", scrub: true } },
            );
        }

        // Phones rise in a staggered wave
        gsap.from(".mm-phone", {
            y: 120,
            autoAlpha: 0,
            duration: 1.2,
            ease: "expo.out",
            stagger: 0.1,
            scrollTrigger: { trigger: "[data-mm-phones]", start: "top 85%", once: true },
        });
    });

    // Identity: pin the section and scroll the panels sideways (desktop only).
    // It holds on the first panel before moving and on the last one after, so
    // both can be read. Without this the track is a native swipeable scroller.
    mm.add(`${MOTION} and (min-width: 900px)`, () => {
        const section = document.querySelector<HTMLElement>("[data-mm-identity]");
        const viewport = document.querySelector<HTMLElement>("[data-mm-viewport]");
        const track = document.querySelector<HTMLElement>("[data-mm-track]");
        const progress = document.querySelector<HTMLElement>("[data-mm-progress]");
        if (!section || !viewport || !track) return;

        section.classList.add("is-pinned");
        const distance = () => track.scrollWidth - viewport.clientWidth;
        // Pause at each end for HOLD × the sideways distance (in timeline units)
        const HOLD = 0.08;

        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: section,
                start: "top top",
                end: () => `+=${distance() * (1 + HOLD * 2)}`,
                pin: true,
                scrub: 1,
                invalidateOnRefresh: true,
                onUpdate: (self) => progress && gsap.set(progress, { scaleX: self.progress }),
            },
        });
        tl.to({}, { duration: HOLD })
            .to(track, { x: () => -distance(), ease: "none", duration: 1 })
            .to({}, { duration: HOLD });

        return () => {
            tl.scrollTrigger?.kill();
            tl.kill();
            section.classList.remove("is-pinned");
            gsap.set(track, { clearProps: "x" });
        };
    });

    // Identity panels slide in sideways, so lazy-loading would only start once
    // each one is already on screen. Start loading them as the section nears.
    ScrollTrigger.create({
        trigger: "[data-mm-identity]",
        start: "top bottom+=100%",
        once: true,
        onEnter: () =>
            document.querySelectorAll<HTMLImageElement>("[data-mm-track] img").forEach((img) => (img.loading = "eager")),
    });

