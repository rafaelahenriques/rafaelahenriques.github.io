---
import Base from "../../layouts/BaseLayout.astro";
import { render } from "astro:content";
import { Picture } from "astro:assets";
import { getProjects, pad, slugOf, type ProjectEntry } from "../../lib/content";
import { projectSeo } from "../../lib/seo";
import NextProject from "../../components/NextProject.astro";

export async function getStaticPaths() {
    const projects = await getProjects();
    return projects
        .map((project) => ({
            params: { slug: slugOf(project) },
            props: { project },
        }))
        // custom pages (e.g. case studies) render their own route
        .filter(({ props }) => !props.project.data.customPage);
}

interface Props {
    project: ProjectEntry;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, year, role, context, tech, scope, media, section, order, status, category, architecture, metrics } =
    project.data;

// Only explicit galleries: generated covers shouldn't repeat on the project page
const gallery = media?.gallery ?? [];
const inProgress = status === "in-progress";
const kicker = [section === "featured" && order ? pad(order) : "Other work", category].filter(Boolean).join(" — ");

const facts = [
    { label: "Year", value: year },
    { label: "Role", value: role },
    { label: "Context", value: context },
    { label: "Tools", value: tech?.join(", ") },
].filter((f) => f.value);
---

<Base title={title} description={description} {...projectSeo(project)}>
    <header class="page-head wrap">
        <a href="/projects/" class="mono muted link" data-reveal>← All projects</a>
        <p class="project-kicker mono muted" data-reveal>{kicker}</p>
        <h1 class="display project-title" data-split>{title}<span class="stop" aria-hidden="true"></span></h1>
        {
            inProgress && (
                <p class="project-wip" data-reveal>
                    <span class="wip">In progress</span>
                    <span class="muted">Still being built. This page will be updated as the project develops.</span>
                </p>
            )
        }
    </header>

    <section class="wrap">
        <div class="row">
            <dl class="row__label facts mono" data-reveal>
                {
                    facts.map((f) => (
                        <div>
                            <dt class="muted">{f.label}</dt>
                            <dd>{f.value}</dd>
                        </div>
                    ))
                }
                {
                    media?.repo && (
                        <div>
                            <dt class="muted">Source</dt>
                            <dd>
                                <a href={media.repo} class="link">GitHub ↗</a>
                            </dd>
                        </div>
                    )
                }
            </dl>
            <div class="row__body">
                {description && <p class="lead" data-split>{description}</p>}
                {
                    scope && (
                        <ul class="scope mono" aria-label="Scope" data-reveal>
                            {scope.map((s) => <li>{s}</li>)}
                        </ul>
                    )
                }
            </div>
        </div>
    </section>

    {
        gallery.length > 0 && (
            <section class="gallery wrap" aria-label="Images">
                {gallery.map((img, i) => (
                    <figure class="gallery__item" data-reveal-img>
                        <Picture
                            src={img}
                            alt={`${title}, image ${i + 1}`}
                            formats={["avif", "webp"]}
                            widths={[800, 1400, 2000]}
                            sizes="(min-width: 900px) 75vw, 100vw"
                            loading={i === 0 ? "eager" : "lazy"}
                        />
                    </figure>
                ))}
            </section>
        )
    }

    {
        architecture && (
            <section class="section wrap" aria-labelledby="architecture">
                <div class="row">
                    <h2 id="architecture" class="row__label mono muted">Architecture</h2>
                    <ol class="row__body pipeline">
                        {architecture.map((stage, i) => (
                            <li class="pipeline__stage" data-reveal>
                                <span class="pipeline__num mono muted">{pad(i + 1)}</span>
                                <span class="pipeline__label h2">{stage.label}</span>
                                {stage.detail && <span class="pipeline__detail muted">{stage.detail}</span>}
                            </li>
                        ))}
                    </ol>
                </div>
            </section>
        )
    }

    {
        metrics && (
            <section class="section wrap" aria-labelledby="metrics">
                <div class="row">
                    <h2 id="metrics" class="row__label mono muted">What it measures</h2>
                    <dl class="row__body metrics">
                        {metrics.map((m) => (
                            <div class="metrics__item" data-reveal>
                                <dt>{m.label}</dt>
                                {m.detail && <dd class="muted">{m.detail}</dd>}
                            </div>
                        ))}
                    </dl>
                </div>
            </section>
        )
    }

    <section class="section wrap">
        <div class="row">
            <p class="row__label mono muted">Case study</p>
            <div class="row__body prose" data-reveal>
                <Content />
            </div>
        </div>
    </section>

    <NextProject current={slugOf(project)} />
</Base>

<style>
    .project-title {
        max-width: 14ch;
        font-size: clamp(2.75rem, 1rem + 7vw, 8.5rem);
    }

    .project-kicker {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        margin-top: 24px;
    }

    /* unfinished projects say so right under the title */
    .project-wip {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 14px;
        margin: clamp(20px, 3vw, 32px) 0 0;
        font-size: var(--fs-small);
    }

    /* --- ARCHITECTURE: a vertical flow, each stage feeding the next --- */

    .pipeline {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .pipeline__stage {
        position: relative;
        display: grid;
        grid-template-columns: 3rem 1fr;
        gap: 4px var(--gutter);
        padding-bottom: 40px;
    }

    /* connector line + arrow head down to the next stage */
    .pipeline__stage:not(:last-child)::after {
        content: "↓";
        position: absolute;
        left: 0;
        bottom: 8px;
        font-family: var(--mono);
        color: var(--muted);
    }

    .pipeline__label {
        grid-column: 2;
    }

    .pipeline__detail {
        grid-column: 2;
    }

    /* --- METRICS --- */

    .metrics {
        display: grid;
        gap: 0 var(--gutter);
        margin: 0;
    }

    .metrics__item {
        padding-block: 16px;
        border-bottom: 1px solid var(--line);
    }

    .metrics__item:first-child {
        padding-top: 0;
    }

    .metrics__item dt {
        font-size: var(--fs-lead);
        line-height: 1.1;
        letter-spacing: -0.03em;
    }

    .metrics__item dd {
        margin: 6px 0 0;
    }

    @media (min-width: 720px) {
        .metrics {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .metrics__item:nth-child(2) {
            padding-top: 0;
        }
    }

    .facts {
        display: grid;
        gap: 14px;
        align-content: start;
    }

    .facts dd {
        margin: 2px 0 0;
    }

    .scope {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 32px 0 0;
        padding: 0;
        list-style: none;
    }

    .scope li {
        padding: 6px 10px;
        border: 1px solid var(--line);
    }

    .gallery {
        display: grid;
        gap: var(--gutter);
        margin-top: clamp(48px, 8vw, 120px);
    }

    .gallery__item {
        margin: 0;
        overflow: hidden;
    }

    /* <Picture> renders outside this component's scope, hence :global */
    .gallery__item :global(img) {
        width: 100%;
    }

    @media (min-width: 900px) {
        .gallery {
            grid-template-columns: repeat(12, minmax(0, 1fr));
        }

        .gallery__item {
            grid-column: 4 / -1;
        }

        .gallery__item:nth-child(even) {
            grid-column: 1 / span 9;
        }
    }

</style>
