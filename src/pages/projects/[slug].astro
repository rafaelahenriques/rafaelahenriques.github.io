---
import Base from "../../layouts/BaseLayout.astro";
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";
import { Picture } from "astro:assets";

type ProjectEntry = CollectionEntry<"projects">;

export async function getStaticPaths() {
  const entries = await getCollection("projects");
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
  }));
}

const projects: ProjectEntry[] = await getCollection("projects");

const currentId = Astro.params.slug;
const project = projects.find((p) => p.id.replace(/\.md$/, "") === currentId);
if (!project) {
  throw new Error("Project not found");
}

const { Content } = await render(project);

const sortedProjects = [...projects].sort((a, b) => {
  const yearA = a.data.year ?? "";
  const yearB = b.data.year ?? "";
  if (yearA !== yearB) return yearB.localeCompare(yearA);
  return (a.data.title ?? "").localeCompare(b.data.title ?? "");
});

const currentIndex = sortedProjects.findIndex(
  (p) => p.id.replace(/\.md$/, "") === currentId
);
const prev =
  currentIndex > 0 ? sortedProjects[currentIndex - 1] : null;
const next =
  currentIndex < sortedProjects.length - 1
    ? sortedProjects[currentIndex + 1]
    : null;

const media = project.data.media;

const rawRole = project.data.role;
const roles: string[] = Array.isArray(rawRole)
  ? rawRole
  : typeof rawRole === "string" && rawRole.trim().length > 0
  ? rawRole
      .split(/[,/]|&/)
      .map((r) => r.trim())
      .filter(Boolean)
  : [];
---

<Base title={project.data.title} description={project.data.description}>
  <section class="project-header">
    <a href="/projects/" class="back-link">← Back to all projects</a>

    <h1 class="page-title">{project.data.title}</h1>

    {project.data.description && (
      <p class="lead">{project.data.description}</p>
    )}

    {roles.length > 0 && (
      <div class="roles">
        {roles.map((role) => (
          <span class="role-pill">{role}</span>
        ))}
      </div>
    )}

    {(prev || next) && (
      <nav class="project-nav" aria-label="Project navigation">
        <div class="project-nav__side">
          {prev && (
            <a
              href={`/projects/${prev.id.replace(/\.md$/, "")}/`}
              class="nav-link nav-prev"
              aria-label={`Previous: ${prev.data.title}`}
            >
              {/* MOBILE CIRCLE ARROW ONLY */}
              <span class="nav-circle" aria-hidden="true">←</span>

              {/* DESKTOP TEXT + ARROW (SAME LOOK AS BEFORE) */}
              <span class="nav-label">← Previous: {prev.data.title}</span>
            </a>
          )}
        </div>

        <div class="project-nav__side project-nav__side--right">
          {next && (
            <a
              href={`/projects/${next.id.replace(/\.md$/, "")}/`}
              class="nav-link nav-next"
              aria-label={`Next: ${next.data.title}`}
            >
              {/* DESKTOP TEXT + ARROW (SAME LOOK AS BEFORE) */}
              <span class="nav-label">Next: {next.data.title} →</span>

              {/* MOBILE CIRCLE ARROW ONLY */}
              <span class="nav-circle" aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </nav>
    )}
  </section>

  <section class="project-body">
    <Content />

    {media?.gallery && media.gallery.length > 0 && (
      <div class="gallery">
        {media.gallery.map((img) => (
          <figure class="gallery__item">
            <Picture
              src={img}
              alt={`${project.data.title} – screenshot`}
              loading="lazy"
              formats={["avif", "webp", "png"]}
              widths={[320, 640, 768, 1024]}
              sizes="(max-width: 719px) 100vw, (max-width: 1023px) 50vw, 33vw"
            />
          </figure>
        ))}
      </div>
    )}
  </section>
</Base>

<style>
  .project-header {
    margin-bottom: var(--gap);
    display: grid;
    gap: var(--gap);
  }

  .back-link {
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--accent);
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }

  .back-link:hover {
    opacity: 1;
  }

  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }

  .role-pill {
    padding: 6px 12px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--accent) 15%, transparent);
    border: 1px solid color-mix(in oklab, var(--accent) 40%, transparent);
    font-size: var(--step--1);
    color: var(--text);
    backdrop-filter: blur(6px);
    white-space: nowrap;
  }

  .project-nav {
    display: flex;
    justify-content: space-between;
    margin-top: var(--gap);
    gap: 8px;
    flex-wrap: nowrap;
    border-top: 1px solid var(--border);
    padding-top: 10px;
  }

  .project-nav__side {
    display: flex;
    flex: 1 1 auto;
  }

  .project-nav__side--right {
    justify-content: flex-end;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--step--1);
    color: var(--muted);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 999px;
    transition:
      color 0.18s ease,
      background 0.18s ease,
      transform 0.12s ease;
  }

  .nav-link:hover {
    color: var(--text);
    background: var(--glass);
    transform: translateY(-1px);
    text-decoration: none;
  }

  /* Circle (mobile only by default) */
  .nav-circle {
    display: none; /* hidden on desktop */
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--accent) 15%, transparent);
    border: 1px solid color-mix(in oklab, var(--accent) 40%, transparent);
    display: none;
    align-items: center;
    justify-content: center;
    font-size: var(--fontsize-1);
    color: var(--text);
    font-weight: bold;
    flex-shrink: 0;
  }

  .nav-link:hover .nav-circle {
    background: var(--glass);
    border-color: var(--accent);
  }

  .nav-label {
    white-space: nowrap;
  }

  .project-body {
    margin-top: calc(var(--gap) * 2);
    display: grid;
    gap: var(--gap);
  }

  .gallery {
    display: grid;
    gap: var(--gap);
    grid-template-columns: 1fr;
  }

  .gallery__item img {
    width: 100%;
    border-radius: var(--radius);
    object-fit: cover;
    border: 1px solid var(--border);
  }

  @media (min-width: 720px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* MOBILE BEHAVIOUR: circles only, no text; arrows aligned left/right */
  @media (max-width: 599px) {
    .project-nav {
      flex-wrap: nowrap;
      justify-content: space-between;
    }

    .nav-label {
      display: none;
    }

    .nav-circle {
      display: flex;
    }

    .project-nav__side {
      justify-content: flex-start;
    }

    .project-nav__side--right {
      justify-content: flex-end;
    }

    .nav-link {
      padding-inline: 0;
      background: transparent;
    }
  }
</style>