---
import Base from "../../layouts/BaseLayout.astro";
import { render } from "astro:content";
import { Picture } from "astro:assets";
import { getProjects, slugOf, type ProjectEntry } from "../../lib/content";

export async function getStaticPaths() {
    const projects = await getProjects();
    return projects.map((project, i) => ({
        params: { slug: slugOf(project) },
        props: {
            project,
            prev: projects[i - 1] ?? null,
            next: projects[i + 1] ?? null,
        },
    }));
}

interface Props {
    project: ProjectEntry;
    prev: ProjectEntry | null;
    next: ProjectEntry | null;
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const { title, description, year, role, context, tech, scope, media } = project.data;

const gallery = media?.gallery ?? (media?.screenshot ? [media.screenshot] : []);

const facts = [
    { label: "Year", value: year },
    { label: "Role", value: role },
    { label: "Context", value: context },
    { label: "Tools", value: tech?.join(", ") },
].filter((f) => f.value);
---

<Base title={title} description={description}>
    <header class="page-head wrap">
        <a href="/projects/" class="mono muted link" data-reveal>← All projects</a>
        <h1 class="display project-title" data-split>{title}</h1>
    </header>

    <section class="wrap">
        <div class="row">
            <dl class="row__label facts mono" data-reveal>
                {
                    facts.map((f) => (
                        <div>
                            <dt class="muted">{f.label}</dt>
                            <dd>{f.value}</dd>
                        </div>
                    ))
                }
                {
                    media?.repo && (
                        <div>
                            <dt class="muted">Source</dt>
                            <dd>
                                <a href={media.repo} class="link">GitHub ↗</a>
                            </dd>
                        </div>
                    )
                }
            </dl>
            <div class="row__body">
                {description && <p class="lead" data-split>{description}</p>}
                {
                    scope && (
                        <ul class="scope mono" aria-label="Scope" data-reveal>
                            {scope.map((s) => <li>{s}</li>)}
                        </ul>
                    )
                }
            </div>
        </div>
    </section>

    {
        gallery.length > 0 && (
            <section class="gallery wrap" aria-label="Images">
                {gallery.map((img, i) => (
                    <figure class="gallery__item" data-reveal-img>
                        <Picture
                            src={img}
                            alt={`${title}, image ${i + 1}`}
                            formats={["avif", "webp"]}
                            widths={[800, 1400, 2000]}
                            sizes="(min-width: 900px) 75vw, 100vw"
                            loading={i === 0 ? "eager" : "lazy"}
                        />
                    </figure>
                ))}
            </section>
        )
    }

    <section class="section wrap">
        <div class="row">
            <p class="row__label mono muted">Notes</p>
            <div class="row__body prose" data-reveal>
                <Content />
            </div>
        </div>
    </section>

    <nav class="section wrap pager" aria-label="Project navigation">
        {
            prev && (
                <a href={`/projects/${slugOf(prev)}/`} class="pager__link row">
                    <span class="row__label mono muted">← Previous</span>
                    <span class="row__body h2">{prev.data.title}</span>
                </a>
            )
        }
        {
            next && (
                <a href={`/projects/${slugOf(next)}/`} class="pager__link row">
                    <span class="row__label mono muted">Next →</span>
                    <span class="row__body h2">{next.data.title}</span>
                </a>
            )
        }
    </nav>
</Base>

<style>
    .project-title {
        max-width: 14ch;
        font-size: clamp(2.75rem, 1rem + 7vw, 8.5rem);
    }

    .facts {
        display: grid;
        gap: 14px;
        align-content: start;
    }

    .facts dd {
        margin: 2px 0 0;
    }

    .scope {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 32px 0 0;
        padding: 0;
        list-style: none;
    }

    .scope li {
        padding: 6px 10px;
        border: 1px solid var(--line);
        border-radius: 999px;
    }

    .gallery {
        display: grid;
        gap: var(--gutter);
        margin-top: clamp(48px, 8vw, 120px);
    }

    .gallery__item {
        margin: 0;
        overflow: hidden;
    }

    /* <Picture> renders outside this component's scope, hence :global */
    .gallery__item :global(img) {
        width: 100%;
    }

    @media (min-width: 900px) {
        .gallery {
            grid-template-columns: repeat(12, minmax(0, 1fr));
        }

        .gallery__item {
            grid-column: 4 / -1;
        }

        .gallery__item:nth-child(even) {
            grid-column: 1 / span 9;
        }
    }

    .pager {
        display: grid;
    }

    .pager__link .h2 {
        padding-bottom: 14px;
        transition: transform 0.6s var(--ease);
    }

    .pager__link:hover .h2 {
        transform: translateX(12px);
    }

    .pager__link:last-child {
        border-bottom: 1px solid var(--line);
    }
</style>
