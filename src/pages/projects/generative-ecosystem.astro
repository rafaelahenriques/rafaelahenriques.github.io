---
/**
 * Generative Ecosystem case study. Same shape as Study Room: numbered
 * chapters, each ## section of index.md beside what it explains. The videos
 * are recordings of the real app driven by its own controls (growth, climate,
 * the scan window); the plates are its eight species at full bloom. The
 * ranges, places and roadmap come from the project's README and tests.
 */
import Base from "../../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import { projectSeo } from "../../lib/seo";
import Chapter from "../../components/Chapter.astro";
import ChapterNav from "../../components/ChapterNav.astro";
import LoopVideo from "../../components/LoopVideo.astro";
import Shot from "../../components/Shot.astro";
import Lightbox from "../../components/Lightbox.astro";
import NextProject from "../../components/NextProject.astro";

import heroPoster from "../../content/projects/generative-ecosystem/media/hero-poster.jpg";
import climatePoster from "../../content/projects/generative-ecosystem/media/climate-poster.jpg";
import scanPoster from "../../content/projects/generative-ecosystem/media/scan-poster.jpg";
import noMatch from "../../content/projects/generative-ecosystem/media/no-match.jpg";
import plantHedgehog from "../../content/projects/generative-ecosystem/media/plant-hedgehog.jpg";
import plantLavender from "../../content/projects/generative-ecosystem/media/plant-lavender.jpg";
import plantSunflower from "../../content/projects/generative-ecosystem/media/plant-sunflower.jpg";
import plantPeony from "../../content/projects/generative-ecosystem/media/plant-peony.jpg";
import plantTrillium from "../../content/projects/generative-ecosystem/media/plant-trillium.jpg";
import plantOrchid from "../../content/projects/generative-ecosystem/media/plant-orchid.jpg";
import plantLotus from "../../content/projects/generative-ecosystem/media/plant-lotus.jpg";
import plantPoppy from "../../content/projects/generative-ecosystem/media/plant-poppy.jpg";
import growth1 from "../../content/projects/generative-ecosystem/media/growth-1.jpg";
import growth2 from "../../content/projects/generative-ecosystem/media/growth-2.jpg";
import growth3 from "../../content/projects/generative-ecosystem/media/growth-3.jpg";
import growth4 from "../../content/projects/generative-ecosystem/media/growth-4.jpg";
import growth5 from "../../content/projects/generative-ecosystem/media/growth-5.jpg";
import boot1 from "../../content/projects/generative-ecosystem/media/boot-1.jpg";
import boot2 from "../../content/projects/generative-ecosystem/media/boot-2.jpg";
import boot3 from "../../content/projects/generative-ecosystem/media/boot-3.jpg";

const project = (await getEntry("projects", "generative-ecosystem"))!;
const { title, description, role, year, category, tech, media } = project.data;

const links = [
    { href: media?.live, title: "Grow a plant", note: "Live · hand tracking needs a webcam" },
    { href: media?.repo, title: "Code on GitHub", note: "TypeScript, GLSL, one file per species" },
].filter((l) => l.href);

// index.md split at its ## headings; each part is one chapter's text
const parts = new Map(
    (project.rendered?.html ?? "").split(/(?=<h2[\s>])/).flatMap((chunk) => {
        const heading = chunk.match(/^<h2[^>]*>([\s\S]*?)<\/h2>/);
        return heading ? [[heading[1].trim(), chunk.slice(heading[0].length)] as [string, string]] : [];
    }),
);
const t = (heading: string) => parts.get(heading);
const placed = ["Climate decides the plant", "Eight real species", "Pinch to grow", "Scan window", "Architecture", "Loading", "Roadmap", "Credits"];
// a new ## section added to index.md later still shows up, after the others
const extra = [...parts.keys()].filter((heading) => !placed.includes(heading));

// each species: its climate, the real place the tests hold it to, and its optimal ranges
const species = [
    { img: plantHedgehog, name: "Engelmann’s hedgehog cactus", latin: "Echinocereus engelmannii", climate: "Hot desert", place: "Tucson, Arizona", temperature: "20 to 34", humidity: "15 to 45", rainfall: "150 to 350", sun: "9 to 13", alt: "A clump of cactus stems in x-ray, with one magenta flower and a green stem in colour inside the scan window" },
    { img: plantLavender, name: "True lavender", latin: "Lavandula angustifolia", climate: "Mediterranean", place: "Valensole, Provence", temperature: "15 to 24", humidity: "35 to 60", rainfall: "500 to 1000", sun: "6 to 12", alt: "Thin lavender stems in x-ray, one purple flower spike in colour inside the scan window" },
    { img: plantSunflower, name: "Common sunflower", latin: "Helianthus annuus", climate: "Grassland", place: "Wichita, Kansas", temperature: "17 to 34", humidity: "35 to 70", rainfall: "600 to 1000", sun: "7 to 14", alt: "A sunflower with x-ray leaves and stem, its yellow and brown head in colour inside the scan window" },
    { img: plantPeony, name: "Chinese peony", latin: "Paeonia lactiflora", climate: "Temperate", place: "Luoyang, China", temperature: "12 to 22", humidity: "45 to 75", rainfall: "600 to 1200", sun: "5 to 10", alt: "A peony with x-ray leaves, its pale pink flower in colour inside the scan window" },
    { img: plantTrillium, name: "White trillium", latin: "Trillium grandiflorum", climate: "Forest floor", place: "Smoky Mountains", temperature: "10 to 20", humidity: "60 to 90", rainfall: "900 to 1800", sun: "0.5 to 3", alt: "A trillium on a single x-ray stem, its three white petals and green sepals in colour inside the scan window" },
    { img: plantOrchid, name: "Moth orchid", latin: "Phalaenopsis amabilis", climate: "Tropical understory", place: "Borneo", temperature: "22 to 29", humidity: "60 to 80", rainfall: "2000 to 4500", sun: "0.5 to 2.5", alt: "An arching orchid spray in x-ray, its white flowers in colour inside the scan window" },
    { img: plantLotus, name: "Sacred lotus", latin: "Nelumbo nucifera", climate: "Warm wetland", place: "Mekong Delta", temperature: "25 to 30", humidity: "55 to 90", rainfall: "2000 to 2800", sun: "6 to 13", alt: "A lotus with broad x-ray leaves, its pink flower in colour inside the scan window" },
    { img: plantPoppy, name: "Arctic poppy", latin: "Papaver radicatum", climate: "Arctic tundra", place: "Svalbard", temperature: "2 to 11", humidity: "65 to 90", rainfall: "150 to 400", sun: "4 to 12", alt: "A poppy on a thin x-ray stem, its pale yellow flower in colour inside the scan window" },
];

const stages = [
    { img: growth1, name: "Seedling", alt: "A sunflower seedling: a stub of green stem inside the scan window" },
    { img: growth2, name: "Shoot", alt: "The stem extends and the first broad leaves unfurl" },
    { img: growth3, name: "Bud", alt: "A closed sunflower head on top of the stem, with x-ray leaves below" },
    { img: growth4, name: "Opening", alt: "Yellow ray florets form a ring and start to open" },
    { img: growth5, name: "Bloom", alt: "The full sunflower head, the florets open from the rim inwards" },
];

// how a gesture reaches the screen
const pipeline = [
    { step: "Webcam", detail: "Frames stay in the browser" },
    { step: "HandTracker", detail: "ml5 HandPose, 21 landmarks per hand" },
    { step: "GestureRecognizer", detail: "The pinch and the palm’s position" },
    { step: "GestureMapper", detail: "Turns them into growth and the scan window" },
    { step: "ecosystemStore", detail: "Zustand holds the state" },
    { step: "Plant, shaders", detail: "Read the store and draw" },
];

const roadmap = [
    { phase: "Three.js environment with one static 3D plant", status: "Done" },
    { phase: "Procedural plant generation", status: "Started" },
    { phase: "Animated plant growth", status: "Done" },
    { phase: "ml5.js hand tracking", status: "Done" },
    { phase: "Gesture recognition and interaction", status: "Started" },
    { phase: "Environmental simulation", status: "Started" },
    { phase: "Multiple plants and ecosystem behaviour", status: "Planned" },
    { phase: "Custom shaders, lighting and visual polish", status: "Started" },
];
---

<Base title={title} description={description} {...projectSeo(project)}>
    <article class="ge">
        <!-- INTRO -->
        <header class="page-head wrap">
            <a href="/projects/" class="mono muted link" data-reveal>← All projects</a>
            <p class="ge-kicker mono muted" data-reveal>Other work — {category}</p>
            <h1 class="display ge-title" data-split>{title}<span class="stop" aria-hidden="true"></span></h1>
            <p class="ge-wip" data-reveal>
                <span class="wip">In progress</span>
                <span class="muted">Still being built. This page will be updated as the project develops.</span>
            </p>

            <div class="row ge-intro">
                <dl class="row__label ge-facts mono" data-reveal>
                    <div><dt class="muted">Year</dt><dd>{year}</dd></div>
                    <div><dt class="muted">Role</dt><dd>{role}</dd></div>
                    <div><dt class="muted">Stack</dt><dd>{tech?.join(", ")}</dd></div>
                </dl>
                <div class="row__body">
                    <p class="lead ge-lead" data-split>{description}</p>
                    <ul class="ge-links" data-reveal>
                        {
                            links.map((l) => (
                                <li>
                                    <a href={l.href} target="_blank" rel="noopener">
                                        <span class="ge-links__title">{l.title}</span>
                                        <span class="ge-links__note mono muted">{l.note}</span>
                                        <span class="ge-links__arrow" aria-hidden="true">↗</span>
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </header>

        <!-- HERO: from a seedling to full bloom and back -->
        <section class="wrap ge-hero" aria-label="The plant growing">
            <div class="ge-hero__video" data-reveal>
                <LoopVideo src="/media/generative-ecosystem/hero.mp4" poster={heroPoster} label="A Chinese peony grows from a seedling to full bloom and back, while the colour scan window moves over its x-ray" />
            </div>
            <p class="ge-caption mono muted" data-reveal>Recorded with the on-screen controls. With the camera on, your fingers do this.</p>
        </section>

        <Chapter id="ge-climate" num={1} title="Climate decides the plant" html={t("Climate decides the plant")}>
            <div class="ge-stack" slot="media">
                <figure class="ge-figure">
                    <LoopVideo src="/media/generative-ecosystem/climate.mp4" poster={climatePoster} label="The climate sliders move from one climate to the next, and the plant dissolves into the species that fits: peony, hedgehog cactus, arctic poppy, sacred lotus" />
                    <figcaption class="mono muted">Each slider draws the plant’s limits and best range on its track</figcaption>
                </figure>
                <Shot img={noMatch} alt="A hot, dry climate where nothing survives: the hedgehog cactus stays on show with the message: Closest match, but it would not survive here" caption="Nothing survives here: the closest plant stays on show, and says so" />
            </div>
        </Chapter>

        <!-- the optimal range of every factor, for every species -->
        <section class="wrap ge-ranges" aria-labelledby="ge-ranges-title">
            <h3 id="ge-ranges-title" class="mono muted">Optimal ranges</h3>
            <div class="ge-ranges__scroll" role="region" aria-labelledby="ge-ranges-title" tabindex="0">
                <table class="ge-table" data-reveal>
                    <thead class="mono muted">
                        <tr>
                            <th scope="col">Climate</th>
                            <th scope="col">Species</th>
                            <th scope="col">°C</th>
                            <th scope="col">Humidity %</th>
                            <th scope="col">Rain mm/yr</th>
                            <th scope="col">Sun h/day</th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            species.map((s) => (
                                <tr>
                                    <td class="mono muted">{s.climate}</td>
                                    <th scope="row">
                                        {s.name}
                                        <i>{s.latin}</i>
                                    </th>
                                    <td class="mono">{s.temperature}</td>
                                    <td class="mono">{s.humidity}</td>
                                    <td class="mono">{s.rainfall}</td>
                                    <td class="mono">{s.sun}</td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <Chapter id="ge-species" num={2} title="Eight real species" html={t("Eight real species")} fold={false} />

        <section class="wrap ge-plants" aria-label="The eight species at full bloom">
            <ul class="ge-plants__grid">
                {
                    species.map((s) => (
                        <li class="ge-plant">
                            <Shot img={s.img} alt={s.alt} sizes="(min-width: 900px) 24vw, 50vw" />
                            <p class="ge-plant__name">{s.name}</p>
                            <p class="ge-plant__place mono muted">{s.place}</p>
                        </li>
                    ))
                }
            </ul>
        </section>

        <Chapter id="ge-grow" num={3} title="Pinch to grow" html={t("Pinch to grow")} wide>
            <figure class="ge-figure ge-grow">
                <ol class="ge-stages">
                    {
                        stages.map((s, i) => (
                            <li>
                                <Shot img={s.img} alt={s.alt} caption={`0${i + 1} ${s.name}`} sizes="(min-width: 600px) 20vw, 33vw" />
                            </li>
                        ))
                    }
                </ol>
                <figcaption class="mono muted">One sunflower, five stages. Growth changes its form, and the camera keeps up.</figcaption>
            </figure>
        </Chapter>

        <Chapter id="ge-scan" num={4} title="Scan window" html={t("Scan window")}>
            <figure class="ge-figure" slot="media">
                <LoopVideo src="/media/generative-ecosystem/scan.mp4" poster={scanPoster} label="The scan window sweeps over an x-ray hedgehog cactus, showing the same plant in solid colour inside it" />
                <figcaption class="mono muted">Hide interface leaves only the plant and its window</figcaption>
            </figure>
        </Chapter>

        <Chapter id="ge-architecture" num={5} title="Architecture" html={t("Architecture")} side="left">
            <ol class="ge-pipeline" slot="media" aria-label="From the webcam to the screen">
                {
                    pipeline.map((p, i) => (
                        <li>
                            <span class="mono muted">0{i + 1}</span>
                            <strong class="mono">{p.step}</strong>
                            <span class="muted">{p.detail}</span>
                        </li>
                    ))
                }
            </ol>
        </Chapter>

        <Chapter id="ge-loading" num={6} title="Loading" html={t("Loading")}>
            <div class="ge-stack" slot="media">
                <Shot img={boot2} alt="The loading screen at 66 percent: a stippled flower sharpening from coarse blocks to fine dots, beside a log of measured steps" caption="66%: the flower sharpens as the real work finishes" />
                <div class="ge-pair">
                    <Shot img={boot1} alt="The loading screen at 26 percent, the flower still in coarse blocks" caption="26%" sizes="(min-width: 900px) 25vw, 50vw" />
                    <Shot img={boot3} alt="The loading screen at 100 percent, the flower in fine dots and a scan line starting to sweep down" caption="100%: the sweep begins" sizes="(min-width: 900px) 25vw, 50vw" />
                </div>
            </div>
        </Chapter>

        <Chapter id="ge-roadmap" num={7} title="Roadmap" html={t("Roadmap")} side="left" fold={false}>
            <ol class="ge-roadmap" slot="media">
                {
                    roadmap.map((r, i) => (
                        <li>
                            <span class="mono muted">{i + 1}</span>
                            <span>{r.phase}</span>
                            <span class:list={["mono", { muted: r.status !== "Done" }]}>{r.status}</span>
                        </li>
                    ))
                }
            </ol>
        </Chapter>

        <Chapter id="ge-credits" num={8} title="Credits" html={t("Credits")} fold={false} />
        {extra.map((heading, i) => <Chapter id={`ge-extra-${i}`} num={9 + i} title={heading} html={t(heading)} />)}

        <!-- OPEN IT -->
        {
            media?.live && (
                <section class="wrap ge-open" aria-label="Open the plant">
                    <a href={media.live} class="ge-cta" target="_blank" rel="noopener">
                        <span class="mono muted">The camera stays off until you press Start hand tracking</span>
                        <span class="ge-cta__title">Grow a plant <span class="ge-cta__arrow" aria-hidden="true">↗</span></span>
                    </a>
                </section>
            )
        }
    </article>

    <ChapterNav />
    <NextProject current="generative-ecosystem" />
    <Lightbox />
</Base>

<style>
    .ge {
        overflow-x: clip;
        padding-bottom: var(--section);
    }

    /* --- INTRO --- */

    .ge-kicker {
        margin: 24px 0 0;
    }

    .ge-title {
        font-size: clamp(3rem, 1rem + 8vw, 9.5rem);
    }

    .ge-wip {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 14px;
        margin: clamp(20px, 3vw, 32px) 0 0;
        font-size: var(--fs-small);
    }

    .ge-intro {
        margin-top: clamp(32px, 5vw, 64px);
    }

    .ge-facts {
        display: grid;
        gap: 14px;
        align-content: start;
        margin: 0;
    }

    .ge-facts dd {
        margin: 2px 0 0;
    }

    .ge-lead {
        max-width: 34ch;
    }

    /* links: what each one is, spelled out */
    .ge-links {
        max-width: 640px;
        margin: clamp(32px, 4vw, 48px) 0 0;
        padding: 0;
        list-style: none;
        border-bottom: 1px solid var(--line);
    }

    .ge-links a {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 2px 16px;
        padding-block: 14px;
        border-top: 1px solid var(--line);
    }

    .ge-links__title {
        font-size: var(--fs-body);
    }

    .ge-links__note {
        grid-row: 2;
    }

    .ge-links__arrow {
        grid-row: 1 / span 2;
        align-self: center;
        transition: transform 0.2s var(--step);
    }

    .ge-links a:hover .ge-links__arrow,
    .ge-links a:focus-visible .ge-links__arrow {
        transform: translate(4px, -4px);
    }

    /* --- HERO --- */

    .ge-hero {
        display: grid;
        justify-items: center;
        gap: 12px;
        margin-top: clamp(40px, 6vw, 88px);
    }

    .ge-hero__video {
        /* the whole interface stays on screen */
        width: min(100%, calc((100svh - var(--header-h) - 120px) * 1.6));
    }

    .ge-caption {
        margin: 0;
        text-align: center;
    }

    /* --- what sits beside the chapters --- */

    .ge-stack {
        display: grid;
        gap: clamp(24px, 3vw, 40px);
    }

    .ge-figure {
        display: grid;
        gap: 12px;
        margin: 0;
    }

    .ge-pair {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(12px, 1.6vw, 20px);
    }

    /* --- the optimal ranges --- */

    .ge-ranges {
        margin-top: clamp(40px, 6vw, 80px);
    }

    .ge-ranges h3 {
        margin: 0 0 12px;
        font-weight: 400;
    }

    /* on a phone the table scrolls sideways rather than squashing */
    .ge-ranges__scroll {
        overflow-x: auto;
    }

    .ge-ranges__scroll:focus-visible {
        outline: 1px solid var(--blue);
        outline-offset: 4px;
    }

    .ge-table {
        width: 100%;
        min-width: 760px;
        border-collapse: collapse;
        border-top: 1px solid var(--text);
    }

    .ge-table th,
    .ge-table td {
        padding: 12px 16px 12px 0;
        border-bottom: 1px solid var(--line);
        font-weight: 400;
        text-align: left;
        vertical-align: baseline;
        white-space: nowrap;
    }

    .ge-table tbody th {
        font-weight: 500;
    }

    .ge-table tbody th i {
        display: block;
        margin-top: 2px;
        color: var(--muted);
        font-size: var(--fs-small);
        font-weight: 400;
    }

    /* --- the eight plants --- */

    .ge-plants {
        margin-top: clamp(32px, 4vw, 56px);
    }

    .ge-plants__grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(24px, 3vw, 40px) clamp(12px, 1.6vw, 20px);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .ge-plant__name {
        margin: 12px 0 2px;
        font-size: var(--fs-small);
        font-weight: 500;
        line-height: 1.2;
    }

    .ge-plant__place {
        margin: 0;
    }

    @media (min-width: 900px) {
        .ge-plants__grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    /* --- the growth stages --- */

    .ge-grow {
        margin-top: clamp(32px, 4vw, 56px);
    }

    .ge-stages {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 8px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    @media (max-width: 599px) {
        .ge-stages {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px 8px;
        }
    }

    /* --- from the webcam to the screen; the roadmap --- */

    .ge-pipeline,
    .ge-roadmap {
        display: grid;
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--text);
    }

    .ge-pipeline li,
    .ge-roadmap li {
        display: grid;
        align-items: baseline;
        gap: 4px 12px;
        padding-block: 12px;
        border-bottom: 1px solid var(--line);
    }

    .ge-pipeline li {
        grid-template-columns: 2.5rem minmax(0, 11rem) minmax(0, 1fr);
    }

    .ge-pipeline strong {
        font-weight: 400;
    }

    .ge-pipeline span:last-child {
        font-size: var(--fs-small);
    }

    .ge-roadmap li {
        grid-template-columns: 1.5rem minmax(0, 1fr) auto;
    }

    @media (max-width: 599px) {
        .ge-pipeline li {
            grid-template-columns: 2.5rem minmax(0, 1fr);
        }

        .ge-pipeline span:last-child {
            grid-column: 2;
        }
    }

    /* --- OPEN IT --- */

    .ge-open {
        padding-top: calc(var(--section) * 1.4);
    }

    .ge-cta {
        display: grid;
        gap: 14px;
        padding-block: 14px clamp(24px, 3vw, 40px);
        border-block: 1px solid var(--line);
    }

    .ge-cta__title {
        font-family: var(--display);
        font-size: var(--fs-display);
        font-weight: 800;
        line-height: 0.95;
        letter-spacing: -0.055em;
        text-transform: lowercase;
    }

    .ge-cta__arrow {
        display: inline-block;
        transition: transform 0.2s var(--step);
    }

    .ge-cta:hover .ge-cta__arrow,
    .ge-cta:focus-visible .ge-cta__arrow {
        transform: translate(0.12em, -0.12em);
    }
</style>
