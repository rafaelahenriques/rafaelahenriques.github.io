---
/**
 * Study Room case study. Same shape as Mongmo: parts and numbered chapters,
 * each ## section of index.md beside what it explains. The visuals are
 * recordings of the real room (a day as a timelapse, dragging on the rain,
 * the monitor typing the shader, the physics, a doodle, spilled coffee, the
 * calendar), the clickable hotspots, stills of its weather, the
 * Blender render and AO atlas, and a few things drawn in HTML: the asset
 * pipeline, a glass pane that shows Shadertoy's iMouse as you drag, what
 * happens when a service is down, and the performance numbers.
 */
import Base from "../../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import { pad } from "../../lib/content";
import { projectSeo } from "../../lib/seo";
import Chapter from "../../components/Chapter.astro";
import ChapterNav from "../../components/ChapterNav.astro";
import LoopVideo from "../../components/LoopVideo.astro";
import Shot from "../../components/Shot.astro";
import Lightbox from "../../components/Lightbox.astro";
import NextProject from "../../components/NextProject.astro";

import timelapsePoster from "../../content/projects/study-room/media/timelapse-poster.jpg";
import rainPoster from "../../content/projects/study-room/media/rain-poster.jpg";
import monitorPoster from "../../content/projects/study-room/media/monitor-poster.jpg";
import physicsPoster from "../../content/projects/study-room/media/physics-poster.jpg";
import doodlePoster from "../../content/projects/study-room/media/doodle-poster.jpg";
import coffeePoster from "../../content/projects/study-room/media/coffee-poster.jpg";
import calendarPoster from "../../content/projects/study-room/media/calendar-poster.jpg";
import hints from "../../content/projects/study-room/media/hints.jpg";
import blenderRender from "../../content/projects/study-room/media/blender-render.jpg";
import aoAtlas from "../../content/projects/study-room/media/ao-atlas.jpg";
import roomRain from "../../content/projects/study-room/media/room-day-rain.jpg";
import roomNight from "../../content/projects/study-room/media/room-night.jpg";
import roomSnow from "../../content/projects/study-room/media/room-snow.jpg";
import share from "../../content/projects/study-room/media/share.jpg";

const project = (await getEntry("projects", "study-room"))!;
const { title, description, role, year, category, context, order, tech, media } = project.data;

const links = [
    { href: media?.live, title: "Open the room", note: "Live · needs a WebGPU browser" },
    { href: media?.repo, title: "Code on GitHub", note: "Blender scripts, WGSL ports, web app, firmware" },
].filter((l) => l.href);

// index.md split at its ## headings; each part is one chapter's text
const parts = new Map(
    (project.rendered?.html ?? "").split(/(?=<h2[\s>])/).flatMap((chunk) => {
        const heading = chunk.match(/^<h2[^>]*>([\s\S]*?)<\/h2>/);
        return heading ? [[heading[1].trim(), chunk.slice(heading[0].length)] as [string, string]] : [];
    }),
);
const t = (heading: string) => parts.get(heading);
const placed = [
    "The challenge",
    "Building the room",
    "Porting the shader",
    "Bringing the room to life",
    "Things to try",
    "Technical decisions",
    "Performance",
    "Next steps",
    "Credits",
];
// a new ## section added to index.md later still shows up, after the others
const extra = [...parts.keys()].filter((heading) => !placed.includes(heading));

const pipeline = [
    { step: "Blender", detail: "Room, props, ten animation clips" },
    { step: "Cycles AO bake", detail: "One 2048² atlas" },
    { step: "GLB", detail: "The scene, 4.1 MB" },
    { step: "Three.js", detail: "WebGPU, live lighting, shaders, physics" },
    { step: "Netlify", detail: "Redeploys on every push" },
];

const fallbacks = [
    { missing: "WebGPU", result: "A clear message, instead of shaders that can’t run" },
    { missing: "Weather · Open-Meteo", result: "Manual weather values, and the panel says so" },
    { missing: "Music · Audius", result: "The error shows in the interface; the room carries on" },
    { missing: "Baked AO atlas", result: "The room still renders, without contact shadows" },
];

const stats = [
    { value: "8.3", unit: "ms", label: "Median frame time" },
    { value: "9.2", unit: "ms", label: "95th-percentile frame time" },
    { value: "120", unit: "FPS", label: "Observed frame rate", note: "Display-capped" },
    { value: "468", unit: "", label: "Draw calls per frame", note: "Including the shadow pass" },
    { value: "152k", unit: "", label: "Triangles" },
    { value: "4.1", unit: "MB", label: "GLB size" },
    { value: "300", unit: "KB", label: "AO atlas" },
];
---

<Base title={title} description={description} {...projectSeo(project)} image={share}>
    <article class="sr">
        <!-- INTRO -->
        <header class="page-head wrap">
            <a href="/projects/" class="mono muted link" data-reveal>← All projects</a>
            <p class="sr-kicker mono muted" data-reveal>{pad(order ?? 5)} — {category}</p>
            <h1 class="display sr-title" data-split>{title}</h1>

            <div class="row sr-intro">
                <dl class="row__label sr-facts mono" data-reveal>
                    <div><dt class="muted">Year</dt><dd>{year}</dd></div>
                    <div><dt class="muted">Role</dt><dd>{role}</dd></div>
                    <div><dt class="muted">Context</dt><dd>{context}</dd></div>
                    <div><dt class="muted">Stack</dt><dd>{tech?.join(", ")}</dd></div>
                </dl>
                <div class="row__body">
                    <p class="lead sr-lead" data-split>{description}</p>
                    <ul class="sr-links" data-reveal>
                        {
                            links.map((l) => (
                                <li>
                                    <a href={l.href} target="_blank" rel="noopener">
                                        <span class="sr-links__title">{l.title}</span>
                                        <span class="sr-links__note mono muted">{l.note}</span>
                                        <span class="sr-links__arrow" aria-hidden="true">↗</span>
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </header>

        <!-- HERO: one day in the room -->
        <section class="wrap sr-hero" aria-label="One day in the room">
            <div class="sr-hero__video" data-reveal data-sr-hero>
                <LoopVideo src="/media/study-room/timelapse.mp4" poster={timelapsePoster} label="One day in the room, from 05:00 to 23:30: the sky, the sun and the lamps follow the hour" />
            </div>
            <p class="sr-hero__caption" data-reveal>
                <span class="mono muted">Room time</span>
                <strong class="sr-hero__clock" data-sr-clock aria-hidden="true">05:00</strong>
                <span class="muted">One day in twelve seconds. The sun, the sky and every lamp follow the hour.</span>
            </p>
        </section>

        <!-- ============ PART 1 ============ -->
        <div class="sr-part-wrap wrap" data-reveal data-part="The room">
            <p class="sr-part mono">The room</p>
        </div>

        <Chapter id="sr-challenge" num={1} title="The challenge" html={t("The challenge")}>
            <figure class="sr-stage" slot="media">
                <div class="sr-video sr-video--tall">
                    <LoopVideo src="/media/study-room/rain.mp4" poster={rainPoster} label="Dragging on the window: up for heavier rain and fog, down to clear it, then letting go" />
                </div>
                <figcaption class="mono muted">Hold and drag on the glass. Let go, and the live weather takes over again.</figcaption>
            </figure>
        </Chapter>

        <Chapter id="sr-building" num={2} title="Building the room" html={t("Building the room")} side="left">
            <div class="sr-building" slot="media">
                <ol class="sr-pipeline" aria-label="Pipeline" data-sr-diagram>
                    {
                        pipeline.map((p, i) => (
                            <li class="sr-pipeline__step">
                                <span class="mono muted">{pad(i + 1)}</span>
                                <strong>{p.step}</strong>
                                <span class="muted">{p.detail}</span>
                            </li>
                        ))
                    }
                </ol>
                <div class="sr-pair">
                    <Shot img={blenderRender} alt="The room rendered in Blender: desk, monitor, shelves, easel and window, in sage green and terracotta" caption="Blender look-dev render" sizes="(min-width: 900px) 25vw, 50vw" />
                    <Shot img={aoAtlas} alt="The baked ambient occlusion atlas: soft grey shadows of the floor, walls and furniture laid out flat" caption="Baked AO atlas · 2048² · 300 KB" sizes="(min-width: 900px) 25vw, 50vw" />
                </div>
            </div>
        </Chapter>

        <!-- ============ PART 2 ============ -->
        <div class="sr-part-wrap wrap" data-reveal data-part="The shader">
            <p class="sr-part mono">The shader</p>
        </div>

        <Chapter id="sr-shader" num={3} title="Porting the shader" html={t("Porting the shader")}>
            <div class="sr-shader" slot="media">
                <figure class="sr-stage sr-stage--dark">
                    <div class="sr-video sr-video--wide">
                        <LoopVideo src="/media/study-room/monitor.mp4" poster={monitorPoster} label="The room's own monitor typing out the WGSL port of Heartfelt" />
                    </div>
                    <figcaption class="mono">The room’s monitor types out the port</figcaption>
                </figure>

                <figure class="sr-imouse">
                    <div
                        class="sr-pane"
                        data-sr-pane
                        role="img"
                        aria-label="A small window pane: hold and drag on it to see how Shadertoy's iMouse drives the rain"
                    >
                        <canvas class="sr-pane__canvas" data-sr-pane-canvas></canvas>
                        <span class="sr-pane__hint mono" data-sr-pane-hint>Hold and drag</span>
                    </div>
                    <dl class="sr-readout mono" aria-live="off">
                        <div><dt>iMouse.z</dt><dd data-sr-z>0 · not pressed</dd></div>
                        <div><dt>rainAmount</dt><dd data-sr-rain>0.30 · weather</dd></div>
                        <div><dt>T offset</dt><dd data-sr-time>+0.00 s</dd></div>
                    </dl>
                    <figcaption class="mono muted">Up and down is M.y, the rain; left and right is M.x, time.</figcaption>
                </figure>
            </div>
        </Chapter>

        <!-- ============ PART 3 ============ -->
        <div class="sr-part-wrap wrap" data-reveal data-part="Making it live">
            <p class="sr-part mono">Making it live</p>
        </div>

        <Chapter id="sr-life" num={4} title="Bringing the room to life" html={t("Bringing the room to life")} side="left">
            <div class="sr-life" slot="media">
                <figure class="sr-stage sr-stage--room">
                    <div class="sr-video sr-video--square">
                        <LoopVideo src="/media/study-room/physics.mp4" poster={physicsPoster} label="Paper balls thrown towards the bin, then the books knocked off the shelves, with Rapier physics" />
                    </div>
                    <figcaption class="mono muted">Rapier: paper balls, then the books</figcaption>
                </figure>
                <div class="sr-trio">
                    <Shot img={roomRain} alt="The room on a rainy morning, the lamp on and drops on the window" caption="Rain · 11:00" sizes="(min-width: 900px) 16vw, 33vw" />
                    <Shot img={roomNight} alt="The room at night, lit by the lamp, string lights and monitor, a dark blue sky outside" caption="Clear · 21:30" sizes="(min-width: 900px) 16vw, 33vw" />
                    <Shot img={roomSnow} alt="The room on a snowy afternoon, snow falling and white roofs outside the window" caption="Snow · 16:00" sizes="(min-width: 900px) 16vw, 33vw" />
                </div>
            </div>
        </Chapter>

        <Chapter id="sr-try" num={5} title="Things to try" html={t("Things to try")} fold={false}>
            <Shot slot="media" img={hints} alt="The room with every clickable object marked by a dot and a label: Clock, Drag for rain, Books, Spin, Screen, Lamp, Throw paper, Coffee, Next day, Doodle, Drawers" caption="What can I click? Every hotspot at once" sizes="(min-width: 900px) 50vw, 100vw" />
        </Chapter>

        <section class="wrap sr-try" aria-label="Things to try, recorded">
            <figure class="sr-try__item sr-try__item--main">
                <LoopVideo src="/media/study-room/doodle.mp4" poster={doodlePoster} label="Doodling on the easel: the camera flies to the canvas, a sun, hills, a house and two birds are drawn, then Done steps back" />
                <figcaption class="mono muted">Easel · doodle mode</figcaption>
            </figure>
            <figure class="sr-try__item">
                <LoopVideo src="/media/study-room/coffee.mp4" poster={coffeePoster} label="Hovering over the mug shows Spill the coffee; it tips over and the puddle ripples" />
                <figcaption class="mono muted">Mug · the third shader port</figcaption>
            </figure>
            <figure class="sr-try__item">
                <LoopVideo src="/media/study-room/calendar.mp4" poster={calendarPoster} label="Pressing the calendar twice: the page flips to the next day and the room's light dips through a day change" />
                <figcaption class="mono muted">Calendar · next day</figcaption>
            </figure>
        </section>

        <Chapter id="sr-decisions" num={6} title="Technical decisions" html={t("Technical decisions")} fold={false}>
            <figure class="sr-diagram" slot="media" data-sr-diagram>
                <div class="sr-table" role="table" aria-label="What happens when a part is unavailable">
                    <div class="sr-table__row sr-table__row--head mono" role="row">
                        <span role="columnheader">If this is unavailable</span>
                        <span role="columnheader">The room</span>
                    </div>
                    {
                        fallbacks.map((f) => (
                            <div class="sr-table__row" role="row">
                                <span role="cell" class="mono">{f.missing}</span>
                                <span role="cell">{f.result}</span>
                            </div>
                        ))
                    }
                </div>
                <figcaption class="mono muted">Tested with each one switched off</figcaption>
            </figure>
        </Chapter>

        <Chapter id="sr-performance" num={7} title="Performance" html={t("Performance")} side="left" fold={false}>
            <figure class="sr-diagram" slot="media" data-sr-diagram>
                <ul class="sr-stats">
                    {
                        stats.map((s) => (
                            <li class="sr-stat">
                                <span class="sr-stat__value">
                                    {s.value}
                                    {s.unit && <small>{s.unit}</small>}
                                </span>
                                <span class="sr-stat__label">
                                    {s.label}
                                    {s.note && <span class="muted"> · {s.note}</span>}
                                </span>
                            </li>
                        ))
                    }
                </ul>
                <figcaption class="mono muted">Apple M4 · Chromium 152 · WebGPU · 1360 × 918</figcaption>
            </figure>
        </Chapter>

        <!-- ============ PART 4 ============ -->
        <div class="sr-part-wrap wrap" data-reveal data-part="Looking back">
            <p class="sr-part mono">Looking back</p>
        </div>

        <Chapter id="sr-next" num={8} title="Next steps" html={t("Next steps")} fold={false} />
        <Chapter id="sr-credits" num={9} title="Credits" html={t("Credits")} fold={false} />
        {extra.map((heading, i) => <Chapter id={`sr-extra-${i}`} num={10 + i} title={heading} html={t(heading)} />)}

        <!-- OPEN IT -->
        {
            media?.live && (
                <section class="wrap sr-open" aria-label="Open the room">
                    <a href={media.live} class="sr-cta" target="_blank" rel="noopener">
                        <span class="mono muted">Needs WebGPU: a recent Chrome or Edge, Safari 26+, or Firefox 141+ on Windows</span>
                        <span class="sr-cta__title">Open the room <span class="sr-cta__arrow" aria-hidden="true">↗</span></span>
                    </a>
                </section>
            )
        }
    </article>

    <ChapterNav />
    <NextProject current="study-room" />
    <Lightbox />
</Base>

<script>
    import { gsap } from "gsap";

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // --- hero: the room's clock, read from where the timelapse is ---
    // the recording holds 05:00 for 0.7 s, then runs to 23:30 over 12 s
    const hero = document.querySelector<HTMLElement>("[data-sr-hero]");
    const clock = document.querySelector<HTMLElement>("[data-sr-clock]");
    const video = hero?.querySelector("video");
    if (video && clock) {
        const hourAt = (s: number) => 5 + 18.5 * Math.min(1, Math.max(0, (s - 0.7) / 12));
        const show = () => {
            const minutes = Math.round(hourAt(video.currentTime) * 60);
            clock.textContent = `${String(Math.floor(minutes / 60) % 24).padStart(2, "0")}:${String(minutes % 60).padStart(2, "0")}`;
        };
        const tick = () => {
            show();
            if (!video.paused) requestAnimationFrame(tick);
        };
        video.addEventListener("play", () => requestAnimationFrame(tick));
        video.addEventListener("seeked", show);
    }

    // --- diagrams build up the first time they come into view ---
    if (!reduceMotion) {
        const io = new IntersectionObserver(
            (entries) =>
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    io.unobserve(entry.target);
                    const items = entry.target.querySelectorAll(".sr-pipeline__step, .sr-table__row, .sr-stat");
                    gsap.from(items, { autoAlpha: 0, y: 14, duration: 0.7, ease: "expo.out", stagger: 0.08 });
                }),
            { threshold: 0.3 },
        );
        document.querySelectorAll("[data-sr-diagram]").forEach((d) => io.observe(d));
    }

    // --- the glass pane: Shadertoy's iMouse, as the port reads it ---
    const pane = document.querySelector<HTMLElement>("[data-sr-pane]");
    if (pane) {
        const canvas = pane.querySelector<HTMLCanvasElement>("[data-sr-pane-canvas]")!;
        const hint = pane.querySelector<HTMLElement>("[data-sr-pane-hint]")!;
        const out = {
            z: document.querySelector<HTMLElement>("[data-sr-z]")!,
            rain: document.querySelector<HTMLElement>("[data-sr-rain]")!,
            time: document.querySelector<HTMLElement>("[data-sr-time]")!,
        };
        const g = canvas.getContext("2d")!;
        const WEATHER_RAIN = 0.3; // what the "live weather" says while nobody touches the glass

        // iMouse: x, y from the bottom-left in 0–1, z > 0 while pressed (like M in the shader)
        const mouse = { x: 0, y: 0, down: false };
        let rain = WEATHER_RAIN; // eased, like the room does
        let fog = 0.15;

        // a fixed set of drops, from a seeded random so they don't jump around
        let seed = 7;
        const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
        const drops = Array.from({ length: 140 }, () => ({ x: rand(), y: rand(), r: 1.6 + rand() * 3.2, speed: 0.01 + rand() * 0.05 }));

        let w = 0;
        let h = 0;
        const resize = () => {
            const dpr = Math.min(window.devicePixelRatio, 2);
            w = pane.clientWidth;
            h = pane.clientHeight;
            canvas.width = Math.round(w * dpr);
            canvas.height = Math.round(h * dpr);
            g.setTransform(dpr, 0, 0, dpr, 0, 0);
            draw(performance.now() / 1000);
        };

        const draw = (seconds: number) => {
            // T = iTime + M.x * 2.0
            const T = seconds + (mouse.down ? mouse.x * 2 : 0);
            // outside: sky, hills, roofs
            const sky = g.createLinearGradient(0, 0, 0, h);
            sky.addColorStop(0, "#c9d3d8");
            sky.addColorStop(1, "#e4e2dc");
            g.fillStyle = sky;
            g.fillRect(0, 0, w, h);
            g.fillStyle = "#b9c6b6";
            g.beginPath();
            g.moveTo(0, h * 0.66);
            g.quadraticCurveTo(w * 0.3, h * 0.52, w * 0.6, h * 0.63);
            g.quadraticCurveTo(w * 0.85, h * 0.7, w, h * 0.6);
            g.lineTo(w, h);
            g.lineTo(0, h);
            g.fill();
            // a row of houses: [left, width, wall height, roof height] as fractions
            const houses = [
                [0.04, 0.16, 0.14, 0.1],
                [0.24, 0.12, 0.1, 0.08],
                [0.52, 0.18, 0.16, 0.11],
                [0.78, 0.13, 0.12, 0.08],
            ];
            for (const [x, hw, wall, roof] of houses) {
                const left = x * w;
                const right = (x + hw) * w;
                const eaves = h * (1 - wall);
                g.fillStyle = "#d9cfc4";
                g.fillRect(left, eaves, right - left, h - eaves);
                g.fillStyle = "#c27a5e";
                g.beginPath();
                g.moveTo(left - hw * w * 0.06, eaves);
                g.lineTo((left + right) / 2, eaves - roof * h);
                g.lineTo(right + hw * w * 0.06, eaves);
                g.fill();
            }
            // fog on the glass
            g.fillStyle = `rgba(236, 238, 238, ${0.25 + fog * 0.55})`;
            g.fillRect(0, 0, w, h);
            // drops: more of them the more it rains, sliding down with T
            const count = Math.round(rain * drops.length);
            for (let i = 0; i < count; i++) {
                const d = drops[i];
                const y = (((d.y + T * d.speed) % 1) + 1) % 1;
                const r = d.r * (0.7 + rain * 0.6);
                const x = d.x * w;
                const py = y * h;
                // a bead of water: darker rim below, a highlight above
                g.beginPath();
                g.arc(x, py, r, 0, Math.PI * 2);
                g.fillStyle = "rgba(120, 132, 136, 0.28)";
                g.fill();
                g.beginPath();
                g.arc(x, py - r * 0.18, r * 0.78, 0, Math.PI * 2);
                g.fillStyle = "rgba(255, 255, 255, 0.5)";
                g.fill();
                g.beginPath();
                g.arc(x - r * 0.3, py - r * 0.38, r * 0.22, 0, Math.PI * 2);
                g.fillStyle = "rgba(255, 255, 255, 0.95)";
                g.fill();
            }
            // the pointer, while it's on the glass
            if (mouse.down) {
                const px = mouse.x * w;
                const py = (1 - mouse.y) * h;
                g.beginPath();
                g.arc(px, py, 11, 0, Math.PI * 2);
                g.fillStyle = "rgba(255, 255, 255, 0.35)";
                g.fill();
                g.lineWidth = 2;
                g.strokeStyle = "#fff";
                g.stroke();
            }
        };

        const readout = () => {
            out.z.textContent = mouse.down ? "1 · pressed" : "0 · not pressed";
            // rainAmount = select(weatherRain, M.y, iMouse.z > 0.0)
            out.rain.textContent = mouse.down ? `${mouse.y.toFixed(2)} · M.y` : `${WEATHER_RAIN.toFixed(2)} · weather`;
            out.time.textContent = `${mouse.down ? "+" + (mouse.x * 2).toFixed(2) : "+0.00"} s`;
        };

        const place = (e: PointerEvent) => {
            const b = pane.getBoundingClientRect();
            mouse.x = Math.min(1, Math.max(0, (e.clientX - b.left) / b.width));
            mouse.y = Math.min(1, Math.max(0, 1 - (e.clientY - b.top) / b.height));
        };

        pane.addEventListener("pointerdown", (e) => {
            mouse.down = true;
            try {
                pane.setPointerCapture(e.pointerId); // keep the drag even if the pointer leaves the pane
            } catch {
                /* already released: dragging still works without capture */
            }
            place(e);
            hint.hidden = true;
            readout();
            kick();
        });
        pane.addEventListener("pointermove", (e) => {
            if (!mouse.down) return;
            place(e);
            readout();
            kick();
        });
        const release = () => {
            mouse.down = false;
            readout();
            kick();
        };
        pane.addEventListener("pointerup", release);
        pane.addEventListener("pointercancel", release);

        // animate while on screen; with reduced motion, settle at once and redraw on input
        let visible = false;
        let running = false;
        let last = performance.now();
        const frame = (now: number) => {
            const dt = Math.min(0.05, (now - last) / 1000);
            last = now;
            const rainTarget = mouse.down ? mouse.y : WEATHER_RAIN;
            // fogTarget = max(fog, 0.6 + 0.4 * M.y) while dragging, as in rain.ts
            const fogTarget = mouse.down ? 0.6 + 0.4 * mouse.y : 0.15;
            rain += (rainTarget - rain) * (1 - Math.exp(-dt * 6));
            fog += (fogTarget - fog) * (1 - Math.exp(-dt * (mouse.down ? 4 : 1.5)));
            draw(now / 1000);
            if (visible && !reduceMotion) requestAnimationFrame(frame);
            else running = false;
        };
        const kick = () => {
            if (reduceMotion) {
                rain = mouse.down ? mouse.y : WEATHER_RAIN;
                fog = mouse.down ? 0.6 + 0.4 * mouse.y : 0.15;
                draw(0);
                return;
            }
            if (running || !visible) return;
            running = true;
            last = performance.now();
            requestAnimationFrame(frame);
        };

        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
            if (visible) kick();
        }).observe(pane);
        new ResizeObserver(resize).observe(pane);
    }
</script>

