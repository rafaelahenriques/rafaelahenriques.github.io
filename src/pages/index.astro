---
import Base from "../layouts/BaseLayout.astro";
import ProjectGameBoy from "../components/ProjectGameBoy.astro";
import PixelEdge from "../components/PixelEdge.astro";
import ReelIntro from "../components/ReelIntro.astro";
import { Image, getImage } from "astro:assets";
import babyPhoto from "../assets/me/rafaela-2006.jpg";
import reelPoster from "../assets/showreel/poster.jpg";
import { getFeatured } from "../lib/content";
import { websiteSchema } from "../lib/seo";

const featured = await getFeatured();
const REEL = "/media/showreel/showreel-2026.mp4";
const REEL_SMALL = "/media/showreel/showreel-2026-small.mp4";
const posterSrc = (await getImage({ src: reelPoster, width: 1600, format: "webp", quality: 78 })).src;
---

<Base
    title="Home"
    description="Rafaela Henriques is a web developer in Kortrijk, Belgium: full-stack, mobile and interactive projects, and a Digital Design & Development student at Howest."
    schema={[websiteSchema()]}
>
    <!-- the first visit of a session opens on the showreel (ReelIntro), in place
         of the loading screen; never with reduced motion. Runs before the
         layout's own script, which then sees the loader as done -->
    <script is:inline slot="head">
        (() => {
            try {
                if (sessionStorage.getItem("loader-seen") === "1" || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
                const root = document.documentElement;
                root.classList.add("is-reel");
                sessionStorage.setItem("loader-seen", "1");
                // in case its script never runs: the page after 9 s
                window.__reelFailsafe = setTimeout(() => {
                    root.classList.remove("is-reel");
                    dispatchEvent(new Event("reel:done"));
                }, 9000);
            } catch {}
        })();
    </script>
    <ReelIntro src={REEL} srcSmall={REEL_SMALL} />

    <!-- HELLO: a poster. My name huge, me in 2006 over it -->
    <section class="hero wrap" aria-labelledby="intro">

        <figure class="hero__photo photo" data-cursor="2006">
            <div class="hero__frame" data-reveal-img>
                <Image
                    src={babyPhoto}
                    alt="Rafaela as a little girl in a party hat"
                    widths={[300, 600, 900]}
                    sizes="(min-width: 900px) 16vw, 50vw"
                    loading="eager"
                />
            </div>
        </figure>

        <h1 id="intro" class="hero__name display" data-rise>
            <span class="hero__line"><span data-rise-line>Rafaela</span></span>
            <span class="hero__line hero__line--2"><span data-rise-line>Henriques<span class="stop" aria-hidden="true"></span></span></span>
            <span class="visually-hidden"> — web developer</span>
        </h1>

        <p class="hero__note dash" data-reveal>
            Web developer working across <b>full-stack, mobile and data</b> —
        </p>
        <p class="hero__tech mono" data-decode>
            <span aria-hidden="true">→</span> Python · TypeScript · React · FastAPI · PostgreSQL · React Native
        </p>
        <div class="hero__note hero__note--right dash" data-reveal>
            <p>with a background in <b>game development and design</b>.</p>
            <a href="/about/" class="mono link">More about me →</a>
        </div>
    </section>

    <!-- SHOWREEL: the projects in 46 seconds, cut to music. Scrolling, it grows
         until it fills the screen, then shrinks back; it plays, with sound,
         when it's asked to -->
    <section class="reel" aria-labelledby="reel" data-reel>
        <div class="wrap">
            <div class="reel__head">
                <h2 id="reel" class="mono muted">Showreel 2026</h2>
                <p class="mono muted">0:46</p>
            </div>
        </div>
        <div class="reel__track" data-reel-track>
            <div class="reel__stage">
                <div class="reel__frame" data-reel-frame>
                    <video
                        class="reel__video"
                        playsinline
                        preload="none"
                        poster={posterSrc}
                        width="1920"
                        height="1080"
                        aria-label="Showreel 2026: my name types out, then Study Room, Generative Flora, the Halloween Google Doodle, Marina Yee, Mongmo, Ben & Jerry’s: A Farm in the Pint and Miles & Meals, cut to music"
                        data-reel-video
                    >
                        <source src={REEL_SMALL} type="video/mp4" media="(max-width: 700px)" />
                        <source src={REEL} type="video/mp4" />
                    </video>
                    <button type="button" class="reel__play" data-reel-play>
                        <svg viewBox="0 0 7 7" width="28" height="28" aria-hidden="true" shape-rendering="crispEdges">
                            <path d="M0 0h2v7H0zM2 1h2v5H2zM4 2h2v3H4zM6 3h1v1H6z" fill="currentColor" />
                        </svg>
                        <span class="reel__play-text">
                            <span class="reel__play-title" data-reel-play-title>Play showreel</span>
                            <span class="reel__play-meta mono">With sound · 0:46</span>
                        </span>
                    </button>
                    <div class="reel__bar mono">
                        <span class="reel__buttons">
                            <button type="button" class="reel__btn" data-reel-pause>Pause</button>
                            <button type="button" class="reel__btn" aria-pressed="true" data-reel-sound>Sound on</button>
                        </span>
                        <span class="reel__credit">
                            Music: Bankston / What You Running From / courtesy of
                            <a href="https://www.epidemicsound.com" class="link" target="_blank" rel="noopener">Epidemic Sound ↗</a>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SELECTED PROJECTS: on a Game Boy, in an inverted block the page dissolves
         into (it runs on into the footer) -->
    <PixelEdge class="selected-edge" seed={3} rows={10} />
    <div class="inverse" data-joins-footer>
        <ProjectGameBoy projects={featured} />
    </div>
</Base>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const reel = document.querySelector<HTMLElement>("[data-reel]");
    if (reel) {
        const track = reel.querySelector<HTMLElement>("[data-reel-track]")!;
        const frame = reel.querySelector<HTMLElement>("[data-reel-frame]")!;
        const video = reel.querySelector<HTMLVideoElement>("[data-reel-video]")!;
        const play = reel.querySelector<HTMLButtonElement>("[data-reel-play]")!;
        const playTitle = reel.querySelector<HTMLElement>("[data-reel-play-title]")!;
        const pause = reel.querySelector<HTMLButtonElement>("[data-reel-pause]")!;
        const sound = reel.querySelector<HTMLButtonElement>("[data-reel-sound]")!;
        const still = window.matchMedia("(prefers-reduced-motion: reduce)");

        /* --- the size: small in the page, the whole window halfway through the scroll --- */

        const small = { w: 0, h: 0 };
        const measure = () => {
            const room = reel.querySelector<HTMLElement>(".reel__head")!.clientWidth;
            small.w = Math.min(room, (window.innerHeight - 220) * (16 / 9));
            small.w = Math.max(small.w, Math.min(room, 320));
            small.h = small.w * (9 / 16);
        };
        // grows over the first 40 % of the scroll, holds, shrinks over the last 40 %
        const ease = (t: number) => t * t * (3 - 2 * t);
        const amount = (p: number) => (p < 0.4 ? ease(p / 0.4) : p > 0.6 ? ease((1 - p) / 0.4) : 1);
        let progress = 0;
        const size = () => {
            const f = still.matches ? 0 : amount(progress);
            const W = document.documentElement.clientWidth;
            // "full screen" is the window below the fixed header, so the header never covers the top of the reel
            const top = document.querySelector<HTMLElement>("[data-header]")?.offsetHeight ?? 0;
            const room = frame.parentElement!.clientHeight - top;
            // a tall screen (a phone upright) gains nothing from the full height: edge to edge is enough
            const H = W < room ? W * (9 / 16) : room;
            frame.style.width = `${small.w + (W - small.w) * f}px`;
            frame.style.height = `${small.h + (H - small.h) * f}px`;
            // centred in that space: down by half the header as it grows
            frame.style.transform = `translateY(${(top / 2) * f}px)`;
            frame.classList.toggle("is-full", f > 0.98);
        };
        ScrollTrigger.create({
            trigger: track,
            start: "top top",
            end: "bottom bottom",
            onUpdate: (self) => {
                progress = self.progress;
                size();
            },
            onRefresh: (self) => {
                progress = self.progress;
                measure();
                size();
            },
        });
        measure();
        size();
        still.addEventListener("change", () => ScrollTrigger.refresh());

        /* --- playing: only when asked, with sound --- */

        const sync = () => {
            const playing = !video.paused && !video.ended;
            frame.classList.toggle("is-playing", playing);
            pause.textContent = playing ? "Pause" : "Play";
        };
        const start = () => {
            frame.classList.add("is-started");
            video.muted = false;
            sound.textContent = "Sound on";
            sound.setAttribute("aria-pressed", "true");
            video.play().catch(() => {});
            pause.focus({ preventScroll: true });
        };
        play.addEventListener("click", start);
        pause.addEventListener("click", () => (video.paused ? video.play().catch(() => {}) : video.pause()));
        video.addEventListener("click", () => {
            if (!frame.classList.contains("is-started")) start();
            else if (video.paused) video.play().catch(() => {});
            else video.pause();
        });
        sound.addEventListener("click", () => {
            video.muted = !video.muted;
            sound.textContent = video.muted ? "Sound off" : "Sound on";
            sound.setAttribute("aria-pressed", String(!video.muted));
        });
        video.addEventListener("play", sync);
        video.addEventListener("pause", sync);
        video.addEventListener("ended", () => {
            frame.classList.remove("is-started");
            playTitle.textContent = "Play again";
            sync();
            play.focus({ preventScroll: true });
        });
        // it stops when it's scrolled away
        new IntersectionObserver(([entry]) => {
            if (!entry.isIntersecting && !video.paused) video.pause();
        }).observe(frame);
    }
</script>

<style>
    /* first thing on the page: most of the screen under the header, with
       the next block just showing at the bottom */
    .hero {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        grid-template-rows: 1fr auto;
        column-gap: var(--gutter);
        min-height: calc(86svh - var(--header-h));
        padding-block: 24px 32px;
        overflow: hidden;
    }

    /* my name, as big as it fits */
    .hero__name {
        grid-column: 1 / -1;
        grid-row: 1;
        align-self: end;
        position: relative;
        z-index: 1;
        margin: 0;
        font-size: clamp(4rem, 19vw, 26rem);
        white-space: nowrap;
    }

    .hero__line {
        display: block;
        overflow: hidden;
        padding-bottom: 0.05em;
    }

    .hero__line > span {
        display: block;
    }

    .hero__line--2 {
        padding-left: 6vw;
    }

    /* the photo sits over the name, like a poster */
    .hero__photo {
        grid-column: 8 / span 2;
        grid-row: 1;
        align-self: end;
        position: relative;
        z-index: 2;
        margin: 0 0 4vw;
    }

    .hero__frame {
        aspect-ratio: 3 / 4;
        overflow: hidden;
        background: var(--text);
    }

    .hero__frame :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 42% 40%;
    }

    .hero__note,
    .hero__tech {
        grid-row: 2;
        margin: 28px 0 0;
    }

    .hero__note {
        grid-column: 1 / span 4;
        max-width: 31ch;
        font-size: var(--fs-body);
        line-height: 1.35;
    }

    .hero__note b {
        font-weight: 500;
    }

    .hero__note p {
        margin: 0;
    }

    .hero__note .link {
        display: inline-block;
        margin-top: 14px;
    }

    .hero__tech {
        grid-column: 5 / span 4;
        align-self: end;
        text-align: center;
        color: var(--muted);
    }

    .hero__note--right {
        grid-column: 9 / span 4;
        justify-self: end;
        text-align: right;
    }

    .hero__note--right.dash::before {
        margin-left: auto;
    }

    /* the showreel: a rule and its name, like the Selected projects head, then
       a tall track: the film sticks to the window while it grows and shrinks */
    .reel {
        padding-top: clamp(32px, 5vw, 64px);
    }

    .reel__head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--gutter);
        padding-top: 14px;
        border-top: 1px solid var(--line);
    }

    .reel__head h2,
    .reel__head p {
        margin: 0;
    }

    .reel__track {
        position: relative;
        height: 260vh;
        height: 260svh;
    }

    .reel__stage {
        position: sticky;
        top: 0;
        display: grid;
        place-items: center;
        height: 100vh;
        height: 100svh;
        overflow: hidden;
    }

    /* the cinema: ink round the picture, never cropped */
    .reel__frame {
        position: relative;
        width: min(100% - 2 * var(--gutter), (100svh - 220px) * 16 / 9);
        aspect-ratio: 16 / 9;
        background: #0e0e0e;
        color: #e9e7e2;
    }

    .reel__video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        cursor: pointer;
    }

    /* the big button: blue, a pixel triangle, what it is under it */
    .reel__play {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        gap: 16px;
        width: max-content;
        height: max-content;
        margin: auto;
        padding: 18px 26px 18px 22px;
        border: 0;
        background: var(--blue);
        color: #fff;
        text-align: left;
        cursor: pointer;
        transition: transform 0.2s var(--step);
    }

    .reel__play:hover,
    .reel__play:focus-visible {
        transform: scale(1.04);
        outline: 2px solid #e9e7e2;
        outline-offset: 3px;
    }

    .reel__play-text {
        display: grid;
        gap: 4px;
    }

    .reel__play-title {
        font-family: var(--display);
        font-size: clamp(1.4rem, 1rem + 1.6vw, 2.4rem);
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.04em;
    }

    .reel__play-meta {
        opacity: 0.8;
    }

    .is-started .reel__play {
        display: none;
    }

    /* under way: Pause and Sound bottom left, the music credit bottom right */
    .reel__bar {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-end;
        gap: 8px 16px;
        padding: 12px;
        pointer-events: none;
    }

    .reel__bar > * {
        pointer-events: auto;
    }

    .reel__buttons {
        display: flex;
        gap: 8px;
        visibility: hidden;
    }

    .is-started .reel__buttons {
        visibility: visible;
    }

    .reel__btn {
        padding: 6px 10px;
        border: 1px solid rgba(233, 231, 226, 0.4);
        background: rgba(14, 14, 14, 0.7);
        color: #e9e7e2;
        font: inherit;
        letter-spacing: inherit;
        text-transform: inherit;
        cursor: pointer;
    }

    .reel__btn:hover,
    .reel__btn:focus-visible {
        border-color: var(--blue);
        background: var(--blue);
        color: #fff;
        outline: none;
    }

    .reel__credit {
        padding: 6px 10px;
        background: rgba(14, 14, 14, 0.7);
        color: #bdbbb6;
        text-align: right;
    }

    .reel__credit .link {
        color: #e9e7e2;
    }

    /* without motion: the film where it is, no growing */
    @media (prefers-reduced-motion: reduce) {
        .reel__track,
        .reel__stage {
            height: auto;
        }

        .reel__stage {
            position: static;
            padding-block: clamp(24px, 4vw, 48px);
        }
    }

    @media (max-width: 599px) {
        .reel__credit {
            font-size: 10px;
        }
    }

    .selected-edge {
        margin-top: clamp(32px, 5vw, 80px);
    }

    /* phones and tablets: the photo above the name, the notes stacked */
    @media (max-width: 899px) {
        .hero {
            grid-template-columns: repeat(6, minmax(0, 1fr));
            grid-template-rows: auto;
            min-height: 0;
        }

        .hero__photo {
            grid-column: 3 / span 3;
            grid-row: 1;
            margin: 0 0 -4vw;
        }

        .hero__name {
            grid-row: 2;
            font-size: 19vw;
        }

        .hero__line--2 {
            padding-left: 4vw;
        }

        .hero__note {
            grid-column: 1 / span 5;
            grid-row: 3;
        }

        .hero__tech {
            grid-column: 1 / -1;
            grid-row: 4;
            text-align: left;
        }

        .hero__note--right {
            grid-column: 2 / span 5;
            grid-row: 5;
        }
    }
</style>
