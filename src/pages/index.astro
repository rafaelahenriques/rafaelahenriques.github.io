---
import Base from "../layouts/BaseLayout.astro";
import ProjectCarousel, { type Slide } from "../components/ProjectCarousel.astro";
import WorkIndex from "../components/WorkIndex.astro";
import { getImage } from "astro:assets";
import { getProjects, getPosts, formatDate, slugOf } from "../lib/content";

const projects = await getProjects();
const latestPosts = (await getPosts()).slice(0, 3);

// Carousel: gallery images (or the screenshot), taken round-robin across
// projects so every project shows up and neighbours differ. 10 max.
const CAROUSEL_SIZE = 10;
const galleries = projects.map((p) =>
    (p.data.media?.gallery ?? [p.data.media?.screenshot]).filter((img) => img !== undefined),
);
const depth = Math.max(...galleries.map((g) => g.length));
const sources = Array.from({ length: depth }, (_, round) =>
    projects.map((p, i) => ({ p, image: galleries[i][round] })),
)
    .flat()
    .filter((s) => s.image !== undefined)
    .slice(0, CAROUSEL_SIZE);

const slides: Slide[] = await Promise.all(
    sources.map(async ({ p, image }) => ({
        src: (await getImage({ src: image!, width: 800, format: "webp" })).src,
        title: p.data.title,
        year: p.data.year,
        href: `/projects/${slugOf(p)}/`,
    })),
);
---

<Base title="Home" description="Rafaela Henriques — web developer. Selected projects and blog.">
    <ProjectCarousel slides={slides} />

    <section class="section wrap" aria-labelledby="intro">
        <div class="row">
            <h2 id="intro" class="row__label mono muted">Intro</h2>
            <div class="row__body">
                <p class="lead intro" data-split>
                    Web developer with a background in game development,
                    building interfaces that feel sharp, fast and clear.
                </p>
                <a href="/about/" class="intro__more mono link" data-reveal>More about me →</a>
            </div>
        </div>
    </section>

    <section class="section wrap" aria-labelledby="work">
        <div class="section-head">
            <h2 id="work" class="mono muted">Index — Projects</h2>
            <a href="/projects/" class="mono link">All projects ({projects.length})</a>
        </div>
        <WorkIndex projects={projects} />
    </section>

    <section class="section wrap" aria-labelledby="blog">
        <div class="section-head">
            <h2 id="blog" class="mono muted">Latest from the blog</h2>
            <a href="/blog/" class="mono link">All posts</a>
        </div>
        <ol class="index index--dated">
            {
                latestPosts.map((post) => (
                    <li class="index__item" data-reveal>
                        <a href={`/blog/${slugOf(post)}/`} class="index__link">
                            <span class="index__num mono muted">→</span>
                            <span class="index__title">{post.data.title}</span>
                            <span class="index__meta mono muted">{post.data.tags?.join(", ")}</span>
                            <time class="index__year mono" datetime={post.data.date.toISOString()}>
                                {formatDate(post.data.date)}
                            </time>
                        </a>
                    </li>
                ))
            }
        </ol>
    </section>
</Base>

<style>
    .intro {
        max-width: 30ch;
    }

    .intro__more {
        display: inline-block;
        margin-top: 32px;
    }

    .section-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--gutter);
        margin-bottom: 14px;
    }
</style>
