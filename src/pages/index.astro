---
import Base from "../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";

type ProjectEntry = CollectionEntry<"projects">;
type BlogEntry = CollectionEntry<"blog">;

// Sort helpers
const sortProjects = (items: ProjectEntry[]) =>
  [...items].sort((a, b) => (b.data.year ?? "").localeCompare(a.data.year ?? ""));

const sortPosts = (items: BlogEntry[]) =>
  [...items].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const projects = sortProjects(await getCollection("projects") as ProjectEntry[]);
const latestProjects = projects.slice(0, 3);

const posts = sortPosts(await getCollection("blog") as BlogEntry[]);
const latestPosts = posts.slice(0, 3);
---

<Base title="Home" description="Rafaela — projects and blog.">
  <section class="section reveal" style="margin-top: 0;">
    <h1 class="reveal">Web Developer</h1>
    <p class="lead reveal">
      I build sleek, interactive web applications with a focus on clean code and great design.
    </p>
    <a href="/about/" class="button button--primary reveal">More About Me</a>
  </section>

  <section class="section reveal" aria-labelledby="home-projects">
    <div class="section__label" id="home-projects">Latest Projects</div>

    <!-- 1-column on mobile, 2-column grid from 720px+ -->
    <div class="grid home-grid home-projects-grid stagger">
      {latestProjects.map((p) => {
        const screenshot = p.data.media?.screenshot;
        return (
          <a href={`/projects/${p.id.replace(/\.md$/, "")}/`} class="card">
            <div class="card__media">
              {screenshot && (
                <Picture
                  src={screenshot}
                  alt={p.data.title}
                  loading="lazy"
                  formats={["avif", "webp", "png"]}
                  widths={[320, 640, 768, 1024, 1400]}
                  sizes="(max-width: 719px) 100vw, (max-width: 1023px) 50vw, (max-width: 1399px) 33vw, 25vw"
                />
              )}
            </div>
            <h3 class="card__title">{p.data.title}</h3>
            <p class="card__meta">{p.data.year}</p>
          </a>
        );
      })}
    </div>

    <p style={`margin-top: var(--gap);`}>
      <a href="/projects/" class="button">See all projects</a>
    </p>
  </section>

  <section class="section reveal" aria-labelledby="home-blog">
    <div class="section__label" id="home-blog">Latest Posts</div>

    <!-- 1-column on mobile, 2-column grid from 720px+ -->
    <div class="grid home-grid home-blog-grid">
      {latestPosts.map((post) => (
        <a href={`/blog/${post.id}/`} class="card">
          <h3 class="card__title">{post.data.title}</h3>
          <p class="card__meta">
            {post.data.date.toLocaleDateString("en-GB", { dateStyle: "medium" })}
          </p>
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="card__tags" aria-label="Tags">
              {post.data.tags.map((tag) => (
                <span class="tag-pill">{tag}</span>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>

    <p style={`margin-top: var(--gap);`}>
      <a href="/blog/" class="button">See all posts</a>
    </p>
  </section>
</Base>