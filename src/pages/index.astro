---
import Base from "../layouts/BaseLayout.astro";
import ProjectDeck from "../components/ProjectDeck.astro";
import SpreadName from "../components/SpreadName.astro";
import babyPhoto from "../assets/me/rafaela-2006.jpg";
import { getFeatured } from "../lib/content";

const featured = await getFeatured();
---

<Base title="Home" description="Rafaela Henriques — web developer. Selected projects.">
    <!-- HELLO: my name spread across the page, with me in 2006 in the middle -->
    <section class="hello" aria-labelledby="intro">
        <h2 id="intro" class="visually-hidden">Intro</h2>
        <SpreadName
            word="Rafaela"
            insertAt={3}
            image={babyPhoto}
            alt="Rafaela as a little girl in a party hat"
            focus="46% 42%"
            figLeft="Fig. 01 — Rafaela, 2006"
        />
        <div class="wrap hello__text">
            <p class="caps" data-split>
                Web developer working across full-stack, mobile and data — with a
                background in game development and design.
            </p>
            <p class="caps-eg mono" data-reveal>
                <span aria-hidden="true">→</span>
                <span>Python · TypeScript · React · FastAPI · PostgreSQL · React Native</span>
            </p>
            <p class="hello__more" data-reveal>
                <a href="/about/" class="mono link">More about me →</a>
            </p>
        </div>
    </section>

    <!-- SELECTED PROJECTS: a deck of cards -->
    <ProjectDeck projects={featured} />
</Base>

<style>
    /* first thing on the page: sits right under the header */
    .hello {
        padding-top: clamp(40px, 7vw, 96px);
    }

    .hello__text {
        margin-top: clamp(48px, 7vw, 96px);
    }

    .hello__more {
        margin: clamp(28px, 4vw, 48px) 0 0;
        text-align: center;
    }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }
</style>
