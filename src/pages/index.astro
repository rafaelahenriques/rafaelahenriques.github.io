---
import Base from "../layouts/BaseLayout.astro";
import ProjectCarousel, { type Slide } from "../components/ProjectCarousel.astro";
import WorkIndex from "../components/WorkIndex.astro";
import SpreadName from "../components/SpreadName.astro";
import babyPhoto from "../assets/me/rafaela-2006.jpg";
import { getImage } from "astro:assets";
import { getProjects, getFeatured, getOtherWork, slugOf } from "../lib/content";

const projects = await getProjects();
const featured = await getFeatured();
const otherWork = await getOtherWork();

// Carousel: gallery images (or the screenshot), taken round-robin across
// projects so every project shows up and neighbours differ. 10 max.
const CAROUSEL_SIZE = 10;
const galleries = projects.map((p) =>
    (p.data.media?.gallery ?? [p.data.media?.screenshot]).filter((img) => img !== undefined),
);
const depth = Math.max(...galleries.map((g) => g.length));
const sources = Array.from({ length: depth }, (_, round) =>
    projects.map((p, i) => ({ p, image: galleries[i][round] })),
)
    .flat()
    .filter((s) => s.image !== undefined)
    .slice(0, CAROUSEL_SIZE);

const slides: Slide[] = await Promise.all(
    sources.map(async ({ p, image }) => ({
        src: (await getImage({ src: image!, width: 800, format: "webp" })).src,
        title: p.data.title,
        year: p.data.year,
        href: `/projects/${slugOf(p)}/`,
    })),
);
---

<Base title="Home" description="Rafaela Henriques — web developer. Selected projects.">
    <ProjectCarousel slides={slides} />

    <!-- HELLO: my name spread across the page, with me in 2006 in the middle -->
    <section class="section hello" aria-labelledby="intro">
        <h2 id="intro" class="visually-hidden">Intro</h2>
        <SpreadName
            word="Rafaela"
            insertAt={3}
            image={babyPhoto}
            alt="Rafaela as a little girl in a party hat, getting a kiss on the cheek"
            focus="46% 42%"
            figLeft="Fig. 01 — Rafaela, 2006"
            figRight="Fig. 02 — today →"
            figRightHref="/about/"
        />
        <div class="wrap hello__text">
            <p class="caps" data-split>
                Web developer working across full-stack, mobile and data — with a
                background in game development and design.
            </p>
            <p class="caps-eg mono" data-reveal>
                <span aria-hidden="true">→</span>
                <span>E.g. Python, React Native, Supabase, GSAP and Figma</span>
            </p>
            <p class="hello__more" data-reveal>
                <a href="/about/" class="mono link">More about me →</a>
            </p>
        </div>
    </section>

    <section class="section wrap" aria-labelledby="work">
        <div class="section-head">
            <h2 id="work" class="mono muted">Selected projects</h2>
            <a href="/projects/" class="mono link">All projects</a>
        </div>
        <WorkIndex projects={featured} />
        <p class="other-line mono muted" data-reveal>
            Other work —
            {
                otherWork.map((p, i) => (
                    <>
                        <a href={`/projects/${slugOf(p)}/`} class="link">{p.data.title}</a>
                        {i < otherWork.length - 1 && " · "}
                    </>
                ))
            }
        </p>
    </section>
</Base>

<style>
    .hello__text {
        margin-top: clamp(48px, 7vw, 96px);
    }

    .hello__more {
        margin: clamp(28px, 4vw, 48px) 0 0;
        text-align: center;
    }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    .other-line {
        margin-top: 18px;
    }

    .section-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--gutter);
        margin-bottom: 14px;
    }
</style>
