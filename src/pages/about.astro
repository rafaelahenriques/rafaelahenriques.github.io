---
import Base from "../layouts/BaseLayout.astro";
import ContactLinks from "../components/ContactLinks.astro";
import GitHubStats from "../components/GitHubStats.astro";
import PixelEdge from "../components/PixelEdge.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { pad } from "../lib/content";
import { site } from "../lib/site";
import portrait from "../assets/me/rafaela.jpg";
import { profilePageSchema } from "../lib/seo";

// Skill groups from the content collection, by `order` then name
const skills = (await getCollection("skills")).sort((a, b) => {
    const byOrder = (a.data.order ?? 999) - (b.data.order ?? 999);
    return byOrder || a.data.category.localeCompare(b.data.category);
});

const traits = ["Adaptable", "Curious", "Proactive", "Communicative", "User-minded"];
---

<Base title="About" type="profile" image={portrait} schema={[profilePageSchema("/about/")]} description="Rafaela Henriques, an Angolan-Portuguese developer based in Belgium, studying Digital Design & Development at Howest: Creative Development major, Experience Design minor.">
    <!-- ALL OF IT ON ONE SCREEN, MORE OR LESS: the photo on the left (it stays
         put while the text scrolls), the profile, skills and availability on
         the right. The longer profile opens under "Read more". -->
    <section class="about wrap" aria-labelledby="about-title">
        <p class="about__head mono">
            <span>About</span>
            <span class="muted">{site.location}</span>
        </p>

        <figure class="about__photo photo" data-about-portrait data-cursor="Hi">
            <div class="about__frame" data-reveal-img>
                <div class="about__inner" data-about-parallax>
                    <Image
                        src={portrait}
                        alt="Rafaela sitting on a stone quay by the water in the evening sun"
                        widths={[500, 900, 1400]}
                        sizes="(min-width: 900px) 30vw, 100vw"
                        loading="eager"
                        quality={88}
                    />
                </div>
                <!-- the photo dissolves into the page in pixels -->
                <PixelEdge class="about__edge" seed={9} rows={5} tone="page" />
            </div>
            <figcaption class="about__caption mono">
                <span class="muted">Fig. 02 — Rafaela</span>
                <span class="about__traits">
                    <span class="visually-hidden">Traits: </span>
                    {
                        traits.map((t, i) => (
                            <>
                                <span class="about__trait">{t}</span>
                                {i < traits.length - 1 && <span class="muted" aria-hidden="true"> / </span>}
                            </>
                        ))
                    }
                </span>
            </figcaption>
        </figure>

        <div class="about__text">
            <h1 id="about-title" class="display about__title" data-rise>
                <span class="about__line"><span data-rise-line>About<span class="stop" aria-hidden="true"></span></span></span>
                <span class="visually-hidden"> Rafaela Henriques</span>
            </h1>

            <p class="about__lead" data-reveal>
                I’m Rafaela, an Angolan-Portuguese developer based in Belgium,
                currently studying Digital Design &amp; Development at Howest,
                majoring in Creative Development and minoring in Experience
                Design.
            </p>

            <!-- the rest of the profile, folded away until asked for -->
            <details class="about__more" data-about-more data-reveal>
                <summary class="btn">
                    <span class="about__more-open">Read more</span>
                    <span class="about__more-close">Read less</span>
                    <span class="about__more-sign" aria-hidden="true"></span>
                </summary>
                <div class="about__more-body">
                    <div class="about__columns">
                        <p>
                            I’m always looking to learn, improve, and understand things
                            more deeply. I’m not someone who likes to stay comfortable
                            with what I already know. I want to keep pushing myself and
                            become better at what I do. That mindset is what led me to
                            move to Belgium on my own and challenge myself beyond what I
                            was used to.
                        </p>
                        <p>
                            Development is where I feel most at home: building, solving
                            problems, and turning ideas into something real. But I also
                            care about how people experience what I create. That’s why
                            the combination of Creative Development and Experience
                            Design feels so natural to me.
                        </p>
                    </div>
                    <p class="about__closing">
                        Ultimately, I want to become an excellent developer and build
                        something of my own. Something I believe in, and something that
                        genuinely brings value to others.
                    </p>
                </div>
            </details>

            <h2 id="skills" class="about__label mono muted">What I work with</h2>
            <ol class="skills" aria-labelledby="skills">
                {
                    skills.map((group, i) => (
                        <li class="skills__item" data-reveal>
                            <span class="skills__num mono muted">{pad(i + 1)}</span>
                            <h3 class="skills__name">{group.data.category}</h3>
                            <p class="skills__items mono">{group.data.items.join(", ")}</p>
                        </li>
                    ))
                }
            </ol>

            <div class="about__availability" data-reveal>
                <h2 id="availability" class="about__label mono muted">Availability</h2>
                <p>
                    Open to software and web development roles in the UK,
                    US and Belgium, and to projects where I can ship real features
                    as part of a team.
                </p>
                <ContactLinks class="about__links mono" />
            </div>
        </div>
    </section>

    <!-- GITHUB: the numbers and most used languages, from the public profile -->
    <GitHubStats />
</Base>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    // the portrait drifts slower than the page, like it's further away
    gsap.matchMedia().add("(prefers-reduced-motion: no-preference) and (min-width: 900px)", () => {
        const portrait = document.querySelector<HTMLElement>("[data-about-portrait]");
        if (!portrait) return;
        gsap.fromTo(
            portrait.querySelector("[data-about-parallax]"),
            { yPercent: -5 },
            {
                yPercent: 5,
                ease: "none",
                scrollTrigger: { trigger: portrait, start: "top bottom", end: "bottom top", scrub: true },
            },
        );
    });

    // "Read more": the rest of the profile comes in a line at a time, in steps
    const more = document.querySelector<HTMLDetailsElement>("[data-about-more]");
    more?.addEventListener("toggle", () => {
        if (!more.open || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        gsap.from(more.querySelectorAll(".about__more-body p"), { autoAlpha: 0, y: 10, duration: 0.4, ease: "steps(4)", stagger: 0.08 });
        ScrollTrigger.refresh();
    });
</script>

<style>
    .about {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--gutter);
        padding-block: 0 var(--section);
    }

    .about__head {
        grid-column: 1 / -1;
        display: flex;
        justify-content: space-between;
        gap: var(--gutter);
        margin: 0;
        padding-block: 12px;
        border-bottom: 1px solid var(--line);
    }

    /* --- the photo, and the traits under it --- */

    .about__photo {
        grid-column: 1 / span 5;
        align-self: start;
        margin: 28px 0 0;
    }

    .about__frame {
        position: relative;
        aspect-ratio: 3 / 4;
        overflow: hidden;
        background: var(--text);
    }

    /* (inside the frame, to beat the edge's own position: relative) */
    .about__frame :global(.about__edge) {
        position: absolute;
        inset: auto 0 -1px;
        z-index: 1;
    }

    /* taller than the frame so the parallax never shows an edge */
    .about__inner {
        height: 112%;
        margin-top: -6%;
    }

    .about__frame :global(img) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 60%;
    }

    .about__caption {
        display: grid;
        gap: 6px;
        margin-top: 10px;
    }

    /* --- the text --- */

    .about__text {
        grid-column: 7 / -1;
        min-width: 0;
        margin-top: 28px;
    }

    .about__title {
        margin: 0 0 clamp(24px, 3vw, 40px);
        font-size: clamp(4.5rem, 1rem + 10vw, 11rem);
    }

    .about__line {
        display: block;
        overflow: hidden;
        padding-bottom: 0.05em;
    }

    .about__line > span {
        display: block;
    }

    .about__lead {
        max-width: 30ch;
        margin: 0;
        font-size: clamp(1.375rem, 1rem + 1.2vw, 2.125rem);
        font-weight: 500;
        line-height: 1.15;
        letter-spacing: -0.025em;
    }

    /* "Read more": a square button with a plus that turns into a minus */
    .about__more {
        margin-top: clamp(20px, 2.4vw, 32px);
    }

    .about__more > summary {
        list-style: none;
    }

    .about__more > summary::-webkit-details-marker {
        display: none;
    }

    .about__more-sign {
        position: relative;
        width: 10px;
        height: 10px;
    }

    .about__more-sign::before,
    .about__more-sign::after {
        content: "";
        position: absolute;
        inset: 4px 0 auto;
        height: 2px;
        background: currentColor;
    }

    .about__more-sign::after {
        transform: rotate(90deg);
    }

    .about__more[open] .about__more-sign::after,
    .about__more-close,
    .about__more[open] .about__more-open {
        display: none;
    }

    .about__more[open] .about__more-close {
        display: inline;
    }

    .about__more-body {
        padding-top: clamp(20px, 2.4vw, 32px);
    }

    .about__columns {
        display: grid;
        gap: 1em var(--gutter);
        color: var(--muted);
    }

    .about__columns p,
    .about__closing {
        margin: 0;
    }

    /* as wide as the two columns above it, so the edges line up */
    .about__closing {
        margin-top: clamp(20px, 2.4vw, 32px);
        padding-top: 14px;
        border-top: 1px solid var(--line);
        font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
        line-height: 1.3;
        letter-spacing: -0.015em;
    }

    @media (min-width: 1200px) {
        .about__columns {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    /* --- skills: a numbered list, like every list on the site --- */

    .about__label {
        margin: clamp(48px, 6vw, 80px) 0 12px;
    }

    .skills {
        margin: 0;
        padding: 0;
        list-style: none;
        border-bottom: 1px solid var(--line);
    }

    .skills__item {
        display: grid;
        grid-template-columns: 2.5rem minmax(0, 1fr);
        gap: 4px var(--gutter);
        align-items: baseline;
        padding-block: 14px;
        border-top: 1px solid var(--line);
    }

    .skills__name {
        margin: 0;
        font-family: var(--display);
        font-size: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
        font-weight: 800;
        line-height: 0.95;
        letter-spacing: -0.05em;
        text-transform: lowercase;
    }

    .skills__items {
        grid-column: 2;
        margin: 0;
        color: var(--muted);
    }

    @media (min-width: 1200px) {
        .skills__item {
            grid-template-columns: 2.5rem minmax(0, 1.1fr) minmax(0, 1fr);
        }

        .skills__items {
            grid-column: 3;
        }
    }

    /* --- availability and the links --- */

    .about__availability p {
        max-width: 34ch;
        margin: 0;
        font-size: var(--fs-body);
    }

    .about__availability :global(.about__links) {
        margin-top: 20px;
    }

    /* desktop: the photo stays in view while the text goes by */
    @media (min-width: 900px) {
        .about__photo {
            position: sticky;
            top: calc(var(--header-h) + 24px);
        }
    }

    /* phones and tablets: one column, the title first */
    @media (max-width: 899px) {
        .about__text {
            display: contents;
        }

        .about__title {
            grid-column: 1 / -1;
            order: -1;
            margin-top: 24px;
        }

        .about__head {
            order: -2;
        }

        .about__photo {
            grid-column: 1 / span 10;
            margin-top: 0;
        }

        .about__lead,
        .about__more,
        .about__label,
        .skills,
        .about__availability {
            grid-column: 1 / -1;
        }

        .about__lead {
            margin-top: clamp(32px, 6vw, 48px);
        }
    }
</style>
