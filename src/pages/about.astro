---
import Base from "../layouts/BaseLayout.astro";
import ContactLinks from "../components/ContactLinks.astro";
import { getCollection } from "astro:content";

// Skill groups from the content collection, by `order` then name
const skills = (await getCollection("skills")).sort((a, b) => {
    const byOrder = (a.data.order ?? 999) - (b.data.order ?? 999);
    return byOrder || a.data.category.localeCompare(b.data.category);
});

const traits = ["Adaptable", "Hard-working", "Friendly", "Curious", "Observant", "Proactive"];
---

<Base title="About" description="About Rafaela Henriques, web developer.">
    <header class="page-head wrap">
        <p class="mono muted" data-reveal>About</p>
        <h1 class="display" data-split>Rafaela Henriques</h1>
    </header>

    <section class="wrap" aria-label="Profile">
        <div class="row">
            <p class="row__label mono muted">Profile</p>
            <div class="row__body">
                <p class="lead" data-split>
                    I’m a web developer with a background in game development,
                    studying Digital Design &amp; Development (Devine) at Howest.
                    I build interfaces that feel sharp, fast and clear.
                </p>
                <div class="about__columns" data-reveal>
                    <p>
                        I’m Angolan and Portuguese, and that mix shows up in how
                        I think about products: practical, direct, but still open
                        to experimentation when it actually improves the
                        experience.
                    </p>
                    <p>
                        I like working close to the front end: design tokens,
                        responsive layouts, and interactions that feel
                        intentional instead of noisy.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="section wrap" aria-labelledby="traits">
        <div class="row">
            <h2 id="traits" class="row__label mono muted">Traits</h2>
            <p class="row__body traits h2" data-split>{traits.join(" / ")}</p>
        </div>
    </section>

    <section class="section wrap" aria-labelledby="skills">
        <div class="row">
            <h2 id="skills" class="row__label mono muted">What I work with</h2>
            <dl class="row__body skills">
                {
                    skills.map((group) => (
                        <div class="skills__group" data-reveal>
                            <dt class="mono muted">{group.data.category}</dt>
                            <dd>{group.data.items.join(", ")}</dd>
                        </div>
                    ))
                }
            </dl>
        </div>
    </section>

    <section class="section wrap" aria-labelledby="availability">
        <div class="row">
            <h2 id="availability" class="row__label mono muted">Availability</h2>
            <div class="row__body">
                <p class="lead" data-split>
                    Open for front-end focused roles, collaboration, and projects
                    where design and development actually talk to each other.
                </p>
                <div data-reveal>
                    <ContactLinks class="about__links mono" />
                </div>
            </div>
        </div>
    </section>
</Base>

<style>
    .about__columns {
        display: grid;
        gap: 1em var(--gutter);
        margin-top: clamp(32px, 4vw, 56px);
        max-width: 60rem;
        color: var(--muted);
    }

    @media (min-width: 900px) {
        .about__columns {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    .traits {
        max-width: 22ch;
    }

    .skills {
        display: grid;
        margin: 0;
    }

    .skills__group {
        display: grid;
        grid-template-columns: minmax(8rem, 1fr) 2fr;
        gap: var(--gutter);
        padding-block: 14px;
        border-bottom: 1px solid var(--line);
    }

    .skills__group:first-child {
        padding-top: 0;
    }

    .skills__group dd {
        margin: 0;
    }

    :global(.about__links) {
        margin-top: 32px;
    }
</style>
