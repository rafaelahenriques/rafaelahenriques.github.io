---
import Base from "../layouts/BaseLayout.astro";
import ContactLinks from "../components/ContactLinks.astro";
import GitHubStats from "../components/GitHubStats.astro";
import PixelEdge from "../components/PixelEdge.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { pad } from "../lib/content";
import portrait from "../assets/me/rafaela.jpg";
import { profilePageSchema } from "../lib/seo";

// Skill groups from the content collection, by `order` then name
const skills = (await getCollection("skills")).sort((a, b) => {
    const byOrder = (a.data.order ?? 999) - (b.data.order ?? 999);
    return byOrder || a.data.category.localeCompare(b.data.category);
});

const traits = ["Adaptable", "Curious", "Proactive", "Communicative", "User-minded"];
---

<Base title="About" type="profile" image={portrait} schema={[profilePageSchema("/about/")]} description="Rafaela Henriques, an Angolan-Portuguese developer based in Belgium, studying Digital Design & Development at Howest: Creative Development major, Experience Design minor.">
    <!-- HEADER: name on the left, portrait on the right -->
    <header class="page-head wrap about-head">
        <div class="about-head__title">
            <p class="mono muted" data-reveal>About</p>
            <h1 class="display about-name" data-split>Rafaela Henriques<span class="stop" aria-hidden="true"></span></h1>
            <div class="about-head__links" data-reveal>
                <ContactLinks class="mono" />
            </div>
        </div>
        <figure class="about-portrait photo" data-about-portrait data-cursor="Hi">
            <div class="about-portrait__frame" data-reveal-img>
                <div class="about-portrait__inner" data-about-parallax>
                <Image
                    src={portrait}
                    alt="Rafaela sitting on a stone quay by the water in the evening sun"
                    widths={[500, 900, 1400, 1800]}
                    sizes="(min-width: 900px) 34vw, 100vw"
                    loading="eager"
                    quality={88}
                />
                </div>
                <!-- the photo dissolves into the page in pixels, like the dark blocks do -->
                <PixelEdge class="about-portrait__edge" seed={9} rows={5} tone="page" />
            </div>
        </figure>
    </header>

    <section class="wrap" aria-label="Profile">
        <div class="row">
            <p class="row__label mono muted">Profile</p>
            <div class="row__body">
                <p class="lead about-lead" data-split>
                    I’m Rafaela, an Angolan-Portuguese developer based in Belgium,
                    currently studying Digital Design &amp; Development at Howest,
                    majoring in Creative Development and minoring in Experience
                    Design.
                </p>
                <div class="about__columns" data-reveal>
                    <p>
                        I’m always looking to learn, improve, and understand things
                        more deeply. I’m not someone who likes to stay comfortable
                        with what I already know. I want to keep pushing myself and
                        become better at what I do. That mindset is what led me to
                        move to Belgium on my own and challenge myself beyond what I
                        was used to.
                    </p>
                    <p>
                        Development is where I feel most at home: building, solving
                        problems, and turning ideas into something real. But I also
                        care about how people experience what I create. That’s why
                        the combination of Creative Development and Experience
                        Design feels so natural to me.
                    </p>
                </div>
                <p class="about-closing" data-split>
                    Ultimately, I want to become an excellent developer and build
                    something of my own. Something I believe in, and something that
                    genuinely brings value to others.
                </p>
            </div>
        </div>
    </section>

    <!-- TRAITS: one big centred statement -->
    <section class="section wrap about-traits" aria-labelledby="traits">
        <h2 id="traits" class="mono muted about-center-label">Traits</h2>
        <p class="caps about-traits__text" data-split>
            {
                // the slash stays with the word before it, so no line starts with one
                traits.map((t, i) => (
                    <>
                        <span class="about-traits__word">{t}{i < traits.length - 1 && <span class="about-traits__slash">{"\u00a0/"}</span>}</span>{" "}
                    </>
                ))
            }
        </p>
    </section>

    <!-- SKILLS and GITHUB, on an inverted block, like the footer -->
    <PixelEdge class="about-night-edge" seed={5} rows={9} tone="inverse" />
    <div class="inverse about-night">
    <!-- SKILLS: numbered like a playbook -->
    <section class="section wrap about-skills" aria-labelledby="skills">
        <h2 id="skills" class="mono muted about-skills__label">What I work with</h2>
        <ol class="playbook">
            {
                skills.map((group, i) => (
                    <li class="playbook__item" data-reveal>
                        <span class="playbook__num">{pad(i + 1)}</span>
                        <h3 class="playbook__name">{group.data.category}</h3>
                        <p class="playbook__items mono">
                            <span aria-hidden="true">→</span> {group.data.items.join(", ")}
                        </p>
                    </li>
                ))
            }
        </ol>
    </section>

    <!-- GITHUB: the numbers and most used languages, from the public profile -->
    <GitHubStats />
    </div>
    <PixelEdge seed={6} rows={9} tone="inverse" direction="up" />

    <section class="section wrap about-last" aria-labelledby="availability">
        <div class="row">
            <h2 id="availability" class="row__label mono muted">Availability</h2>
            <div class="row__body">
                <p class="lead about-availability" data-split>
                    Open to software and web development roles in the UK,
                    US and Belgium, and to projects where I can ship real features
                    as part of a team.
                </p>
                <div data-reveal>
                    <ContactLinks class="about__links mono" />
                </div>
            </div>
        </div>
    </section>
</Base>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    // the portrait drifts slower than the page, like it's further away
    gsap.matchMedia().add("(prefers-reduced-motion: no-preference) and (min-width: 900px)", () => {
        const portrait = document.querySelector<HTMLElement>("[data-about-portrait]");
        if (!portrait) return;
        gsap.fromTo(
            portrait.querySelector("[data-about-parallax]"),
            { yPercent: -5 },
            {
                yPercent: 5,
                ease: "none",
                scrollTrigger: { trigger: portrait, start: "top bottom", end: "bottom top", scrub: true },
            },
        );
    });
</script>

<style>
    /* --- HEADER --- */

    .about-head {
        display: grid;
        gap: clamp(32px, 5vw, 64px) var(--gutter);
    }

    .about-name {
        margin-top: 18px;
        max-width: 8ch;
        font-size: clamp(4rem, 1rem + 11vw, 13rem);
    }

    .about-head__links {
        margin-top: clamp(20px, 3vw, 32px);
    }

    .about-portrait {
        margin: 0;
    }

    .about-portrait__frame {
        position: relative;
        aspect-ratio: 3 / 4;
        overflow: hidden;
    }

    /* (inside the frame, to beat the edge's own position: relative) */
    .about-portrait__frame :global(.about-portrait__edge) {
        position: absolute;
        inset: auto 0 -1px;
        z-index: 1;
    }

    /* taller than the frame so the parallax never shows an edge */
    .about-portrait__inner {
        height: 112%;
        margin-top: -6%;
    }

    .about-portrait__frame :global(img) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 60%;
    }

    @media (min-width: 900px) {
        .about-head {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            align-items: end;
        }

        .about-head__title {
            grid-column: 1 / span 7;
        }

        .about-portrait {
            grid-column: 9 / span 4;
        }
    }

    /* --- PROFILE --- */

    .about-lead {
        max-width: 34ch;
    }

    /* two paragraphs side by side: why I push myself, why dev + experience */
    .about__columns {
        display: grid;
        gap: 1em var(--gutter);
        margin-top: clamp(32px, 4vw, 56px);
        max-width: 60rem;
        color: var(--muted);
    }

    .about__columns p {
        margin: 0;
    }

    @media (min-width: 900px) {
        .about__columns {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    /* where it's all heading: set apart, in the text colour */
    .about-closing {
        max-width: 34ch;
        margin: clamp(32px, 4vw, 56px) 0 0;
        padding-top: 14px;
        border-top: 1px solid var(--line);
        font-size: clamp(1.25rem, 1rem + 0.9vw, 1.75rem);
        line-height: 1.25;
        letter-spacing: -0.02em;
    }

    .about-availability {
        max-width: 30ch;
    }

    /* --- TRAITS --- */

    .about-center-label {
        margin: 0 0 clamp(20px, 3vw, 32px);
        text-align: center;
    }

    .about-traits__text {
        max-width: 20ch;
        font-size: clamp(2.5rem, 1rem + 6vw, 7.5rem);
    }

    .about-traits__word {
        white-space: nowrap;
    }

    /* the slashes in blue pixels' place: quiet */
    .about-traits__slash {
        color: var(--muted);
    }

    /* --- THE DARK BLOCK: skills and GitHub --- */

    :global(.about-night-edge) {
        margin-top: var(--section);
    }

    .about-night {
        padding-bottom: clamp(48px, 7vw, 104px);
    }

    .about-skills {
        padding-top: clamp(48px, 7vw, 104px);
    }

    /* --- SKILLS PLAYBOOK --- */

    .about-skills__label {
        margin: 0 0 14px;
    }

    .playbook {
        margin: 0;
        padding: 0;
        list-style: none;
        border-bottom: 1px solid var(--line);
    }

    .playbook__item {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 6px var(--gutter);
        align-items: baseline;
        padding-block: clamp(16px, 2vw, 28px);
        border-top: 1px solid var(--line);
    }

    .playbook__name {
        font-family: var(--display);
        font-size: clamp(2.25rem, 1rem + 4.4vw, 5.5rem);
        font-weight: 800;
        line-height: 0.88;
        letter-spacing: -0.06em;
        text-transform: lowercase;
    }

    /* small mono numbers, like every list on the site */
    .playbook__num {
        font-family: var(--mono);
        font-size: var(--fs-mono);
        color: var(--muted);
        align-self: start;
        padding-top: 0.6em;
    }

    .playbook__name {
        margin: 0;
    }

    .playbook__items {
        grid-column: 2;
        margin: 0;
        color: var(--muted);
    }

    @media (min-width: 900px) {
        .playbook__item {
            grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1fr);
        }

        .playbook__items {
            grid-column: 3;
            align-self: end;
            padding-bottom: 0.6em;
        }
    }

    .about-last {
        padding-bottom: var(--section);
    }

    :global(.about__links) {
        margin-top: 32px;
    }
</style>
