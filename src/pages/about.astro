---
import Base from "../layouts/BaseLayout.astro";
import ContactLinks from "../components/ContactLinks.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { pad } from "../lib/content";
import portrait from "../assets/me/rafaela.jpg";

// Skill groups from the content collection, by `order` then name
const skills = (await getCollection("skills")).sort((a, b) => {
    const byOrder = (a.data.order ?? 999) - (b.data.order ?? 999);
    return byOrder || a.data.category.localeCompare(b.data.category);
});

const traits = ["Adaptable", "Curious", "Proactive", "Communicative", "User-minded"];
---

<Base title="About" description="Rafaela Henriques, an Angolan-Portuguese developer studying Digital Design & Development at Howest in Belgium.">
    <!-- HEADER: name on the left, portrait on the right -->
    <header class="page-head wrap about-head">
        <div class="about-head__title">
            <p class="mono muted" data-reveal>About</p>
            <h1 class="display about-name" data-split>Rafaela Henriques</h1>
            <div class="about-head__links" data-reveal>
                <ContactLinks class="mono" />
            </div>
        </div>
        <figure class="about-portrait" data-about-portrait>
            <div class="about-portrait__frame" data-reveal-img>
                <div class="about-portrait__inner" data-about-parallax>
                <Image
                    src={portrait}
                    alt="Rafaela sitting on a stone quay by the water in the evening sun"
                    widths={[500, 900, 1400, 1800]}
                    sizes="(min-width: 900px) 34vw, 100vw"
                    loading="eager"
                    quality={88}
                />
                </div>
            </div>
        </figure>
    </header>

    <section class="wrap" aria-label="Profile">
        <div class="row">
            <p class="row__label mono muted">Profile</p>
            <div class="row__body">
                <p class="lead about-lead" data-split>
                    I’m Rafaela, an Angolan-Portuguese developer currently
                    studying Digital Design &amp; Development at Howest in Belgium.
                </p>
                <div class="about__columns" data-reveal>
                    <p>
                        I’ve spent much of my life moving between countries,
                        cultures and ways of thinking. Growing up in Angola,
                        living in Portugal and later moving to Belgium taught me
                        to adapt quickly, question what I already know and stay
                        open to different ways of approaching a problem.
                    </p>
                    <p>
                        I’m ambitious and deeply curious. I like understanding how
                        things work, but I’m rarely satisfied with knowing only my
                        part of the process. That curiosity took me from game
                        development into full-stack development, and it is also
                        why I chose an education that exposed me to design,
                        research and user experience. I want to understand the
                        whole process, not just the code I’m responsible for.
                    </p>
                    <p>
                        I’m drawn to unfamiliar environments and difficult
                        problems because that is where I learn the most. Whether
                        it is a new country, technology or way of working, I would
                        rather be challenged than stay with what I already know.
                    </p>
                </div>
                <p class="about-closing" data-split>
                    Ultimately, I want to become the kind of developer who can
                    move comfortably between technology, people and ideas — and
                    eventually use everything I learn to build something of my own.
                </p>
            </div>
        </div>
    </section>

    <!-- TRAITS: one big centred statement -->
    <section class="section wrap about-traits" aria-labelledby="traits">
        <h2 id="traits" class="mono muted about-center-label">Traits</h2>
        <p class="caps about-traits__text" data-split>
            {
                // the slash stays with the word before it, so no line starts with one
                traits.map((t, i) => (
                    <>
                        <span class="about-traits__word">{t}{i < traits.length - 1 && <span class="about-traits__slash">{"\u00a0/"}</span>}</span>{" "}
                    </>
                ))
            }
        </p>
    </section>

    <!-- SKILLS: numbered like a playbook -->
    <section class="section wrap" aria-labelledby="skills">
        <h2 id="skills" class="mono muted about-skills__label">What I work with</h2>
        <ol class="playbook">
            {
                skills.map((group, i) => (
                    <li class="playbook__item" data-reveal>
                        <span class="playbook__num">{pad(i + 1)}</span>
                        <h3 class="playbook__name">{group.data.category}</h3>
                        <p class="playbook__items mono">
                            <span aria-hidden="true">→</span> {group.data.items.join(", ")}
                        </p>
                    </li>
                ))
            }
        </ol>
    </section>

    <section class="section wrap about-last" aria-labelledby="availability">
        <div class="row">
            <h2 id="availability" class="row__label mono muted">Availability</h2>
            <div class="row__body">
                <p class="lead about-availability" data-split>
                    Open to software and web development internships in the UK,
                    US and Europe, and to projects where I can ship real features
                    as part of a team.
                </p>
                <div data-reveal>
                    <ContactLinks class="about__links mono" />
                </div>
            </div>
        </div>
    </section>
</Base>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    // the portrait drifts slower than the page, like it's further away
    gsap.matchMedia().add("(prefers-reduced-motion: no-preference) and (min-width: 900px)", () => {
        const portrait = document.querySelector<HTMLElement>("[data-about-portrait]");
        if (!portrait) return;
        gsap.fromTo(
            portrait.querySelector("[data-about-parallax]"),
            { yPercent: -5 },
            {
                yPercent: 5,
                ease: "none",
                scrollTrigger: { trigger: portrait, start: "top bottom", end: "bottom top", scrub: true },
            },
        );
    });
</script>

<style>
    /* --- HEADER --- */

    .about-head {
        display: grid;
        gap: clamp(32px, 5vw, 64px) var(--gutter);
    }

    .about-name {
        margin-top: 18px;
        max-width: 8ch;
    }

    .about-head__links {
        margin-top: clamp(20px, 3vw, 32px);
    }

    .about-portrait {
        margin: 0;
    }

    .about-portrait__frame {
        aspect-ratio: 3 / 4;
        overflow: hidden;
    }

    /* taller than the frame so the parallax never shows an edge */
    .about-portrait__inner {
        height: 112%;
        margin-top: -6%;
    }

    .about-portrait__frame :global(img) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 60%;
    }

    @media (min-width: 900px) {
        .about-head {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            align-items: end;
        }

        .about-head__title {
            grid-column: 1 / span 7;
        }

        .about-portrait {
            grid-column: 9 / span 4;
        }
    }

    /* --- PROFILE --- */

    .about-lead {
        max-width: 30ch;
    }

    /* the story flows down two columns, so three paragraphs stay balanced */
    .about__columns {
        margin-top: clamp(32px, 4vw, 56px);
        max-width: 60rem;
        color: var(--muted);
    }

    .about__columns p {
        margin: 0 0 1em;
    }

    @media (min-width: 900px) {
        .about__columns {
            columns: 2;
            column-gap: var(--gutter);
        }
    }

    /* where it's all heading: set apart, in the text colour */
    .about-closing {
        max-width: 34ch;
        margin: clamp(32px, 4vw, 56px) 0 0;
        padding-top: 14px;
        border-top: 1px solid var(--line);
        font-size: clamp(1.25rem, 1rem + 0.9vw, 1.75rem);
        line-height: 1.25;
        letter-spacing: -0.02em;
    }

    .about-availability {
        max-width: 30ch;
    }

    /* --- TRAITS --- */

    .about-center-label {
        margin: 0 0 clamp(20px, 3vw, 32px);
        text-align: center;
    }

    .about-traits__text {
        max-width: 22ch;
        font-size: clamp(2rem, 1rem + 4.4vw, 5.5rem);
    }

    .about-traits__word {
        white-space: nowrap;
    }

    .about-traits__slash {
        color: var(--muted);
        font-weight: 500;
    }

    /* --- SKILLS PLAYBOOK --- */

    .about-skills__label {
        margin: 0 0 14px;
    }

    .playbook {
        margin: 0;
        padding: 0;
        list-style: none;
        border-bottom: 1px solid var(--line);
    }

    .playbook__item {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 6px var(--gutter);
        align-items: baseline;
        padding-block: clamp(16px, 2vw, 28px);
        border-top: 1px solid var(--line);
    }

    .playbook__num,
    .playbook__name {
        font-size: clamp(2rem, 1rem + 3.6vw, 4.5rem);
        font-weight: 800;
        line-height: 0.95;
        letter-spacing: -0.04em;
        text-transform: uppercase;
    }

    .playbook__name {
        margin: 0;
    }

    .playbook__items {
        grid-column: 2;
        margin: 0;
        color: var(--muted);
    }

    @media (min-width: 900px) {
        .playbook__item {
            grid-template-columns: 8rem minmax(0, 1fr) minmax(0, 1fr);
        }

        .playbook__items {
            grid-column: 3;
            align-self: end;
            padding-bottom: 0.6em;
        }
    }

    .about-last {
        padding-bottom: var(--section);
    }

    :global(.about__links) {
        margin-top: 32px;
    }
</style>
