---
const email = "rafaela.henriques@student.howest.be";
const year = new Date().getFullYear();
---

<footer class="site-footer wrap">
    <div class="row">
        <p class="row__label mono muted">Contact</p>
        <div class="row__body">
            <a href={`mailto:${email}`} class="site-footer__cta display" data-split>
                Let's talk
            </a>
            <a href={`mailto:${email}`} class="site-footer__email link">{email}</a>
        </div>
    </div>

    <div class="site-footer__bar mono">
        <!-- CREATURE (sits on the rule, drag it sideways) -->
        <div class="footer-creature" aria-hidden="true">
            <div class="footer-creature__group">
                <div class="footer-creature__shadow"></div>

                <div class="footer-creature__body">
                    <div class="footer-creature__face">
                        <span class="footer-creature__eye"></span>
                        <span class="footer-creature__eye"></span>
                    </div>
                </div>

                <div class="footer-creature__z">Z</div>
            </div>
        </div>

        <span>© {year} Rafaela Henriques</span>
        <nav aria-label="Social">
            <a href="https://github.com/rafaelahenriques" class="link">GitHub</a>
        </nav>
        <a href="#top" class="link">Back to top ↑</a>
    </div>

    <script>
        import "../scripts/creature.js";
    </script>
</footer>

<style>
    .site-footer {
        margin-top: var(--section);
    }

    .site-footer__cta {
        display: block;
        width: fit-content;
    }

    .site-footer__email {
        display: inline-block;
        margin-top: 20px;
        font-size: var(--fs-body);
        overflow-wrap: anywhere;
    }

    .site-footer__bar {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 12px var(--gutter);
        margin-top: clamp(120px, 14vw, 200px);
        padding-block: 18px;
        border-top: 1px solid var(--line);
    }

    /* --- CREATURE --- */

    .footer-creature {
        position: absolute;
        bottom: 100%;
        left: calc(50% - 70px);
        pointer-events: none;
    }

    .footer-creature__group {
        position: relative;
        width: 140px;
        height: 90px;
        pointer-events: auto;
        cursor: grab;
    }

    .footer-creature__shadow {
        position: absolute;
        bottom: -6px;
        left: 50%;
        width: 90px;
        height: 12px;
        border-radius: 999px;
        transform: translateX(-50%);
        background: radial-gradient(
            ellipse at center,
            color-mix(in oklab, var(--text) 35%, transparent),
            transparent 70%
        );
        filter: blur(1px);
    }

    .footer-creature__body {
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 80px;
        height: 52px;
        border-radius: 999px 999px 0 0;
        transform: translateX(-50%);
        transform-origin: 50% 100%;
        background: var(--text);
    }

    .footer-creature__face {
        position: absolute;
        inset: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
    }

    /* Eyes: awake in light mode */
    .footer-creature__eye {
        position: relative;
        width: 8px;
        height: 13px;
        border-radius: 4px;
        background: var(--bg);
    }

    .footer-creature__eye::before,
    .footer-creature__eye::after {
        content: "";
        position: absolute;
        inset: 0;
        display: none;
    }

    /* Excited >< while dragged (light mode only) */
    .footer-creature--excited .footer-creature__eye {
        width: 16px;
        height: 16px;
        background: none;
    }

    .footer-creature--excited .footer-creature__eye::after {
        display: block;
        content: ">";
        inset: auto;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-family: var(--mono);
        font-size: 1.1rem;
        line-height: 1;
        white-space: nowrap;
        color: var(--bg);
    }

    .footer-creature--excited .footer-creature__eye + .footer-creature__eye::after {
        content: "<";
    }

    /* Dark mode: asleep */
    :global(html.dark) .footer-creature__eye {
        width: 12px;
        height: 6px;
        background: transparent;
    }

    :global(html.dark) .footer-creature__eye::before {
        display: block;
        border-bottom: 2px solid var(--bg);
        border-radius: 999px;
    }

    .footer-creature__z {
        position: absolute;
        bottom: 56px;
        left: 68%;
        font-family: var(--mono);
        color: var(--muted);
        opacity: 0;
        user-select: none;
        pointer-events: none;
    }
</style>
