---
/**
 * The end screen: inverted, with "let's talk" big, the pet in pixels in the
 * middle (drag it sideways; it sleeps in dark mode), and the contact links.
 */
import ContactLinks from "./ContactLinks.astro";
import { site } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="site-footer inverse">
    <p class="site-footer__status mono wrap">{site.availability}</p>

    <div class="site-footer__mid wrap">
        <a href={`mailto:${site.email}`} class="site-footer__cta display" data-split>
            Let's talk<span class="stop" aria-hidden="true"></span>
        </a>

        <!-- the pet (scripts/creature.js), drawn in pixels; drag it sideways -->
        <div class="footer-pet" data-pet data-cursor-link aria-hidden="true">
            <canvas width="20" height="22"></canvas>
        </div>

        <div class="site-footer__buttons">
            <a href={`mailto:${site.email}`} class="btn site-footer__email">{site.email} <span aria-hidden="true">✉</span></a>
            <a href="#top" class="btn">Back to top <span aria-hidden="true">↑</span></a>
        </div>
    </div>

    <div class="site-footer__bar wrap mono">
        <span>© {year} Rafaela Henriques</span>
        <ContactLinks />
        <span class="muted">50.83° N, 3.27° E</span>
    </div>

    <script>
        import "../scripts/creature.js";
    </script>
</footer>

<style>
    .site-footer {
        display: grid;
        grid-template-rows: auto 1fr auto;
        min-height: min(100svh, 920px);
        text-align: center;
    }

    /* a blinking blue pixel: open to work */
    .site-footer__status {
        margin: 0;
        padding-top: clamp(32px, 4vw, 48px);
    }

    .site-footer__status::before {
        content: "";
        display: inline-block;
        width: 8px;
        height: 8px;
        margin-right: 10px;
        background: var(--blue);
        vertical-align: 0;
        animation: stop-blink 1.1s steps(1) infinite;
    }

    .site-footer__mid {
        display: grid;
        place-items: center;
        align-content: center;
        gap: clamp(20px, 3vw, 32px);
        padding-block: clamp(48px, 7vw, 96px);
    }

    .site-footer__cta {
        display: block;
        width: fit-content;
        font-size: clamp(4.5rem, 1rem + 12vw, 15rem);
    }

    .footer-pet {
        width: clamp(160px, 16vw, 240px);
        cursor: grab;
        touch-action: pan-y;
    }

    .footer-pet canvas {
        display: block;
        width: 100%;
        height: auto;
        image-rendering: pixelated;
    }

    .site-footer__buttons {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
    }

    .site-footer__email {
        text-transform: none;
        overflow-wrap: anywhere;
        white-space: normal;
    }

    .site-footer__bar {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 12px var(--gutter);
        padding-block: 16px;
        border-top: 1px solid var(--line);
    }

    @media (prefers-reduced-motion: reduce) {
        .site-footer__status::before {
            animation: none;
        }
    }

    @media (max-width: 719px) {
        .site-footer__bar {
            flex-direction: column;
        }
    }
</style>
