<footer>
    <div class="footer-wrap">
        <small>© {new Date().getFullYear()} Rafaela</small>
        <nav aria-label="Footer">
            <a href="https://github.com/rafaelahenriques">GitHub</a>
            <span> · </span>
            <a href="mailto:rafaela.henriques@student.howest.be">Email</a>
        </nav>
    </div>

    <!-- CREATURE -->
    <div class="footer-creature">
        <div class="footer-creature__group">
            <div class="footer-creature__shadow"></div>

            <div class="footer-creature__body">
                <div class="footer-creature__face">
                    <span class="footer-creature__eye"></span>
                    <span class="footer-creature__eye"></span>
                </div>
            </div>

            <div class="footer-creature__z">Z</div>
        </div>
    </div>

    <script type="module" src="/creature.js"></script>
</footer>

<style>
    /* Base footer layout */

    footer {
        margin-top: var(--space-l);
        padding-block: var(--space-s);
        color: var(--muted);
        font-size: var(--fontsize--1);
        position: relative;
    }

    .footer-wrap {
        max-width: var(--max-width);
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: flex-start;
        position: relative;
        z-index: 3;
    }

    .footer-wrap nav {
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    @media (min-width: 720px) {
        .footer-wrap {
            flex-direction: row;
            justify-content: space-between;
        }
    }

    /* --- CREATURE --- */

    .footer-creature {
        position: absolute;
        bottom: 10px;
        left: 20rem;
        right: 0;
        display: flex;
        justify-content: center;
        pointer-events: none;
        z-index: 20;
    }

    .footer-creature__group {
        position: relative;
        width: 140px;
        height: 90px;
        pointer-events: auto;
    }

    .footer-creature__shadow {
        width: 90px;
        height: 14px;
        border-radius: 999px;
        background: radial-gradient(
            ellipse at center,
            rgba(0, 0, 0, 0.4),
            transparent 70%
        );
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        filter: blur(1px);
    }

    .footer-creature__body {
        width: 80px;
        height: 52px;
        border-radius: 999px;
        background: var(--accent);
        position: absolute;
        bottom: 8px;
        left: 50%;
        transform: translateX(-50%);
        box-shadow:
            0 8px 20px rgba(0, 0, 0, 0.25),
            0 0 0 2px color-mix(in oklab, var(--accent) 30%, transparent);
    }

    html.dark .footer-creature__body {
        box-shadow:
            0 10px 28px rgba(0, 0, 0, 0.6),
            0 0 0 2px color-mix(in oklab, var(--accent) 50%, transparent);
    }

    .footer-creature__face {
        position: absolute;
        inset: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
    }

    /* --- EYES --- */

    /* Base (light mode, calm / awake) */
    .footer-creature__eye {
        position: relative;
        width: 10px;
        height: 15px;
        border-radius: 5px;
        background: rgba(232, 249, 255, 0.95);
        overflow: hidden;
    }

    .footer-creature__eye::before,
    .footer-creature__eye::after {
        content: "";
        position: absolute;
        inset: 0;
        display: none; /* enabled in specific states below */
    }

   /* --- EXCITED EYES (light mode only, shows literal >< ) --- */

.footer-creature__group.footer-creature--excited .footer-creature__eye {
    background: none;
    width: 18px;
    height: 18px;
    position: relative;
}

.footer-creature__group.footer-creature--excited .footer-creature__eye::before,
.footer-creature__group.footer-creature--excited .footer-creature__eye::after {
    display: none; /* remove any previous drawing */
}

.footer-creature__group.footer-creature--excited .footer-creature__eye::after {
    display: block;
    content: "> <";
    font-family: var(--font-body);
    font-size: 2rem;
    font-weight: bold;
    color: rgba(232, 249, 255, 0.95);
    position: absolute;
    top: 5%;
    left: 50%;
    transform: translate(-50%, -55%);
    line-height: 1;
}

    /* DARK MODE = sleeping eyes (always, ignore excited class) */
    html.dark .footer-creature__eye {
        width: 14px;
        height: 6px;
        background: transparent;
        box-shadow: none;
    }

    html.dark .footer-creature__eye::before,
    html.dark .footer-creature__eye::after {
        display: none;
    }

    html.dark .footer-creature__eye::before {
        display: block;
        border-bottom: 2px solid rgba(255, 255, 255, 0.9);
        border-radius: 999px;
    }

    .footer-creature__z {
        position: absolute;
        bottom: 60px;
        left: 68%;
        font-family: var(--font-title);
        font-size: var(--fontsize-1);
        color: color-mix(in oklab, var(--text) 70%, transparent);
        opacity: 0;
        user-select: none;
        pointer-events: none;
    }

    @media (min-width: 1024px) {
        .footer-creature {
            position: relative;
            bottom: 15rem;
            left: auto;
            right: auto;
            justify-content: right;
        }

        .footer-creature__group {
            width: 200px;
            height: 130px;
        }

        .footer-creature__body {
            width: 130px;
            height: 95px;
            bottom: 10px;
        }

        .footer-creature__shadow {
            width: 140px;
            height: 20px;
        }

        .footer-creature__face {
            gap: 14px;
        }

        .footer-creature__eye {
            transform: scale(1.2);
        }
    }
</style>