---
/**
 * The end screen: inverted, with "let's talk" big, the pet in pixels in the
 * middle (a palanca negra: hover it for a fact, drag it sideways; it sleeps in
 * dark mode), and the contact links.
 */
import ContactLinks from "./ContactLinks.astro";
import { site } from "../lib/site";

const year = new Date().getFullYear();
const petFact = "I’m from Angola. This is the palanca negra gigante, our national symbol. It lives nowhere else.";
---

<footer class="site-footer inverse">
    <p class="site-footer__status mono wrap">{site.availability}</p>

    <div class="site-footer__mid wrap">
        <a href={`mailto:${site.email}`} class="site-footer__cta display" data-split>
            Let's talk<span class="stop" aria-hidden="true"></span>
        </a>

        <!-- the pet (scripts/creature.js), drawn in pixels; drag it sideways -->
        <div class="footer-pet" data-pet data-cursor-link role="img" aria-label={`A pixel palanca negra. ${petFact}`} tabindex="0">
            <canvas width="34" height="28"></canvas>
            <p class="footer-pet__fact mono" aria-hidden="true">{petFact}</p>
        </div>

        <div class="site-footer__buttons">
            <a href={`mailto:${site.email}`} class="btn site-footer__email">{site.email} <span aria-hidden="true">✉</span></a>
            <a href="#top" class="btn">Back to top <span aria-hidden="true">↑</span></a>
        </div>
    </div>

    <div class="site-footer__bar wrap mono">
        <span>© {year} Rafaela Henriques · <a href="/privacy/" class="link">Privacy</a></span>
        <ContactLinks />
        <!-- Lubango, Angola -->
        <span class="muted">14.92° S, 13.49° E</span>
    </div>

    <script>
        import "../scripts/creature.js";
    </script>
</footer>

<style>
    .site-footer {
        display: grid;
        grid-template-rows: auto 1fr auto;
        min-height: min(100svh, 920px);
        text-align: center;
    }

    /* a blinking blue pixel: open to work */
    .site-footer__status {
        margin: 0;
        padding-top: clamp(32px, 4vw, 48px);
    }

    .site-footer__status::before {
        content: "";
        display: inline-block;
        width: 8px;
        height: 8px;
        margin-right: 10px;
        background: var(--blue);
        vertical-align: 0;
        animation: stop-blink 1.1s steps(1) infinite;
    }

    .site-footer__mid {
        display: grid;
        place-items: center;
        align-content: center;
        gap: clamp(20px, 3vw, 32px);
        padding-block: clamp(48px, 7vw, 96px);
    }

    .site-footer__cta {
        display: block;
        width: fit-content;
        font-size: clamp(4.5rem, 1rem + 12vw, 15rem);
    }

    .footer-pet {
        position: relative;
        width: clamp(204px, 20vw, 306px);
        cursor: grab;
        touch-action: pan-y;
    }

    .footer-pet canvas {
        display: block;
        width: 100%;
        height: auto;
        image-rendering: pixelated;
    }

    /* its speech bubble, like a game's dialogue box; it travels with the pet */
    .footer-pet__fact {
        position: absolute;
        bottom: calc(100% + 12px);
        left: 50%;
        width: min(280px, 72vw);
        margin: 0;
        padding: 12px 14px;
        background: var(--text);
        color: var(--bg);
        text-align: left;
        opacity: 0;
        pointer-events: none;
        transform: translateX(-50%);
        transition: opacity 0.15s var(--step);
    }

    /* the bubble's tail: one square pixel */
    .footer-pet__fact::after {
        content: "";
        position: absolute;
        top: 100%;
        left: 50%;
        width: 12px;
        height: 12px;
        background: var(--text);
    }

    .footer-pet:hover .footer-pet__fact,
    .footer-pet:focus-visible .footer-pet__fact,
    .footer-pet.is-telling .footer-pet__fact {
        opacity: 1;
    }

    /* with room to spare it sits beside the pet, clear of "let's talk" */
    @media (min-width: 900px) {
        .footer-pet__fact {
            top: 34%;
            bottom: auto;
            left: calc(100% + 20px);
            transform: none;
        }

        .footer-pet__fact::after {
            top: 16px;
            left: -12px;
        }

        .footer-pet.tells-left .footer-pet__fact {
            right: calc(100% + 20px);
            left: auto;
        }

        .footer-pet.tells-left .footer-pet__fact::after {
            left: 100%;
        }
    }

    .site-footer__buttons {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
    }

    .site-footer__email {
        text-transform: none;
        overflow-wrap: anywhere;
        white-space: normal;
    }

    .site-footer__bar {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 12px var(--gutter);
        padding-block: 16px;
        border-top: 1px solid var(--line);
    }

    @media (prefers-reduced-motion: reduce) {
        .site-footer__status::before {
            animation: none;
        }
    }

    @media (max-width: 719px) {
        .site-footer__bar {
            flex-direction: column;
        }
    }
</style>
