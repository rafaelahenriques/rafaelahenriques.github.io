---
/**
 * A short screen recording that loops: an app on a phone, a website clip.
 * Muted and looping, it plays only while on screen and loads nothing until
 * it gets close; a Pause / Play button sits under it, and with reduced
 * motion it waits to be played. The poster is the first frame. It's never
 * taller than the window, so all of it can be seen at once. `sound` adds a
 * button for a recording worth hearing; it still starts muted.
 */
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    /** path under public/, e.g. "/media/mongmo/ordering.mp4" */
    src: string;
    poster: ImageMetadata;
    /** what the recording shows, for screen readers and the button */
    label: string;
    sound?: boolean;
}

const { src, poster, label, sound = false } = Astro.props;
const posterSrc = (await getImage({ src: poster, width: Math.min(poster.width, 1200), format: "webp", quality: 80 })).src;
---

<figure class="phone-video" data-phone-video style={`--ratio: ${poster.width / poster.height}`}>
    <video
        class="phone-video__video"
        muted
        loop
        playsinline
        preload="none"
        poster={posterSrc}
        width={poster.width}
        height={poster.height}
        aria-label={label}
    >
        <source src={src} type="video/mp4" />
    </video>
    <div class="phone-video__controls">
        <button type="button" class="phone-video__toggle mono" aria-label={`Play: ${label}`} data-phone-video-toggle>
            Play
        </button>
        {
            sound && (
                <button type="button" class="phone-video__toggle mono" aria-pressed="false" data-phone-video-sound>
                    Sound off
                </button>
            )
        }
    </div>
</figure>

<script>
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    document.querySelectorAll<HTMLElement>("[data-phone-video]").forEach((figure) => {
        const video = figure.querySelector("video")!;
        const button = figure.querySelector<HTMLButtonElement>("[data-phone-video-toggle]")!;
        const label = video.getAttribute("aria-label") ?? "";
        // the visitor's own choice wins over autoplay
        let userPaused = reduceMotion;
        let onScreen = false;

        const sync = () => {
            const playing = !video.paused;
            button.textContent = playing ? "Pause" : "Play";
            button.setAttribute("aria-label", `${playing ? "Pause" : "Play"}: ${label}`);
        };
        const play = () => video.play().catch(() => {});

        video.addEventListener("play", sync);
        video.addEventListener("pause", sync);

        const toggle = () => {
            if (video.paused) {
                userPaused = false;
                play();
            } else {
                userPaused = true;
                video.pause();
            }
        };
        button.addEventListener("click", toggle);
        video.addEventListener("click", toggle);

        // turning the sound on also starts it
        const soundButton = figure.querySelector<HTMLButtonElement>("[data-phone-video-sound]");
        soundButton?.addEventListener("click", () => {
            video.muted = !video.muted;
            soundButton.textContent = video.muted ? "Sound off" : "Sound on";
            soundButton.setAttribute("aria-pressed", String(!video.muted));
            if (!video.muted && video.paused) {
                userPaused = false;
                play();
            }
        });

        // start downloading a little before it scrolls in, play while it's visible
        new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting && video.preload === "none") video.preload = "auto";
            },
            { rootMargin: "50% 0px" },
        ).observe(figure);
        new IntersectionObserver(
            ([entry]) => {
                onScreen = entry.isIntersecting;
                if (onScreen && !userPaused) play();
                else if (!onScreen) video.pause();
            },
            { threshold: 0.35 },
        ).observe(figure);

        document.addEventListener("visibilitychange", () => {
            if (document.hidden) video.pause();
            else if (onScreen && !userPaused) play();
        });
    });
</script>

<style>
    /* centred unless the page lines it up with something (--video-align) */
    .phone-video {
        display: grid;
        justify-items: var(--video-align, center);
        gap: 8px;
        margin: 0;
    }

    /* the 96px leaves room for the header's gap and the buttons under it */
    .phone-video__video {
        display: block;
        width: min(100%, calc((100svh - var(--header-h) - 96px) * var(--ratio)));
        height: auto;
        cursor: pointer;
    }

    .phone-video__controls {
        display: flex;
        gap: 8px;
    }

    /* under the phone, so it never covers the app's own controls */
    .phone-video__toggle {
        padding: 4px 10px;
        border: 1px solid var(--line);
        background: none;
        color: var(--muted);
        cursor: pointer;
        transition:
            color 0.15s var(--step),
            border-color 0.15s var(--step),
            background-color 0.15s var(--step);
    }

    .phone-video__toggle:hover,
    .phone-video__toggle:focus-visible {
        border-color: var(--blue);
        background: var(--blue);
        color: #e9e7e2;
        outline: none;
    }
</style>
