---
/**
 * Text theme toggle. BaseLayout's <head> script applies the initial theme
 * (saved choice, else system); this switches it and follows system changes
 * until the visitor picks one manually.
 */
---

<button
    type="button"
    class="theme-toggle text-button"
    data-theme-toggle
    aria-pressed="false"
    aria-label="Switch to dark mode"
>
    <span class="theme-toggle__dot" aria-hidden="true"></span>
    <span data-theme-label>Light</span>
</button>

<style>
    .theme-toggle {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    /* a square, half ink half paper; it flips over in steps */
    .theme-toggle__dot {
        width: 10px;
        height: 10px;
        border: 1px solid currentColor;
        background: linear-gradient(90deg, currentColor 50%, transparent 50%);
        transition: transform 0.3s steps(2, end);
    }

    :global(html.dark) .theme-toggle__dot {
        transform: rotate(180deg);
    }

    /* icon only on small screens; aria-label still names the action */
    @media (max-width: 480px) {
        [data-theme-label] {
            display: none;
        }

        .theme-toggle__dot {
            width: 12px;
            height: 12px;
        }
    }
</style>

<script>
    const root = document.documentElement;
    const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    const label = document.querySelector<HTMLElement>("[data-theme-label]");
    const system = window.matchMedia("(prefers-color-scheme: dark)");

    const hasManualChoice = () => {
        try {
            const saved = localStorage.getItem("theme");
            return saved === "light" || saved === "dark";
        } catch {
            return false;
        }
    };

    const applyTheme = (theme: "light" | "dark") => {
        const isDark = theme === "dark";
        root.classList.toggle("dark", isDark);
        root.classList.toggle("light", !isDark);
        root.style.colorScheme = theme;
        button?.setAttribute("aria-pressed", String(isDark));
        button?.setAttribute("aria-label", isDark ? "Switch to light mode" : "Switch to dark mode");
        if (label) label.textContent = isDark ? "Dark" : "Light";
    };

    applyTheme(root.classList.contains("dark") ? "dark" : "light");

    button?.addEventListener("click", () => {
        const next = root.classList.contains("dark") ? "light" : "dark";
        try {
            localStorage.setItem("theme", next);
        } catch {}
        applyTheme(next);
    });

    system.addEventListener("change", (e) => {
        if (!hasManualChoice()) applyTheme(e.matches ? "dark" : "light");
    });
</script>
