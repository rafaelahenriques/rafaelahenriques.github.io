---
/**
 * Selected projects as a deck of cards. The top card can be dragged or
 * flicked away (it tucks in at the back), any title in the index pulls its
 * card to the top, and while nobody touches it the deck shuffles itself; a
 * line under the active title shows when. Cards are links to the projects.
 * Without JS it's a static stack with the first project on top.
 */
import { Image } from "astro:assets";
import { pad, slugOf, type ProjectEntry } from "../lib/content";

interface Props {
    projects: ProjectEntry[];
}

const { projects } = Astro.props;

const cards = projects.map((p, i) => ({
    num: pad(p.data.order ?? i + 1),
    title: p.data.title,
    category: p.data.category,
    year: p.data.year,
    inProgress: p.data.status === "in-progress",
    href: `/projects/${slugOf(p)}/`,
    image: p.data.media?.screenshot,
}));

// Resting spot of each card in the stack, as fractions of the card width
// (mirrored in the script). The first is the top card.
const SLOTS = [
    { x: 0, y: 0, r: -2, s: 1 },
    { x: 0.07, y: 0.04, r: 4, s: 0.96 },
    { x: -0.07, y: 0.07, r: -6, s: 0.92 },
    { x: 0.04, y: 0.1, r: 8, s: 0.88 },
];
const slotOf = (i: number) => SLOTS[Math.min(i, SLOTS.length - 1)];
---

<section class="deck-section wrap" aria-labelledby="selected" data-deck>
    <div class="deck-head">
        <h2 id="selected" class="mono muted">Selected projects</h2>
        <a href="/projects/" class="mono link">All projects →</a>
    </div>

    <div class="deck-layout">
        <div class="deck-info">
            <ol class="deck-index">
                {
                    cards.map((c, i) => (
                        <li>
                            <button type="button" class="deck-index__btn" data-deck-go={i} aria-pressed={String(i === 0)}>
                                <span class="mono">{c.num}</span>
                                <span class="deck-index__title">{c.title}</span>
                                <span class="deck-index__meta mono">
                                    {c.inProgress ? "In progress" : c.category}
                                </span>
                                <span class="deck-index__bar" aria-hidden="true" />
                            </button>
                        </li>
                    ))
                }
            </ol>
            <p class="deck-foot">
                <a href={cards[0].href} class="mono link" data-deck-cta>
                    View <span data-deck-cta-title>{cards[0].title}</span> →
                </a>
                <span class="deck-hint mono muted">Drag the card, or pick a title</span>
            </p>
        </div>

        <div class="deck" data-deck-stack>
            {
                cards.map((c, i) => {
                    const slot = slotOf(i);
                    return (
                        <a
                            href={c.href}
                            class="deck-card"
                            data-deck-card
                            draggable="false"
                            tabindex={i === 0 ? undefined : "-1"}
                            aria-hidden={i === 0 ? undefined : "true"}
                            style={`--x:${slot.x};--y:${slot.y};--r:${slot.r}deg;--s:${slot.s};z-index:${100 - i}`}
                        >
                            <div class="deck-card__media">
                                {c.image && (
                                    <Image
                                        src={c.image}
                                        alt=""
                                        widths={[400, 720]}
                                        sizes="(min-width: 900px) 360px, 68vw"
                                        draggable="false"
                                        loading="lazy"
                                    />
                                )}
                            </div>
                            <div class="deck-card__caption mono">
                                <span class="muted">{c.num}</span>
                                <span class="deck-card__title">{c.title}</span>
                                <span class="muted">{c.year}</span>
                            </div>
                        </a>
                    );
                })
            }
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { Draggable } from "gsap/Draggable";

    gsap.registerPlugin(Draggable);

    // same resting spots as the markup: fractions of the card width
    const SLOTS = [
        { x: 0, y: 0, r: -2, s: 1 },
        { x: 0.07, y: 0.04, r: 4, s: 0.96 },
        { x: -0.07, y: 0.07, r: -6, s: 0.92 },
        { x: 0.04, y: 0.1, r: 8, s: 0.88 },
    ];
    const AUTOPLAY = 5; // seconds per card while nobody's touching it

    const root = document.querySelector<HTMLElement>("[data-deck]");
    const stack = root?.querySelector<HTMLElement>("[data-deck-stack]");
    const cards = root ? [...root.querySelectorAll<HTMLAnchorElement>("[data-deck-card]")] : [];

    if (root && stack && cards.length > 1) {
        const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-deck-go]")];
        const bars = buttons.map((b) => b.querySelector<HTMLElement>(".deck-index__bar")!);
        const cta = root.querySelector<HTMLAnchorElement>("[data-deck-cta]")!;
        const ctaTitle = root.querySelector<HTMLElement>("[data-deck-cta-title]")!;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
        const speed = reduceMotion ? 0 : 1;

        let order = cards.map((_, i) => i); // order[0] is the card on top
        let busy = false;

        const width = () => cards[0].offsetWidth;
        const slotProps = (slot: number) => {
            const s = SLOTS[Math.min(slot, SLOTS.length - 1)];
            const w = width();
            return { x: s.x * w, y: s.y * w, rotation: s.r, scale: s.s };
        };
        // stacking order, once a move has finished
        const restack = () => order.forEach((ci, slot) => gsap.set(cards[ci], { zIndex: 100 - slot }));
        // only the top card is reachable by keyboard and screen readers
        const exposeTop = () =>
            order.forEach((ci, slot) => {
                cards[ci].tabIndex = slot === 0 ? 0 : -1;
                if (slot === 0) cards[ci].removeAttribute("aria-hidden");
                else cards[ci].setAttribute("aria-hidden", "true");
            });

        // GSAP owns the transforms from here; the CSS stack was the no-JS fallback.
        // With motion on, the cards wait out of sight to be dealt in.
        cards.forEach((c, i) => {
            c.style.transform = "none";
            gsap.set(c, { ...slotProps(i), transformPerspective: 900, autoAlpha: reduceMotion ? 1 : 0 });
        });

        // --- autoplay: the active title's line fills, then the deck moves on ---
        let bar: gsap.core.Tween | null = null;
        let hovering = false;
        let inView = false;
        const playing = () => !reduceMotion && inView && !hovering && !document.hidden;
        const startBar = () => {
            bar?.kill();
            bars.forEach((b) => gsap.set(b, { scaleX: 0 }));
            if (reduceMotion) return;
            bar = gsap.fromTo(
                bars[order[0]],
                { scaleX: 0 },
                { scaleX: 1, duration: AUTOPLAY, ease: "none", paused: !playing(), onComplete: () => advance(1) },
            );
        };
        const syncBar = () => (playing() ? bar?.resume() : bar?.pause());

        const updateInfo = () => {
            const top = order[0];
            buttons.forEach((b, i) => b.setAttribute("aria-pressed", String(i === top)));
            cta.setAttribute("href", cards[top].getAttribute("href")!);
            ctaTitle.textContent = buttons[top].querySelector(".deck-index__title")?.textContent ?? "";
            exposeTop();
            startBar();
            syncDraggables();
        };

        // --- the moves ---

        /** Throw the top card off to one side; it tucks in at the back. */
        function advance(dir: number) {
            if (busy) return;
            busy = true;
            const top = order[0];
            order = [...order.slice(1), top];
            const card = cards[top];
            const w = width();
            gsap.set(card, { zIndex: 200 });
            const tl = gsap.timeline({
                onComplete: () => {
                    busy = false;
                    restack();
                },
            });
            tl.to(card, { x: dir * w * 1.25, y: -w * 0.12, rotation: dir * 24, rotationX: 0, rotationY: 0, duration: 0.45 * speed, ease: "power2.in" })
                .set(card, { zIndex: 0 })
                .to(card, { ...slotProps(order.length - 1), duration: 0.6 * speed, ease: "power3.out" });
            order.slice(0, -1).forEach((ci, slot) => {
                gsap.set(cards[ci], { zIndex: 100 - slot });
                tl.to(cards[ci], { ...slotProps(slot), duration: 0.6 * speed, ease: "power3.out" }, 0.18 * speed);
            });
            updateInfo();
        }

        /** Pull a card out of the deck and lay it on top. */
        function bringToFront(ci: number) {
            if (busy || order[0] === ci) return;
            busy = true;
            order = [ci, ...order.filter((c) => c !== ci)];
            const card = cards[ci];
            const w = width();
            const tl = gsap.timeline({
                onComplete: () => {
                    busy = false;
                    restack();
                },
            });
            tl.to(card, { x: w * 0.85, y: -w * 0.06, rotation: 14, duration: 0.35 * speed, ease: "power2.out" })
                .set(card, { zIndex: 200 })
                .to(card, { ...slotProps(0), duration: 0.55 * speed, ease: "power3.inOut" });
            order.slice(1).forEach((c, i) => tl.to(cards[c], { ...slotProps(i + 1), duration: 0.6 * speed, ease: "power3.out" }, 0.1 * speed));
            updateInfo();
        }

        // --- drag / flick the top card ---
        const draggables = cards.map((card) =>
            Draggable.create(card, {
                type: finePointer ? "x,y" : "x", // touch: horizontal swipes, page still scrolls
                dragClickables: true,
                minimumMovement: 6,
                onPress() {
                    bar?.pause();
                    gsap.to(card, { rotationX: 0, rotationY: 0, duration: 0.3 });
                },
                onDrag() {
                    gsap.set(card, { rotation: SLOTS[0].r + this.x * 0.06 });
                },
                onRelease() {
                    // pressed without dragging: the click opens the project
                    if (!this.isDragging) return syncBar();
                },
                onDragEnd() {
                    const w = width();
                    if (Math.abs(this.x) > w * 0.28) advance(Math.sign(this.x));
                    else {
                        gsap.to(card, { ...slotProps(0), duration: 0.7 * speed, ease: "elastic.out(1, 0.6)" });
                        syncBar();
                    }
                },
            })[0],
        );
        function syncDraggables() {
            draggables.forEach((d, ci) => (ci === order[0] ? d.enable() : d.disable()));
        }

        // --- the top card leans towards the cursor ---
        if (finePointer && !reduceMotion) {
            stack.addEventListener("pointermove", (e) => {
                const card = cards[order[0]];
                if (busy || draggables[order[0]].isPressed) return;
                const r = card.getBoundingClientRect();
                const dx = (e.clientX - (r.left + r.width / 2)) / r.width;
                const dy = (e.clientY - (r.top + r.height / 2)) / r.height;
                gsap.to(card, { rotationY: dx * 10, rotationX: -dy * 10, duration: 0.6, ease: "power3.out", overwrite: "auto" });
            });
            stack.addEventListener("pointerleave", () => {
                if (!busy) gsap.to(cards[order[0]], { rotationX: 0, rotationY: 0, duration: 0.8, ease: "power3.out" });
            });
        }

        // --- the index ---
        buttons.forEach((b, i) => b.addEventListener("click", () => bringToFront(i)));

        // pause the shuffle while someone is looking closely or using the keyboard
        root.addEventListener("pointerenter", () => {
            hovering = true;
            syncBar();
        });
        root.addEventListener("pointerleave", () => {
            hovering = false;
            syncBar();
        });
        root.addEventListener("focusin", () => {
            hovering = true;
            syncBar();
        });
        root.addEventListener("focusout", () => {
            hovering = root.matches(":hover");
            syncBar();
        });
        document.addEventListener("visibilitychange", syncBar);

        // deal the cards in the first time the deck comes into view
        let dealt = reduceMotion;
        const deal = () => {
            if (dealt) return;
            dealt = true;
            // bottom card first, each one landing on the pile with a little twist
            [...order].reverse().forEach((ci, i) => {
                const slot = order.indexOf(ci);
                const rest = slotProps(slot);
                gsap.fromTo(
                    cards[ci],
                    { x: rest.x, y: rest.y + width() * 0.6, rotation: i % 2 ? 14 : -12, autoAlpha: 0 },
                    { ...rest, autoAlpha: 1, duration: 0.9, ease: "expo.out", delay: i * 0.12 },
                );
            });
        };
        const waitForLoader = () =>
            document.documentElement.classList.contains("is-loading")
                ? new Promise<void>((resolve) => {
                      window.addEventListener("loader:done", () => resolve(), { once: true });
                      setTimeout(resolve, 5500);
                  })
                : Promise.resolve();

        const io = new IntersectionObserver(
            ([entry]) => {
                inView = entry.isIntersecting;
                if (inView) waitForLoader().then(deal);
                syncBar();
            },
            { threshold: 0.35 },
        );
        io.observe(stack);

        // the card size follows the viewport; keep the stack in shape
        window.addEventListener("resize", () => {
            if (!busy) order.forEach((ci, slot) => gsap.set(cards[ci], slotProps(slot)));
        });

        updateInfo();
        restack();
    }
</script>

<style>
    .deck-section {
        padding-block: var(--section);
        /* thrown cards leave the screen instead of widening the page */
        overflow-x: clip;
    }

    .deck-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--gutter);
        padding-top: 14px;
        border-top: 1px solid var(--line);
    }

    .deck-head h2 {
        margin: 0;
    }

    .deck-layout {
        display: grid;
        gap: clamp(40px, 6vw, 64px) var(--gutter);
        margin-top: clamp(40px, 6vw, 80px);
    }

    /* --- the index --- */

    .deck-index {
        margin: 0;
        padding: 0;
        list-style: none;
        border-bottom: 1px solid var(--line);
    }

    .deck-index li {
        border-top: 1px solid var(--line);
    }

    .deck-index__btn {
        position: relative;
        display: grid;
        grid-template-columns: 2.5rem minmax(0, 1fr) auto;
        align-items: baseline;
        gap: var(--gutter);
        width: 100%;
        padding: clamp(14px, 1.8vw, 22px) 0;
        border: 0;
        background: none;
        color: var(--muted);
        font: inherit;
        text-align: left;
        cursor: pointer;
        transition:
            color 0.4s var(--ease),
            padding 0.6s var(--ease);
    }

    .deck-index__btn:hover,
    .deck-index__btn[aria-pressed="true"] {
        color: var(--text);
    }

    .deck-index__btn[aria-pressed="true"] {
        padding-left: 12px;
    }

    .deck-index__title {
        font-size: var(--fs-lead);
        line-height: 1.1;
        letter-spacing: -0.03em;
    }

    /* fills while the card is on top; when it's full the deck moves on */
    .deck-index__bar {
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        height: 1px;
        background: var(--text);
        transform: scaleX(0);
        transform-origin: left;
    }

    .deck-foot {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px var(--gutter);
        margin: 20px 0 0;
    }

    @media (max-width: 599px) {
        .deck-index__meta {
            display: none;
        }

        .deck-index__btn {
            grid-template-columns: 2.5rem minmax(0, 1fr);
        }
    }

    /* --- the deck --- */

    .deck {
        --card-w: min(360px, 68vw);
        position: relative;
        /* card (4:5 image + caption) plus room for the cards fanned behind it */
        height: calc(var(--card-w) * 1.25 + var(--card-w) * 0.22 + 64px);
        order: -1;
    }

    .deck-card {
        position: absolute;
        top: 0;
        left: 50%;
        width: var(--card-w);
        margin-left: calc(var(--card-w) / -2);
        padding: 10px;
        background: var(--bg);
        border: 1px solid var(--line);
        box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.35);
        /* no-JS stack; GSAP takes over the transform */
        transform: translate(calc(var(--x) * var(--card-w)), calc(var(--y) * var(--card-w))) rotate(var(--r)) scale(var(--s));
        cursor: grab;
        touch-action: pan-y;
        user-select: none;
        -webkit-user-select: none;
        -webkit-tap-highlight-color: transparent;
    }

    .deck-card:active {
        cursor: grabbing;
    }

    :global(html.dark) .deck-card {
        box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.8);
    }

    .deck-card__media {
        aspect-ratio: 4 / 5;
        overflow: hidden;
        background: color-mix(in oklab, var(--text) 6%, var(--bg));
    }

    .deck-card__media :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        pointer-events: none;
    }

    .deck-card__caption {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        gap: 12px;
        padding: 12px 2px 2px;
    }

    .deck-card__title {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    @media (min-width: 900px) {
        .deck-layout {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            align-items: center;
        }

        .deck-info {
            grid-column: 1 / span 5;
        }

        .deck {
            grid-column: 7 / -1;
            order: 0;
        }
    }
</style>
