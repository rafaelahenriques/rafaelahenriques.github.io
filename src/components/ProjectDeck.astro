---
/**
 * Selected projects as a deck of cards. Grab the deck anywhere and drag or
 * flick the top card away (it tucks in at the back); a two-finger trackpad
 * swipe, the arrow keys and the ← → buttons do the same, and any title in
 * the index pulls its card to the top. While nobody touches it the deck
 * shuffles itself (a line under the active title shows when); the first
 * manual move hands control to the visitor for good. Cards are links to the
 * projects. Without JS it's a static stack with the first project on top.
 */
import { Image } from "astro:assets";
import { pad, slugOf, type ProjectEntry } from "../lib/content";

interface Props {
    projects: ProjectEntry[];
}

const { projects } = Astro.props;

const cards = projects.map((p, i) => ({
    num: pad(p.data.order ?? i + 1),
    title: p.data.title,
    category: p.data.category,
    year: p.data.year,
    inProgress: p.data.status === "in-progress",
    href: `/projects/${slugOf(p)}/`,
    image: p.data.media?.screenshot,
}));

// Resting spot of each card in the stack, as fractions of the card width
// (mirrored in the script). The first is the top card.
const SLOTS = [
    { x: 0, y: 0, r: -2, s: 1 },
    { x: 0.07, y: 0.04, r: 4, s: 0.96 },
    { x: -0.07, y: 0.07, r: -6, s: 0.92 },
    { x: 0.04, y: 0.1, r: 8, s: 0.88 },
];
const slotOf = (i: number) => SLOTS[Math.min(i, SLOTS.length - 1)];
---

<section class="deck-section wrap" aria-labelledby="selected" data-deck>
    <div class="deck-head">
        <h2 id="selected" class="mono muted">Selected projects</h2>
        <a href="/projects/" class="mono link">All projects →</a>
    </div>

    <div class="deck-layout">
        <div class="deck-info">
            <ol class="deck-index">
                {
                    cards.map((c, i) => (
                        <li>
                            <button type="button" class="deck-index__btn" data-deck-go={i} aria-pressed={i === 0 ? "true" : "false"}>
                                <span class="mono">{c.num}</span>
                                <span class="deck-index__title">{c.title}</span>
                                <span class="deck-index__meta mono">
                                    {c.inProgress ? <span class="wip">In progress</span> : c.category}
                                </span>
                                <span class="deck-index__bar" aria-hidden="true" />
                            </button>
                        </li>
                    ))
                }
            </ol>
            <p class="deck-foot">
                <a href={cards[0].href} class="mono link" data-deck-cta>
                    View <span data-deck-cta-title>{cards[0].title}</span> →
                </a>
            </p>
        </div>

        <div class="deck-col">
        <div class="deck" data-deck-stack>
            {
                cards.map((c, i) => {
                    const slot = slotOf(i);
                    return (
                        <a
                            href={c.href}
                            class="deck-card"
                            data-deck-card
                            draggable="false"
                            tabindex={i === 0 ? undefined : "-1"}
                            aria-hidden={i === 0 ? undefined : "true"}
                            style={`--x:${slot.x};--y:${slot.y};--r:${slot.r}deg;--s:${slot.s};z-index:${100 - i}`}
                        >
                            <div class="deck-card__media">
                                {c.inProgress && <span class="wip wip--on-media">In progress</span>}
                                {c.image && (
                                    <Image
                                        src={c.image}
                                        alt=""
                                        widths={[400, 720]}
                                        sizes="(min-width: 900px) 360px, 68vw"
                                        draggable="false"
                                        loading="lazy"
                                    />
                                )}
                            </div>
                            <div class="deck-card__caption mono">
                                <span class="muted">{c.num}</span>
                                <span class="deck-card__title">{c.title}</span>
                                <span class="muted">{c.year}</span>
                            </div>
                        </a>
                    );
                })
            }
        </div>
        <div class="deck-controls">
            <button type="button" class="deck-controls__btn" data-deck-prev aria-label="Previous project">←</button>
            <span class="deck-hint mono muted">Swipe or drag the cards</span>
            <button type="button" class="deck-controls__btn" data-deck-next aria-label="Next project">→</button>
        </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { Draggable } from "gsap/Draggable";

    gsap.registerPlugin(Draggable);

    // same resting spots as the markup: fractions of the card width
    const SLOTS = [
        { x: 0, y: 0, r: -2, s: 1 },
        { x: 0.07, y: 0.04, r: 4, s: 0.96 },
        { x: -0.07, y: 0.07, r: -6, s: 0.92 },
        { x: 0.04, y: 0.1, r: 8, s: 0.88 },
    ];
    const AUTOPLAY = 5; // seconds per card while nobody's touching it
    const THROW_DISTANCE = 0.22; // of the card width
    const THROW_SPEED = 0.5; // px per ms: a quick flick throws even if it's short

    const root = document.querySelector<HTMLElement>("[data-deck]");
    const stack = root?.querySelector<HTMLElement>("[data-deck-stack]");
    const cards = root ? [...root.querySelectorAll<HTMLAnchorElement>("[data-deck-card]")] : [];

    if (root && stack && cards.length > 1) {
        const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-deck-go]")];
        const bars = buttons.map((b) => b.querySelector<HTMLElement>(".deck-index__bar")!);
        const cta = root.querySelector<HTMLAnchorElement>("[data-deck-cta]")!;
        const ctaTitle = root.querySelector<HTMLElement>("[data-deck-cta-title]")!;
        const prevButton = root.querySelector<HTMLButtonElement>("[data-deck-prev]")!;
        const nextButton = root.querySelector<HTMLButtonElement>("[data-deck-next]")!;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
        const speed = reduceMotion ? 0 : 1;

        let order = cards.map((_, i) => i); // order[0] is the card on top
        let move: gsap.core.Timeline | null = null; // the move in progress, if any

        const width = () => cards[0].offsetWidth;
        const slotProps = (slot: number) => {
            const s = SLOTS[Math.min(slot, SLOTS.length - 1)];
            const w = width();
            return { x: s.x * w, y: s.y * w, rotation: s.r, scale: s.s };
        };
        // stacking order, once a move has finished
        const restack = () => order.forEach((ci, slot) => gsap.set(cards[ci], { zIndex: 100 - slot }));
        // only the top card is clickable and reachable by keyboard and screen readers
        const exposeTop = () =>
            order.forEach((ci, slot) => {
                const top = slot === 0;
                cards[ci].tabIndex = top ? 0 : -1;
                cards[ci].classList.toggle("is-top", top);
                if (top) cards[ci].removeAttribute("aria-hidden");
                else cards[ci].setAttribute("aria-hidden", "true");
            });
        // a new move never waits or gets dropped: the one before it jumps to its end
        const finishMove = () => {
            if (move?.isActive()) move.progress(1);
        };

        // GSAP owns the transforms from here; the CSS stack was the no-JS fallback.
        // With motion on, the cards wait out of sight to be dealt in.
        cards.forEach((c, i) => {
            c.style.transform = "none";
            gsap.set(c, { ...slotProps(i), transformPerspective: 900, autoAlpha: reduceMotion ? 1 : 0 });
        });

        // --- autoplay: the active title's line fills, then the deck moves on ---
        let bar: gsap.core.Tween | null = null;
        let hovering = false;
        let inView = false;
        let manual = false; // set by the first move the visitor makes
        const playing = () => !reduceMotion && !manual && inView && !hovering && !document.hidden;
        const startBar = () => {
            bar?.kill();
            bars.forEach((b) => gsap.set(b, { scaleX: 0 }));
            if (reduceMotion || manual) return;
            bar = gsap.fromTo(
                bars[order[0]],
                { scaleX: 0 },
                { scaleX: 1, duration: AUTOPLAY, ease: "none", paused: !playing(), onComplete: () => advance(1) },
            );
        };
        const syncBar = () => (playing() ? bar?.resume() : bar?.pause());
        /** The visitor has taken over: no more shuffling on its own. */
        const takeOver = () => {
            if (manual) return;
            manual = true;
            bar?.kill();
            bars.forEach((b) => gsap.set(b, { scaleX: 0 }));
            root.classList.add("is-manual");
        };

        const updateInfo = () => {
            const top = order[0];
            buttons.forEach((b, i) => b.setAttribute("aria-pressed", String(i === top)));
            cta.setAttribute("href", cards[top].getAttribute("href")!);
            ctaTitle.textContent = buttons[top].querySelector(".deck-index__title")?.textContent ?? "";
            exposeTop();
            startBar();
            syncDraggables();
        };

        // --- the two moves ---

        /** Throw the top card off to one side; it tucks in at the back. */
        function advance(dir: number) {
            finishMove();
            const top = order[0];
            order = [...order.slice(1), top];
            const card = cards[top];
            const w = width();
            gsap.set(card, { zIndex: 200 });
            move = gsap.timeline({ onComplete: restack });
            move.to(card, { x: dir * w * 1.25, y: -w * 0.12, rotation: dir * 24, rotationX: 0, rotationY: 0, duration: 0.45 * speed, ease: "power2.in" })
                .set(card, { zIndex: 0 })
                .to(card, { ...slotProps(order.length - 1), duration: 0.6 * speed, ease: "power3.out" });
            order.slice(0, -1).forEach((ci, slot) => {
                gsap.set(cards[ci], { zIndex: 100 - slot });
                move!.to(cards[ci], { ...slotProps(slot), duration: 0.6 * speed, ease: "power3.out" }, 0.18 * speed);
            });
            updateInfo();
        }

        /** Pull a card out of the deck and lay it on top. */
        function bringToFront(ci: number) {
            finishMove();
            if (order[0] === ci) return;
            order = [ci, ...order.filter((c) => c !== ci)];
            const card = cards[ci];
            const w = width();
            move = gsap.timeline({ onComplete: restack });
            move.to(card, { x: w * 0.85, y: -w * 0.06, rotation: 14, duration: 0.35 * speed, ease: "power2.out" })
                .set(card, { zIndex: 200 })
                .to(card, { ...slotProps(0), duration: 0.55 * speed, ease: "power3.inOut" });
            order.slice(1).forEach((c, i) => move!.to(cards[c], { ...slotProps(i + 1), duration: 0.6 * speed, ease: "power3.out" }, 0.1 * speed));
            updateInfo();
        }

        const next = () => {
            takeOver();
            advance(1);
        };
        const previous = () => {
            takeOver();
            bringToFront(order[order.length - 1]);
        };

        // --- drag or flick: press anywhere on the deck, the top card comes along ---
        let samples: { x: number; t: number }[] = [];
        const draggables = cards.map((card) =>
            Draggable.create(card, {
                trigger: stack,
                type: finePointer ? "x,y" : "x", // touch: horizontal swipes, the page still scrolls
                dragClickables: true,
                minimumMovement: 6,
                cursor: "grab",
                activeCursor: "grabbing",
                onPress() {
                    bar?.pause();
                    if (move?.isActive()) {
                        finishMove();
                        this.update();
                    }
                    gsap.to(card, { rotationX: 0, rotationY: 0, duration: 0.3, overwrite: "auto" });
                    samples = [];
                },
                onDragStart() {
                    takeOver();
                },
                onDrag() {
                    gsap.set(card, { rotation: SLOTS[0].r + this.x * 0.06 });
                    samples.push({ x: this.x, t: performance.now() });
                    if (samples.length > 5) samples.shift();
                },
                onRelease() {
                    // pressed without dragging: the click opens the project
                    if (!this.isDragging) syncBar();
                },
                onDragEnd() {
                    const first = samples[0];
                    const last = samples[samples.length - 1];
                    const velocity = first && last && last.t > first.t ? (last.x - first.x) / (last.t - first.t) : 0;
                    const far = Math.abs(this.x) > width() * THROW_DISTANCE;
                    const flicked = Math.abs(velocity) > THROW_SPEED && Math.sign(velocity) === Math.sign(this.x);
                    if (far || flicked) advance(Math.sign(this.x) || 1);
                    else gsap.to(card, { ...slotProps(0), duration: 0.7 * speed, ease: "elastic.out(1, 0.6)" });
                },
            })[0],
        );
        function syncDraggables() {
            draggables.forEach((d, ci) => (ci === order[0] ? d.enable() : d.disable()));
        }

        // --- two-finger trackpad swipe ---
        let swipe = 0;
        let swipeLockedUntil = 0;
        stack.addEventListener(
            "wheel",
            (e) => {
                // vertical scrolling passes straight through to the page
                if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
                // horizontal: it's for the deck (and not the browser's back gesture)
                e.preventDefault();
                const now = performance.now();
                if (now < swipeLockedUntil) {
                    // the same swipe's momentum keeps arriving; ignore it until it stops
                    swipeLockedUntil = now + 250;
                    return;
                }
                swipe += e.deltaX;
                if (Math.abs(swipe) > 40) {
                    takeOver();
                    advance(swipe > 0 ? -1 : 1);
                    swipe = 0;
                    swipeLockedUntil = now + 600;
                }
            },
            { passive: false },
        );

        // --- buttons and keys ---
        prevButton.addEventListener("click", previous);
        nextButton.addEventListener("click", next);
        buttons.forEach((b, i) =>
            b.addEventListener("click", () => {
                takeOver();
                bringToFront(i);
            }),
        );
        root.addEventListener("keydown", (e) => {
            if (e.key === "ArrowRight") next();
            else if (e.key === "ArrowLeft") previous();
            else return;
            e.preventDefault();
        });

        // --- the top card leans towards the cursor ---
        if (finePointer && !reduceMotion) {
            stack.addEventListener("pointermove", (e) => {
                const card = cards[order[0]];
                if (move?.isActive() || draggables[order[0]].isPressed) return;
                const r = card.getBoundingClientRect();
                const dx = (e.clientX - (r.left + r.width / 2)) / r.width;
                const dy = (e.clientY - (r.top + r.height / 2)) / r.height;
                gsap.to(card, { rotationY: dx * 10, rotationX: -dy * 10, duration: 0.6, ease: "power3.out", overwrite: "auto" });
            });
            stack.addEventListener("pointerleave", () => {
                if (!move?.isActive()) gsap.to(cards[order[0]], { rotationX: 0, rotationY: 0, duration: 0.8, ease: "power3.out" });
            });
        }

        // pause the shuffle while someone is looking closely or using the keyboard
        root.addEventListener("pointerenter", () => {
            hovering = true;
            syncBar();
        });
        root.addEventListener("pointerleave", () => {
            hovering = false;
            syncBar();
        });
        root.addEventListener("focusin", () => {
            hovering = true;
            syncBar();
        });
        root.addEventListener("focusout", () => {
            hovering = root.matches(":hover");
            syncBar();
        });
        document.addEventListener("visibilitychange", syncBar);

        // deal the cards in the first time the deck comes into view
        let dealt = reduceMotion;
        const deal = () => {
            if (dealt) return;
            dealt = true;
            // bottom card first, each one landing on the pile with a little twist
            move = gsap.timeline({ onComplete: restack });
            [...order].reverse().forEach((ci, i) => {
                const rest = slotProps(order.indexOf(ci));
                move!.fromTo(
                    cards[ci],
                    { x: rest.x, y: rest.y + width() * 0.6, rotation: i % 2 ? 14 : -12, autoAlpha: 0 },
                    { ...rest, autoAlpha: 1, duration: 0.9, ease: "expo.out" },
                    i * 0.12,
                );
            });
        };
        const waitForLoader = () =>
            document.documentElement.classList.contains("is-loading")
                ? new Promise<void>((resolve) => {
                      window.addEventListener("loader:done", () => resolve(), { once: true });
                      setTimeout(resolve, 5500);
                  })
                : Promise.resolve();

        const io = new IntersectionObserver(
            ([entry]) => {
                inView = entry.isIntersecting;
                if (inView) waitForLoader().then(deal);
                syncBar();
            },
            { threshold: 0.35 },
        );
        io.observe(stack);

        // the card size follows the viewport; keep the stack in shape
        window.addEventListener("resize", () => {
            finishMove();
            order.forEach((ci, slot) => gsap.set(cards[ci], slotProps(slot)));
        });

        updateInfo();
        restack();
    }
</script>

<style>
    .deck-section {
        padding-block: var(--section);
        /* thrown cards leave the screen instead of widening the page */
        overflow-x: clip;
    }

    .deck-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--gutter);
        padding-top: 14px;
        border-top: 1px solid var(--line);
    }

    .deck-head h2 {
        margin: 0;
    }

    .deck-layout {
        display: grid;
        gap: clamp(40px, 6vw, 64px) var(--gutter);
        margin-top: clamp(40px, 6vw, 80px);
    }

    /* --- the index --- */

    .deck-index {
        margin: 0;
        padding: 0;
        list-style: none;
        border-bottom: 1px solid var(--line);
    }

    .deck-index li {
        border-top: 1px solid var(--line);
    }

    .deck-index__btn {
        position: relative;
        display: grid;
        grid-template-columns: 2.5rem minmax(0, 1fr);
        align-items: baseline;
        gap: var(--gutter);
        width: 100%;
        padding: clamp(14px, 1.8vw, 22px) 0;
        border: 0;
        background: none;
        color: var(--muted);
        font: inherit;
        text-align: left;
        cursor: pointer;
        transition:
            color 0.4s var(--ease),
            padding 0.6s var(--ease);
    }

    .deck-index__btn:hover,
    .deck-index__btn[aria-pressed="true"] {
        color: var(--text);
    }

    .deck-index__btn[aria-pressed="true"] {
        padding-left: 12px;
    }

    .deck-index__title {
        font-size: var(--fs-lead);
        line-height: 1.1;
        letter-spacing: -0.03em;
    }

    /* fills while the card is on top; when it's full the deck moves on */
    .deck-index__bar {
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        height: 1px;
        background: var(--text);
        transform: scaleX(0);
        transform-origin: left;
    }

    .deck-foot {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px var(--gutter);
        margin: 20px 0 0;
    }

    /* the category sits under the title, and beside it once there's room */
    .deck-index__meta {
        grid-column: 2;
        margin-top: 6px;
        color: var(--muted);
    }

    @media (min-width: 600px) and (max-width: 899px), (min-width: 1280px) {
        .deck-index__btn {
            grid-template-columns: 2.5rem minmax(0, 1fr) auto;
        }

        .deck-index__meta {
            grid-column: 3;
            margin-top: 0;
            color: inherit;
        }
    }

    /* --- the deck --- */

    .deck-col {
        order: -1;
        min-width: 0;
    }

    .deck {
        --card-w: min(360px, 68vw);
        position: relative;
        /* card (4:5 image + caption) plus room for the cards fanned behind it */
        height: calc(var(--card-w) * 1.25 + var(--card-w) * 0.22 + 64px);
        /* the cards' z-indexes stay inside the deck, never above the header or the loader */
        isolation: isolate;
        /* the whole deck is the handle: grab anywhere, the top card comes along */
        cursor: grab;
        touch-action: pan-y;
        overscroll-behavior-x: contain;
        user-select: none;
        -webkit-user-select: none;
    }

    .deck:active {
        cursor: grabbing;
    }

    .deck-controls {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 16px;
        margin-top: 8px;
    }

    .deck-controls__btn {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border: 1px solid var(--line);
        border-radius: 50%;
        background: none;
        color: var(--text);
        font: inherit;
        cursor: pointer;
        transition:
            border-color 0.3s var(--ease),
            background-color 0.3s var(--ease),
            color 0.3s var(--ease);
    }

    .deck-controls__btn:hover,
    .deck-controls__btn:focus-visible {
        border-color: var(--text);
    }

    .deck-controls__btn:active {
        background: var(--text);
        color: var(--bg);
    }

    /* once the visitor is in charge, the autoplay lines go */
    .deck-section.is-manual .deck-index__bar {
        display: none;
    }

    .deck-card {
        position: absolute;
        top: 0;
        left: 50%;
        width: var(--card-w);
        margin-left: calc(var(--card-w) / -2);
        padding: 10px;
        background: var(--bg);
        border: 1px solid var(--line);
        box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.35);
        /* no-JS stack; GSAP takes over the transform */
        transform: translate(calc(var(--x) * var(--card-w)), calc(var(--y) * var(--card-w))) rotate(var(--r)) scale(var(--s));
        -webkit-tap-highlight-color: transparent;
    }

    /* with JS, only the top card takes clicks; a press on the cards behind it
       lands on the deck, which drags the top card */
    :global(html.js) .deck-card:not(.is-top) {
        pointer-events: none;
    }

    :global(html.dark) .deck-card {
        box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.8);
    }

    .deck-card__media {
        position: relative;
        aspect-ratio: 4 / 5;
        overflow: hidden;
        background: color-mix(in oklab, var(--text) 6%, var(--bg));
    }

    .deck-card__media :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        pointer-events: none;
    }

    .deck-card__caption {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        gap: 12px;
        padding: 12px 2px 2px;
    }

    .deck-card__title {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    @media (min-width: 900px) {
        .deck-layout {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            align-items: center;
        }

        .deck-info {
            grid-column: 1 / span 6;
        }

        .deck-col {
            grid-column: 7 / -1;
            order: 0;
        }
    }
</style>
