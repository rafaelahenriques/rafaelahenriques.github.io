---
/**
 * Selected projects on an old TV. Each project is a channel: its clip plays on
 * the screen (src/scripts/tv.ts), and beside it a short note says what it is,
 * when and with what. The channel buttons under the TV are tabs; the arrows,
 * the dial on the TV and the arrow keys change channel too, and the screen
 * opens the project. Until the visitor picks a channel the TV moves on by
 * itself when a clip ends; Pause stops it. With reduced motion it shows stills
 * and waits. Without JS (or WebGL) the notes are still all here, and the clip
 * plays in a plain video.
 */
import { pad, slugOf, type ProjectEntry } from "../lib/content";

interface Props {
    projects: ProjectEntry[];
}

const { projects } = Astro.props;

const channels = projects.map((p, i) => {
    const num = pad(p.data.order ?? i + 1);
    const clip = p.data.tv;
    return {
        num,
        label: `CH ${num}`,
        title: p.data.title,
        category: p.data.category,
        year: p.data.year,
        tech: (p.data.tech ?? []).slice(0, 5),
        brief: p.data.tagline ?? p.data.description,
        inProgress: p.data.status === "in-progress",
        href: `/projects/${slugOf(p)}/`,
        clip,
        poster: clip?.replace(/\.mp4$/, ".jpg"),
    };
});
const first = channels[0];
---

<section class="tv-section wrap" aria-labelledby="selected" data-tv>
    <div class="tv-head">
        <h2 id="selected" class="mono muted">Selected projects</h2>
        <a href="/projects/" class="mono link">All projects →</a>
    </div>

    <div class="tv-layout">
        <div class="tv-info">
            {
                channels.map((c, i) => (
                    <article class="tv-panel" id={`tv-panel-${i}`} role="tabpanel" aria-labelledby={`tv-tab-${i}`} hidden={i !== 0} data-tv-panel>
                        <p class="tv-panel__kicker mono muted">
                            {c.label} — {c.category}
                            {c.inProgress && <span class="wip">In progress</span>}
                        </p>
                        <h3 class="tv-panel__title">{c.title}</h3>
                        <dl class="tv-panel__facts mono">
                            <div>
                                <dt class="muted">Year</dt>
                                <dd>{c.year}</dd>
                            </div>
                            <div>
                                <dt class="muted">Built with</dt>
                                <dd>{c.tech.join(" · ")}</dd>
                            </div>
                        </dl>
                        <p class="tv-panel__brief">{c.brief}</p>
                        <a href={c.href} class="mono link">View project →</a>
                    </article>
                ))
            }
        </div>

        <div class="tv-col">
            <div class="tv-stage" data-tv-stage>
                <canvas class="tv-canvas" data-tv-canvas aria-hidden="true"></canvas>
                <!-- no WebGL: the clip in a plain frame -->
                <div class="tv-fallback" data-tv-fallback hidden>
                    <video muted playsinline loop preload="none" poster={first.poster} data-tv-fallback-video aria-hidden="true"></video>
                </div>
            </div>

            <div class="tv-controls">
                <button type="button" class="tv-btn" data-tv-prev aria-label="Previous channel">←</button>
                <div class="tv-channels" role="tablist" aria-label="Selected projects">
                    {
                        channels.map((c, i) => (
                            <button
                                type="button"
                                role="tab"
                                class="tv-ch mono"
                                id={`tv-tab-${i}`}
                                aria-selected={i === 0 ? "true" : "false"}
                                aria-controls={`tv-panel-${i}`}
                                tabindex={i === 0 ? "0" : "-1"}
                                data-tv-tab={i}
                            >
                                <span aria-hidden="true">{c.num}</span>
                                <span class="visually-hidden">{c.title}</span>
                            </button>
                        ))
                    }
                </div>
                <button type="button" class="tv-btn" data-tv-next aria-label="Next channel">→</button>
                <button type="button" class="tv-pause mono" data-tv-pause aria-pressed="false">Pause</button>
            </div>
            <p class="tv-credit mono muted">
                TV: <a href="https://sketchfab.com/3d-models/old-tv-d0ff257bc4fc4b5d9f9a0d319f174a00" target="_blank" rel="noopener">“Old TV” by Blank2574</a>,
                <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>
            </p>
        </div>
    </div>

    <script type="application/json" data-tv-channels set:html={JSON.stringify(channels.map(({ label, title, clip, poster, href }) => ({ label, title, clip, poster, href })))} />
</section>

<script>
    import { gsap } from "gsap";
    import type { TV } from "../scripts/tv";

    type ChannelData = { label: string; title: string; clip?: string; poster?: string; href: string };

    const root = document.querySelector<HTMLElement>("[data-tv]");
    if (root) {
        const channels: ChannelData[] = JSON.parse(root.querySelector("[data-tv-channels]")!.textContent!);
        const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-tv-tab]")];
        const panels = [...root.querySelectorAll<HTMLElement>("[data-tv-panel]")];
        const canvas = root.querySelector<HTMLCanvasElement>("[data-tv-canvas]")!;
        const pauseBtn = root.querySelector<HTMLButtonElement>("[data-tv-pause]")!;
        const fallback = root.querySelector<HTMLElement>("[data-tv-fallback]")!;
        const fallbackVideo = root.querySelector<HTMLVideoElement>("[data-tv-fallback-video]")!;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        let current = 0;
        let playing = !reduceMotion;
        let tv: TV | null = null;
        let useFallback = false;

        const showFallback = () => {
            const ch = channels[current];
            fallbackVideo.poster = ch.poster ?? "";
            if (ch.clip) {
                fallbackVideo.src = ch.clip;
                if (playing) fallbackVideo.play().catch(() => {});
            } else fallbackVideo.removeAttribute("src");
        };

        const select = (i: number, byVisitor: boolean) => {
            const n = channels.length;
            i = ((i % n) + n) % n;
            if (byVisitor) tv?.setAuto(false);
            if (i === current && tv) return;
            current = i;
            tabs.forEach((t, j) => {
                t.setAttribute("aria-selected", String(j === i));
                t.tabIndex = j === i ? 0 : -1;
            });
            panels.forEach((p, j) => (p.hidden = j !== i));
            if (!reduceMotion) gsap.from(panels[i].children, { autoAlpha: 0, y: 12, duration: 0.6, ease: "expo.out", stagger: 0.05, overwrite: true });
            if (tv) tv.tune(i);
            else if (useFallback) showFallback();
        };

        tabs.forEach((t, i) => t.addEventListener("click", () => select(i, true)));
        // tabs pattern: the arrow keys move along the channels
        root.querySelector("[role=tablist]")!.addEventListener("keydown", (e) => {
            const k = (e as KeyboardEvent).key;
            const to = k === "ArrowRight" ? current + 1 : k === "ArrowLeft" ? current - 1 : k === "Home" ? 0 : k === "End" ? channels.length - 1 : null;
            if (to === null) return;
            e.preventDefault();
            select(to, true);
            tabs[current].focus();
        });
        root.querySelector("[data-tv-prev]")!.addEventListener("click", () => select(current - 1, true));
        root.querySelector("[data-tv-next]")!.addEventListener("click", () => select(current + 1, true));

        const syncPause = () => {
            pauseBtn.textContent = playing ? "Pause" : "Play";
            pauseBtn.setAttribute("aria-pressed", String(!playing));
        };
        pauseBtn.addEventListener("click", () => {
            playing = !playing;
            syncPause();
            if (tv) {
                if (!playing) tv.setAuto(false);
                tv.setPlaying(playing);
            } else if (useFallback) playing ? fallbackVideo.play().catch(() => {}) : fallbackVideo.pause();
        });
        syncPause();

        // load three.js and the model when the TV gets close to the screen
        const start = async () => {
            try {
                const { createTV } = await import("../scripts/tv");
                tv = await createTV({
                    canvas,
                    channels,
                    reduceMotion,
                    onDial: () => select(current + 1, true),
                    onScreen: () => (window.location.href = channels[current].href),
                    onEnded: () => select(current + 1, false),
                });
                tv.tune(current);
                root.classList.add("is-live");
            } catch (err) {
                console.warn("TV: no WebGL, showing the plain video instead", err);
                useFallback = true;
                fallback.hidden = false;
                canvas.hidden = true;
                showFallback();
            }
        };
        const io = new IntersectionObserver(
            ([entry]) => {
                if (!entry.isIntersecting) return;
                io.disconnect();
                start();
            },
            { rootMargin: "400px 0px" },
        );
        io.observe(root);
    }
</script>

<style>
    .tv-section {
        padding-block: var(--section);
    }

    .tv-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--gutter);
        padding-top: 14px;
        border-top: 1px solid var(--line);
    }

    .tv-head h2 {
        margin: 0;
    }

    .tv-layout {
        display: grid;
        gap: clamp(32px, 5vw, 56px) var(--gutter);
        margin-top: clamp(32px, 5vw, 64px);
    }

    /* --- the note beside the TV --- */

    .tv-info {
        min-width: 0;
    }

    /* the reset makes articles display: block, which would beat [hidden] */
    .tv-panel[hidden] {
        display: none;
    }

    /* without JS every note shows, one after another */
    :global(html:not(.js)) .tv-panel[hidden] {
        display: block;
        margin-top: 48px;
    }

    .tv-panel__kicker {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        margin: 0;
    }

    .tv-panel__title {
        margin: 14px 0 0;
        font-size: clamp(2.25rem, 1.2rem + 3vw, 4rem);
        font-weight: 500;
        line-height: 0.95;
        letter-spacing: -0.05em;
    }

    .tv-panel__facts {
        display: grid;
        gap: 10px;
        margin: clamp(20px, 2.4vw, 32px) 0 0;
        padding-top: 14px;
        border-top: 1px solid var(--line);
    }

    .tv-panel__facts dd {
        margin: 2px 0 0;
    }

    .tv-panel__brief {
        max-width: 34ch;
        margin: clamp(20px, 2.4vw, 28px) 0;
        font-size: var(--fs-body);
        line-height: 1.4;
    }

    /* --- the TV and its controls --- */

    .tv-col {
        order: -1;
        min-width: 0;
    }

    .tv-stage {
        position: relative;
        aspect-ratio: 16 / 11;
    }

    .tv-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        touch-action: pan-y;
        opacity: 0;
        transition: opacity 0.6s var(--ease);
    }

    .tv-section.is-live .tv-canvas {
        opacity: 1;
    }

    .tv-fallback {
        position: absolute;
        inset: 8% 10%;
        display: grid;
        place-items: center;
    }

    .tv-fallback[hidden] {
        display: none;
    }

    .tv-fallback video {
        width: 100%;
        max-height: 100%;
        border-radius: 18px;
        background: #111;
        box-shadow: 0 0 0 14px #2b2420, var(--media-shadow);
    }

    .tv-controls {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-top: 8px;
    }

    .tv-channels {
        display: flex;
        gap: 6px;
    }

    .tv-btn,
    .tv-ch,
    .tv-pause {
        display: grid;
        place-items: center;
        min-width: 44px;
        height: 44px;
        padding: 0 12px;
        border: 1px solid var(--line);
        background: none;
        color: var(--text);
        font: inherit;
        cursor: pointer;
        transition:
            border-color 0.3s var(--ease),
            background-color 0.3s var(--ease),
            color 0.3s var(--ease);
    }

    .tv-btn {
        border-radius: 50%;
        padding: 0;
    }

    .tv-pause {
        margin-left: 6px;
        border-radius: 999px;
        color: var(--muted);
    }

    .tv-btn:hover,
    .tv-btn:focus-visible,
    .tv-ch:hover,
    .tv-ch:focus-visible,
    .tv-pause:hover,
    .tv-pause:focus-visible {
        border-color: var(--text);
        color: var(--text);
    }

    .tv-ch[aria-selected="true"] {
        background: var(--text);
        border-color: var(--text);
        color: var(--bg);
    }

    .tv-credit {
        margin: 14px 0 0;
        font-size: 0.68rem;
        text-align: center;
    }

    .tv-credit a {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    @media (min-width: 900px) {
        .tv-layout {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            align-items: center;
        }

        .tv-info {
            grid-column: 1 / span 4;
        }

        .tv-col {
            grid-column: 5 / -1;
            order: 0;
        }
    }

    @media (max-width: 420px) {
        .tv-controls {
            gap: 6px;
        }

        .tv-channels {
            gap: 4px;
        }

        .tv-btn,
        .tv-ch {
            min-width: 40px;
            height: 40px;
            padding: 0 8px;
        }
    }
</style>
