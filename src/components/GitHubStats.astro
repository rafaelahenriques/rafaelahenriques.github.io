---
/**
 * GitHub, in brief, on a screen like the arcade's: one sentence with the
 * numbers, and the most used languages as a single bar of square pixels. The
 * numbers come from src/data/github.json, which scripts/github-stats.mjs
 * refreshes before every build (public data only).
 */
import github from "../data/github.json";
import { site } from "../lib/site";

const { languages } = github;
const asOf = new Date(`${github.updated}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });

// the bar: 40 squares shared out by largest remainder, so they always add up
const CELLS = 40;
const total = languages.reduce((sum, l) => sum + l.percent, 0);
const exact = languages.map((l) => (l.percent / total) * CELLS);
const cells = exact.map(Math.floor);
const byRemainder = exact.map((x, i) => [x - Math.floor(x), i]).sort((a, b) => b[0] - a[0]);
for (let k = 0; k < CELLS - cells.reduce((a, b) => a + b, 0); k++) cells[byRemainder[k][1]]++;
// each language a shade of the screen's blue, strongest first; everything else faint
const tone = (i: number) => (languages[i].name === "Other" ? "other" : String(i));
const squares = cells.flatMap((n, i) => Array.from({ length: n }, () => tone(i)));
---

<section class="section wrap" aria-labelledby="github">
    <div class="row">
        <h2 id="github" class="row__label mono muted">On GitHub</h2>
        <div class="row__body crt gh__screen" data-reveal>
            <p class="lead gh__summary">
                <strong>{github.commits}</strong> commits to my <strong>{github.repos}</strong> public repos, and
                <strong>{github.contributions}</strong> contributions in the last year.
            </p>

            <div class="gh__langs">
                <p class="gh__label mono">Most used languages</p>
                <div class="gh__bar" aria-hidden="true">
                    {squares.map((t) => <span class={`gh__px gh__tone--${t}`} />)}
                </div>
                <ul class="gh__legend mono">
                    {
                        languages.map((l, i) => (
                            <li>
                                <span class={`gh__px gh__tone--${tone(i)}`} aria-hidden="true" />
                                {l.name} <span class="gh__pct">{Math.round(l.percent)}%</span>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <p class="gh__foot mono">
                <a href={site.github} class="link" target="_blank" rel="noopener">@{github.user} ↗</a> · as of {asOf}
            </p>
        </div>
    </div>
</section>

<style>
    /* the screen: dark glass, the text light, the numbers in neon pixel letters */
    .gh__screen {
        padding: clamp(24px, 3.5vw, 52px);
        color: #f1f6f9;
    }

    .gh__summary {
        max-width: 30ch;
        margin: 0;
    }

    .gh__summary strong {
        color: var(--neon);
        font-family: var(--pixel);
        font-weight: 700;
        text-shadow: 0 0 16px rgba(var(--neon-rgb), 0.5);
    }

    .gh__langs {
        max-width: 44rem;
        margin-top: clamp(32px, 4vw, 56px);
    }

    .gh__label,
    .gh__pct,
    .gh__foot {
        color: var(--neon-pale);
    }

    .gh__label {
        margin: 0 0 14px;
    }

    .gh__pct {
        opacity: 0.7;
    }

    /* the languages as one row of big pixels, like the edges of the dark blocks */
    .gh__bar {
        display: grid;
        grid-template-columns: repeat(40, minmax(0, 1fr));
        gap: clamp(2px, 0.25vw, 4px);
    }

    .gh__px {
        display: block;
        aspect-ratio: 1;
    }

    /* shades of the screen's neon blue, strongest first */
    .gh__tone--0 {
        background: var(--neon);
        box-shadow: 0 0 10px rgba(var(--neon-rgb), 0.45);
    }

    .gh__tone--1 {
        background: color-mix(in oklab, var(--neon) 74%, var(--screen-bg));
    }

    .gh__tone--2 {
        background: color-mix(in oklab, var(--neon) 54%, var(--screen-bg));
    }

    .gh__tone--3 {
        background: color-mix(in oklab, var(--neon) 38%, var(--screen-bg));
    }

    .gh__tone--4 {
        background: color-mix(in oklab, var(--neon) 26%, var(--screen-bg));
    }

    .gh__tone--other {
        background: rgba(var(--neon-rgb), 0.1);
    }

    .gh__legend {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 22px;
        margin: 16px 0 0;
        padding: 0;
        list-style: none;
    }

    .gh__legend li {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .gh__legend .gh__px {
        width: 10px;
    }

    .gh__foot {
        margin: clamp(28px, 3vw, 40px) 0 0;
    }
</style>
