---
/**
 * What GitHub says: commits and contributions, the most used languages as bars
 * of square pixels, and the last year of contributions as a grid of them. The
 * numbers come from src/data/github.json, which scripts/github-stats.mjs
 * refreshes before every build (public data only).
 */
import github from "../data/github.json";
import { pad } from "../lib/content";
import { site } from "../lib/site";

const { languages, calendar } = github;

const day = (iso: string) => new Date(`${iso}T00:00:00Z`);
const formatDate = (iso: string) => day(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });

const numbers = [
    { value: github.commits, label: "Commits to public repos" },
    { value: github.contributions, label: "Contributions in the last year" },
    { value: github.repos, label: "Public repos" },
    { value: github.streaks.longest, label: "Longest streak, in days" },
];

// the bars: the top language fills all the cells, the rest in proportion
const CELLS = 24;
const top = Math.max(...languages.filter((l) => l.name !== "Other").map((l) => l.percent));
const bars = languages.map((l) => ({ ...l, cells: Math.max(1, Math.round((l.percent / top) * CELLS)) }));

// the calendar: a column per week, Sunday at the top, like GitHub's
const STEP = 13; // cell and gap
const CELL = 10;
const LABEL_H = 18;
const offset = day(calendar.start).getUTCDay();
const weeks = Math.ceil((calendar.levels.length + offset) / 7);
const cells = calendar.levels.map((level, i) => ({
    x: Math.floor((i + offset) / 7) * STEP,
    y: LABEL_H + ((i + offset) % 7) * STEP,
    level,
    count: calendar.counts[i],
    date: new Date(day(calendar.start).getTime() + i * 86400000).toISOString().slice(0, 10),
}));
// a month's name over the first week that starts in it
const months: { x: number; name: string }[] = [];
for (let w = 0; w < weeks; w++) {
    const first = new Date(day(calendar.start).getTime() + (w * 7 - offset) * 86400000);
    if (first.getUTCDate() <= 7 && (months.length === 0 || w * STEP - months[months.length - 1].x > 3 * STEP)) {
        months.push({ x: w * STEP, name: first.toLocaleDateString("en-GB", { month: "short", timeZone: "UTC" }) });
    }
}
const width = weeks * STEP - (STEP - CELL);
const height = LABEL_H + 7 * STEP - (STEP - CELL);
---

<section class="section wrap gh" aria-labelledby="github">
    <div class="gh__head">
        <h2 id="github" class="mono muted">On GitHub</h2>
        <a href={site.github} class="mono link" target="_blank" rel="noopener">@{github.user} ↗</a>
    </div>

    <dl class="gh__numbers">
        {
            numbers.map((n) => (
                <div class="gh__number" data-reveal>
                    <dt class="mono muted">{n.label}</dt>
                    <dd>{n.value}</dd>
                </div>
            ))
        }
    </dl>

    <div class="gh__body">
        <div class="gh__langs" data-reveal>
            <h3 class="mono muted">Most used languages</h3>
            <ol class="gh__lang-list">
                {
                    bars.map((l, i) => (
                        <li class:list={["gh__lang", { "gh__lang--other": l.name === "Other" }]}>
                            <span class="gh__lang-num mono muted">{l.name === "Other" ? "··" : pad(i + 1)}</span>
                            <span class="gh__lang-name">{l.name}</span>
                            <span class="gh__bar" style={`--n:${l.cells}`} aria-hidden="true"></span>
                            <span class="gh__lang-pct mono">{Math.round(l.percent)}%</span>
                        </li>
                    ))
                }
            </ol>
            <p class="gh__note mono muted">Each public repo counted once, split by the languages in it.</p>
        </div>

        <div class="gh__calendar" data-reveal>
            <h3 class="mono muted">Day by day</h3>
            <svg class="gh__grid" viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`${github.contributions} contributions in the last year, on ${github.activeDays} days`}>
                {months.map((m) => <text x={m.x} y={11} class="gh__month">{m.name}</text>)}
                {
                    cells.map((c) => (
                        <rect x={c.x} y={c.y} width={CELL} height={CELL} class={`gh__day gh__day--${c.level}`}>
                            {c.count > 0 && <title>{`${c.count} contribution${c.count === 1 ? "" : "s"} on ${formatDate(c.date)}`}</title>}
                        </rect>
                    ))
                }
            </svg>
            <div class="gh__legend mono muted">
                <span>Busiest day: {github.busiest.count} on {formatDate(github.busiest.date)}</span>
                <span class="gh__scale" aria-hidden="true">
                    Less
                    {[0, 1, 2, 3, 4].map((level) => <span class={`gh__swatch gh__day--${level}`}></span>)}
                    More
                </span>
            </div>
        </div>
    </div>

    <p class="gh__updated mono muted">Public activity on GitHub, as of {formatDate(github.updated)}.</p>
</section>

<style>
    .gh__head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--gutter);
        padding-top: 14px;
        border-top: 1px solid var(--line);
    }

    .gh__head h2 {
        margin: 0;
    }

    /* --- the numbers, big like the playbook's --- */

    .gh__numbers {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(24px, 3vw, 40px) var(--gutter);
        margin: clamp(32px, 5vw, 64px) 0 0;
    }

    .gh__number {
        display: flex;
        flex-direction: column-reverse;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 12px;
        border-top: 1px solid var(--text);
    }

    .gh__number dt {
        max-width: 18ch;
    }

    .gh__number dd {
        margin: 0;
        font-size: clamp(2.5rem, 1.2rem + 5vw, 6rem);
        font-weight: 800;
        line-height: 0.9;
        letter-spacing: -0.045em;
    }

    @media (min-width: 900px) {
        .gh__numbers {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    /* --- languages and the calendar --- */

    .gh__body {
        display: grid;
        gap: clamp(48px, 6vw, 80px) var(--gutter);
        margin-top: clamp(48px, 7vw, 104px);
    }

    .gh__body h3 {
        margin: 0 0 18px;
        font-weight: 500;
    }

    @media (min-width: 1000px) {
        .gh__body {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            align-items: start;
        }

        .gh__langs {
            grid-column: 1 / span 5;
        }

        .gh__calendar {
            grid-column: 7 / -1;
        }
    }

    .gh__lang-list {
        margin: 0;
        padding: 0;
        list-style: none;
        border-bottom: 1px solid var(--line);
    }

    .gh__lang {
        display: grid;
        grid-template-columns: 2.25rem minmax(0, 1fr) auto;
        grid-template-areas:
            "num name pct"
            ".   bar  bar";
        align-items: center;
        gap: 8px 12px;
        padding-block: 12px;
        border-top: 1px solid var(--line);
    }

    .gh__lang-num {
        grid-area: num;
    }

    .gh__lang-name {
        grid-area: name;
    }

    .gh__lang-pct {
        grid-area: pct;
        text-align: right;
    }

    /* a row of square pixels: --n of them lit, the rest faint */
    .gh__bar {
        --cell: clamp(7px, 0.75vw, 10px);
        --step: calc(var(--cell) + 3px);
        grid-area: bar;
        position: relative;
        width: calc(24 * var(--step) - 3px);
        height: var(--cell);
        background: repeating-linear-gradient(90deg, var(--line) 0 var(--cell), transparent var(--cell) var(--step));
    }

    .gh__bar::after {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: calc(var(--n) * var(--step) - 3px);
        background: repeating-linear-gradient(90deg, var(--text) 0 var(--cell), transparent var(--cell) var(--step));
    }

    /* everything else together: there, but not a language */
    .gh__lang--other .gh__bar::after {
        background: repeating-linear-gradient(90deg, var(--muted) 0 var(--cell), transparent var(--cell) var(--step));
    }

    @media (min-width: 600px) {
        .gh__lang {
            grid-template-columns: 2.25rem minmax(7rem, 1fr) auto 3rem;
            grid-template-areas: "num name bar pct";
        }
    }

    .gh__note,
    .gh__updated {
        margin: 16px 0 0;
    }

    .gh__updated {
        margin-top: clamp(40px, 5vw, 64px);
    }

    /* the calendar: GitHub's grid, in the page's ink */
    .gh__grid {
        display: block;
        width: 100%;
        height: auto;
        color: var(--text);
    }

    .gh__month {
        font-family: var(--mono);
        font-size: 10px;
        fill: var(--muted);
    }

    .gh__day--0 {
        fill: var(--line);
        background: var(--line);
    }

    .gh__day--1 {
        fill: color-mix(in oklab, currentColor 30%, transparent);
        background: color-mix(in oklab, var(--text) 30%, transparent);
    }

    .gh__day--2 {
        fill: color-mix(in oklab, currentColor 55%, transparent);
        background: color-mix(in oklab, var(--text) 55%, transparent);
    }

    .gh__day--3 {
        fill: color-mix(in oklab, currentColor 78%, transparent);
        background: color-mix(in oklab, var(--text) 78%, transparent);
    }

    .gh__day--4 {
        fill: currentColor;
        background: var(--text);
    }

    .gh__legend {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px var(--gutter);
        margin-top: 14px;
    }

    .gh__scale {
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .gh__swatch {
        width: 10px;
        height: 10px;
    }
</style>
