---
/**
 * A screen recording of the app (the phone frame is part of the video).
 * Muted and looping, it plays only while on screen and loads nothing until
 * it gets close; a Pause / Play button is always there, and with reduced
 * motion it waits to be played. The poster is the first frame.
 */
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    /** path under public/, e.g. "/media/mongmo/ordering.mp4" */
    src: string;
    poster: ImageMetadata;
    /** what the recording shows, for screen readers and the button */
    label: string;
}

const { src, poster, label } = Astro.props;
const posterSrc = (await getImage({ src: poster, width: 640, format: "webp", quality: 80 })).src;
---

<figure class="phone-video" data-phone-video>
    <video
        class="phone-video__video"
        muted
        loop
        playsinline
        preload="none"
        poster={posterSrc}
        width={poster.width}
        height={poster.height}
        aria-label={label}
    >
        <source src={src} type="video/mp4" />
    </video>
    <button type="button" class="phone-video__toggle mono" aria-label={`Play: ${label}`} data-phone-video-toggle>
        Play
    </button>
</figure>

<script>
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    document.querySelectorAll<HTMLElement>("[data-phone-video]").forEach((figure) => {
        const video = figure.querySelector("video")!;
        const button = figure.querySelector<HTMLButtonElement>("[data-phone-video-toggle]")!;
        const label = video.getAttribute("aria-label") ?? "";
        // the visitor's own choice wins over autoplay
        let userPaused = reduceMotion;
        let onScreen = false;

        const sync = () => {
            const playing = !video.paused;
            button.textContent = playing ? "Pause" : "Play";
            button.setAttribute("aria-label", `${playing ? "Pause" : "Play"}: ${label}`);
        };
        const play = () => video.play().catch(() => {});

        video.addEventListener("play", sync);
        video.addEventListener("pause", sync);

        const toggle = () => {
            if (video.paused) {
                userPaused = false;
                play();
            } else {
                userPaused = true;
                video.pause();
            }
        };
        button.addEventListener("click", toggle);
        video.addEventListener("click", toggle);

        // start downloading a little before it scrolls in, play while it's visible
        new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting && video.preload === "none") video.preload = "auto";
            },
            { rootMargin: "50% 0px" },
        ).observe(figure);
        new IntersectionObserver(
            ([entry]) => {
                onScreen = entry.isIntersecting;
                if (onScreen && !userPaused) play();
                else if (!onScreen) video.pause();
            },
            { threshold: 0.35 },
        ).observe(figure);

        document.addEventListener("visibilitychange", () => {
            if (document.hidden) video.pause();
            else if (onScreen && !userPaused) play();
        });
    });
</script>

<style>
    .phone-video {
        display: grid;
        justify-items: center;
        gap: 8px;
        margin: 0;
    }

    .phone-video__video {
        display: block;
        width: 100%;
        height: auto;
        cursor: pointer;
    }

    /* under the phone, so it never covers the app's own controls */
    .phone-video__toggle {
        padding: 4px 10px;
        border: 1px solid rgba(17, 17, 16, 0.16);
        border-radius: 999px;
        background: #fff;
        color: #75736e;
        cursor: pointer;
        transition:
            color 0.3s var(--ease),
            border-color 0.3s var(--ease);
    }

    .phone-video__toggle:hover,
    .phone-video__toggle:focus-visible {
        color: #111110;
        border-color: #111110;
    }
</style>
