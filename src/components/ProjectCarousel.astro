---
/**
 * Draggable 3D media carousel (adapted from mwg_effect103).
 * 9 fixed media slots cycle through `slides`; the centred slide drives the
 * caption. Clicking the centred media opens its project, clicking any other
 * media centres it.
 */
export interface Slide {
    src: string;
    title: string;
    year?: string;
    href: string;
}

interface Props {
    slides: Slide[];
}

const { slides } = Astro.props;
const SLOTS = 9;
// Same offset the script uses, so the centred slot renders the first slide.
const startIndex = (i: number) => {
    const len = slides.length;
    return (((i - (SLOTS - 1) / 2) % len) + len) % len;
};
const pad = (n: number) => String(n).padStart(2, "0");
---

<section class="mwg_effect103" aria-label="Selected work" data-carousel>
    <div class="carousel__top mono">
        <span>Selected work</span>
        <span class="carousel__hint muted">Drag or click to explore</span>
        <span data-carousel-count>01/{pad(slides.length)}</span>
    </div>

    <div class="carousel__stage">
        <div class="container" aria-hidden="true">
            {
                Array.from({ length: SLOTS }, (_, i) => (
                    <div class="media">
                        <img src={slides[startIndex(i)].src} alt="" draggable="false" />
                    </div>
                ))
            }
        </div>
    </div>

    <div class="carousel__caption">
        <a href={slides[0].href} class="carousel__title" data-carousel-link>
            <span class="carousel__mask">
                <span data-carousel-title>{slides[0].title}</span>
            </span>
        </a>
        <span class="carousel__year mono muted" data-carousel-year>{slides[0].year}</span>
        <div class="carousel__controls mono">
            <button type="button" class="text-button link" data-carousel-prev>← Prev</button>
            <button type="button" class="text-button link" data-carousel-next>Next →</button>
        </div>
    </div>

    <div class="medias-loader" aria-hidden="true">
        {
            slides.map((s) => (
                <img
                    src={s.src}
                    alt=""
                    data-title={s.title}
                    data-year={s.year}
                    data-href={s.href}
                />
            ))
        }
    </div>
</section>

<style>
    .mwg_effect103 {
        position: relative;
        height: calc(100dvh - var(--header-h));
        min-height: 520px;
        overflow: hidden;
        display: grid;
        /* minmax(0, …) so the 200vw mobile track can't widen the column */
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: auto 1fr auto;
        padding: 12px var(--gutter) clamp(16px, 3vw, 32px);
        /* horizontal drags belong to the carousel, vertical ones to the page */
        touch-action: pan-y;
    }

    .carousel__top {
        display: flex;
        justify-content: space-between;
        gap: var(--gutter);
    }

    .carousel__hint {
        display: none;
    }

    .carousel__stage {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 0;
        margin-inline: calc(var(--gutter) * -1);
    }

    .mwg_effect103 .container {
        height: calc(11vw / 0.8);
        flex: 0 0 100%;
        perspective: 100vw;
        position: relative;
    }

    .mwg_effect103 .media {
        width: 11vw;
        height: auto;
        aspect-ratio: 0.8;
        position: absolute;
        top: 0;
        left: 0;
        transform-style: preserve-3d;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }

    .mwg_effect103 .media img {
        width: 100%;
        height: 100%;
        display: block;
        border-radius: 0.2vw;
        object-fit: cover;
        user-select: none;
        -webkit-user-drag: none;
        box-shadow: var(--media-shadow);
    }

    .mwg_effect103 .medias-loader img {
        width: 1px;
        height: 1px;
        top: 0;
        left: 0;
        position: absolute;
        visibility: hidden;
        pointer-events: none;
    }

    .carousel__caption {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: end;
        gap: 8px var(--gutter);
    }

    .carousel__title {
        grid-column: 1 / -1;
        font-size: var(--fs-h2);
        line-height: 1;
        letter-spacing: -0.04em;
    }

    .carousel__mask {
        display: inline-block;
        overflow: hidden;
        vertical-align: bottom;
        padding-bottom: 0.08em;
    }

    .carousel__mask > span {
        display: inline-block;
    }

    .carousel__controls {
        display: flex;
        gap: 20px;
    }

    @media (min-width: 769px) {
        .carousel__hint {
            display: block;
        }

        .carousel__caption {
            grid-template-columns: repeat(12, minmax(0, 1fr));
        }

        .carousel__title {
            grid-column: 1 / span 8;
        }

        .carousel__year {
            grid-column: 9 / span 2;
            padding-bottom: 0.5em;
        }

        .carousel__controls {
            grid-column: 11 / span 2;
            justify-self: end;
            padding-bottom: 0.5em;
        }
    }

    @media (max-width: 768px) {
        .mwg_effect103 .container {
            flex: 0 0 200vw;
            height: calc(35vw / 0.8);
        }

        .mwg_effect103 .media {
            width: 35vw;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { Observer } from "gsap/Observer";

    gsap.registerPlugin(Observer);

    const root = document.querySelector<HTMLElement>("[data-carousel]");
    if (root) initCarousel(root);

    function initCarousel(root: HTMLElement) {
        const container = root.querySelector<HTMLElement>(".container")!;
        const loaderImgs = [
            ...root.querySelectorAll<HTMLImageElement>(".medias-loader img"),
        ];
        const mediasUrls = loaderImgs.map(
            (el) => new URL(el.getAttribute("src")!, document.baseURI).href,
        );
        const slides = loaderImgs.map((el) => ({
            title: el.dataset.title ?? "",
            year: el.dataset.year ?? "",
            href: el.dataset.href ?? "#",
        }));

        const countEl = root.querySelector<HTMLElement>("[data-carousel-count]")!;
        const titleEl = root.querySelector<HTMLElement>("[data-carousel-title]")!;
        const yearEl = root.querySelector<HTMLElement>("[data-carousel-year]")!;
        const linkEl = root.querySelector<HTMLAnchorElement>("[data-carousel-link]")!;
        const prevBtn = root.querySelector<HTMLButtonElement>("[data-carousel-prev]")!;
        const nextBtn = root.querySelector<HTMLButtonElement>("[data-carousel-next]")!;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

        const medias = [...root.querySelectorAll<HTMLElement>(".media")];
        const n = medias.length;
        const centerIndex = (n - 1) / 2;
        const step = 1 / n;
        const mod = (v: number, m: number) => ((v % m) + m) % m;
        const pad = (v: number) => String(v).padStart(2, "0");
        const maxZ = Math.ceil(n / 2);
        const ease = "power2.inOut";
        const easeFn = gsap.parseEase(ease);
        const zPhaseStart = (4 * Math.PI) / 3;
        const zPhaseSpan = (7 * Math.PI) / 3;

        const timelines: gsap.core.Timeline[] = [];
        const posState = { pos: 0 };
        let travel = 0;
        let zPeak = 0;
        let dragFactor = 0;
        let dragTarget = 0;
        let didDrag = false;
        let posTo: gsap.QuickToFunc;
        let captionIndex = -1;

        const mediaItems = medias.map((media, index) => ({
            img: media.querySelector("img")!,
            index,
            progress: 0,
            lastStep: Math.floor((index - centerIndex) * step + posState.pos + 0.5),
        }));

        function zAt(p: number) {
            return Math.sin(zPhaseStart + p * zPhaseSpan) * zPeak + 0.5 * zPeak;
        }

        function progressFor(i: number) {
            return mod(0.5 + (i - centerIndex) * step + posState.pos, 1);
        }

        function distanceFromCenter(progress: number) {
            const d = Math.abs(progress - 0.5);
            return Math.min(d, 1 - d);
        }

        function updateZIndexes() {
            medias.forEach((media, i) => {
                const steps = Math.round(distanceFromCenter(timelines[i].progress()) / step);
                media.style.zIndex = String(maxZ - steps);
            });
        }

        // Timelines depend on the viewport width, so they are rebuilt on resize.
        function buildTimelines() {
            timelines.forEach((tl) => tl.kill());
            timelines.length = 0;

            travel = container.offsetWidth;
            zPeak = 0.3 * window.innerWidth;
            dragFactor = 0.5 / window.innerWidth;

            medias.forEach((media, index) => {
                const img = mediaItems[index].img;
                gsap.set([media, img], { clearProps: "all" });

                const tl = gsap.timeline({ paused: true });
                tl.to(media, {
                    x: travel,
                    xPercent: -100,
                    duration: 1,
                    ease,
                    onUpdate(this: gsap.core.Tween) {
                        gsap.set(media, { z: zAt(easeFn(this.progress())) });
                        updateZIndexes();
                    },
                });

                tl.fromTo(media, { scale: 0.66 }, { scale: 1, duration: 0.4, ease: "power2.in" }, 0);
                tl.fromTo(img, { xPercent: -10, autoAlpha: 0 }, { xPercent: 0, autoAlpha: 1, duration: 0.02, ease: "power1.in" }, 0);
                tl.fromTo(media, { scale: 1 }, { scale: 0.66, duration: 0.4, delay: 0.6, ease: "power2.out" }, 0);
                tl.fromTo(img, { xPercent: 0, autoAlpha: 1 }, { xPercent: 10, autoAlpha: 0, duration: 0.02, delay: 0.98, ease: "power1.out" }, 0);

                timelines.push(tl);
            });
        }

        function urlIndexFromSrc(src: string) {
            const resolved = new URL(src, document.baseURI).href;
            const i = mediasUrls.indexOf(resolved);
            return i >= 0 ? i : 0;
        }

        type Item = (typeof mediaItems)[number];

        function getFirstItem(exclude?: Item) {
            const pool = exclude ? mediaItems.filter((i) => i !== exclude) : mediaItems;
            return pool.length ? [...pool].sort((a, b) => b.progress - a.progress)[0] : exclude!;
        }

        function getLastItem(exclude?: Item) {
            const pool = exclude ? mediaItems.filter((i) => i !== exclude) : mediaItems;
            return pool.length ? [...pool].sort((a, b) => a.progress - b.progress)[0] : exclude!;
        }

        function assignNewSrc(wrappingItem: Item, direction: number) {
            const len = mediasUrls.length;
            if (direction > 0) {
                const last = getLastItem(wrappingItem);
                const refIndex = urlIndexFromSrc(last.img.src);
                wrappingItem.img.src = mediasUrls[(refIndex - 1 + len) % len];
            } else {
                const first = getFirstItem(wrappingItem);
                const refIndex = urlIndexFromSrc(first.img.src);
                wrappingItem.img.src = mediasUrls[(refIndex + 1) % len];
            }
        }

        function updateMediaUrls() {
            mediaItems.forEach((item) => {
                const raw = (item.index - centerIndex) * step + posState.pos;
                item.progress = progressFor(item.index);
                const stepVal = Math.floor(raw + 0.5);

                if (stepVal !== item.lastStep) {
                    const direction = stepVal > item.lastStep ? 1 : -1;
                    const steps = Math.abs(stepVal - item.lastStep);
                    for (let i = 0; i < steps; i++) {
                        assignNewSrc(item, direction);
                    }
                }
                item.lastStep = stepVal;
            });
        }

        function updateCaption() {
            const slideIndex = urlIndexFromSrc(mediaItems[centeredIndex()].img.src);
            if (slideIndex === captionIndex) return;
            captionIndex = slideIndex;

            const slide = slides[slideIndex];
            countEl.textContent = `${pad(slideIndex + 1)}/${pad(slides.length)}`;
            titleEl.textContent = slide.title;
            yearEl.textContent = slide.year;
            linkEl.href = slide.href;

            if (!reduceMotion.matches) {
                gsap.fromTo(
                    titleEl,
                    { yPercent: 100 },
                    { yPercent: 0, duration: 0.7, ease: "expo.out", overwrite: true },
                );
            }
        }

        function render() {
            timelines.forEach((tl, i) => tl.progress(progressFor(i)));
            updateMediaUrls();
            updateCaption();
        }

        function nearestPosFor(targetMod: number) {
            let delta = mod(targetMod - posState.pos, 1);
            if (delta > 0.5) delta -= 1;
            return posState.pos + delta;
        }

        function posForIndex(index: number) {
            return nearestPosFor(mod((centerIndex - index) * step, 1));
        }

        function centeredIndex() {
            return mod(Math.round(centerIndex - posState.pos / step), n);
        }

        function animateToIndex(index: number, duration: number, ease: string) {
            gsap.to(posState, {
                pos: posForIndex(index),
                duration,
                ease,
                overwrite: true,
                onUpdate: render,
            });
        }

        function resetPosTo() {
            posTo = gsap.quickTo(posState, "pos", {
                duration: 0.5,
                ease: "power3",
                onUpdate: render,
            });
        }

        const go = (delta: number) =>
            animateToIndex(mod(centeredIndex() + delta, n), 1, "expo.inOut");

        // Offset so the centred slot starts on the first slide.
        mediaItems.forEach((item, index) => {
            item.img.src = mediasUrls[mod(index - centerIndex, mediasUrls.length)];
        });
        buildTimelines();
        render();

        Observer.create({
            target: root,
            type: "pointer,touch",
            onPress: () => {
                didDrag = false;
                gsap.killTweensOf(posState);
                resetPosTo();
                dragTarget = posState.pos;
            },
            onDrag: (self) => {
                if (Math.abs(self.deltaX) > 2) didDrag = true;
                dragTarget += self.deltaX * dragFactor;
                posTo(dragTarget);
            },
            onRelease: () => animateToIndex(centeredIndex(), 0.6, "expo.out"),
        });

        medias.forEach((media, index) => {
            media.addEventListener("click", () => {
                if (didDrag) return;
                if (centeredIndex() === index) {
                    window.location.href = linkEl.href;
                    return;
                }
                animateToIndex(index, 1, "expo.inOut");
            });
        });

        prevBtn.addEventListener("click", () => go(-1));
        nextBtn.addEventListener("click", () => go(1));
        root.addEventListener("keydown", (e) => {
            if (e.key === "ArrowLeft") go(-1);
            if (e.key === "ArrowRight") go(1);
        });

        let lastWidth = window.innerWidth;
        let resizeCall: gsap.core.Tween | undefined;
        window.addEventListener("resize", () => {
            resizeCall?.kill();
            resizeCall = gsap.delayedCall(0.2, () => {
                if (window.innerWidth === lastWidth) return;
                lastWidth = window.innerWidth;
                buildTimelines();
                render();
            });
        });
    }
</script>
