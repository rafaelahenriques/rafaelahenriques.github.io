---
/**
 * A Vimeo video that loads only when someone presses play. Until then nothing
 * goes to Vimeo: no request, no cookies. It fills its parent, which sets the
 * size and shape. Without JavaScript it's a link to the video on Vimeo.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
    id: string;
    /** what the video is, for screen readers */
    title: string;
    /** a still from this site, shown until it plays */
    poster: ImageMetadata;
}

const { id, title, poster } = Astro.props;
const player = `https://player.vimeo.com/video/${id}?badge=0&autopause=0&dnt=1&autoplay=1`;
---

<div class="vimeo" data-vimeo={player} data-vimeo-title={title}>
    <button type="button" class="vimeo__play" aria-label={`Play video: ${title}. Loads from Vimeo.`}>
        <Image src={poster} alt="" widths={[800, 1400, 2000]} sizes="(min-width: 900px) 70vw, 100vw" class="vimeo__poster" />
        <span class="vimeo__label mono">Play video <span class="vimeo__note">Loads from Vimeo</span></span>
    </button>
    <a class="vimeo__link mono" href={`https://vimeo.com/${id}`} target="_blank" rel="noopener noreferrer">Watch on Vimeo ↗</a>
</div>

<script>
    document.querySelectorAll<HTMLElement>("[data-vimeo]").forEach((box) => {
        box.querySelector("button")?.addEventListener("click", () => {
            const frame = document.createElement("iframe");
            frame.src = box.dataset.vimeo ?? "";
            frame.title = box.dataset.vimeoTitle ?? "";
            frame.allow = "autoplay; fullscreen; picture-in-picture; encrypted-media";
            frame.referrerPolicy = "strict-origin-when-cross-origin";
            box.replaceChildren(frame);
            frame.focus();
        });
    });
</script>

<style>
    .vimeo,
    .vimeo__play,
    .vimeo :global(iframe) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
    }

    .vimeo__play {
        display: grid;
        place-items: center;
        padding: 0;
        overflow: hidden;
        background: none;
        cursor: pointer;
    }

    .vimeo__poster {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* a solid label, so it reads over any picture */
    .vimeo__label {
        position: relative;
        display: grid;
        gap: 6px;
        padding: 14px 18px;
        background: #0e0e0e;
        color: #e9e7e2;
        font-size: var(--fs-mono);
        text-transform: uppercase;
        transition:
            background-color 0.15s var(--step),
            color 0.15s var(--step);
    }

    .vimeo__note {
        text-transform: none;
    }

    .vimeo__play:hover .vimeo__label,
    .vimeo__play:focus-visible .vimeo__label {
        background: var(--blue);
        color: var(--on-blue);
    }

    .vimeo__play:focus-visible {
        outline: none;
    }

    /* no JavaScript: the link, nothing to press */
    .vimeo__link {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        color: #e9e7e2;
        font-size: var(--fs-mono);
    }

    :global(html.js) .vimeo__link,
    :global(html:not(.js)) .vimeo__play {
        display: none;
    }
</style>
