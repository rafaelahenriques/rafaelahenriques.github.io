---
/**
 * A word spread across the full width, letter by letter, with a photo set
 * in an oval between two of its letters. It enters as one tight word; then
 * the photo opens at the seam and pushes the letters apart to the edges.
 * Annotations sit above like figure labels in a book.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    word: string;
    image: ImageMetadata;
    alt: string;
    /** the photo goes before the letter at this index */
    insertAt: number;
    /** focal point for the oval crop, e.g. "46% 45%" */
    focus?: string;
    figLeft?: string;
    figRight?: string;
    figRightHref?: string;
}

const { word, image, alt, insertAt, focus = "50% 50%", figLeft, figRight, figRightHref } = Astro.props;
const letters = [...word];
---

<div class="spread" data-spread>
    {
        (figLeft || figRight) && (
            <div class="spread__figs mono wrap">
                <span>{figLeft}</span>
                {figRight && (figRightHref ? <a href={figRightHref} class="link">{figRight}</a> : <span>{figRight}</span>)}
            </div>
        )
    }
    <p class="spread__word wrap" aria-label={word}>
        {
            letters.map((letter, i) => (
                <>
                    {i === insertAt && (
                        <span class="spread__photo" data-spread-photo>
                            <Image
                                src={image}
                                alt={alt}
                                widths={[300, 600, 900]}
                                sizes="(min-width: 900px) 16vw, 28vw"
                                style={`object-position: ${focus}`}
                            />
                        </span>
                    )}
                    <span class="spread__letter" data-spread-letter data-side={i < insertAt ? "left" : "right"} aria-hidden="true">
                        {letter}
                    </span>
                </>
            ))
        }
    </p>
</div>

<script>
    import { gsap } from "gsap";

    // Play once the page is actually visible (after the loading screen, if any)
    const whenVisible = (play: () => void) => {
        if (document.documentElement.classList.contains("is-loading")) {
            window.addEventListener("loader:done", play, { once: true });
        } else {
            play();
        }
    };

    const setUp = () =>
        document.querySelectorAll<HTMLElement>("[data-spread]").forEach((spread) => {
            const word = spread.querySelector<HTMLElement>(".spread__word")!;
            const photo = spread.querySelector<HTMLElement>("[data-spread-photo]")!;
            const letters = [...spread.querySelectorAll<HTMLElement>("[data-spread-letter]")];
            const firstRight = letters.findIndex((l) => l.dataset.side === "right");

            // The CSS layout is the end state (spread across the page). Work out
            // where every letter sits when the word is set tight and centred, and
            // where the seam between the two halves falls.
            const box = word.getBoundingClientRect();
            const widths = letters.map((l) => l.getBoundingClientRect().width);
            const total = widths.reduce((a, b) => a + b, 0);
            let cursor = box.left + (box.width - total) / 2;
            let seam = cursor;
            const offsets = letters.map((l, i) => {
                if (i === firstRight) seam = cursor;
                const packed = cursor;
                cursor += widths[i];
                return packed - l.getBoundingClientRect().left;
            });
            const p = photo.getBoundingClientRect();
            const photoOffset = seam - (p.left + p.width / 2);

            // start: one tight word, the photo a dot at the seam
            gsap.set(letters, { x: (i) => offsets[i], yPercent: 60, autoAlpha: 0 });
            gsap.set(photo, { x: photoOffset, scale: 0 });
            gsap.set(word, { visibility: "visible" });

            const tl = gsap
                .timeline({ paused: true })
                // the word rises in, letter by letter
                .to(letters, { yPercent: 0, autoAlpha: 1, duration: 0.9, ease: "expo.out", stagger: 0.05 })
                // the photo opens at the seam and pushes the letters apart
                .to(photo, { x: 0, scale: 1, duration: 1.5, ease: "expo.inOut" }, "+=0.3")
                .from(photo.querySelector("img"), { scale: 1.6, duration: 1.8, ease: "expo.out" }, "<")
                .to(letters, { x: 0, duration: 1.5, ease: "expo.inOut" }, "<");

            whenVisible(() => tl.play());
        });

    // letter widths depend on the webfont, so measure once it has loaded
    gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", (ctx) => {
        document.fonts.ready.then(ctx.add(setUp));
    });
</script>

<style>
    .spread__figs {
        display: flex;
        justify-content: space-between;
        gap: var(--gutter);
        margin-bottom: clamp(12px, 2vw, 24px);
        font-size: var(--fs-mono);
        text-transform: uppercase;
        color: var(--muted);
    }

    .spread__word {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 0;
        font-size: clamp(2.75rem, 1rem + 11vw, 13rem);
        font-weight: 800;
        line-height: 0.8;
        letter-spacing: -0.04em;
        text-transform: uppercase;
    }

    .spread__letter {
        display: inline-block;
    }

    /* the script reveals the word once it has packed the letters together */
    @media (prefers-reduced-motion: no-preference) {
        :global(html.js) .spread__word {
            visibility: hidden;
        }
    }

    .spread__photo {
        display: block;
        flex: none;
        width: clamp(72px, 14vw, 240px);
        aspect-ratio: 3 / 4;
        overflow: hidden;
        border-radius: 50%;
    }

    .spread__photo :global(img) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
</style>
