---
/**
 * Inverted full-width band linking to the next project in site order. The page
 * dissolves into it in pixels, and it runs straight on into the footer.
 */
import { getProjects, slugOf } from "../lib/content";
import PixelEdge from "./PixelEdge.astro";

interface Props {
    /** slug of the current project */
    current: string;
}

const { current } = Astro.props;
const all = await getProjects();
const index = all.findIndex((p) => slugOf(p) === current);
const next = all[(index + 1) % all.length];
---

<PixelEdge seed={index + 3} rows={8} class="next-project__edge" />
<nav class="next-project inverse" aria-label="Next project" data-joins-footer>
    <a href={`/projects/${slugOf(next)}/`} class="next-project__link wrap" data-cursor="Next">
        <span class="mono next-project__label">Next project</span>
        <span class="next-project__title">
            {next.data.title}
            {next.data.status === "in-progress" && <span class="wip next-project__wip">In progress</span>}
        </span>
        <span class="next-project__arrow" aria-hidden="true">→</span>
    </a>
</nav>

<style>
    .next-project__link {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: end;
        gap: 12px var(--gutter);
        padding-block: clamp(56px, 8vw, 120px);
    }

    .next-project__label {
        grid-column: 1 / -1;
        opacity: 0.6;
    }

    .next-project__title,
    .next-project__arrow {
        font-family: var(--display);
        font-size: clamp(3rem, 1rem + 7vw, 8.5rem);
        font-weight: 800;
        line-height: 0.85;
        letter-spacing: -0.06em;
    }

    .next-project__title {
        text-transform: lowercase;
    }

    .next-project__arrow {
        transition: transform 0.24s steps(4, end);
    }

    .next-project__link:hover .next-project__title {
        color: var(--blue);
    }

    /* sits with the title, at mid-height of the big type */
    .next-project__wip {
        margin-left: 0.6rem;
        vertical-align: middle;
        font-family: var(--mono);
        font-weight: 400;
        letter-spacing: 0.02em;
        text-transform: uppercase;
    }

    .next-project__link:hover .next-project__arrow,
    .next-project__link:focus-visible .next-project__arrow {
        transform: translateX(16px);
    }
</style>
