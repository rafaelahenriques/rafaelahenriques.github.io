---
import ThemeToggle from "./ThemeIcon.astro";
import { site } from "../lib/site";

const links = [
    { href: "/projects/", label: "Projects" },
    { href: "/about/", label: "About" },
];

const path = Astro.url.pathname.endsWith("/")
    ? Astro.url.pathname
    : Astro.url.pathname + "/";

const isCurrent = (href: string) => path.startsWith(href);
---

<header class="site-header mono" data-header>
    <a href="/" class="site-header__brand" aria-label="Rafaela Henriques, home">
        Rafaela Henriques
    </a>

    <p class="site-header__role muted">
        Web Developer — {site.location} —
        <time class="site-header__clock" data-clock data-time-zone={site.timeZone}></time>
    </p>

    <nav aria-label="Primary" class="site-header__nav">
        <ul>
            {
                links.map((link, i) => (
                    <li>
                        <a
                            href={link.href}
                            class="site-header__link"
                            aria-current={isCurrent(link.href) ? "page" : undefined}
                        >
                            <span class="site-header__num">{String(i + 1).padStart(2, "0")}</span>
                            {link.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>

    <div class="site-header__controls">
        <button type="button" class="site-header__search text-button" data-cmdk-open aria-label="Search the site" aria-keyshortcuts="Meta+K Control+K /">
            <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
                <circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
                <path d="M13 13l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
            <span class="site-header__search-label">Search</span>
            <kbd class="site-header__kbd" data-cmdk-key>⌘K</kbd>
        </button>
        <ThemeToggle />
    </div>
</header>

<style>
    .site-header {
        position: fixed;
        inset: 0 0 auto;
        z-index: 50;
        height: var(--header-h);
        display: flex;
        align-items: center;
        gap: var(--gutter);
        padding-inline: var(--gutter);
        border-bottom: 1px solid var(--line);
        background: var(--bg);
        color: var(--text);
    }

    .site-header__brand {
        white-space: nowrap;
    }

    .site-header__role {
        display: none;
    }

    .site-header__nav {
        margin-left: auto;
    }

    .site-header__nav ul {
        display: flex;
        gap: 2px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    /* numbered, filling blue under the pointer */
    .site-header__link {
        display: inline-flex;
        gap: 8px;
        padding: 6px 8px;
        transition:
            background-color 0.15s var(--step),
            color 0.15s var(--step);
    }

    .site-header__num {
        color: var(--muted);
    }

    .site-header__link:hover,
    .site-header__link:focus-visible {
        background: var(--blue);
        color: #e9e7e2;
        outline: none;
    }

    .site-header__link:hover .site-header__num,
    .site-header__link:focus-visible .site-header__num {
        color: inherit;
    }

    /* the page you're on: its number turns into a blue pixel */
    .site-header__link[aria-current="page"] .site-header__num {
        color: transparent;
        background: linear-gradient(var(--blue), var(--blue)) 50% 50% / 8px 8px no-repeat;
    }

    .site-header__link[aria-current="page"]:hover .site-header__num {
        background-image: linear-gradient(#e9e7e2, #e9e7e2);
    }

    .site-header__clock {
        font-variant-numeric: tabular-nums;
    }

    .site-header__controls {
        display: flex;
        align-items: center;
        gap: clamp(12px, 2vw, 24px);
    }

    .site-header__search {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        /* a comfortable tap target even as an icon */
        min-height: 32px;
    }

    .site-header__kbd {
        padding: 1px 5px;
        border: 1px solid var(--line);
        font-size: 0.7rem;
        color: var(--muted);
    }

    /* phones: just the magnifying glass */
    @media (max-width: 719px) {
        .site-header__search-label,
        .site-header__kbd {
            display: none;
        }

        .site-header__link {
            padding-inline: 5px;
        }
    }

    @media (max-width: 400px) {
        .site-header__num {
            display: none;
        }
    }

    @media (min-width: 900px) {
        .site-header {
            display: grid;
            grid-template-columns: repeat(12, minmax(0, 1fr));
        }

        .site-header__brand {
            grid-column: 1 / span 3;
        }

        .site-header__role {
            display: block;
            margin: 0;
            grid-column: 4 / span 4;
            white-space: nowrap;
        }

        .site-header__nav {
            grid-column: 8 / span 2;
            margin-left: 0;
        }

        .site-header__controls {
            grid-column: 10 / span 3;
            justify-self: end;
        }
    }
</style>

<script>
    // Local time where I'm based, e.g. "14:32"; ticks every 15s.
    const clock = document.querySelector<HTMLTimeElement>("[data-clock]");
    if (clock) {
        const format = new Intl.DateTimeFormat("en-GB", {
            hour: "2-digit",
            minute: "2-digit",
            timeZone: clock.dataset.timeZone,
        });
        const tick = () => {
            const now = new Date();
            clock.textContent = format.format(now);
            clock.dateTime = now.toISOString();
        };
        tick();
        setInterval(tick, 15_000);
    }
</script>
