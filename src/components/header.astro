---
import ThemeToggle from "./ThemeIcon.astro";

const links = [
    { href: "/projects/", label: "Projects" },
    { href: "/about/", label: "About" },
];

const path = Astro.url.pathname.endsWith("/")
    ? Astro.url.pathname
    : Astro.url.pathname + "/";

const isCurrent = (href: string) => path.startsWith(href);
---

<header class="site-header mono" data-header>
    <a href="/" class="site-header__brand" aria-label="Rafaela Henriques, home">
        Rafaela Henriques
    </a>

    <span class="site-header__role muted">Web Developer</span>

    <nav aria-label="Primary" class="site-header__nav">
        <ul>
            {
                links.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            class="link"
                            aria-current={isCurrent(link.href) ? "page" : undefined}
                        >
                            {link.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>

    <div class="site-header__controls">
        <ThemeToggle />
    </div>
</header>

<style>
    .site-header {
        position: fixed;
        inset: 0 0 auto;
        z-index: 50;
        height: var(--header-h);
        display: flex;
        align-items: center;
        gap: var(--gutter);
        padding-inline: var(--gutter);
        color: var(--text);
        background: color-mix(in oklab, var(--bg) 88%, transparent);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .site-header__brand {
        white-space: nowrap;
    }

    .site-header__role {
        display: none;
    }

    .site-header__nav {
        margin-left: auto;
    }

    .site-header__nav ul {
        display: flex;
        gap: clamp(12px, 2vw, 28px);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .site-header__nav a[aria-current="page"] {
        background-size: 100% 1px;
    }

    @media (max-width: 480px) {
        .site-header__brand {
            max-width: 9ch;
            white-space: normal;
            line-height: 1.1;
        }
    }

    @media (min-width: 900px) {
        .site-header {
            display: grid;
            grid-template-columns: repeat(12, minmax(0, 1fr));
        }

        .site-header__brand {
            grid-column: 1 / span 3;
        }

        .site-header__role {
            display: block;
            grid-column: 4 / span 3;
        }

        .site-header__nav {
            grid-column: 7 / span 4;
            margin-left: 0;
        }

        .site-header__controls {
            grid-column: 11 / span 2;
            justify-self: end;
        }
    }
</style>
