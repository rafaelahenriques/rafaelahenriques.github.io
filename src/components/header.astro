---
import ThemeToggle from "./ThemeIcon.astro";

const links = [
    { href: "/", label: "Home" },
    { href: "/projects/", label: "Projects" },
    { href: "/blog/", label: "Blog" },
    { href: "/about/", label: "About" },
];

const path = Astro.url.pathname.endsWith("/")
    ? Astro.url.pathname
    : Astro.url.pathname + "/";
---

<header class="site-header">
    <nav aria-label="Primary" class="site-nav">
        <!-- BRAND -->
        <div class="site-nav__brand">
            <a href="/" aria-label="Site home" class="site-nav__logo">
                Rafaela Henriques
            </a>
        </div>

        <!-- NAVIGATION -->
        <ul class="navigation">
            {
                links.map((link) => (
                    <li class="navigation__item">
                        <a
                            href={link.href}
                            class="navigation__link"
                            aria-current={
                                path === link.href ? "page" : undefined
                            }
                        >
                            {link.label}
                        </a>
                    </li>
                ))
            }
        </ul>

        <!-- CONTROLS (THEME TOGGLE, future stuff) -->
        <div class="site-nav__controls">
            <ThemeToggle />
        </div>
    </nav>
</header>

<style>
    /* Base: mobile-first */

    .site-header {
        display: flex;
        justify-content: center;
        padding-block: 8px;
    }

    .site-nav {
        width: 100%;
        max-width: var(--max-width);
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .site-nav__brand {
        flex: 0 0 auto;
    }

    .site-nav__logo {
        text-decoration: none;
        color: var(--text);
        font-weight: 800;
        letter-spacing: -0.01em;
        font-size: var(--step-1);
        white-space: nowrap;
    }

    .navigation {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        padding: 0;
        margin: 0;
        margin-left: auto;
    }

    .navigation__item {
        margin: 0;
    }

    .navigation__link {
        color: var(--muted);
        text-decoration: none;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: var(--step--1);
        position: relative;
        transition:
            transform 0.12s ease,
            color 0.18s ease,
            background 0.18s ease;
    }

    .navigation__link:hover {
        color: var(--text);
        background: var(--glass);
        transform: translateY(-1px);
    }

    .navigation__link[aria-current="page"] {
        color: var(--accent);
        background: color-mix(in oklab, var(--accent) 10%, transparent);
    }

    .site-nav__controls {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Tablet: tighten layout, keep mobile-first philosophy */

    @media (min-width: 720px) {
        .site-header {
            padding-block: 10px;
        }

        .site-nav {
            flex-wrap: nowrap;
            gap: clamp(8px, 1.5vw, 18px);
        }

        .navigation {
            gap: 8px;
        }

        .navigation__link {
            font-size: var(--step-0);
            padding: 10px 14px;
        }
    }

    /* Desktop: more breathing room */

    @media (min-width: 1024px) {
        .site-header {
            padding-block: 12px;
        }

        .site-nav {
            gap: clamp(12px, 1.8vw, 24px);
        }

        .site-nav__logo {
            font-size: var(--step-1);
        }
    }
</style>
