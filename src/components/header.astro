---
const links = [
    { href: "/", label: "Home" },
    { href: "/projects/", label: "Projects" },
    { href: "/blog/", label: "Blog" },
    { href: "/about/", label: "About" },
];
const path = Astro.url.pathname.endsWith("/")
    ? Astro.url.pathname
    : Astro.url.pathname + "/";
---

<header>
    <nav aria-label="Primary" class="site-nav">
        <!-- BRAND -->
        <div class="site-nav__brand">
            <a href="/" aria-label="Site home">Rafaela Henriques</a>
        </div>

        <!-- NAV -->
        <ul class="navigation">
            {
                links.map((l) => (
                    <li>
                        <a
                            href={l.href}
                            aria-current={path === l.href ? "page" : undefined}
                        >
                            {l.label}
                        </a>
                    </li>
                ))
            }
        </ul>

        <!-- THEME SWITCH -->
        <div class="site-nav__controls">
            <label class="theme-toggle" for="theme-switch">
                <input
                    type="checkbox"
                    id="theme-switch"
                    class="theme-toggle__checkbox"
                />

                <span class="theme-toggle__track">
                    <span class="theme-toggle__thumb">
                        <span class="icon-sun">☀</span>
                        <span class="icon-moon">🌙</span>
                    </span>
                </span>
            </label>
        </div>
    </nav>
</header>

<!-- CLIENT JS -->
<script>
    if (typeof window !== "undefined") {
        const checkbox = document.getElementById(
            "theme-switch",
        ) as HTMLInputElement;

        const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
        ).matches;
        const saved = window.localStorage.getItem("theme");
        const initial = saved ?? (prefersDark ? "dark" : "light");

        document.documentElement.dataset.theme = initial;

        if (checkbox) {
            checkbox.checked = initial === "light";

            checkbox.addEventListener("change", () => {
                const theme = checkbox.checked ? "light" : "dark";
                document.documentElement.dataset.theme = theme;
                window.localStorage.setItem("theme", theme);
            });
        }
    }
</script>

<style>
    header {
        display: flex;
        justify-content: center;
        padding-block: 8px;
    }

    .site-nav {
        width: 100%;
        max-width: var(--max-width);
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .site-nav__brand a {
        color: var(--text);
        text-decoration: none;
        font-weight: 800;
        letter-spacing: -0.01em;
        font-size: var(--step-1);
        white-space: nowrap;
    }

    .navigation {
        list-style: none;
        display: flex;
        gap: 6px;
        padding: 0;
        margin: 0;
        margin-left: auto;
    }

    .navigation a {
        color: var(--muted);
        text-decoration: none;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: var(--step--1);
        transition:
            transform 0.12s ease,
            color 0.18s ease,
            background 0.18s ease;
    }

    .navigation a:hover {
        color: var(--text);
        background: var(--glass);
        transform: translateY(-1px);
    }

    .navigation a[aria-current="page"] {
        color: var(--accent);
        background: color-mix(in oklab, var(--accent) 10%, transparent);
    }

    .site-nav__controls {
        display: flex;
        align-items: center;
        margin-left: 0;
    }

    /* THEME TOGGLE */
    .theme-toggle {
        display: inline-flex;
        position: relative;
        cursor: pointer;
        user-select: none;
    }

    .theme-toggle__checkbox {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
    }

    .theme-toggle__track {
        width: 46px;
        height: 24px;
        border-radius: 999px;
        background: var(--glass);
        border: 1px solid var(--border);
        padding: 2px;
        display: flex;
        align-items: center;
        transition:
            background 0.18s ease,
            border-color 0.18s ease;
    }

    .theme-toggle__thumb {
        width: 20px;
        height: 20px;
        border-radius: 999px;
        background: var(--surface);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        transform: translateX(0);
        transition:
            transform 0.18s ease,
            background 0.18s ease;
        overflow: hidden;
    }

    .icon-sun,
    .icon-moon {
        position: absolute;
        font-size: 0.8rem;
        transition:
            opacity 0.18s ease,
            transform 0.18s ease;
    }

    .icon-sun {
        opacity: 1;
        transform: translateY(0);
    }
    .icon-moon {
        opacity: 0;
        transform: translateY(6px);
    }

    .theme-toggle__checkbox:checked + .theme-toggle__track {
        background: color-mix(in oklab, var(--accent) 18%, transparent);
        border-color: color-mix(in oklab, var(--accent) 65%, white);
    }

    .theme-toggle__checkbox:checked
        + .theme-toggle__track
        .theme-toggle__thumb {
        transform: translateX(20px);
        background: var(--accent);
    }

    .theme-toggle__checkbox:checked + .theme-toggle__track .icon-sun {
        opacity: 0;
        transform: translateY(-6px);
    }

    .theme-toggle__checkbox:checked + .theme-toggle__track .icon-moon {
        opacity: 1;
        transform: translateY(0);
    }

    /* TABLET */
    @media (min-width: 720px) {
        header {
            padding-block: 10px;
        }

        .site-nav {
            flex-wrap: nowrap;
            gap: clamp(8px, 1.5vw, 18px);
        }

        .navigation a {
            font-size: var(--step-0);
            padding: 10px 14px;
        }
    }

    /* DESKTOP */
    @media (min-width: 1024px) {
        header {
            padding-block: 12px;
        }

        .site-nav__brand a {
            font-size: var(--step-1);
        }
    }
</style>
