---
import ThemeToggle from "./ThemeIcon.astro";

const links = [
    { href: "/", label: "Home" },
    { href: "/projects/", label: "Projects" },
    { href: "/blog/", label: "Blog" },
    { href: "/about/", label: "About" },
];

const path = Astro.url.pathname.endsWith("/")
    ? Astro.url.pathname
    : Astro.url.pathname + "/";
---

<header class="site-header">
    <div class="site-header__inner">
        <!-- BRAND (top, not fixed on mobile) -->
        <a href="/" aria-label="Site home" class="site-header__brand">
            Rafaela Henriques
        </a>

        <!-- THEME TOGGLE (top-right on mobile, far right on desktop) -->
        <div class="site-header__controls">
            <ThemeToggle />
        </div>

        <!-- PRIMARY NAV (fixed at bottom on mobile, inline in bar on desktop) -->
        <nav aria-label="Primary" class="site-nav">
            <ul class="navigation">
                {
                    links.map((link) => (
                        <li class="navigation__item">
                            <a
                                href={link.href}
                                class="navigation__link"
                                aria-current={
                                    path === link.href ? "page" : undefined
                                }
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
</header>

<style>
    /* Base: mobile-first */

    .site-header {
        position: relative;
        z-index: 40;
    }

    .site-header__inner {
        position: relative;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 8px 16px 0;
    }

    .site-header__brand {
        display: block;
        text-align: center;
        text-decoration: none;
        color: var(--text);
        font-weight: 800;
        letter-spacing: -0.01em;
        font-size: var(--step-1);
        white-space: nowrap;
    }

    .site-header__controls {
        position: absolute;
        top: 8px;
        right: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Mobile bottom nav (fixed) */
    .site-nav {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 8px 16px calc(10px + env(safe-area-inset-bottom));
        background: color-mix(in oklab, var(--surface) 96%, transparent);
        border-top: 1px solid var(--border);
        backdrop-filter: blur(18px);
    }

    .navigation {
        list-style: none;
        display: flex;
        justify-content: center;
        gap: 10px;
        padding: 0;
        margin: 0;
    }

    .navigation__item {
        margin: 0;
    }

    .navigation__link {
        color: var(--muted);
        text-decoration: none;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: var(--step--1);
        position: relative;
        transition:
            transform 0.12s ease,
            color 0.18s ease,
            background 0.18s ease;
    }

    .navigation__link:hover {
        color: var(--text);
        background: var(--glass);
        transform: translateY(-1px);
    }

    .navigation__link[aria-current="page"] {
        color: var(--accent);
        background: color-mix(in oklab, var(--accent) 10%, transparent);
    }

    /* Give room for fixed bottom nav on small screens */
    :global(body) {
        padding-bottom: 72px;
    }

    /* Tablet tweaks if needed (nav still bottom-fixed, just nicer spacing) */
    @media (min-width: 720px) {
        .site-header__inner {
            padding: 10px 20px 0;
        }

        .navigation {
            gap: 12px;
        }

        .navigation__link {
            font-size: var(--step-0);
            padding: 10px 14px;
        }
    }

    /* Desktop: header fixed at top, nav inline in bar, no bottom-fixed nav */

    @media (min-width: 1024px) {
        .site-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 50;
            background: color-mix(in oklab, var(--bg) 92%, transparent);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
        }

        .site-header__inner {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            padding: 12px 24px;
        }

        .site-header__brand {
            flex: 0 0 auto;
            text-align: left;
            font-size: var(--step-1);
        }

        .site-nav {
            position: static;
            flex: 1 1 auto;
            padding: 0;
            background: none;
            border-top: none;
            backdrop-filter: none;
        }

        .navigation {
            justify-content: flex-end;
            gap: 12px;
        }

        .site-header__controls {
            position: static;
            flex: 0 0 auto;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 8px;
        }

        /* Adjust global body padding for fixed top header on desktop */
        :global(body) {
            padding-top: 80px;
            padding-bottom: 28px;
        }
    }
</style>
