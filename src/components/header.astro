---
const links = [
    { href: "/", label: "Home" },
    { href: "/projects/", label: "Projects" },
    { href: "/blog/", label: "Blog" },
    { href: "/about/", label: "About" },
];
const path = Astro.url.pathname.endsWith("/")
    ? Astro.url.pathname
    : Astro.url.pathname + "/";
---

<header>
    <nav aria-label="Primary">
        <a href="/" aria-label="Site home">Rafaela Henriques</a>
        <ul>
            {
                links.map((l) => (
                    <li>
                        <a
                            href={l.href}
                            aria-current={path === l.href ? "page" : undefined}
                        >
                            {l.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>
</header>
