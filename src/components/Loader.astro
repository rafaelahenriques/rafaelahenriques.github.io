---
/**
 * First-visit loading screen: a big count runs to 100% while the page loads,
 * a few status lines tick on, then it clears away in pixels (scripts/wipe.ts). BaseLayout's <head> script adds html.is-loading
 * (once per session, never for reduced motion); without it this renders
 * nothing. When it finishes it fires "loader:done" on window so page
 * animations can start on a visible page.
 */
const year = new Date().getFullYear();
---

<div class="loader" data-loader aria-hidden="true">
    <div class="loader__row mono">
        <span class="loader__lines">
            <span>Rafaela Henriques — Portfolio ©{year}</span>
            <span data-loader-line>01 / Type ........ ok</span>
            <span data-loader-line>02 / Pictures .... ok</span>
            <span data-loader-line>03 / Pixels ...... ok</span>
            <span data-loader-line>04 / Pet ......... awake</span>
        </span>
        <span>Web developer — Kortrijk, BE</span>
    </div>
    <div class="loader__row loader__row--bottom">
        <span class="loader__count"><span data-loader-count>00</span>%</span>
    </div>
    <div class="loader__bar"><span data-loader-bar></span></div>
</div>

<script>
    import { gsap } from "gsap";
    import { uncover } from "../scripts/wipe";

    const root = document.documentElement;
    const loader = document.querySelector<HTMLElement>("[data-loader]");

    const done = () => {
        root.classList.remove("is-loading");
        try {
            sessionStorage.setItem("loader-seen", "1");
        } catch {}
        window.dispatchEvent(new Event("loader:done"));
    };

    if (loader && root.classList.contains("is-loading")) {
        const count = loader.querySelector<HTMLElement>("[data-loader-count]")!;
        const bar = loader.querySelector<HTMLElement>("[data-loader-bar]")!;
        const lines = [...loader.querySelectorAll<HTMLElement>("[data-loader-line]")];
        const progress = { value: 0 };
        const render = () => {
            const v = Math.round(progress.value);
            count.textContent = String(v).padStart(2, "0");
            bar.style.transform = `scaleX(${progress.value / 100})`;
            lines.forEach((line, i) => line.classList.toggle("is-on", v >= (i + 1) * 22));
        };

        // run towards 90 while the page loads…
        const toNinety = gsap.to(progress, { value: 90, duration: 1.8, ease: "power2.out", onUpdate: render });

        const loaded = new Promise<void>((resolve) => {
            if (document.readyState === "complete") resolve();
            else window.addEventListener("load", () => resolve(), { once: true });
        });
        const minimum = new Promise((resolve) => setTimeout(resolve, 800));
        const cap = new Promise((resolve) => setTimeout(resolve, 4000)); // never hold anyone longer

        Promise.race([Promise.all([loaded, minimum]), cap]).then(() => {
            toNinety.kill();
            // …then finish the count, and the panel clears away in pixels
            gsap.timeline()
                .to(progress, { value: 100, duration: 0.45, ease: "power1.inOut", onUpdate: render })
                .add(() => {
                    uncover(480);
                    gsap.set(loader, { display: "none" });
                }, "+=0.2")
                .add(done, "+=0.15");
        });
    } else if (loader) {
        loader.remove();
    }
</script>

<style>
    .loader {
        display: none;
    }

    :global(html.is-loading) .loader {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        /* the visible screen, so phone toolbars never cover the counter */
        height: 100vh;
        height: 100dvh;
        z-index: 1000;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 18px var(--gutter) var(--gutter);
        padding-bottom: max(var(--gutter), env(safe-area-inset-bottom));
        background: var(--text);
        color: var(--bg);
        /* if the script never runs, get out of the way after 5s */
        animation: loader-failsafe 0s linear 5s forwards;
    }

    :global(html.is-loading) {
        overflow: hidden;
    }

    @keyframes loader-failsafe {
        to {
            visibility: hidden;
        }
    }

    .loader__row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: var(--gutter);
    }

    .loader__lines {
        display: grid;
        gap: 2px;
    }

    [data-loader-line] {
        visibility: hidden;
    }

    [data-loader-line].is-on {
        visibility: visible;
    }

    .loader__row--bottom {
        margin-top: auto;
    }

    .loader__count {
        display: block;
        /* never squeezed by the text beside it */
        flex: none;
        font-family: var(--display);
        font-size: clamp(6rem, 2rem + 24vw, 30rem);
        font-weight: 800;
        line-height: 0.74;
        letter-spacing: -0.07em;
        font-variant-numeric: tabular-nums;
    }

    /* phones: the place line goes under the status lines */
    @media (max-width: 599px) {
        .loader__row:first-child {
            flex-direction: column;
        }
    }

    .loader__bar {
        height: 1px;
        margin-top: clamp(16px, 2vw, 24px);
        background: color-mix(in oklab, var(--bg) 25%, transparent);
    }

    .loader__bar span {
        display: block;
        height: 100%;
        background: var(--bg);
        transform: scaleX(0);
        transform-origin: left;
    }
</style>
