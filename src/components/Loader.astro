---
/**
 * First-visit loading screen: a counter runs to 100 while the page loads,
 * then the panel wipes up. BaseLayout's <head> script adds html.is-loading
 * (once per session, never for reduced motion); without it this renders
 * nothing. When it finishes it fires "loader:done" on window so page
 * animations can start on a visible page.
 */
const year = new Date().getFullYear();
---

<div class="loader" data-loader aria-hidden="true">
    <div class="loader__row mono">
        <span>Rafaela Henriques</span>
        <span>Portfolio ©{year}</span>
    </div>
    <div class="loader__row loader__row--bottom">
        <span class="loader__count"><span data-loader-count>000</span></span>
        <span class="mono loader__meta">Web developer — Kortrijk, BE</span>
    </div>
    <div class="loader__bar"><span data-loader-bar></span></div>
</div>

<script>
    import { gsap } from "gsap";

    const root = document.documentElement;
    const loader = document.querySelector<HTMLElement>("[data-loader]");

    const done = () => {
        root.classList.remove("is-loading");
        try {
            sessionStorage.setItem("loader-seen", "1");
        } catch {}
        window.dispatchEvent(new Event("loader:done"));
    };

    if (loader && root.classList.contains("is-loading")) {
        const count = loader.querySelector<HTMLElement>("[data-loader-count]")!;
        const bar = loader.querySelector<HTMLElement>("[data-loader-bar]")!;
        const progress = { value: 0 };
        const render = () => {
            count.textContent = String(Math.round(progress.value)).padStart(3, "0");
            bar.style.transform = `scaleX(${progress.value / 100})`;
        };

        // run towards 90 while the page loads…
        const toNinety = gsap.to(progress, { value: 90, duration: 1.8, ease: "power2.out", onUpdate: render });

        const loaded = new Promise<void>((resolve) => {
            if (document.readyState === "complete") resolve();
            else window.addEventListener("load", () => resolve(), { once: true });
        });
        const minimum = new Promise((resolve) => setTimeout(resolve, 1200));
        const cap = new Promise((resolve) => setTimeout(resolve, 4000)); // never hold anyone longer

        Promise.race([Promise.all([loaded, minimum]), cap]).then(() => {
            toNinety.kill();
            // …then finish the count and lift the panel away
            gsap.timeline({ onComplete: () => gsap.set(loader, { display: "none" }) })
                .to(progress, { value: 100, duration: 0.45, ease: "power1.inOut", onUpdate: render })
                .to(".loader__count > span", { yPercent: -110, duration: 0.6, ease: "expo.in" }, "+=0.1")
                .to(".loader__row .mono, .loader__meta", { autoAlpha: 0, duration: 0.3 }, "<")
                .to(loader, { yPercent: -100, duration: 1, ease: "expo.inOut" }, "-=0.15")
                .add(done, "-=0.45");
        });
    } else if (loader) {
        loader.remove();
    }
</script>

<style>
    .loader {
        display: none;
    }

    :global(html.is-loading) .loader {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: var(--gutter);
        background: var(--text);
        color: var(--bg);
        /* if the script never runs, get out of the way after 5s */
        animation: loader-failsafe 0s linear 5s forwards;
    }

    :global(html.is-loading) {
        overflow: hidden;
    }

    @keyframes loader-failsafe {
        to {
            visibility: hidden;
        }
    }

    .loader__row {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: var(--gutter);
    }

    .loader__row--bottom {
        margin-top: auto;
    }

    .loader__count {
        display: block;
        overflow: hidden;
        font-size: clamp(5rem, 2rem + 18vw, 22rem);
        font-weight: 500;
        line-height: 0.82;
        letter-spacing: -0.06em;
        font-variant-numeric: tabular-nums;
    }

    .loader__count > span {
        display: inline-block;
    }

    .loader__meta {
        padding-bottom: 0.8em;
        text-align: right;
    }

    .loader__bar {
        height: 1px;
        margin-top: clamp(16px, 2vw, 24px);
        background: color-mix(in oklab, var(--bg) 25%, transparent);
    }

    .loader__bar span {
        display: block;
        height: 100%;
        background: var(--bg);
        transform: scaleX(0);
        transform-origin: left;
    }
</style>
