---
/**
 * Command menu (⌘K / Ctrl K, or "/"): one search box for the whole site.
 * Type a project, a category or a technology ("react", "python", "mobile")
 * and jump straight to it; or open the résumé, copy the email address,
 * open LinkedIn / GitHub, switch the theme.
 *
 * A modal <dialog> with the combobox + listbox pattern: the input keeps
 * focus, the arrow keys move the active option, Enter runs it, Escape
 * closes. Everything is rendered at build time; the script only filters.
 */
import { getProjects, slugOf } from "../lib/content";
import { site, contactLinks } from "../lib/site";

type Item = {
    group: string;
    label: string;
    hint?: string;
    /** extra words to match on, not shown */
    keywords?: string;
    href?: string;
    external?: boolean;
    action?: "copy-email" | "theme";
    wip?: boolean;
};

const projects = await getProjects();
const resume = contactLinks.find((l) => l.href === site.cv);

const items: Item[] = [
    ...projects.map((p) => ({
        group: "Projects",
        label: p.data.title,
        hint: p.data.category,
        keywords: [...(p.data.tech ?? []), ...(p.data.tags ?? []), ...p.data.types, p.data.year ?? ""].join(" "),
        href: `/projects/${slugOf(p)}/`,
        wip: p.data.status === "in-progress",
    })),
    { group: "Pages", label: "Home", href: "/" },
    { group: "Pages", label: "All projects", hint: "List or grid, filter by type", href: "/projects/" },
    { group: "Pages", label: "About", hint: "Bio, skills, availability", href: "/about/" },
    ...(resume ? [{ group: "Contact", label: "Open résumé", hint: "PDF", keywords: "cv resume download", href: resume.href, external: true }] : []),
    { group: "Contact", label: "Copy email address", hint: site.email, keywords: "mail contact", action: "copy-email" as const },
    { group: "Contact", label: "Send an email", hint: site.email, keywords: "mail contact", href: `mailto:${site.email}` },
    ...(site.linkedin ? [{ group: "Contact", label: "LinkedIn", keywords: "profile", href: site.linkedin, external: true }] : []),
    ...(site.github ? [{ group: "Contact", label: "GitHub", keywords: "code repositories", href: site.github, external: true }] : []),
    { group: "Settings", label: "Switch light / dark", keywords: "theme dark mode light mode", action: "theme" as const },
];

const groups = [...new Set(items.map((i) => i.group))];
---

<dialog class="cmdk" data-cmdk data-email={site.email} aria-label="Search the site">
    <div class="cmdk__panel">
        <div class="cmdk__search">
            <svg class="cmdk__icon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                <circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
                <path d="M13 13l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
            <input
                class="cmdk__input"
                type="text"
                role="combobox"
                aria-expanded="true"
                aria-controls="cmdk-list"
                aria-autocomplete="list"
                aria-label="Search projects, pages and links"
                placeholder="Search projects, tech…"
                autocomplete="off"
                spellcheck="false"
                data-cmdk-input
            />
            <kbd class="cmdk__esc mono">Esc</kbd>
        </div>

        <ul class="cmdk__list" id="cmdk-list" role="listbox" aria-label="Results" data-cmdk-list>
            {
                groups.map((group) => (
                    <>
                        <li class="cmdk__group mono" role="presentation" data-cmdk-group={group}>
                            {group}
                        </li>
                        {items
                            .filter((item) => item.group === group)
                            .map((item, i) => (
                                <li
                                    class="cmdk__option"
                                    role="option"
                                    id={`cmdk-${group.toLowerCase()}-${i}`}
                                    aria-selected="false"
                                    data-cmdk-option
                                    data-group={group}
                                    data-search={`${item.label} ${item.hint ?? ""} ${item.keywords ?? ""}`.toLowerCase()}
                                    data-href={item.href}
                                    data-external={item.external ? "" : undefined}
                                    data-action={item.action}
                                >
                                    <span class="cmdk__label">{item.label}</span>
                                    {item.wip && <span class="wip">In progress</span>}
                                    {item.hint && <span class="cmdk__hint mono">{item.hint}</span>}
                                    {item.external && <span class="cmdk__ext" aria-hidden="true">↗</span>}
                                </li>
                            ))}
                    </>
                ))
            }
        </ul>
        <p class="cmdk__empty mono" data-cmdk-empty hidden>Nothing found. Try a technology, like React or Python.</p>

        <p class="cmdk__foot mono" aria-hidden="true">
            <span><kbd>↑</kbd><kbd>↓</kbd> to move</span>
            <span><kbd>↵</kbd> to open</span>
            <span class="cmdk__status" data-cmdk-status></span>
        </p>
        <p class="visually-hidden" aria-live="polite" data-cmdk-live></p>
    </div>
</dialog>

<script>
    const dialog = document.querySelector<HTMLDialogElement>("[data-cmdk]");

    if (dialog) {
        const input = dialog.querySelector<HTMLInputElement>("[data-cmdk-input]")!;
        const options = [...dialog.querySelectorAll<HTMLElement>("[data-cmdk-option]")];
        const groups = [...dialog.querySelectorAll<HTMLElement>("[data-cmdk-group]")];
        const empty = dialog.querySelector<HTMLElement>("[data-cmdk-empty]")!;
        const status = dialog.querySelector<HTMLElement>("[data-cmdk-status]")!;
        const live = dialog.querySelector<HTMLElement>("[data-cmdk-live]")!;
        const email = dialog.dataset.email ?? "";

        let visible = options;
        let active = 0;
        let opener: HTMLElement | null = null;

        const setActive = (index: number) => {
            if (!visible.length) {
                input.removeAttribute("aria-activedescendant");
                return;
            }
            active = (index + visible.length) % visible.length;
            visible.forEach((o, i) => o.setAttribute("aria-selected", String(i === active)));
            input.setAttribute("aria-activedescendant", visible[active].id);
            visible[active].scrollIntoView({ block: "nearest" });
        };

        // every word typed has to appear somewhere in the option's text
        const filter = () => {
            const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
            visible = options.filter((o) => {
                const show = terms.every((t) => o.dataset.search!.includes(t));
                o.hidden = !show;
                o.setAttribute("aria-selected", "false");
                return show;
            });
            groups.forEach((g) => (g.hidden = !visible.some((o) => o.dataset.group === g.dataset.cmdkGroup)));
            empty.hidden = visible.length > 0;
            live.textContent = terms.length ? `${visible.length} result${visible.length === 1 ? "" : "s"}` : "";
            setActive(0);
        };

        const open = () => {
            if (dialog.open) return;
            opener = document.activeElement as HTMLElement | null;
            input.value = "";
            status.textContent = "";
            filter();
            dialog.showModal();
            input.focus();
        };
        const close = () => {
            if (dialog.open) dialog.close();
        };
        dialog.addEventListener("close", () => opener?.focus?.());

        const run = async (option: HTMLElement) => {
            const { href, action } = option.dataset;
            if (action === "copy-email") {
                try {
                    await navigator.clipboard.writeText(email);
                    status.textContent = "Copied ✓";
                    live.textContent = "Email address copied";
                    setTimeout(close, 700);
                } catch {
                    window.location.href = `mailto:${email}`;
                }
                return;
            }
            if (action === "theme") {
                close();
                document.querySelector<HTMLButtonElement>("[data-theme-toggle]")?.click();
                return;
            }
            if (!href) return;
            close();
            if (option.hasAttribute("data-external")) {
                window.open(href, "_blank", "noopener");
            } else {
                window.location.href = href;
            }
        };

        input.addEventListener("input", filter);
        input.addEventListener("keydown", (e) => {
            if (e.key === "ArrowDown") setActive(active + 1);
            else if (e.key === "ArrowUp") setActive(active - 1);
            else if (e.key === "Home" && e.ctrlKey) setActive(0);
            else if (e.key === "End" && e.ctrlKey) setActive(visible.length - 1);
            else if (e.key === "Enter" && visible[active]) run(visible[active]);
            else return;
            e.preventDefault();
        });
        options.forEach((o) => {
            o.addEventListener("click", () => run(o));
            o.addEventListener("pointermove", () => {
                const i = visible.indexOf(o);
                if (i !== active) setActive(i);
            });
        });
        // a click on the backdrop (outside the panel) closes it
        dialog.addEventListener("click", (e) => {
            if (e.target === dialog) close();
        });

        // ⌘K / Ctrl K anywhere; "/" when not already typing somewhere
        document.addEventListener("keydown", (e) => {
            const typing = e.target instanceof HTMLElement && (e.target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName));
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
                e.preventDefault();
                dialog.open ? close() : open();
            } else if (e.key === "/" && !typing && !dialog.open) {
                e.preventDefault();
                open();
            }
        });
        document.querySelectorAll<HTMLElement>("[data-cmdk-open]").forEach((b) => b.addEventListener("click", open));

        // show the right shortcut on the header button
        const isMac = /Mac|iPhone|iPad/.test(navigator.userAgent);
        document.querySelectorAll<HTMLElement>("[data-cmdk-key]").forEach((k) => (k.textContent = isMac ? "⌘K" : "Ctrl K"));
    }
</script>

<style>
    .cmdk {
        width: min(640px, calc(100% - 2 * var(--gutter)));
        max-height: min(70vh, 560px);
        margin: 12vh auto auto;
        padding: 0;
        border: 1px solid var(--line);
        background: var(--bg);
        color: var(--text);
        overflow: hidden;
    }

    .cmdk::backdrop {
        background: rgba(14, 14, 14, 0.6);
    }

    /* opens like a screen switching on: a line, then the panel */
    .cmdk[open] {
        animation: cmdk-in 0.24s steps(4, end);
    }

    @keyframes cmdk-in {
        from {
            transform: scaleY(0.04);
        }
    }

    .cmdk__panel {
        display: flex;
        flex-direction: column;
        max-height: inherit;
    }

    .cmdk__search {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 18px;
        border-bottom: 1px solid var(--line);
    }

    .cmdk__icon {
        flex: none;
        color: var(--muted);
    }

    .cmdk__input {
        flex: 1;
        min-width: 0;
        padding: 0;
        border: 0;
        background: none;
        color: inherit;
        font: inherit;
        font-size: var(--fs-body);
        outline: none;
    }

    .cmdk__input::placeholder {
        color: var(--muted);
    }

    kbd,
    .cmdk__esc {
        padding: 2px 6px;
        border: 1px solid var(--line);
        font-family: var(--mono);
        font-size: 0.7rem;
        color: var(--muted);
    }

    .cmdk__list {
        flex: 1;
        margin: 0;
        padding: 6px 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        list-style: none;
    }

    .cmdk__group {
        padding: 12px 18px 4px;
        font-size: var(--fs-mono);
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .cmdk__option {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 18px;
        cursor: pointer;
    }

    .cmdk__option[aria-selected="true"] {
        background: var(--blue);
        color: #e9e7e2;
    }

    .cmdk__label,
    .cmdk__hint {
        min-width: 0;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    /* when space runs out the hint gives way long before the title does */
    .cmdk__label {
        flex: 0 1 auto;
    }

    .cmdk__hint {
        flex: 0 1000 auto;
        margin-left: auto;
        padding-left: 12px;
        font-size: var(--fs-mono);
        opacity: 0.6;
        text-transform: uppercase;
    }

    .cmdk__ext {
        margin-left: auto;
        opacity: 0.6;
    }

    .cmdk__option .wip {
        flex: none;
    }

    /* phones: drop the hints and let long titles wrap instead of cutting them */
    @media (max-width: 559px) {
        .cmdk__hint {
            display: none;
        }

        .cmdk__label {
            white-space: normal;
        }
    }

    .cmdk__empty {
        margin: 0;
        padding: 18px;
        color: var(--muted);
    }

    .cmdk__foot {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 16px;
        margin: 0;
        padding: 10px 18px;
        border-top: 1px solid var(--line);
        font-size: var(--fs-mono);
        color: var(--muted);
    }

    .cmdk__foot kbd + kbd {
        margin-left: 2px;
    }

    .cmdk__status {
        margin-left: auto;
        color: var(--text);
    }

    [hidden] {
        display: none !important;
    }

    /* touch screens: no keyboard hints */
    @media (hover: none) {
        .cmdk__foot,
        .cmdk__esc {
            display: none;
        }
    }
</style>
