---
/**
 * Selected projects on a Game Boy. Each project's clip plays on its screen
 * (src/scripts/gameboy.ts), and beside it a short note says what it is, when
 * and with what. The numbered buttons under it are tabs; the arrows, the arrow
 * keys and the Game Boy's own buttons change project too (A and → next, B and
 * ← back), Start or the screen opens the project and Select pauses. Until the
 * visitor picks a project it moves on by itself when a clip ends. With reduced
 * motion it shows stills and waits. Without JS (or WebGL) the notes are still
 * all here, and the clip plays in a plain video.
 */
import { pad, slugOf, type ProjectEntry } from "../lib/content";

interface Props {
    projects: ProjectEntry[];
}

const { projects } = Astro.props;

const games = projects.map((p, i) => {
    const clip = p.data.clip;
    return {
        num: pad(p.data.order ?? i + 1),
        title: p.data.title,
        category: p.data.category,
        year: p.data.year,
        tech: (p.data.tech ?? []).slice(0, 5),
        brief: p.data.tagline ?? p.data.description,
        inProgress: p.data.status === "in-progress",
        href: `/projects/${slugOf(p)}/`,
        clip,
        poster: clip?.replace(/\.mp4$/, ".jpg"),
    };
});
const first = games[0];
---

<section class="gb-section wrap" aria-labelledby="selected" data-gb>
    <div class="gb-head">
        <h2 id="selected" class="mono muted">Selected projects</h2>
        <a href="/projects/" class="mono link">All projects →</a>
    </div>

    <div class="gb-layout">
        <div class="gb-info">
            {
                games.map((g, i) => (
                    <article class="gb-panel" id={`gb-panel-${i}`} role="tabpanel" aria-labelledby={`gb-tab-${i}`} hidden={i !== 0} data-gb-panel>
                        <p class="gb-panel__kicker mono muted">
                            {g.num} — {g.category}
                            {g.inProgress && <span class="wip">In progress</span>}
                        </p>
                        <h3 class="gb-panel__title">{g.title}</h3>
                        <dl class="gb-panel__facts mono">
                            <div>
                                <dt class="muted">Year</dt>
                                <dd>{g.year}</dd>
                            </div>
                            <div>
                                <dt class="muted">Built with</dt>
                                <dd>{g.tech.join(" · ")}</dd>
                            </div>
                        </dl>
                        <p class="gb-panel__brief">{g.brief}</p>
                        <a href={g.href} class="mono link">View project →</a>
                    </article>
                ))
            }
        </div>

        <div class="gb-col">
            <div class="gb-stage" data-cursor="Play">
                <canvas class="gb-canvas" data-gb-canvas aria-hidden="true"></canvas>
                <!-- no WebGL: the clip in a plain frame -->
                <div class="gb-fallback" data-gb-fallback hidden>
                    <video muted playsinline loop preload="none" poster={first.poster} data-gb-fallback-video aria-hidden="true"></video>
                </div>
            </div>

            <div class="gb-controls">
                <button type="button" class="gb-btn" data-gb-prev aria-label="Previous project">←</button>
                <div class="gb-tabs" role="tablist" aria-label="Selected projects">
                    {
                        games.map((g, i) => (
                            <button
                                type="button"
                                role="tab"
                                class="gb-tab mono"
                                id={`gb-tab-${i}`}
                                aria-selected={i === 0 ? "true" : "false"}
                                aria-controls={`gb-panel-${i}`}
                                tabindex={i === 0 ? "0" : "-1"}
                                data-gb-tab={i}
                            >
                                <span aria-hidden="true">{g.num}</span>
                                <span class="visually-hidden">{g.title}</span>
                            </button>
                        ))
                    }
                </div>
                <button type="button" class="gb-btn" data-gb-next aria-label="Next project">→</button>
                <button type="button" class="gb-pause mono" data-gb-pause aria-pressed="false">Pause</button>
            </div>
            <p class="gb-hint mono muted" data-gb-hint hidden>Try its buttons: A next · B back · Start opens</p>
            <p class="gb-credit mono muted">
                Game Boy: <a href="https://sketchfab.com/3d-models/game-boy-in-voxel-0a99ab3b9cac4bdeacc90118df63a8c9" target="_blank" rel="noopener">“GAME BOY in voxel” by Dani</a>,
                <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>
            </p>
        </div>
    </div>

    <script type="application/json" data-gb-games set:html={JSON.stringify(games.map(({ num, title, clip, poster, href }) => ({ num, title, clip, poster, href })))} />
</section>

<script>
    import { gsap } from "gsap";
    import type { GameBoy } from "../scripts/gameboy";
    import { go } from "../scripts/wipe";

    type Game = { num: string; title: string; clip?: string; poster?: string; href: string };

    const root = document.querySelector<HTMLElement>("[data-gb]");
    if (root) {
        const games: Game[] = JSON.parse(root.querySelector("[data-gb-games]")!.textContent!);
        const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-gb-tab]")];
        const panels = [...root.querySelectorAll<HTMLElement>("[data-gb-panel]")];
        const canvas = root.querySelector<HTMLCanvasElement>("[data-gb-canvas]")!;
        const pauseBtn = root.querySelector<HTMLButtonElement>("[data-gb-pause]")!;
        const hint = root.querySelector<HTMLElement>("[data-gb-hint]")!;
        const fallback = root.querySelector<HTMLElement>("[data-gb-fallback]")!;
        const fallbackVideo = root.querySelector<HTMLVideoElement>("[data-gb-fallback-video]")!;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        let current = 0;
        let playing = !reduceMotion;
        let gb: GameBoy | null = null;
        let useFallback = false;

        const showFallback = () => {
            const g = games[current];
            fallbackVideo.poster = g.poster ?? "";
            if (g.clip) {
                fallbackVideo.src = g.clip;
                if (playing) fallbackVideo.play().catch(() => {});
            } else fallbackVideo.removeAttribute("src");
        };

        const select = (i: number, byVisitor: boolean) => {
            const n = games.length;
            i = ((i % n) + n) % n;
            if (byVisitor) gb?.setAuto(false);
            if (i === current && gb) return;
            current = i;
            tabs.forEach((t, j) => {
                t.setAttribute("aria-selected", String(j === i));
                t.tabIndex = j === i ? 0 : -1;
            });
            panels.forEach((p, j) => (p.hidden = j !== i));
            if (!reduceMotion) gsap.from(panels[i].children, { autoAlpha: 0, y: 12, duration: 0.6, ease: "expo.out", stagger: 0.05, overwrite: true });
            if (gb) gb.tune(i);
            else if (useFallback) showFallback();
        };

        tabs.forEach((t, i) => t.addEventListener("click", () => select(i, true)));
        // tabs pattern: the arrow keys move along the projects
        root.querySelector("[role=tablist]")!.addEventListener("keydown", (e) => {
            const k = (e as KeyboardEvent).key;
            const to = k === "ArrowRight" ? current + 1 : k === "ArrowLeft" ? current - 1 : k === "Home" ? 0 : k === "End" ? games.length - 1 : null;
            if (to === null) return;
            e.preventDefault();
            select(to, true);
            tabs[current].focus();
        });
        root.querySelector("[data-gb-prev]")!.addEventListener("click", () => select(current - 1, true));
        root.querySelector("[data-gb-next]")!.addEventListener("click", () => select(current + 1, true));

        const syncPause = () => {
            pauseBtn.textContent = playing ? "Pause" : "Play";
            pauseBtn.setAttribute("aria-pressed", String(!playing));
        };
        const togglePlaying = () => {
            playing = !playing;
            syncPause();
            if (gb) {
                if (!playing) gb.setAuto(false);
                gb.setPlaying(playing);
            } else if (useFallback) playing ? fallbackVideo.play().catch(() => {}) : fallbackVideo.pause();
        };
        pauseBtn.addEventListener("click", togglePlaying);
        syncPause();

        // load three.js and the model when the Game Boy gets close to the screen
        const start = async () => {
            try {
                const { createGameBoy } = await import("../scripts/gameboy");
                gb = await createGameBoy({
                    canvas,
                    channels: games,
                    reduceMotion,
                    onNext: () => select(current + 1, true),
                    onPrev: () => select(current - 1, true),
                    onOpen: () => go(games[current].href),
                    onToggle: togglePlaying,
                    onEnded: () => select(current + 1, false),
                });
                gb.tune(current);
                root.classList.add("is-live");
                hint.hidden = false;
            } catch (err) {
                console.warn("Game Boy: no WebGL, showing the plain video instead", err);
                useFallback = true;
                fallback.hidden = false;
                canvas.hidden = true;
                showFallback();
            }
        };
        const io = new IntersectionObserver(
            ([entry]) => {
                if (!entry.isIntersecting) return;
                io.disconnect();
                start();
            },
            { rootMargin: "400px 0px" },
        );
        io.observe(root);
    }
</script>

<style>
    .gb-section {
        padding-block: var(--section);
    }

    .gb-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--gutter);
        padding-top: 14px;
        border-top: 1px solid var(--line);
    }

    .gb-head h2 {
        margin: 0;
    }

    .gb-layout {
        display: grid;
        gap: clamp(32px, 5vw, 56px) var(--gutter);
        margin-top: clamp(32px, 5vw, 64px);
    }

    /* --- the note beside it --- */

    .gb-info {
        min-width: 0;
    }

    /* the reset makes articles display: block, which would beat [hidden] */
    .gb-panel[hidden] {
        display: none;
    }

    /* without JS every note shows, one after another */
    :global(html:not(.js)) .gb-panel[hidden] {
        display: block;
        margin-top: 48px;
    }

    .gb-panel__kicker {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        margin: 0;
    }

    .gb-panel__title {
        margin: 14px 0 0;
        font-family: var(--display);
        font-size: clamp(2.5rem, 1.2rem + 3.6vw, 4.75rem);
        font-weight: 800;
        line-height: 0.9;
        letter-spacing: -0.055em;
    }

    .gb-panel__facts {
        display: grid;
        gap: 10px;
        margin: clamp(20px, 2.4vw, 32px) 0 0;
        padding-top: 14px;
        border-top: 1px solid var(--line);
    }

    .gb-panel__facts dd {
        margin: 2px 0 0;
    }

    .gb-panel__brief {
        max-width: 34ch;
        margin: clamp(20px, 2.4vw, 28px) 0;
        font-size: var(--fs-body);
        line-height: 1.4;
    }

    /* --- the Game Boy and its controls --- */

    .gb-col {
        order: -1;
        min-width: 0;
    }

    .gb-stage {
        position: relative;
        /* it's tall: square, but never taller than most of the screen */
        aspect-ratio: 1 / 1;
        max-height: min(74svh, 720px);
        width: 100%;
    }

    .gb-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        touch-action: pan-y;
        opacity: 0;
        transition: opacity 0.6s var(--ease);
    }

    .gb-section.is-live .gb-canvas {
        opacity: 1;
    }

    .gb-fallback[hidden] {
        display: none;
    }

    .gb-fallback {
        position: absolute;
        inset: 10% 18%;
        display: grid;
        place-items: center;
    }

    .gb-fallback video {
        width: 100%;
        max-height: 100%;
        background: var(--screen-bg);
        outline: 1px solid var(--line);
        outline-offset: 12px;
    }

    .gb-controls {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-top: 8px;
    }

    .gb-tabs {
        display: flex;
        gap: 6px;
    }

    /* square, hairline; blue under the pointer and on the project showing */
    .gb-btn,
    .gb-tab,
    .gb-pause {
        display: grid;
        place-items: center;
        min-width: 44px;
        height: 44px;
        padding: 0 12px;
        border: 1px solid var(--line);
        background: none;
        color: var(--text);
        font: inherit;
        cursor: pointer;
        transition:
            border-color 0.15s var(--step),
            background-color 0.15s var(--step),
            color 0.15s var(--step);
    }

    .gb-btn {
        padding: 0;
        font-family: var(--mono);
    }

    .gb-pause {
        margin-left: 6px;
        color: var(--muted);
    }

    .gb-btn:hover,
    .gb-btn:focus-visible,
    .gb-tab:hover,
    .gb-tab:focus-visible,
    .gb-pause:hover,
    .gb-pause:focus-visible {
        border-color: var(--blue);
        color: var(--text);
        outline: none;
    }

    .gb-tab[aria-selected="true"] {
        background: var(--blue);
        border-color: var(--blue);
        color: #e9e7e2;
    }

    .gb-hint[hidden] {
        display: none;
    }

    .gb-hint {
        margin: 14px 0 0;
        text-align: center;
    }

    .gb-credit {
        margin: 8px 0 0;
        font-size: 0.68rem;
        text-align: center;
    }

    .gb-credit a {
        text-decoration: underline;
        text-decoration-color: var(--blue);
        text-underline-offset: 0.2em;
    }

    @media (min-width: 900px) {
        .gb-layout {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            align-items: center;
        }

        .gb-info {
            grid-column: 1 / span 5;
        }

        .gb-col {
            grid-column: 6 / -1;
            order: 0;
        }
    }

    @media (max-width: 420px) {
        .gb-controls {
            gap: 6px;
        }

        .gb-tabs {
            gap: 4px;
        }

        .gb-btn,
        .gb-tab {
            min-width: 40px;
            height: 40px;
            padding: 0 8px;
        }
    }
</style>
