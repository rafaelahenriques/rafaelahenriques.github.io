---
/**
 * The projects page: an arcade. By default a close-up of a black cabinet
 * whose screen flips through the projects (src/scripts/arcade.ts),
 * with the project on screen, back / next and a link beside it (under it on
 * smaller screens). The cabinet's own controls work too: left stick and
 * buttons go back, right ones forward, the screen opens the project. Until the
 * visitor touches anything it flips on its own (not with reduced motion).
 *
 * "View as list" moves in on the screen until it fills the middle of the page
 * and shows every project on it, like a game's select screen: back to the
 * arcade on the left, the filters on the right. The list is plain HTML, laid
 * over the 3D screen to its measurements (LIST in arcade.ts); on smaller
 * screens it's just the screen, without the camera move. The view is kept in
 * the URL (?view=list), the filter as a hash (/projects/#web, which on its own
 * opens the list). Without JS or WebGL it's the list.
 */
import { getImage } from "astro:assets";
import { pad, slugOf, PROJECT_TYPES, type ProjectEntry } from "../lib/content";
import PixelEdge from "./PixelEdge.astro";

interface Props {
    projects: ProjectEntry[];
}

const { projects } = Astro.props;

// a line or two on what it is: the tagline, or the start of a long description
const briefOf = (p: ProjectEntry) => {
    if (p.data.tagline) return p.data.tagline;
    const d = p.data.description ?? "";
    return d.length > 120 ? `${d.split(/[:—]/)[0].trim()}.` : d;
};

const games = await Promise.all(
    projects.map(async (p, i) => {
        const image = p.data.media?.thumbnail ?? p.data.media?.screenshot;
        return {
            num: pad(i + 1),
            title: p.data.title,
            category: p.data.category ?? "",
            year: p.data.year ?? "",
            brief: briefOf(p),
            href: `/projects/${slugOf(p)}/`,
            types: p.data.types as string[],
            inProgress: p.data.status === "in-progress",
            // small: the screen dithers it into big pixels anyway
            image: image && (await getImage({ src: image, width: 480, format: "webp", quality: 75 })).src,
            // the list's thumbnail: tiny on purpose, shown in big pixels
            thumb: image && (await getImage({ src: image, width: 36, format: "png" })).src,
        };
    }),
);
const first = games[0];
const meta = (g: (typeof games)[number]) => [g.category, g.year].filter(Boolean).join(" · ");

const filters = [
    { key: "all", label: "All", count: games.length },
    ...PROJECT_TYPES.map((t) => ({ key: t.key as string, label: t.label as string, count: games.filter((g) => g.types.includes(t.key)).length })),
].filter((f) => f.count > 0);
const filterKeys = filters.map((f) => f.key);
---

<!-- the view from the URL, before anything paints, so the wrong one never flashes -->
<script is:inline define:vars={{ filterKeys }}>
    // the arcade, unless the URL asks for the list or links to a filter (/projects/#web)
    const linked = new URLSearchParams(location.search).get("view") === "list" || (location.hash.length > 1 && filterKeys.includes(location.hash.slice(1)));
    document.documentElement.dataset.projectsView = linked ? "list" : "arcade";
</script>

<div class="arcade" data-arcade data-joins-footer>
    <section class="arcade__block night" aria-labelledby="projects-title">
        <div class="arcade__top wrap mono">
            <h1 id="projects-title" class="arcade__label">Projects <span class="arcade__count">({pad(games.length)})</span></h1>
            <button type="button" class="arcade__view arcade__for-arcade" data-view-to="list">
                View as list
                <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M0 1.5h12M0 6h12M0 10.5h12" stroke="currentColor" stroke-width="1.5" /></svg>
            </button>
        </div>

        <div class="arcade__stage">
            <canvas class="arcade__canvas" data-arcade-canvas aria-hidden="true"></canvas>
            <p class="arcade__loading mono" data-arcade-loading>Insert coin…</p>
        </div>

        <div class="arcade__bar arcade__for-arcade wrap">
            <p class="arcade__now" aria-live="polite">
                <span class="arcade__num mono" data-arcade-num>{first.num} / {pad(games.length)}</span>
                <a href={first.href} class="arcade__title" data-arcade-title>{first.title}</a>
                <span class="arcade__meta mono" data-arcade-meta>{meta(first)}</span>
                <span class="arcade__brief" data-arcade-brief>{first.brief}</span>
            </p>
            <div class="arcade__controls">
                <button type="button" class="arcade__btn" data-arcade-prev aria-label="Previous project">←</button>
                <button type="button" class="arcade__btn" data-arcade-next aria-label="Next project">→</button>
                <a href={first.href} class="arcade__open mono" data-arcade-open>Open project <span aria-hidden="true">→</span></a>
            </div>
            <p class="arcade__hint mono" data-arcade-hint hidden>Try the sticks and buttons · the screen opens a project</p>
        </div>

        <!-- THE LIST: back to the arcade on the left, the screen, the filters on the right -->
        <div class="arcade__side arcade__side--left arcade__for-list">
            <button type="button" class="arcade__back mono" data-view-to="arcade">
                <span aria-hidden="true">←</span> Back to arcade
            </button>
        </div>

        <div class="arcade__side arcade__side--right arcade__for-list">
            <p class="arcade__side-label mono">Filter</p>
            <div class="arcade__filters" role="group" aria-label="Filter projects">
                {
                    filters.map((f) => (
                        <button type="button" class="arcade__filter mono" data-filter={f.key} data-label={f.label} aria-pressed={f.key === "all" ? "true" : "false"}>
                            <span>{f.label}</span>
                            <span class="arcade__filter-count">{pad(f.count)}</span>
                        </button>
                    ))
                }
            </div>
        </div>

        <div class="arcade__screen crt arcade__for-list" data-arcade-screen>
            <div class="screen">
                <p class="screen__head">
                    <span data-screen-label>Select project</span>
                    <span data-screen-count>{pad(games.length)} / {pad(games.length)}</span>
                </p>
                <ul class="screen__rows" aria-label="All projects">
                    {
                        games.map((g) => (
                            <li data-row>
                                <a href={g.href} class="screen__row">
                                    <span class="screen__thumb">{g.thumb && <img src={g.thumb} alt="" width="36" height="24" loading="lazy" decoding="async" />}</span>
                                    <span class="screen__num">{g.num}</span>
                                    <span class="screen__text">
                                        <span class="screen__title">{g.title}</span>
                                        <span class="screen__cat">{g.category}</span>
                                    </span>
                                    <span class="screen__year">{g.year}</span>
                                </a>
                            </li>
                        ))
                    }
                </ul>
                <p class="screen__hint" aria-hidden="true"><span>↑↓ Choose · Enter start</span><span>Esc arcade</span></p>
            </div>
        </div>
        <p class="visually-hidden" aria-live="polite" data-filter-status></p>

        <p class="arcade__credit wrap mono">
            Arcade: <a href="https://sketchfab.com/3d-models/arcade-invaders-8c96ac36c52e4cf2a33cf605bd762014" target="_blank" rel="noopener">“Arcade Invaders” by tef</a>,
            <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>, restyled
        </p>
    </section>
    <!-- straight on into the footer: on the light theme both are ink, so the
         pixels don't show; on the dark one the footer is paper and they do -->
    <PixelEdge class="arcade__edge" seed={12} rows={9} tone="inverse" />

    <script type="application/json" data-arcade-games set:html={JSON.stringify(games)} />
</div>

<script>
    import { gsap } from "gsap";
    import type { Arcade, ArcadeGame } from "../scripts/arcade";
    import { go } from "../scripts/wipe";

    type Game = ArcadeGame & { types: string[]; brief: string };
    type View = "arcade" | "list";

    const root = document.querySelector<HTMLElement>("[data-arcade]");
    if (root) {
        const html = document.documentElement;
        const games: Game[] = JSON.parse(root.querySelector("[data-arcade-games]")!.textContent!);
        const canvas = root.querySelector<HTMLCanvasElement>("[data-arcade-canvas]")!;
        const num = root.querySelector<HTMLElement>("[data-arcade-num]")!;
        const title = root.querySelector<HTMLAnchorElement>("[data-arcade-title]")!;
        const meta = root.querySelector<HTMLElement>("[data-arcade-meta]")!;
        const brief = root.querySelector<HTMLElement>("[data-arcade-brief]")!;
        const open = root.querySelector<HTMLAnchorElement>("[data-arcade-open]")!;
        const hint = root.querySelector<HTMLElement>("[data-arcade-hint]")!;
        const loading = root.querySelector<HTMLElement>("[data-arcade-loading]")!;
        const screenEl = root.querySelector<HTMLElement>("[data-arcade-screen]")!;
        const rows = [...root.querySelectorAll<HTMLElement>("[data-row]")];
        const filterButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-filter]")];
        const screenLabel = root.querySelector<HTMLElement>("[data-screen-label]")!;
        const screenCount = root.querySelector<HTMLElement>("[data-screen-count]")!;
        const status = root.querySelector<HTMLElement>("[data-filter-status]")!;
        const arcadeParts = [...root.querySelectorAll<HTMLElement>(".arcade__for-arcade")];
        const listParts = [...root.querySelectorAll<HTMLElement>(".arcade__for-list")];
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        // where the list sits over the cabinet's screen; smaller, it's the screen alone
        const wide = window.matchMedia("(min-width: 1100px)");
        const pad = (n: number) => String(n).padStart(2, "0");

        let view: View = html.dataset.projectsView === "list" ? "list" : "arcade";
        let current = 0;
        let arcade: Arcade | null = null;

        /* --- the arcade: flipping through the projects --- */

        // attract mode: it flips by itself until the visitor takes over
        const ATTRACT_MS = 4200;
        let attract = !reduceMotion;
        let timer = 0;
        let hovering = false;
        const schedule = () => {
            clearTimeout(timer);
            if (!attract) return;
            timer = window.setTimeout(() => {
                if (arcade?.visible && !hovering && view === "arcade") step(1, false);
                schedule();
            }, ATTRACT_MS);
        };

        const select = (i: number) => {
            current = i;
            const g = games[i];
            num.textContent = `${g.num} / ${pad(games.length)}`;
            title.textContent = g.title;
            title.href = open.href = g.href;
            meta.textContent = [g.category, g.year].filter(Boolean).join(" · ");
            brief.textContent = g.brief;
            if (!reduceMotion) gsap.fromTo([num, title, meta, brief], { autoAlpha: 0, y: 8 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: "expo.out", stagger: 0.04, overwrite: true });
            arcade?.show(i);
        };
        const step = (dir: number, byVisitor: boolean) => {
            if (byVisitor) attract = false;
            const n = games.length;
            select((((current + dir) % n) + n) % n);
            schedule();
        };

        root.querySelector("[data-arcade-prev]")!.addEventListener("click", () => step(-1, true));
        root.querySelector("[data-arcade-next]")!.addEventListener("click", () => step(1, true));
        canvas.addEventListener("pointerenter", () => (hovering = true));
        canvas.addEventListener("pointerleave", () => (hovering = false));

        /* --- the list: filtering --- */

        let filter = "all";
        const keys = filterButtons.map((b) => b.dataset.filter!);
        const shown = () => rows.flatMap((r, i) => (r.hidden ? [] : [i]));
        const labelFor = (key: string) => (key === "all" ? "Select project" : `Select project · ${filterButtons.find((b) => b.dataset.filter === key)!.dataset.label}`);

        const applyFilter = (key: string, animate = true) => {
            const next = keys.includes(key) ? key : "all";
            const changed = next !== filter;
            filter = next;
            filterButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === next)));
            rows.forEach((r, i) => (r.hidden = next !== "all" && !games[i].types.includes(next)));
            const visible = shown();
            screenLabel.textContent = labelFor(next);
            screenCount.textContent = `${pad(visible.length)} / ${pad(games.length)}`;
            status.textContent = `Showing ${visible.length} of ${games.length} projects`;
            history.replaceState(null, "", location.pathname + location.search + (next === "all" ? "" : `#${next}`));
            arcade?.setList(visible, labelFor(next));
            // the rows come back on like an old screen redrawing
            if (animate && changed && !reduceMotion) {
                // (opacity only: a hidden row can't take focus, and ↑ ↓ may come straight away)
                gsap.fromTo(rows.filter((r) => !r.hidden), { opacity: 0 }, { opacity: 1, duration: 0.24, ease: "steps(3)", stagger: 0.04, clearProps: "opacity" });
            }
        };
        filterButtons.forEach((b) => b.addEventListener("click", () => applyFilter(b.dataset.filter!)));
        window.addEventListener("hashchange", () => applyFilter(location.hash.slice(1) || "all"));

        /* --- switching between the two: in on the screen, and back out --- */

        let busy = false;
        const setView = async (next: View, { animate = true, save = true } = {}) => {
            if (next === view || busy) return;
            busy = true;
            view = next;
            if (save) {
                const url = new URL(location.href);
                if (next === "list") url.searchParams.set("view", "list");
                else url.searchParams.delete("view");
                history.replaceState(null, "", url);
            }
            if (window.scrollY > 0) window.scrollTo({ top: 0 });
            // the camera move only where the list sits over the cabinet's screen
            const move = !!arcade && wide.matches && animate && !reduceMotion;
            if (next === "list") {
                clearTimeout(timer);
                if (move) {
                    await gsap.to(arcadeParts, { autoAlpha: 0, duration: 0.25, ease: "power2.in" });
                    gsap.set(listParts, { autoAlpha: 0 });
                    html.dataset.projectsView = "list";
                    arcade!.refit();
                    await arcade!.setMode("list");
                    // the screen was drawn to match: swap the picture for the real list
                    await gsap.to(screenEl, { autoAlpha: 1, duration: 0.15 });
                    gsap.fromTo(listParts.filter((el) => el !== screenEl), { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: "expo.out", stagger: 0.08 });
                } else {
                    html.dataset.projectsView = "list";
                    arcade?.refit();
                    arcade?.setMode("list", false);
                    // an old screen switching on: a bright line opening out
                    if (animate && !reduceMotion) gsap.fromTo(screenEl, { scaleY: 0.02, filter: "brightness(3)" }, { scaleY: 1, filter: "brightness(1)", duration: 0.5, ease: "expo.out", clearProps: "transform,filter" });
                }
                gsap.set(arcadeParts, { clearProps: "opacity,visibility,transform" });
                rows.find((r) => !r.hidden)?.querySelector("a")?.focus({ preventScroll: true });
            } else {
                if (move) {
                    await gsap.to(listParts, { autoAlpha: 0, duration: 0.2, ease: "power2.in" });
                    gsap.set(arcadeParts, { autoAlpha: 0 });
                    html.dataset.projectsView = "arcade";
                    await arcade!.setMode("arcade");
                    gsap.to(arcadeParts, { autoAlpha: 1, duration: 0.4, ease: "power2.out", clearProps: "opacity,visibility" });
                } else {
                    html.dataset.projectsView = "arcade";
                    arcade?.setMode("arcade", false);
                }
                gsap.set(listParts, { clearProps: "opacity,visibility,transform" });
                schedule();
            }
            busy = false;
        };
        root.querySelectorAll<HTMLElement>("[data-view-to]").forEach((b) => b.addEventListener("click", () => setView(b.dataset.viewTo as View)));

        /* --- keys: ← → on the arcade; ↑ ↓ through the list, Esc back to the arcade --- */

        document.addEventListener("keydown", (e) => {
            if (e.target instanceof HTMLInputElement || e.metaKey || e.ctrlKey || e.altKey) return;
            if (view === "arcade") {
                if (!root.contains(document.activeElement) && document.activeElement !== document.body) return;
                if (e.key === "ArrowLeft") step(-1, true);
                else if (e.key === "ArrowRight") step(1, true);
                return;
            }
            if (e.key === "Escape" && arcade && !root.classList.contains("is-flat")) setView("arcade");
            if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
            // ↑ ↓ move through the list from anywhere on it (a filter just
            // clicked, the back button): from outside the rows they start at
            // the top or the bottom
            if (!root.contains(document.activeElement) && document.activeElement !== document.body) return;
            const links = rows.filter((r) => !r.hidden).map((r) => r.querySelector("a")!);
            if (!links.length) return;
            const at = links.indexOf(document.activeElement as HTMLAnchorElement);
            e.preventDefault();
            const to = at < 0 ? (e.key === "ArrowDown" ? 0 : links.length - 1) : e.key === "ArrowDown" ? Math.min(links.length - 1, at + 1) : Math.max(0, at - 1);
            links[to].focus();
        });

        /* --- start --- */

        applyFilter(location.hash.slice(1) || "all", false);

        // load three.js and the model once the arcade is about to be seen
        const start = async () => {
            try {
                const { createArcade } = await import("../scripts/arcade");
                arcade = await createArcade({
                    canvas,
                    games,
                    reduceMotion,
                    onPrev: () => step(-1, true),
                    onNext: () => step(1, true),
                    onOpen: () => go(games[current].href),
                    screenBox: () => (wide.matches ? screenEl.getBoundingClientRect() : null),
                });
                await arcade.setList(shown(), labelFor(filter));
                if (view === "list") await arcade.setMode("list", false);
                arcade.show(current);
                root.classList.add("is-live");
                hint.hidden = false;
                schedule();
            } catch (err) {
                // no WebGL: the list, on its own
                console.warn("Arcade: no WebGL, showing the list instead", err);
                arcade = null;
                root.classList.add("is-flat");
                setView("list", { animate: false, save: false });
            } finally {
                loading.hidden = true;
            }
        };
        const io = new IntersectionObserver(
            ([entry]) => {
                if (!entry.isIntersecting) return;
                io.disconnect();
                start();
            },
            { rootMargin: "400px 0px" },
        );
        io.observe(root);
    }
</script>

<style>
    .arcade :global(.arcade__edge) {
        background: var(--night-bg);
    }

    .arcade__block {
        --stage-h: clamp(400px, 64vh, 620px);
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        container-type: inline-size;
    }

    .arcade__top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--gutter);
        padding-block: 8px 0;
        color: var(--muted);
    }

    .arcade__label {
        margin: 0;
        font: inherit;
        letter-spacing: inherit;
        text-transform: inherit;
    }

    .arcade__view {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border: 1px solid currentColor;
        background: none;
        color: var(--text);
        font: inherit;
        text-transform: inherit;
        letter-spacing: inherit;
        cursor: pointer;
        transition:
            background-color 0.15s var(--step),
            border-color 0.15s var(--step),
            color 0.15s var(--step);
    }

    .arcade__view:hover,
    .arcade__view:focus-visible {
        border-color: var(--blue);
        background: var(--blue);
        color: #e9e7e2;
        outline: none;
    }

    .arcade__stage {
        position: relative;
        height: var(--stage-h);
    }

    /* the close-up cuts off softly at the bottom; moved in on the screen, it doesn't */
    @property --fade {
        syntax: "<percentage>";
        inherits: false;
        initial-value: 82%;
    }

    .arcade__canvas {
        --fade: 82%;
        display: block;
        width: 100%;
        height: 100%;
        mask-image: linear-gradient(to bottom, #000 var(--fade), transparent);
        opacity: 0;
        transition:
            opacity 1.2s var(--ease),
            --fade 1.2s var(--ease);
        touch-action: pan-y;
    }

    :global(html[data-projects-view="list"]) .arcade__canvas {
        --fade: 100%;
    }

    .is-live .arcade__canvas {
        opacity: 1;
    }

    .arcade__loading {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        margin: 0;
        color: var(--muted);
    }

    .arcade__loading[hidden],
    .arcade__hint[hidden] {
        display: none;
    }

    /* --- the arcade's project on screen, and its controls --- */

    .arcade__bar {
        display: grid;
        gap: 18px;
        padding-block: 20px;
        border-top: 1px solid var(--line);
    }

    .arcade__now {
        display: grid;
        gap: 6px;
        margin: 0;
        min-width: 0;
    }

    .arcade__num,
    .arcade__meta,
    .arcade__hint {
        color: var(--muted);
    }

    /* what it is, in a line or two */
    .arcade__brief {
        max-width: 38ch;
        margin-top: 10px;
        font-size: var(--fs-body);
        line-height: 1.4;
    }

    .arcade__title {
        font-family: var(--display);
        font-size: clamp(2.25rem, 1rem + 3.6vw, 4.5rem);
        font-weight: 800;
        line-height: 0.9;
        letter-spacing: -0.055em;
        text-decoration: none;
        color: var(--text);
        overflow-wrap: anywhere;
        transition: color 0.15s var(--step);
    }

    .arcade__title:hover {
        color: var(--blue);
    }

    .arcade__controls {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .arcade__btn {
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        padding: 0;
        border: 1px solid var(--line);
        background: none;
        color: var(--text);
        font: inherit;
        font-size: 1.1rem;
        cursor: pointer;
        transition:
            border-color 0.15s var(--step),
            background-color 0.15s var(--step),
            color 0.15s var(--step);
    }

    .arcade__btn:hover,
    .arcade__btn:focus-visible {
        border-color: var(--blue);
        outline: none;
    }

    .arcade__btn:active {
        background: var(--blue);
        border-color: var(--blue);
        color: #e9e7e2;
    }

    /* the one filled button: blue, like the cabinet's buttons */
    .arcade__open {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        height: 48px;
        margin-left: auto;
        padding: 0 18px;
        background: var(--blue);
        color: #e9e7e2;
        text-decoration: none;
        text-transform: uppercase;
        transition:
            background-color 0.15s var(--step),
            color 0.15s var(--step);
    }

    .arcade__open:hover,
    .arcade__open:focus-visible {
        background: #e9e7e2;
        color: #0e0e0e;
        outline: none;
    }

    .arcade__hint {
        margin: 0;
    }

    .arcade__credit {
        margin: 0;
        padding-block: 24px;
        color: var(--muted);
    }

    .arcade__credit a {
        color: inherit;
    }

    /* --- the list's controls: back to the arcade, and the filters --- */

    .arcade__side {
        display: grid;
        gap: 12px;
        align-content: start;
    }

    .arcade__side-label {
        margin: 0;
        color: var(--muted);
    }

    .arcade__back,
    .arcade__filter {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px 14px;
        border: 1px solid var(--line);
        background: none;
        color: var(--text);
        font-family: var(--mono);
