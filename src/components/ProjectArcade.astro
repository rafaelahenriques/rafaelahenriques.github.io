---
/**
 * The projects as an arcade: a close-up of a cabinet whose screen flips
 * through them (src/scripts/arcade.ts), on a dark block that dissolves into
 * the page in pixels. Under it, the project on screen, back / next and a link
 * to open it. The cabinet's own controls work too: left stick and buttons go
 * back, right ones forward, 1P / 2P and the screen open the project. Until the
 * visitor touches anything it flips on its own (not with reduced motion).
 *
 * The projects page tells it which projects match the filter with an
 * "arcade:filter" event (the indexes, in order); if WebGL isn't there it sends
 * "arcade:unavailable" and the page shows the list instead.
 */
import { getImage } from "astro:assets";
import { pad, slugOf, type ProjectEntry } from "../lib/content";
import PixelEdge from "./PixelEdge.astro";

interface Props {
    projects: ProjectEntry[];
}

const { projects } = Astro.props;

const games = await Promise.all(
    projects.map(async (p, i) => {
        const image = p.data.media?.thumbnail ?? p.data.media?.screenshot;
        return {
            num: pad(i + 1),
            title: p.data.title,
            category: p.data.category ?? "",
            year: p.data.year ?? "",
            href: `/projects/${slugOf(p)}/`,
            // small: the screen dithers it into big pixels anyway
            image: image && (await getImage({ src: image, width: 480, format: "webp", quality: 75 })).src,
            inProgress: p.data.status === "in-progress",
        };
    }),
);
const first = games[0];
const meta = (g: (typeof games)[number]) => [g.category, g.year].filter(Boolean).join(" · ");
---

<div class="arcade" data-arcade>
    <PixelEdge seed={11} rows={6} tone="night" />
    <section class="arcade__block night" aria-label="Projects arcade">
        <div class="arcade__stage">
            <canvas class="arcade__canvas" data-arcade-canvas aria-hidden="true"></canvas>
            <p class="arcade__loading mono" data-arcade-loading>Insert coin…</p>
        </div>

        <div class="arcade__bar wrap">
            <p class="arcade__now" aria-live="polite">
                <span class="arcade__num mono" data-arcade-num>{first.num} / {pad(games.length)}</span>
                <a href={first.href} class="arcade__title" data-arcade-title>{first.title}</a>
                <span class="arcade__meta mono" data-arcade-meta>{meta(first)}</span>
            </p>
            <div class="arcade__controls">
                <button type="button" class="arcade__btn" data-arcade-prev aria-label="Previous project">←</button>
                <button type="button" class="arcade__btn" data-arcade-next aria-label="Next project">→</button>
                <a href={first.href} class="arcade__open mono" data-arcade-open>Open project <span aria-hidden="true">→</span></a>
            </div>
        </div>

        <div class="arcade__foot wrap mono">
            <p class="arcade__hint" data-arcade-hint hidden>Sticks and buttons flip through · 1P or the screen opens</p>
            <p class="arcade__credit">
                Arcade: <a href="https://sketchfab.com/3d-models/arcade-invaders-8c96ac36c52e4cf2a33cf605bd762014" target="_blank" rel="noopener">“Arcade Invaders” by tef</a>,
                <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>, restyled
            </p>
        </div>
    </section>
    <PixelEdge seed={12} rows={6} tone="night" direction="up" />

    <script type="application/json" data-arcade-games set:html={JSON.stringify(games)} />
</div>

<script>
    import { gsap } from "gsap";
    import type { Arcade, ArcadeGame } from "../scripts/arcade";

    const root = document.querySelector<HTMLElement>("[data-arcade]");
    if (root) {
        const games: ArcadeGame[] = JSON.parse(root.querySelector("[data-arcade-games]")!.textContent!);
        const canvas = root.querySelector<HTMLCanvasElement>("[data-arcade-canvas]")!;
        const num = root.querySelector<HTMLElement>("[data-arcade-num]")!;
        const title = root.querySelector<HTMLAnchorElement>("[data-arcade-title]")!;
        const meta = root.querySelector<HTMLElement>("[data-arcade-meta]")!;
        const open = root.querySelector<HTMLAnchorElement>("[data-arcade-open]")!;
        const hint = root.querySelector<HTMLElement>("[data-arcade-hint]")!;
        const loading = root.querySelector<HTMLElement>("[data-arcade-loading]")!;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const total = String(games.length).padStart(2, "0");

        // the projects that match the filter, in order, and where we are among them
        let order = games.map((_, i) => i);
        let current = 0;
        let arcade: Arcade | null = null;

        // attract mode: it flips by itself until the visitor takes over
        const ATTRACT_MS = 4200;
        let attract = !reduceMotion;
        let timer = 0;
        let hovering = false;
        const schedule = () => {
            clearTimeout(timer);
            if (!attract) return;
            timer = window.setTimeout(() => {
                if (arcade?.visible && !hovering) step(1, false);
                schedule();
            }, ATTRACT_MS);
        };

        const select = (i: number) => {
            current = i;
            const g = games[i];
            num.textContent = `${g.num} / ${total}`;
            title.textContent = g.title;
            title.href = open.href = g.href;
            meta.textContent = [g.category, g.year].filter(Boolean).join(" · ");
            if (!reduceMotion) gsap.fromTo([num, title, meta], { autoAlpha: 0, y: 8 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: "expo.out", stagger: 0.04, overwrite: true });
            arcade?.show(i);
        };
        const step = (dir: number, byVisitor: boolean) => {
            if (!order.length) return;
            if (byVisitor) attract = false;
            const at = order.indexOf(current);
            const n = order.length;
            select(order[(((at < 0 ? 0 : at + dir) % n) + n) % n]);
            schedule();
        };

        root.querySelector("[data-arcade-prev]")!.addEventListener("click", () => step(-1, true));
        root.querySelector("[data-arcade-next]")!.addEventListener("click", () => step(1, true));
        root.addEventListener("keydown", (e) => {
            if (e.target instanceof HTMLInputElement) return;
            if (e.key === "ArrowLeft") step(-1, true);
            else if (e.key === "ArrowRight") step(1, true);
        });
        canvas.addEventListener("pointerenter", () => (hovering = true));
        canvas.addEventListener("pointerleave", () => (hovering = false));

        // the page's filter: keep to the matching projects
        root.addEventListener("arcade:filter", (e) => {
            order = (e as CustomEvent<number[]>).detail;
            if (order.length && !order.includes(current)) select(order[0]);
        });

        // load three.js and the model once the arcade is about to be seen
        const start = async () => {
            try {
                const { createArcade } = await import("../scripts/arcade");
                arcade = await createArcade({
                    canvas,
                    games,
                    reduceMotion,
                    onPrev: () => step(-1, true),
                    onNext: () => step(1, true),
                    onOpen: () => (window.location.href = games[current].href),
                });
                arcade.show(current);
                root.classList.add("is-live");
                hint.hidden = false;
                schedule();
            } catch (err) {
                console.warn("Arcade: no WebGL, showing the list instead", err);
                root.dispatchEvent(new CustomEvent("arcade:unavailable", { bubbles: true }));
            } finally {
                loading.hidden = true;
            }
        };
        const io = new IntersectionObserver(
            ([entry]) => {
                if (!entry.isIntersecting) return;
                io.disconnect();
                start();
            },
            { rootMargin: "400px 0px" },
        );
        io.observe(root);
    }
</script>

<style>
    .arcade__block {
        position: relative;
    }

    /* the screen's glow on the dark behind the cabinet */
    .arcade__stage {
        position: relative;
        height: clamp(460px, 80vh, 860px);
        background: radial-gradient(60% 55% at 50% 42%, rgba(160, 255, 60, 0.13), transparent 70%);
    }

    .arcade__canvas {
        display: block;
        width: 100%;
        height: 100%;
        /* the close-up cuts off softly at the bottom */
        mask-image: linear-gradient(to bottom, #000 82%, transparent);
        opacity: 0;
        transition: opacity 1.2s var(--ease);
        touch-action: pan-y;
    }

    .is-live .arcade__canvas {
        opacity: 1;
    }

    .arcade__loading {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        margin: 0;
        color: var(--muted);
    }

    .arcade__loading[hidden] {
        display: none;
    }

    /* --- the project on screen, and the controls --- */

    .arcade__bar {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        gap: 16px var(--gutter);
        padding-block: 20px;
        border-top: 1px solid var(--line);
    }

    .arcade__now {
        display: grid;
        gap: 6px;
        margin: 0;
        min-width: 0;
    }

    .arcade__num,
    .arcade__meta {
        color: var(--muted);
    }

    .arcade__title {
        font-size: clamp(1.6rem, 0.9rem + 3vw, 3.75rem);
        font-weight: 800;
        line-height: 0.95;
        letter-spacing: -0.03em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--text);
        overflow-wrap: anywhere;
    }

    .arcade__title:hover {
        color: #c3f23a;
    }

    .arcade__controls {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .arcade__btn {
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        padding: 0;
        border: 1px solid var(--line);
        background: none;
        color: var(--text);
        font: inherit;
        font-size: 1.1rem;
        cursor: pointer;
        transition:
            border-color 0.3s var(--ease),
            background-color 0.3s var(--ease),
            color 0.3s var(--ease);
    }

    .arcade__btn:hover {
        border-color: var(--text);
    }

    .arcade__btn:active {
        background: var(--text);
        color: var(--bg);
    }

    /* the one lit-up button: phosphor green, square, like the screen */
    .arcade__open {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        height: 48px;
        margin-left: 6px;
        padding: 0 18px;
        background: #c3f23a;
        color: #15300d;
        text-decoration: none;
        text-transform: uppercase;
        transition: box-shadow 0.3s var(--ease);
    }

    .arcade__open:hover,
    .arcade__open:focus-visible {
        box-shadow: 0 0 24px rgba(195, 242, 58, 0.55);
    }

    .arcade__foot {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px var(--gutter);
        padding-bottom: 24px;
        color: var(--muted);
    }

    .arcade__foot p {
        margin: 0;
    }

    .arcade__hint[hidden] {
        display: none;
    }

    .arcade__credit a {
        color: inherit;
    }

    @media (max-width: 719px) {
        .arcade__stage {
            height: clamp(400px, 66vh, 620px);
        }

        .arcade__bar {
            grid-template-columns: minmax(0, 1fr);
        }

        .arcade__open {
            margin-left: auto;
        }
    }
</style>
