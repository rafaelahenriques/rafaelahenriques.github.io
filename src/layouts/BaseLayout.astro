---
const { title = "Portfolio", description = "" } = Astro.props;
const fullTitle =
    title === "Home" ? "Rafaela Henriques — Web Developer" : `${title} — Rafaela Henriques`;

import "../styles/reset.css";
import "../styles/global.css";

import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import Loader from "../components/Loader.astro";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <meta name="color-scheme" content="light dark" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=Inter:wght@500;800&display=swap"
        />
        <!-- page-specific extras, e.g. a case study's own fonts -->
        <slot name="head" />

        <!-- Apply theme + JS flag before first paint so nothing flashes -->
        <script is:inline>
            (() => {
                const root = document.documentElement;
                root.classList.add("js");
                let theme = null;
                try {
                    theme = localStorage.getItem("theme");
                } catch {}
                if (theme !== "light" && theme !== "dark") {
                    theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
                }
                root.classList.add(theme);
                root.style.colorScheme = theme;

                // Loading screen: first page of a visit only, never for reduced motion
                let seen = false;
                try {
                    seen = sessionStorage.getItem("loader-seen") === "1";
                } catch {}
                if (!seen && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
                    root.classList.add("is-loading");
                    // safety net: never leave the page locked if the loader script fails
                    setTimeout(() => root.classList.remove("is-loading"), 6000);
                }
            })();
        </script>
    </head>
    <body id="top">
        <Loader />
        <Header />
        <main id="main">
            <slot />
        </main>
        <Footer />

        <script>
            import { initAnimations } from "../scripts/animations";
            initAnimations();
        </script>
    </body>
</html>
