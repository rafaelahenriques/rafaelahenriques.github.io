---
const { title = "Portfolio", description = "" } = Astro.props;

import "../styles/reset.css";
import "../styles/markdown.css";
import "../styles/global.css";

import Header from "../components/header.astro";
import Footer from "../components/footer.astro";

---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="color-scheme" content="light dark" />
        <!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Gasoek+One&family=Roboto:ital,wght@0,100..900;1,100..900&family=Rubik+Glitch&display=swap"
  rel="stylesheet"
/>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anonymous+Pro:ital,wght@0,400;0,700;1,400;1,700&family=Press+Start+2P&display=swap" rel="stylesheet">
    </head>
    <body>
        <Header />
        <main id="main">
            <slot />
        </main>
        <Footer />
    </body>
</html>
