---
import "../styles/reset.css";
import "../styles/global.css";

import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import Loader from "../components/Loader.astro";
import CommandMenu from "../components/CommandMenu.astro";
import PixelEdge from "../components/PixelEdge.astro";
import portrait from "../assets/me/rafaela.jpg";
import { NAME, personSchema, type Schema } from "../lib/seo";

interface Props {
    title?: string;
    description?: string;
    /** share image, cropped to 1200×630; defaults to /og.png */
    image?: ImageMetadata;
    type?: "website" | "article" | "profile";
    /** structured data for this page, on top of the Person every page carries */
    schema?: Schema[];
    /** keep this page out of search results (e.g. the 404) */
    noindex?: boolean;
}

const { title = "Portfolio", description = "", image, type = "website", schema = [], noindex = false } = Astro.props;
const fullTitle = title === "Home" ? `${NAME} — Web Developer` : `${title} — ${NAME}`;

// absolute URLs: search engines and share previews need the full address
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = image
    ? new URL((await getImage({ src: image, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 80 })).src, Astro.site).href
    : new URL("/og.png", Astro.site).href;
const personImage = new URL((await getImage({ src: portrait, width: 800, format: "jpg", quality: 80 })).src, Astro.site).href;
const jsonLd = [personSchema(personImage), ...schema];
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <meta name="author" content={NAME} />
        {!noindex && <link rel="canonical" href={canonical} />}
        <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
        <meta name="color-scheme" content="light dark" />
        <meta name="theme-color" content="#f3f1ec" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#0e0e0d" media="(prefers-color-scheme: dark)" />

        <!-- icons: Google uses favicon.ico / the 96 px PNG (multiples of 48 px) -->
        <link rel="icon" href="/favicon.ico" sizes="48x48" />
        <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <!-- share previews (LinkedIn, Slack, iMessage, X…) -->
        <meta property="og:type" content={type} />
        <meta property="og:site_name" content={NAME} />
        <meta property="og:locale" content="en" />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={shareImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={image ? title : `${NAME}, web developer`} />
        <meta name="twitter:card" content="summary_large_image" />

        <!-- structured data: who this is, and what this page is -->
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=Inter:wght@500;800&family=Silkscreen:wght@400;700&display=swap"
        />
        <!-- page-specific extras, e.g. a case study's own fonts -->
        <slot name="head" />

        <!-- Apply theme + JS flag before first paint so nothing flashes -->
        <script is:inline>
            (() => {
                const root = document.documentElement;
                root.classList.add("js");
                let theme = null;
                try {
                    theme = localStorage.getItem("theme");
                } catch {}
                if (theme !== "light" && theme !== "dark") {
                    theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
                }
                root.classList.add(theme);
                root.style.colorScheme = theme;

                // Loading screen: first page of a visit only, never for reduced motion
                let seen = false;
                try {
                    seen = sessionStorage.getItem("loader-seen") === "1";
                } catch {}
                if (!seen && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
                    root.classList.add("is-loading");
                    // safety net: never leave the page locked if the loader script fails
                    setTimeout(() => root.classList.remove("is-loading"), 6000);
                }
            })();
        </script>
    </head>
    <body id="top">
        <a class="skip-link mono" href="#main">Skip to content</a>
        <Loader />
        <Header />
        <main id="main">
            <slot />
        </main>
        <!-- the page dissolves into the footer, unless it already ends in a dark block -->
        <PixelEdge class="footer-edge" seed={7} rows={6} />
        <Footer />
        <CommandMenu />

        <script>
            import { initAnimations } from "../scripts/animations";
            initAnimations();
        </script>
    </body>
</html>
